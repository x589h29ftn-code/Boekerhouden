@page "/a/{Id:guid}/aansluitingen"
@inject AansluitingDienst Aansluiting
@inject BankDienst Bank

<AdministratieKader Id="Id" Titel="Aansluitingen" Actief="/aansluitingen" BijOpenen="Open">
    <Acties>
        <button class="btn btn-sm btn-outline-secondary" disabled="@bezig" title="Bijwerken" @onclick="Laad">Verversen</button>
    </Acties>
    <ChildContent>
        @if (lijst is { Count: 0 })
        {
            <div class="leeg-regel">Geen bank, crediteuren, debiteuren of btw-rekeningen ingericht.</div>
        }
        else if (lijst is not null)
        {
            <div class="card overzichtskaart">
                <table class="table align-middle mb-0 overzichtstabel aansluitingen" data-sleepbaar="aansluitingen">
                    <thead>
                        <tr><th>Aansluiting</th><th>Rekening</th><th class="text-end">Grootboek</th><th class="text-end">Volgens bron</th><th class="text-end">Verschil</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in lijst)
                        {
                            <tr class="@(Doel(a) is null ? null : "klikbaar")" @onclick="() => Naar(a)">
                                <td>@a.Onderwerp</td>
                                <td class="text-secondary">@a.Rekening</td>
                                <td class="bedrag text-end">@Weergave.Bedrag(a.Grootboek)</td>
                                <td class="bedrag text-end">@(a.Bron is { } bron ? Weergave.Bedrag(bron) : null)</td>
                                <td class="bedrag text-end @(a.Sluit ? null : "let-op")">@(a.Verschil is { } v ? Weergave.Bedrag(v) : null)</td>
                                <td class="status">@(a.Sluit ? a.Toelichting : a.Toelichting is null ? "sluit niet" : $"sluit niet; {a.Toelichting}")</td>
                            </tr>
                            @foreach (var bv in a.Verschillen ?? [])
                            {
                                <tr class="bankverschil">
                                    <td class="ps-4 text-truncate" title="@bv.Omschrijving">
                                        <span class="text-secondary me-2">@Weergave.Datum(bv.Datum)</span>@bv.Omschrijving
                                    </td>
                                    <td class="text-secondary">
                                        @if (bv.Boekstuk is { } stuk && stuk.Split(' ', 2) is [var dagboek, var boekstuk])
                                        {
                                            <a href="/a/@Id/boeking/@dagboek/@boekstuk" title="Naar de boeking">@stuk</a>
                                        }
                                    </td>
                                    <td class="bedrag text-end">@(bv.Soort == Bankverschilsoort.ZonderMutatie ? Weergave.Bedrag(bv.Grootboek) : bv.Grootboek == 0 ? null : Weergave.Bedrag(bv.Grootboek))</td>
                                    <td class="bedrag text-end">@(bv.Soort == Bankverschilsoort.ZonderMutatie ? null : Weergave.Bedrag(bv.Bedrag))</td>
                                    <td></td>
                                    <td>
                                        <span class="status @(bv.Soort == Bankverschilsoort.ZonderMutatie ? null : "let-op")">@Uitleg(bv)</span>
                                        @if (mag && bv.Soort == Bankverschilsoort.NietInGrootboek && bv.Mutatie is { } mutatie)
                                        {
                                            <button class="btn btn-sm btn-link p-0 ms-2 regelactie" disabled="@bezig" title="De mutatie komt terug in Te verwerken om opnieuw te boeken" @onclick="() => Terug(mutatie)">opnieuw verwerken</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (bericht is not null)
            {
                <div class="bericht small mt-2">@bericht</div>
            }
            <Foutmeldingen Fouten="fouten" />
        }
    </ChildContent>
</AdministratieKader>

@code {
    private Geopend? geopend;
    private IReadOnlyList<Aansluiting>? lijst;
    private bool bezig;
    private bool mag;
    private string? bericht;
    private IReadOnlyList<string> fouten = [];

    private static string Uitleg(Bankverschil v) => v.Soort switch
    {
        Bankverschilsoort.NietInGrootboek => "geboekte mutatie staat niet op de bank",
        Bankverschilsoort.Afwijkend => "op de bank met een ander bedrag",
        _ => "boeking op de bank zonder mutatie",
    };

    private async Task Terug(Guid mutatie)
    {
        bezig = true;
        var uitkomst = await Bank.TerugNaarTeVerwerken(geopend!.Wie, Id, mutatie);
        fouten = uitkomst.Fouten;
        bericht = uitkomst.IsGelukt ? "De mutatie staat weer in Te verwerken bij de bank." : null;
        await Laad();
    }

    [Inject]
    private NavigationManager Navigatie { get; set; } = default!;

    [Parameter]
    public Guid Id { get; set; }

    private async Task Open(Geopend g)
    {
        geopend = g;
        mag = g.Kop.Mag(Recht.Invoeren);
        await Laad();
    }

    private async Task Laad()
    {
        bezig = true;
        lijst = await Aansluiting.Aansluitingen(geopend!.Wie, Id);
        bezig = false;
    }

    /// <summary>Waar een regel heen gaat: de bank, de openstaande crediteuren of de grootboekkaart.</summary>
    private string? Doel(Aansluiting a) => a.Soort switch
    {
        Aansluitingsoort.Bank => $"/a/{Id}/bank",
        Aansluitingsoort.Crediteuren => $"/a/{Id}/crediteuren",
        _ when a.Rekening is { } r && !r.Contains(',', StringComparison.Ordinal) => $"/a/{Id}/grootboek?rekening={Uri.EscapeDataString(r)}",
        _ => null,
    };

    private void Naar(Aansluiting a)
    {
        if (Doel(a) is { } doel)
        {
            Navigatie.NavigateTo(doel);
        }
    }
}
