@page "/a/{Id:guid}/grootboek"
@inject GrootboekDienst Grootboek
@inject NavigationManager Navigatie
@inject IJSRuntime JS
@inject OverzichtDienst Overzicht
@using Boekerhouden.Boekhouding.Grootboek

<AdministratieKader Id="Id" Titel="Grootboekkaart" Actief="/grootboek" BijOpenen="Open">
    <Kenmerken>
        @if (Alle && kaarten is not null)
        {
            <span>@Weergave.Datum(van) t/m @Weergave.Datum(tot)</span>
            <span class="scheiding">·</span>
            <span>@kaarten.Count @(kaarten.Count == 1 ? "rekening" : "rekeningen")</span>
        }
        else if (kaart is { } k)
        {
            <span>@Weergave.Datum(k.Van) t/m @Weergave.Datum(k.Tot)</span>
            <span class="scheiding">·</span>
            <span>begin @Weergave.Bedrag(k.Beginsaldo)</span>
            <span class="scheiding">·</span>
            <span>@k.Mutaties.Count @(k.Mutaties.Count == 1 ? "mutatie" : "mutaties")</span>
            <span class="scheiding">·</span>
            <span>eind <strong>@Weergave.Bedrag(k.Eindsaldo)</strong></span>
        }
    </Kenmerken>
    <Acties>
        <select class="form-select form-select-sm w-auto" aria-label="Rekening" value="@Rekening" @onchange="KiesRekening">
            <option value="@AlleWaarde">Alle rekeningen</option>
            @foreach (var r in rekeningen)
            {
                <option value="@r.Nummer">@r.Nummer @r.Naam</option>
            }
        </select>
        <PeriodeKeuze Van="van" Tot="tot" Gewijzigd="KiesPeriode" />
        <button class="btn btn-sm btn-outline-secondary" disabled="@bezig" title="De grootboekkaart als Excel" @onclick="Excel">Excel</button>
        <button class="btn btn-sm btn-outline-secondary" disabled="@bezig" title="De grootboekkaart als PDF (A4 liggend)" @onclick="Pdf">PDF</button>
    </Acties>
    <ChildContent>
        @if (Alle && kaarten is not null)
        {
            <div class="d-flex align-items-center gap-2 mb-2">
                <a class="btn btn-sm btn-link text-secondary px-0" href="/a/@Id/kolommenbalans?@Weergave.Periodequery(van, tot)" title="Naar de kolommenbalans" aria-label="Naar de kolommenbalans"><Icoon Naam="arrow-left" /></a>
                <input class="form-control form-control-sm ms-auto kaartzoeken" placeholder="Zoeken op omschrijving, bedrag, relatie of factuurnummer" aria-label="Zoeken"
                       @bind="zoek" @bind:event="oninput" />
            </div>
            <Foutmeldingen Fouten="fouten" />
            @if (kaarten.Count == 0)
            {
                <LegeStaat Icoon="file-text" Tekst="Geen boekingen in deze periode" />
            }
            @foreach (var k in kaarten.Where(k => string.IsNullOrWhiteSpace(zoek) || k.Mutaties.Any(Past)))
            {
                var mutaties = k.Mutaties.Where(Past).ToList();
                <div class="alle-kaart mb-3">
                    <div class="d-flex align-items-baseline gap-2 mb-1">
                        <a class="rekeningnummer" href="/a/@Id/grootboek?rekening=@Uri.EscapeDataString(k.Rekening.Nummer)&@Weergave.Periodequery(van, tot)" title="Alleen deze kaart">@k.Rekening.Nummer</a>
                        <span class="fw-semibold">@k.Rekening.Naam</span>
                        <span class="small text-secondary ms-auto">eind @Weergave.Bedrag(k.Eindsaldo)</span>
                    </div>
                    <div class="card overzichtskaart">
                        <table class="table align-middle mb-0 overzichtstabel grootboekkaart">
                            <thead>
                                <tr><th style="width:7rem">Datum</th><th style="width:4.5rem">Dagboek</th><th style="width:7rem">Boekstuk</th><th>Omschrijving</th><th style="width:4rem">Btw</th><th class="text-end" style="width:7rem">Btw-bedrag</th><th style="width:8rem">Factuur</th><th class="text-end" style="width:8rem">Debet</th><th class="text-end" style="width:8rem">Credit</th><th class="text-end" style="width:8rem">Saldo</th></tr>
                            </thead>
                            <tbody>
                                <tr class="text-secondary"><td>@Weergave.Datum(k.Van)</td><td colspan="6">Beginsaldo</td><td></td><td></td><td class="bedrag text-end">@Weergave.Bedrag(k.Beginsaldo)</td></tr>
                                @foreach (var m in mutaties)
                                {
                                    <tr class="klikbaar" @onclick="() => NaarBoeking(m.Dagboek, m.Boekstuk)">
                                        <td class="text-nowrap">@Weergave.Datum(m.Datum)</td>
                                        <td>@m.Dagboek</td>
                                        <td class="text-nowrap">@m.Boekstuk</td>
                                        <td class="text-truncate" title="@m.Omschrijving">@m.Omschrijving</td>
                                        <td class="text-secondary">@m.BtwCode</td>
                                        <td class="bedrag text-end">@(m.Btw is { } btw ? Weergave.Bedrag(btw) : null)</td>
                                        <td class="text-secondary text-truncate" title="@m.Relatie">@m.Factuurnummer</td>
                                        <td class="bedrag text-end">@(m.Bedrag > 0 ? Weergave.Bedrag(m.Bedrag) : null)</td>
                                        <td class="bedrag text-end">@(m.Bedrag < 0 ? Weergave.Bedrag(-m.Bedrag) : null)</td>
                                        <td class="bedrag text-end">@Weergave.Bedrag(m.Saldo)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="generaal">
                                    <td colspan="7">Totaal en eindsaldo</td>
                                    <td class="bedrag text-end">@Weergave.Bedrag(k.TotaalDebet)</td>
                                    <td class="bedrag text-end">@Weergave.Bedrag(k.TotaalCredit)</td>
                                    <td class="bedrag text-end">@Weergave.Bedrag(k.Eindsaldo)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }
        }
        else if (kaart is not null)
        {
            <div class="d-flex align-items-center gap-2 mb-2">
                <a class="btn btn-sm btn-link text-secondary px-0" href="/a/@Id/kolommenbalans?@Weergave.Periodequery(van, tot)" title="Naar de kolommenbalans" aria-label="Naar de kolommenbalans"><Icoon Naam="arrow-left" /></a>
                <span class="rekeningnummer">@kaart.Rekening.Nummer</span>
                <span class="fw-semibold">@kaart.Rekening.Naam</span>
                <span class="btn-group btn-group-sm ms-2 bladeren">
                    <button class="btn btn-outline-secondary" title="Vorige rekening@(Buur(-1) is { } v ? $": {v.Nummer} {v.Naam}" : null)" aria-label="Vorige rekening" disabled="@(Buur(-1) is null)" @onclick="() => Blader(-1)"><Icoon Naam="chevron-left" /></button>
                    <button class="btn btn-outline-secondary" title="Volgende rekening@(Buur(1) is { } n ? $": {n.Nummer} {n.Naam}" : null)" aria-label="Volgende rekening" disabled="@(Buur(1) is null)" @onclick="() => Blader(1)"><Icoon Naam="chevron-right" /></button>
                </span>
                <input class="form-control form-control-sm ms-auto kaartzoeken" placeholder="Zoeken op omschrijving, bedrag, relatie of factuurnummer" aria-label="Zoeken"
                       @bind="zoek" @bind:event="oninput" />
            </div>
            <Foutmeldingen Fouten="fouten" />
            @if (gekozen.Count > 0)
            {
                <div class="d-flex align-items-center gap-2 mb-2 small herboeken">
                    <span>@gekozen.Count @(gekozen.Count == 1 ? "regel" : "regels") (<Euro Waarde="Gekozen.Sum(m => m.Bedrag)" />) herboeken naar</span>
                    <div class="herboeken-rekening"><RekeningKeuze Id="herboek-rekening" @bind-Waarde="naarRekening" Schema="schema" Kader="geopend" /></div>
                    <button class="btn btn-sm btn-primary" disabled="@(bezig || string.IsNullOrWhiteSpace(naarRekening))" aria-busy="@(bezig ? "true" : null)" @onclick="Herboek">Herboeken</button>
                    <button class="btn btn-sm btn-link text-secondary" @onclick="() => gekozen.Clear()">Annuleren</button>
                </div>
            }
            <div class="card overzichtskaart">
                <table class="table align-middle mb-0 overzichtstabel grootboekkaart" data-sleepbaar="grootboekkaart">
                    <thead>
                        <tr>
                            @if (MagHerboeken)
                            {
                                <th class="kiezen"><input class="form-check-input" type="checkbox" aria-label="Alle regels kiezen" checked="@AllesGekozen" @onchange="WisselAlles" /></th>
                            }
                            <SorteerKop Sortering="sortering" Naam="Datum" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Dagboek" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Boekstuk" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Omschrijving" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Btw" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Btw-bedrag" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Factuur" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Debet" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Credit" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            <th class="text-end">Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="text-secondary">
                            @if (MagHerboeken)
                            {
                                <td></td>
                            }
                            <td>@Weergave.Datum(kaart.Van)</td><td colspan="6">Beginsaldo</td><td></td><td></td>
                            <td class="bedrag text-end">@Weergave.Bedrag(kaart.Beginsaldo)</td>
                        </tr>
                        @foreach (var m in Zichtbaar)
                        {
                            <tr class="klikbaar @(gekozen.Contains(m) ? "table-active" : null)" @onclick="() => NaarBoeking(m.Dagboek, m.Boekstuk)">
                                @if (MagHerboeken)
                                {
                                    <td class="kiezen" @onclick:stopPropagation><input class="form-check-input" type="checkbox" aria-label="Kiezen" checked="@gekozen.Contains(m)" @onchange="() => Wissel(m)" /></td>
                                }
                                <td class="text-nowrap">@Weergave.Datum(m.Datum)</td>
                                <td>@m.Dagboek</td>
                                <td class="text-nowrap">@m.Boekstuk</td>
                                <td class="text-truncate" title="@m.Omschrijving">@m.Omschrijving</td>
                                <td class="text-secondary">@m.BtwCode</td>
                                <td class="bedrag text-end">@(m.Btw is { } btw ? Weergave.Bedrag(btw) : null)</td>
                                <td class="text-secondary text-truncate" title="@m.Relatie">@m.Factuurnummer</td>
                                <td class="bedrag text-end">@(m.Bedrag > 0 ? Weergave.Bedrag(m.Bedrag) : null)</td>
                                <td class="bedrag text-end">@(m.Bedrag < 0 ? Weergave.Bedrag(-m.Bedrag) : null)</td>
                                <td class="bedrag text-end">@Weergave.Bedrag(m.Saldo)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        @if (!string.IsNullOrWhiteSpace(zoek))
                        {
                            <tr class="text-secondary">
                                <td colspan="@(MagHerboeken ? 8 : 7)">Gevonden: @Zichtbaar.Count() @(Zichtbaar.Count() == 1 ? "regel" : "regels")</td>
                                <td class="bedrag text-end">@Weergave.Bedrag(Zichtbaar.Where(m => m.Bedrag > 0).Sum(m => m.Bedrag))</td>
                                <td class="bedrag text-end">@Weergave.Bedrag(-Zichtbaar.Where(m => m.Bedrag < 0).Sum(m => m.Bedrag))</td>
                                <td></td>
                            </tr>
                        }
                        <tr class="generaal">
                            <td colspan="@(MagHerboeken ? 8 : 7)">Totaal en eindsaldo</td>
                            <td class="bedrag text-end">@Weergave.Bedrag(kaart.TotaalDebet)</td>
                            <td class="bedrag text-end">@Weergave.Bedrag(kaart.TotaalCredit)</td>
                            <td class="bedrag text-end">@Weergave.Bedrag(kaart.Eindsaldo)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </ChildContent>
</AdministratieKader>

@code {
    private Geopend? geopend;
    private DateOnly van;
    private DateOnly tot;
    private IReadOnlyList<Boekhouding.Grootboek.Rekening> rekeningen = [];
    private Boekhouding.Grootboek.Grootboekkaart? kaart;
    private IReadOnlyList<Boekhouding.Grootboek.Grootboekkaart>? kaarten;

    /// <summary>De keuze "Alle rekeningen": alle kaarten met een saldo of mutaties onder elkaar.</summary>
    private const string AlleWaarde = "alle";

    private bool Alle => Rekening == AlleWaarde;
    private IReadOnlyList<Boekhouding.Grootboek.Rekening> metMutaties = [];
    private Rekeningschema? schema;
    private string? zoek;
    private readonly HashSet<Kaartregel> gekozen = [];
    private string? naarRekening;
    private bool bezig;
    private IReadOnlyList<string>? fouten;

    private readonly Sortering<Kaartregel> sortering = new(
        new("Datum", m => m.Datum, EerstOplopend: true),
        new("Dagboek", m => m.Dagboek),
        new("Boekstuk", m => m.Boekstuk),
        new("Omschrijving", m => m.Omschrijving.ToUpperInvariant()),
        new("Btw", m => m.BtwCode),
        new("Btw-bedrag", m => m.Btw, EerstOplopend: false),
        new("Factuur", m => m.Factuurnummer?.ToUpperInvariant()),
        new("Debet", m => m.Bedrag > 0 ? m.Bedrag : null, EerstOplopend: false),
        new("Credit", m => m.Bedrag < 0 ? -m.Bedrag : null, EerstOplopend: false));

    /// <summary>Herboeken mag met het recht Boekhouden, en niet vanaf bank, debiteuren, crediteuren of btw.</summary>
    private bool MagHerboeken =>
        geopend?.Kop.Mag(Recht.Boekhouden) == true
        && kaart?.Rekening.Functie is not (Rekeningfunctie.Bank or Rekeningfunctie.Debiteuren or Rekeningfunctie.Crediteuren or Rekeningfunctie.Voorbelasting or Rekeningfunctie.AfTeDragenBtw);

    /// <summary>De mutaties die bij de zoektekst passen, in de gekozen volgorde.</summary>
    private IEnumerable<Kaartregel> Zichtbaar => sortering.Pas((kaart?.Mutaties ?? []).Where(Past));

    private IEnumerable<Kaartregel> Gekozen => (kaart?.Mutaties ?? []).Where(gekozen.Contains);

    private bool AllesGekozen => Zichtbaar.Any() && Zichtbaar.All(gekozen.Contains);

    /// <summary>Zoeken op omschrijving, relatie, factuurnummer, boekstuk of bedrag (debet, credit of btw, ook zonder minteken).</summary>
    private bool Past(Kaartregel m)
    {
        if (string.IsNullOrWhiteSpace(zoek))
        {
            return true;
        }

        var tekst = zoek.Trim();
        if (BedragParser.TryParse(tekst, out var bedrag) && (Math.Abs(m.Bedrag) == Math.Abs(bedrag) || (m.Btw is { } btw && Math.Abs(btw) == Math.Abs(bedrag))))
        {
            return true;
        }

        return m.Omschrijving.Contains(tekst, StringComparison.CurrentCultureIgnoreCase)
               || m.Relatie?.Contains(tekst, StringComparison.CurrentCultureIgnoreCase) == true
               || m.Factuurnummer?.Contains(tekst, StringComparison.OrdinalIgnoreCase) == true
               || m.Boekstuk.Contains(tekst, StringComparison.OrdinalIgnoreCase);
    }

    private void Wissel(Kaartregel regel)
    {
        if (!gekozen.Remove(regel))
        {
            gekozen.Add(regel);
        }
    }

    private void WisselAlles()
    {
        if (AllesGekozen)
        {
            gekozen.Clear();
        }
        else
        {
            gekozen.UnionWith(Zichtbaar);
        }
    }

    private async Task Herboek()
    {
        bezig = true;
        var uitkomst = await Grootboek.Herboek(geopend!.Wie, Id, [.. gekozen.Select(m => new Herboekregel(m.Dagboek, m.Boekstuk, m.Regel))], naarRekening ?? "");
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            gekozen.Clear();
            naarRekening = null;
            await Laad();
        }

        bezig = false;
    }

    private async Task Excel()
    {
        bezig = true;
        await JS.Bewaar(Alle ? await Overzicht.KaartenExcel(geopend!.Wie, Id, van, tot) : await Overzicht.KaartExcel(geopend!.Wie, Id, Rekening!, van, tot),
            $"{(Alle ? "Grootboekkaarten" : $"Grootboekkaart {Rekening}")} {van:yyyy-MM-dd} {tot:yyyy-MM-dd}.xlsx", Download.Excel);
        bezig = false;
    }

    private async Task Pdf()
    {
        bezig = true;
        var uitkomst = Alle ? await Overzicht.KaartenPdf(geopend!.Wie, Id, van, tot) : await Overzicht.KaartPdf(geopend!.Wie, Id, Rekening!, van, tot);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            await JS.Bewaar(uitkomst.Waarde!, $"{(Alle ? "Grootboekkaarten" : $"Grootboekkaart {Rekening}")} {van:yyyy-MM-dd} {tot:yyyy-MM-dd}.pdf", Download.Pdf);
        }

        bezig = false;
    }

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "rekening")]
    public string? Rekening { get; set; }

    [SupplyParameterFromQuery(Name = "jaar")]
    public int? Jaar { get; set; }

    [SupplyParameterFromQuery(Name = "van")]
    public string? VanTekst { get; set; }

    [SupplyParameterFromQuery(Name = "tot")]
    public string? TotTekst { get; set; }

    private async Task Open(Geopend g)
    {
        geopend = g;
        var jaren = await Grootboek.Boekjaren(g.Wie, Id);
        schema = await Grootboek.Schema(g.Wie, Id);
        rekeningen = [.. schema.Alle];
        (van, tot) = Weergave.Periode(VanTekst, TotTekst) ?? Boekhouding.Grootboek.Periode.Jaar(Jaar is { } j && jaren.Contains(j) ? j : jaren[0]);
        Rekening = Rekening == AlleWaarde || rekeningen.Any(r => r.Nummer == Rekening) ? Rekening : rekeningen.FirstOrDefault(r => r.Functie == Rekeningfunctie.Bank)?.Nummer ?? rekeningen.FirstOrDefault()?.Nummer;
        await Laad();
    }

    private async Task Laad()
    {
        kaarten = Alle ? await Grootboek.Kaarten(geopend!.Wie, Id, van, tot) : null;
        kaart = Rekening is null || Alle ? null : await Grootboek.Kaart(geopend!.Wie, Id, Rekening, van, tot);
        gekozen.Clear();
        // Bladeren gaat langs de rekeningen met een saldo of mutaties in de periode, zoals in de kolommenbalans.
        metMutaties = [.. (await Grootboek.Kolommenbalans(geopend!.Wie, Id, van, tot)).Regels.Where(r => r.Debet != 0 || r.Credit != 0).Select(r => r.Rekening)];
    }

    /// <summary>De vorige of volgende rekening met mutaties (in de volgorde van het rekeningschema).</summary>
    private Boekhouding.Grootboek.Rekening? Buur(int stap)
    {
        var lijst = metMutaties.Count > 0 ? metMutaties : rekeningen;
        var plek = rekeningen.ToList().FindIndex(r => r.Nummer == Rekening);
        var volgorde = lijst.Select(r => (Rekening: r, Plek: rekeningen.ToList().FindIndex(x => x.Nummer == r.Nummer))).ToList();
        return stap > 0
            ? volgorde.Where(x => x.Plek > plek).OrderBy(x => x.Plek).Select(x => x.Rekening).FirstOrDefault()
            : volgorde.Where(x => x.Plek < plek && x.Plek >= 0).OrderByDescending(x => x.Plek).Select(x => x.Rekening).FirstOrDefault();
    }

    private async Task Blader(int stap)
    {
        if (Buur(stap) is { } rekening)
        {
            Rekening = rekening.Nummer;
            Adres();
            await Laad();
        }
    }

    private void Adres() =>
        Navigatie.NavigateTo($"/a/{Id}/grootboek?rekening={Uri.EscapeDataString(Rekening ?? "")}&{Weergave.Periodequery(van, tot)}", replace: true);

    private async Task KiesRekening(ChangeEventArgs e)
    {
        Rekening = e.Value?.ToString();
        Adres();
        await Laad();
    }

    private async Task KiesPeriode((DateOnly Van, DateOnly Tot) periode)
    {
        (van, tot) = periode;
        Adres();
        await Laad();
    }

    /// <summary>Inzoomen op de boeking (en van daar naar de factuur).</summary>
    private void NaarBoeking(string dagboek, string boekstuk) =>
        Navigatie.NavigateTo($"/a/{Id}/boeking/{Uri.EscapeDataString(dagboek)}/{Uri.EscapeDataString(boekstuk)}");
}
