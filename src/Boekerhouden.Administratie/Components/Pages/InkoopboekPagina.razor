@page "/a/{Id:guid}/inkoopboek"
@inject InkoopDienst Inkoop
@inject NavigationManager Navigatie

<AdministratieKader Id="Id" Titel="Inkoop" Actief="/inkoopboek" BijOpenen="Open">
    <Acties>
        <span class="form-check form-switch mb-0 small text-nowrap">
            <input class="form-check-input" type="checkbox" id="alle-jaren" checked="@alleJaren" @onchange="WisselAlleJaren" />
            <label class="form-check-label text-secondary" for="alle-jaren">alle jaren</label>
        </span>
        @if (!alleJaren)
        {
            <PeriodeKeuze Van="van" Tot="tot" Gewijzigd="KiesPeriode" />
        }
    </Acties>
    <ChildContent>
        <div class="zoekbalk d-flex align-items-center flex-wrap gap-2 mb-3">
            <input class="form-control form-control-sm zoek-tekst" type="search" placeholder="Zoek op leverancier, factuurnummer, boekstuk of omschrijving" aria-label="Zoeken" @bind="tekst" @bind:event="oninput" />
            <select class="form-select form-select-sm w-auto" aria-label="Leverancier" @bind="relatie">
                <option value="">Alle leveranciers</option>
                @foreach (var l in Leveranciers)
                {
                    <option value="@l.Relatie">@l.Naam</option>
                }
            </select>
            <span class="text-secondary small ms-2">Bedrag</span>
            <input class="form-control form-control-sm text-end zoek-bedrag" placeholder="van" aria-label="Bedrag van" @bind="bedragVan" @bind:event="oninput" />
            <span class="text-secondary small">–</span>
            <input class="form-control form-control-sm text-end zoek-bedrag" placeholder="tot" aria-label="Bedrag tot" @bind="bedragTot" @bind:event="oninput" />
            <span class="form-check form-switch mb-0 small ms-2">
                <input class="form-check-input" type="checkbox" id="alleen-open" @bind="alleenOpen" />
                <label class="form-check-label text-secondary" for="alleen-open">alleen open</label>
            </span>
            @if (Filter != new Inkoopboekfilter())
            {
                <button class="btn btn-sm btn-link text-secondary" @onclick="WisFilter">wissen</button>
            }
        </div>
        @if (regels is { Count: 0 })
        {
            <div class="card card-body text-center text-secondary py-4">Geen inkoopfacturen @(alleJaren ? null : "in deze periode").</div>
        }
        else if (regels is not null)
        {
            var zichtbaar = Gesorteerd(Gefilterd).ToList();
            <div class="card overzichtskaart">
                <table class="table align-middle mb-0 overzichtstabel inkoopboek" data-sleepbaar="inkoopboek">
                    <thead>
                        <tr>
                            @foreach (var k in Kolommen)
                            {
                                <th class="sorteerbaar @(k.Bedrag ? "text-end" : null)" aria-sort="@(sortering == k.Naam ? (oplopend ? "ascending" : "descending") : null)" title="Sorteren" @onclick="() => Sorteer(k)">
                                    @k.Naam<span class="sorteerpijl" aria-hidden="true">@(sortering == k.Naam ? (oplopend ? "▲" : "▼") : null)</span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in zichtbaar)
                        {
                            <tr class="klikbaar" title="@(r.Document is null ? "Naar de boeking" : "Naar de factuur")" @onclick="() => Open(r)">
                                <td class="text-nowrap">@Weergave.Datum(r.Datum)</td>
                                <td class="text-nowrap text-secondary">@r.Dagboek @r.Boekstuk</td>
                                <td title="@r.Relatie">@r.Leverancier</td>
                                <td>@r.Factuurnummer</td>
                                <td class="omschrijving" title="@r.Omschrijving">@r.Omschrijving</td>
                                <td class="bedrag text-end">@Bedragen.Getal(r.Exclusief)</td>
                                <td class="bedrag text-end">@Bedragen.Getal(r.Btw)</td>
                                <td class="bedrag text-end">@Bedragen.Getal(r.Totaal)</td>
                                <td class="bedrag text-end text-secondary">@(r.Openstaand == 0 ? null : Bedragen.Getal(r.Openstaand))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="generaal">
                            <td colspan="5">Totaal (@zichtbaar.Count @(zichtbaar.Count == 1 ? "factuur" : "facturen"))</td>
                            <td class="bedrag text-end">@Bedragen.Getal(zichtbaar.Sum(r => r.Exclusief))</td>
                            <td class="bedrag text-end">@Bedragen.Getal(zichtbaar.Sum(r => r.Btw))</td>
                            <td class="bedrag text-end">@Bedragen.Getal(zichtbaar.Sum(r => r.Totaal))</td>
                            <td class="bedrag text-end">@Bedragen.Getal(zichtbaar.Sum(r => r.Openstaand))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </ChildContent>
</AdministratieKader>

@code {
    private Geopend? geopend;
    private DateOnly van;
    private DateOnly tot;
    private string tekst = "";
    private string relatie = "";
    private string bedragVan = "";
    private string bedragTot = "";
    private bool alleenOpen;
    private bool alleJaren;
    private IReadOnlyList<Inkoopboekregel>? regels;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "van")]
    public string? VanTekst { get; set; }

    [SupplyParameterFromQuery(Name = "tot")]
    public string? TotTekst { get; set; }

    private Inkoopboekfilter Filter => new(
        string.IsNullOrWhiteSpace(tekst) ? null : tekst.Trim(),
        relatie.Length == 0 ? null : relatie,
        Getal(bedragVan),
        Getal(bedragTot),
        alleenOpen);

    private IEnumerable<Inkoopboekregel> Gefilterd => (regels ?? []).Where(Filter.Past);

    /// <summary>Een kolom om op te sorteren: tekst eerst A–Z, bedragen en datums eerst hoog–laag (nieuwste eerst).</summary>
    private sealed record Kolom(string Naam, Func<Inkoopboekregel, IComparable> Waarde, bool Bedrag = false, bool EerstOplopend = false);

    private static readonly Kolom[] Kolommen =
    [
        new("Datum", r => r.Datum),
        new("Boekstuk", r => r.Boekstuk, EerstOplopend: true),
        new("Leverancier", r => r.Leverancier.ToUpperInvariant(), EerstOplopend: true),
        new("Factuur", r => r.Factuurnummer.ToUpperInvariant(), EerstOplopend: true),
        new("Omschrijving", r => r.Omschrijving.ToUpperInvariant(), EerstOplopend: true),
        new("Excl. btw", r => r.Exclusief, Bedrag: true),
        new("Btw", r => r.Btw, Bedrag: true),
        new("Totaal", r => r.Totaal, Bedrag: true),
        new("Open", r => r.Openstaand, Bedrag: true),
    ];

    private string sortering = "Datum";
    private bool oplopend = true;

    private void Sorteer(Kolom kolom) =>
        (sortering, oplopend) = sortering == kolom.Naam ? (sortering, !oplopend) : (kolom.Naam, kolom.EerstOplopend);

    private IEnumerable<Inkoopboekregel> Gesorteerd(IEnumerable<Inkoopboekregel> lijst)
    {
        var kolom = Kolommen.First(k => k.Naam == sortering);
        var volgorde = oplopend ? lijst.OrderBy(kolom.Waarde) : lijst.OrderByDescending(kolom.Waarde);
        return volgorde.ThenBy(r => r.Datum).ThenBy(r => r.Boekstuk, StringComparer.Ordinal);
    }

    /// <summary>De leveranciers in de gekozen periode, op naam.</summary>
    private IEnumerable<(string Relatie, string Naam)> Leveranciers =>
        (regels ?? []).GroupBy(r => r.Relatie).Select(g => (g.Key, g.First().Leverancier)).OrderBy(l => l.Item2, StringComparer.CurrentCultureIgnoreCase);

    private static decimal? Getal(string tekst) =>
        string.IsNullOrWhiteSpace(tekst) ? null : BedragParser.TryParse(tekst, out var b) ? Math.Abs(b) : null;

    private void WisFilter() => (tekst, relatie, bedragVan, bedragTot, alleenOpen) = ("", "", "", "", false);

    private async Task WisselAlleJaren(ChangeEventArgs e)
    {
        alleJaren = e.Value is true;
        await Laad();
    }

    private async Task Open(Geopend g)
    {
        geopend = g;
        // Standaard het jaar van de laatste factuur (niet van de laatste boeking: een verdeling loopt soms door in een later jaar).
        (van, tot) = Weergave.Periode(VanTekst, TotTekst) ?? Boekhouding.Grootboek.Periode.Jaar(await Inkoop.LaatsteFactuurjaar(g.Wie, Id) ?? DateTime.Today.Year);
        await Laad();
    }

    private async Task Laad() => regels = alleJaren
        ? await Inkoop.Inkoopboek(geopend!.Wie, Id, DateOnly.MinValue, DateOnly.MaxValue)
        : await Inkoop.Inkoopboek(geopend!.Wie, Id, van, tot);

    private async Task KiesPeriode((DateOnly Van, DateOnly Tot) periode)
    {
        (van, tot) = periode;
        Navigatie.NavigateTo($"/a/{Id}/inkoopboek?{Weergave.Periodequery(van, tot)}", replace: true);
        await Laad();
    }

    /// <summary>Inzoomen: de factuur (met de boeking), of de boeking als er geen document bij hoort.</summary>
    private void Open(Inkoopboekregel r) =>
        Navigatie.NavigateTo(r.Document is { } document ? $"/a/{Id}/inkoop/{document}" : $"/a/{Id}/boeking/{r.Dagboek}/{r.Boekstuk}");
}
