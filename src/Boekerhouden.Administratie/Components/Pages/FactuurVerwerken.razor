@page "/a/{Id:guid}/inkoop/{DocumentId:guid}"
@using Boekerhouden.Boekhouding.Btw
@using Boekerhouden.Boekhouding.Facturen
@using Boekerhouden.Boekhouding.Herkenning
@implements IAsyncDisposable
@inject InkoopDienst Inkoop
@inject NavigationManager Navigatie
@inject IJSRuntime JS
@inject IServiceProvider Diensten

<AdministratieKader Id="Id" Titel="Factuur verwerken" Actief="/inkoop" BijOpenen="Open">
    <Acties>
        @if (werkvoorraad is { Count: > 0 } && Positie is { } positie)
        {
            <span class="bladeren">
                <button class="btn btn-sm btn-link text-secondary px-1" title="Vorige factuur (Alt+↑)" disabled="@(positie == 0)" @onclick="() => Ga(-1)">‹</button>
                <span class="small text-secondary">@(positie + 1) van @werkvoorraad.Count</span>
                <button class="btn btn-sm btn-link text-secondary px-1" title="Volgende factuur (Alt+↓)" disabled="@(positie == werkvoorraad.Count - 1)" @onclick="() => Ga(1)">›</button>
            </span>
        }
        @if (verwerking is { Document.Status: Documentstatus.TeVerwerken } info)
        {
            var signalen = (info.Voorstel?.Belemmeringen.Count ?? 0) + (info.Voorstel is null && info.Document.Melding is not null ? 1 : 0);
            <details class="uitklapmenu weergavemenu infomenu">
                <summary class="btn btn-sm btn-outline-secondary" title="Herkenning en voorstel">Info@(signalen > 0 ? $" ({signalen})" : null)</summary>
                <div class="menu">
                    @if (info.Voorstel is { } v)
                    {
                        <div class="small">@v.Advies.Reden</div>
                        @if (info.UitZoektemplate is { Count: > 0 } uitTemplate)
                        {
                            <div class="small text-secondary mt-1">Van de aangewezen plek: @string.Join(", ", uitTemplate.Select(Veldnaam))</div>
                        }
                        @foreach (var b in v.Belemmeringen)
                        {
                            <div class="status let-op mt-1">@b</div>
                        }
                    }
                    else if (info.Document.Melding is { } melding)
                    {
                        <div class="status let-op">@melding</div>
                    }
                    <div class="small text-secondary mt-2" title="@info.Document.Bestandsnaam">@info.Document.Bestandsnaam · ingelezen @Weergave.DatumTijd(info.Document.IngelezenOp) door @info.Document.IngelezenDoor</div>
                </div>
            </details>
        }
        <details class="uitklapmenu weergavemenu">
            <summary class="btn btn-sm btn-outline-secondary">Weergave</summary>
            <div class="menu">
                @foreach (var (sleutel, naam) in Weergaveopties)
                {
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@weergave.Contains(sleutel)" @onchange="e => ZetWeergave(sleutel, e.Value is true)" />
                        <span class="form-check-label">@naam</span>
                    </label>
                }
            </div>
        </details>
        @if (geopend is not null)
        {
            <DocumentOpenen Wie="geopend.Wie" Administratie="Id" Document="DocumentId" Tekst="Origineel" Klasse="btn btn-sm btn-outline-secondary" />
        }
    </Acties>
    <ChildContent>
        @if (verwerking is null)
        {
            <div class="alert alert-warning">Dit document bestaat niet (meer). <a href="/a/@Id/inkoop">Naar inkoop</a></div>
        }
        else if (verwerking.Document.Status != Documentstatus.TeVerwerken)
        {
            <div class="verwerken">
                <div class="verwerken-formulier">
                    <Foutmeldingen Fouten="fouten" />
                    <div class="bericht d-flex align-items-center gap-3 mb-3">
                        <span>
                            @(verwerking.Document.Status switch
                            {
                                Documentstatus.Geboekt => verwerking.Document.Soort == Documentsoort.Creditnota ? "Deze creditnota is geboekt." : "Deze factuur is geboekt.",
                                Documentstatus.Gearchiveerd => verwerking.Document.Soort == Documentsoort.Prive ? "Dit document is privé en niet geboekt." : "Dit document is bewaard zonder boeking.",
                                _ => "Dit document staat in quarantaine.",
                            })
                            @if (verwerking.Document.Status == Documentstatus.Gearchiveerd && verwerking.Document.Melding is { } notitie)
                            {
                                <span class="text-secondary">@notitie</span>
                            }
                        </span>
                        @if (context.Mag(Recht.Invoeren) && verwerking.Document.Status == Documentstatus.Geboekt)
                        {
                            @if (bevestigHeropenen)
                            {
                                <button class="btn btn-sm btn-primary ms-auto" @onclick="Heropenen" disabled="@bezig">Ja, heropenen</button>
                                <button class="btn btn-sm btn-link text-secondary" @onclick="() => bevestigHeropenen = false">annuleren</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-primary ms-auto" title="De boeking wordt teruggedraaid (tegenboeking) en de factuur staat weer open om aan te passen" @onclick="() => bevestigHeropenen = true">Heropenen</button>
                            }
                        }
                        @if (context.Mag(Recht.Invoeren) && verwerking.Document.Status == Documentstatus.Gearchiveerd)
                        {
                            <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="Terugzetten">Terug naar Te verwerken</button>
                        }
                    </div>
                    @if (geboekteFactuur is { } g)
                    {
                        <div class="card mb-3 boekformulier geboekt">
                            <div class="card-body">
                                <div class="veld"><span class="veldnaam">Factuurnummer</span><span>@g.Factuurnummer</span></div>
                                <div class="veld"><span class="veldnaam">Leverancier</span><span>@(verwerking.Relaties.FirstOrDefault(r => r.Code == g.Relatie)?.Naam ?? g.Relatie)</span></div>
                                <div class="veld"><span class="veldnaam">Factuurdatum</span><span>@Weergave.Datum(g.Datum) <span class="text-secondary ms-3">vervalt @Weergave.Datum(g.Vervaldatum)</span></span></div>
                                <div class="veld"><span class="veldnaam">Omschrijving</span><span>@g.Omschrijving</span></div>
                                <div class="veld"><span class="veldnaam">Bedrag</span><span class="bedrag">@Bedragen.Getal(g.Totaal)@(g.Creditnota ? " (creditnota)" : null)</span></div>
                                <div class="veld"><span class="veldnaam">Boekstuk</span><span>@g.Dagboek @g.Boekstuk</span></div>
                                <table class="table table-sm align-middle regeltabel mt-3 mb-0">
                                    <thead>
                                        <tr><th>Omschrijving</th><th>Grootboekrekening</th><th>Btw</th><th class="text-end">Excl. btw</th><th class="text-end">Btw-bedrag</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in g.Regels)
                                        {
                                            <tr>
                                                <td>@(r.Omschrijving.Length > 0 ? r.Omschrijving : g.Omschrijving)</td>
                                                <td><span class="rekeningnummer">@r.Rekeningnummer</span> @verwerking.Schema.Zoek(r.Rekeningnummer)?.Naam</td>
                                                <td title="@r.BtwCode">@(BtwCodes.Zoek(verwerking.Btwtabel.Op(g.Datum), r.BtwCode)?.Kort ?? r.BtwCode)</td>
                                                <td class="bedrag text-end">@Bedragen.Getal(r.Bedrag)</td>
                                                <td class="bedrag text-end">@(r.Btw is { } b ? Bedragen.Getal(b) : null)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    <a class="small" href="/a/@Id/inkoop">Naar inkoop</a>
                </div>
                @if (verwerking.Document.Status == Documentstatus.Geboekt)
                {
                    <div @ref="scheiding" class="verwerken-scheiding @(ViewerZichtbaar ? null : "d-none")"></div>
                    <div @ref="viewerPaneel" class="verwerken-viewer @(ViewerZichtbaar ? null : "d-none")">
                        <div @ref="viewer" class="factuurviewer"></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="verwerken">
                @if (Toon("werkvoorraad") && werkvoorraad is { Count: > 1 })
                {
                    <nav class="werkvoorraad" aria-label="Te verwerken">
                        @foreach (var d in werkvoorraad)
                        {
                            <a class="werkvoorraad-item @(d.Id == DocumentId ? "actief" : null)" href="/a/@Id/inkoop/@d.Id" title="@($"{d.Factuurnummer} {d.Melding}".Trim())">
                                <span class="werkvoorraad-naam">@(d.Leverancier ?? d.Bestandsnaam)</span>
                                <span class="bedrag"><Euro Waarde="d.Totaal" /></span>
                            </a>
                        }
                    </nav>
                }
                <div class="verwerken-formulier">
                    @if (vorigeGeboekt is not null)
                    {
                        <div class="bericht small mb-2">@vorigeGeboekt</div>
                    }
                    <Foutmeldingen Fouten="fouten" />
                    <div class="card mb-3 boekformulier">
                        <div class="card-body">
                            <div class="veld">
                                <label for="nummer">Factuurnummer</label>
                                <input id="nummer" class="form-control @Doel("nummer") @Onzeker("nummer")" title="@Waarom("nummer")" @bind="factuurnummer" @bind:event="oninput" @bind:after='() => onzeker.Remove("nummer")' @onfocus='() => Kies("nummer", "Factuurnummer")' />
                            </div>
                            <div class="veld">
                                <label for="leverancier">Leverancier</label>
                                <select id="leverancier" class="form-select" @bind="leverancier" @bind:after="LaadHistorie">
                                    <option value="@Nieuw">Nieuwe leverancier…</option>
                                    @foreach (var r in verwerking.Relaties)
                                    {
                                        <option value="@r.Code">@r.Naam</option>
                                    }
                                </select>
                            </div>
                            @if (leverancier == Nieuw)
                            {
                                <div class="veld">
                                    <label for="naam">Naam</label>
                                    <input id="naam" class="form-control @Doel("naam")" @bind="nieuw.Naam" @onfocus='() => Kies("naam", "Naam")' />
                                </div>
                                <div class="veld">
                                    <label for="iban">IBAN</label>
                                    <input id="iban" class="form-control @Doel("iban") @Onzeker("iban")" title="@Waarom("iban")" @bind="nieuw.Iban" @bind:after='() => onzeker.Remove("iban")' @onfocus='() => Kies("iban", "IBAN")' />
                                </div>
                                <div class="veld">
                                    <label for="btwnr">Btw- en KvK-nummer</label>
                                    <div class="veld-rij">
                                        <input id="btwnr" class="form-control @Doel("btwnr") @Onzeker("btwnr")" title="@Waarom("btwnr")" placeholder="btw-nummer" @bind="nieuw.BtwNummer" @bind:after='() => onzeker.Remove("btwnr")' @onfocus='() => Kies("btwnr", "Btw-nummer")' />
                                        <input id="kvk" class="form-control @Doel("kvk") @Onzeker("kvk")" title="@Waarom("kvk")" placeholder="KvK-nummer" aria-label="KvK-nummer" @bind="nieuw.KvkNummer" @bind:after='() => onzeker.Remove("kvk")' @onfocus='() => Kies("kvk", "KvK-nummer")' />
                                    </div>
                                </div>
                            }
                            <div class="veld">
                                <label for="datum">Factuurdatum</label>
                                <div class="veld-rij">
                                    <input id="datum" type="date" class="form-control veld-smal @Doel("datum") @Onzeker("datum")" title="@Waarom("datum")" @bind="datum" @bind:after='() => onzeker.Remove("datum")' @onfocus='() => Kies("datum", "Factuurdatum")' />
                                </div>
                            </div>
                            @if (Toon("verval"))
                            {
                                <div class="veld">
                                    <label for="verval">Vervaldatum</label>
                                    <div class="veld-rij">
                                        <input id="verval" type="date" class="form-control veld-smal @Doel("verval")" @bind="vervaldatum" @onfocus='() => Kies("verval", "Vervaldatum")' />
                                    </div>
                                </div>
                                <div class="veld">
                                    <label for="kenmerk">Betalingskenmerk</label>
                                    <input id="kenmerk" class="form-control @Doel("kenmerk") @Onzeker("kenmerk")" title="@Waarom("kenmerk")" @bind="kenmerk" @bind:event="oninput" @bind:after='() => onzeker.Remove("kenmerk")' @onfocus='() => Kies("kenmerk", "Betalingskenmerk")' />
                                </div>
                            }
                            <div class="veld veld-boven">
                                <label for="omschrijving">Omschrijving</label>
                                <div>
                                    <div class="input-group">
                                        <input id="omschrijving" class="form-control @Doel("omschrijving")" @bind="omschrijving" @bind:event="oninput" @onfocus='() => Kies("omschrijving", "Omschrijving")' />
                                        <select @key="variabeleKeuze" class="form-select flex-grow-0 variabelekeuze" aria-label="Variabele invoegen" title="Variabele invoegen" @onchange="VoegVariabeleToe">
                                            <option value="">#</option>
                                            @foreach (var (naam, betekenis) in Omschrijvingssjabloon.Variabelen)
                                            {
                                                <option value="@naam" title="@betekenis">@naam</option>
                                            }
                                        </select>
                                    </div>
                                    @if (Omschrijvingssjabloon.IsSjabloon(omschrijving))
                                    {
                                        <div class="small text-secondary mt-1" title="Zo komt de omschrijving in de boeking">@Omschrijvingssjabloon.Vul(omschrijving, Variabelen)</div>
                                    }
                                    @foreach (var o in Omschrijvingssjabloon.Onbekend(omschrijving))
                                    {
                                        <div class="status let-op mt-1">#@o is geen variabele.</div>
                                    }
                                </div>
                            </div>
                            <div class="veld">
                                <label for="totaal">Bedrag</label>
                                <div class="veld-rij">
                                    <input id="totaal" class="form-control veld-smal text-end @Doel("totaal")" title="Het totaal van de factuur, inclusief btw" @bind="factuurbedrag" @bind:event="oninput" @onfocus='() => Kies("totaal", "Bedrag inclusief btw")' />
                                    <span class="form-check form-switch mb-0">
                                        <input id="creditnota" class="form-check-input" type="checkbox" checked="@(soort == Documentsoort.Creditnota)" @onchange="e => soort = e.Value is true ? Documentsoort.Creditnota : Documentsoort.Factuur" />
                                        <label class="form-check-label" for="creditnota">Creditnota</label>
                                    </span>
                                </div>
                            </div>
                            @if (soort == Documentsoort.Creditnota && leverancier != Nieuw && historie?.Where(h => h.Openstaand < 0).ToList() is { Count: > 0 } openFacturen)
                            {
                                <div class="veld">
                                    <label for="verreken">Verrekenen met</label>
                                    <select id="verreken" class="form-select" @bind="verrekenMet">
                                        <option value="">niet verrekenen</option>
                                        @foreach (var f in openFacturen)
                                        {
                                            <option value="@f.Post">@f.Factuurnummer · @Weergave.Datum(f.Datum) · open @Bedragen.Getal(-f.Openstaand)</option>
                                        }
                                    </select>
                                </div>
                            }

                            <table class="table table-sm align-middle regeltabel mt-3 mb-1">
                                <thead>
                                    <tr>
                                        @if (Toon("regelomschrijving"))
                                        {
                                            <th>Omschrijving</th>
                                        }
                                        <th style="width:27%">Grootboekrekening</th>
                                        <th style="width:21%">Btw</th>
                                        <th class="text-end" style="width:15%">Excl. btw</th>
                                        @if (Toon("btwbedrag"))
                                        {
                                            <th class="text-end" style="width:14%">Btw-bedrag</th>
                                        }
                                        <th style="width:1.75rem"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < regels.Count; i++)
                                    {
                                        var regel = regels[i];
                                        var n = i;
                                        <tr>
                                            @if (Toon("regelomschrijving"))
                                            {
                                                <td><input class="form-control form-control-sm @Doel($"regel:{n}")" @bind="regel.Omschrijving" @bind:event="oninput" @onfocus='() => Kies($"regel:{n}", $"Omschrijving regel {n + 1}")' placeholder="@(Omschrijvingssjabloon.IsSjabloon(omschrijving) ? Omschrijvingssjabloon.Vul(omschrijving, Variabelen) : omschrijving)" aria-label="Omschrijving regel" /></td>
                                            }
                                            <td>
                                                <RekeningKeuze @bind-Waarde:get="regel.Rekening" @bind-Waarde:set='v => regel.Rekening = v ?? ""' Schema="verwerking.Schema" Voorkeur="voorkeur" />
                                                @if (verwerking.Schema.Zoek(regel.Rekening) is { } gekozen)
                                                {
                                                    <div class="small text-secondary text-truncate rekeningnaam">@gekozen.Naam</div>
                                                }
                                            </td>
                                            <td>
                                                <select class="form-select form-select-sm" @bind="regel.BtwCode" aria-label="Btw-code">
                                                    @foreach (var c in Codes.Where(c => c.Richting == BtwRichting.Inkoop && (c.Actief || c.Code == regel.BtwCode)))
                                                    {
                                                        <option value="@c.Code" title="@c.Code · @c.Omschrijving">@c.Kort</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input class="form-control form-control-sm text-end @Doel($"bedrag:{n}")" @bind="regel.Bedrag" @bind:event="oninput" @onfocus='() => Kies($"bedrag:{n}", "Bedrag exclusief btw")' aria-label="Bedrag exclusief btw" /></td>
                                            @if (Toon("btwbedrag"))
                                            {
                                                <td>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <input class="form-control form-control-sm text-end @Doel($"btw:{n}")" @bind:get="BtwTekst(regel)" @bind:set="v => ZetBtw(regel, v)" @bind:event="oninput" @onfocus='() => Kies($"btw:{n}", "Btw")' title="@(regel.BtwHandmatig ? $"Aangepast; berekend {BerekendeBtw(regel)}" : IsVerlegd(regel) ? "Btw verlegd: het pakket berekent de btw bij het boeken (af te dragen en aftrekbaar)" : "Berekend uit het tarief")" placeholder="@(IsVerlegd(regel) ? "verlegd" : null)" aria-label="Btw" />
                                                        @if (regel.BtwHandmatig)
                                                        {
                                                            <button class="btn btn-sm btn-link text-secondary p-0" title="Terug naar de berekende btw (@BerekendeBtw(regel))" @onclick="() => regel.BtwHandmatig = false">↺</button>
                                                        }
                                                    </div>
                                                </td>
                                            }
                                            <td><button class="btn btn-sm btn-link text-secondary p-0 regel-weg" title="Regel verwijderen" @onclick="() => Verwijder(regel)" disabled="@(regels.Count <= 1)">×</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="d-flex align-items-start gap-3">
                                <button class="btn btn-sm btn-link nog-een-regel" @onclick="RegelToevoegen">+ Nog een regel</button>
                                <div class="ms-auto text-end small">
                                    <div>Totaal incl. btw <span class="bedrag fw-semibold ms-2">@(Totaal is { } t ? Bedragen.Getal(t) : "–")</span></div>
                                    @if (Verschil is { } verschil && verschil != 0)
                                    {
                                        <div class="status let-op" title="Totaal van de regels min het bedrag van de factuur">Verschil <span class="bedrag ms-2">@Bedragen.Getal(verschil)</span></div>
                                    }
                                </div>
                            </div>
                            @foreach (var s in Signalen)
                            {
                                <div class="status let-op mb-1">@s</div>
                            }
                            <div class="d-flex align-items-center gap-3 mt-3">
                                <button class="btn btn-primary" @onclick="Boek" disabled="@bezig" title="Ctrl+Enter">@(Signalen.Count > 0 || Verschil is not (null or 0) ? "Toch boeken" : "Boeken")</button>
                                @if (overgenomen is not null)
                                {
                                    <span class="small text-secondary text-truncate">@overgenomen</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div @ref="scheiding" class="verwerken-scheiding @(ViewerZichtbaar ? null : "d-none")" title="Sleep om de factuur breder of smaller te maken; dubbelklik voor de standaardbreedte"></div>
                <div @ref="viewerPaneel" class="verwerken-viewer @(ViewerZichtbaar ? null : "d-none")">
                    <div @ref="viewer" class="factuurviewer"></div>
                </div>
            </div>
        }
    </ChildContent>
</AdministratieKader>

@code {
    private const string Nieuw = "";

    private Geopend? geopend;
    private Verwerking? verwerking;
    private string leverancier = Nieuw;
    private NieuweLeverancier nieuw = new();
    private string factuurnummer = "";
    private DateOnly datum;
    private DateOnly vervaldatum;
    private string omschrijving = "";
    private string? kenmerk;
    private List<Invoerregel> regels = [];
    private bool bezig;
    private IReadOnlyList<string>? fouten;

    // Soort document: factuur, creditnota (omgekeerd boeken, eventueel verrekenen) of bewaren zonder boeking.
    private Documentsoort soort;
    private Guid? verrekenMet;
    private string? factuurbedrag;
    private bool bevestigHeropenen;

    // Een geboekte factuur: hoe hij geboekt is; na heropenen vult dat het formulier (in plaats van wat herkend was).
    private GeboekteFactuur? geboekteFactuur;
    private GeboekteFactuur? heropend;

    // De werkvoorraad: de documenten in Te verwerken, om zonder de lijst van factuur naar factuur te gaan.
    private IReadOnlyList<DocumentRegel>? werkvoorraad;
    private Guid geladen;
    private string? vorigeGeboekt;
    private bool naBoeken;
    private bool externVolgen;
    private IJSObjectReference? sneltoetsen;

    // Eerdere facturen van de gekozen leverancier, en de rekeningen die daarbij het vaakst gebruikt zijn.
    private IReadOnlyList<EerdereFactuur>? historie;
    private IReadOnlyList<string> voorkeur = [];

    // De viewer: het veld dat een aangewezen gebied krijgt, en of de factuur in een apart venster staat.
    private ElementReference viewer;
    private ElementReference viewerPaneel;
    private ElementReference scheiding;
    private IJSObjectReference? module;
    private IJSObjectReference? viewerKoppeling;
    private bool viewerGestart;
    private DotNetObjectReference<FactuurVerwerken>? zelf;
    private string doel = "omschrijving";
    private string doelNaam = "Omschrijving";
    private bool losVenster;
    private string? overgenomen;
    private int variabeleKeuze;

    // Velden die de herkenning niet vond of niet op de factuur terugvond, met de reden (tooltip).
    private readonly Dictionary<string, string> onzeker = [];

    // Wat de gebruiker op de factuur aanwees, per veld: wordt bij het boeken het zoektemplate van de leverancier.
    private readonly Dictionary<Factuurveld, Zoekgebied> aanwijzingen = [];

    // Weergave: wat de gebruiker wil zien tijdens het verwerken; onthouden in de browser.
    private static readonly (string Sleutel, string Naam)[] Weergaveopties =
    [
        ("werkvoorraad", "Werkvoorraad naast het formulier"),
        ("viewer", "Factuur naast het formulier"),
        ("btwbedrag", "Btw-bedrag per regel"),
        ("regelomschrijving", "Omschrijving per regel"),
        ("verval", "Vervaldatum en betalingskenmerk"),
    ];

    // De onderdelen van vóór de werkvoorraad: wie toen de weergave aanpaste, krijgt de werkvoorraad er standaard bij.
    private static readonly string[] EerderBekend = ["viewer", "btwbedrag", "regelomschrijving", "verval"];

    private static readonly string[] AlleWeergave = [.. Weergaveopties.Select(o => o.Sleutel)];

    private HashSet<string> weergave = [.. AlleWeergave];

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public Guid DocumentId { get; set; }

    private decimal? Totaal => regels.All(r => Getal(r.Bedrag) is not null)
        ? regels.Sum(r => Getal(r.Bedrag)!.Value + BtwOpFactuur(r))
        : null;

    /// <summary>Totaal van de regels min het totaal van de factuur; leeg als een van beide onbekend is.</summary>
    private decimal? Verschil => Totaal is { } t && Factuurtotaal is { } f ? t - f : null;

    /// <summary>Het totaal op de factuur; bij een creditnota zonder minteken, zoals de bedragen in het formulier.</summary>
    private decimal? Factuurtotaal => Getal(factuurbedrag) is { } f ? Math.Abs(f) : null;

    private bool Toon(string sleutel) => weergave.Contains(sleutel);

    /// <summary>De btw-codes met de tarieven op de factuurdatum (een nieuw tarief geldt vanaf zijn ingangsdatum).</summary>
    private IReadOnlyList<BtwCode> Codes => verwerking?.Btwtabel.Op(datum) ?? [];

    private bool ViewerZichtbaar => Toon("viewer") && !losVenster;

    /// <summary>De plaats van dit document in de werkvoorraad, of leeg als het er niet (meer) in staat.</summary>
    private int? Positie => werkvoorraad?.Select((d, i) => (d, i)).Where(x => x.d.Id == DocumentId).Select(x => (int?)x.i).FirstOrDefault();

    private Factuurvariabelen Variabelen => new(
        factuurnummer, verwerking?.Herkend?.Omschrijving,
        leverancier == Nieuw ? nieuw.Naam : verwerking?.Relaties.FirstOrDefault(r => r.Code == leverancier)?.Naam,
        datum, vervaldatum, kenmerk);

    /// <summary>Kloppen de bedragen (btw bij het tarief, samen het totaal van de factuur)?</summary>
    private IReadOnlyList<string> Signalen
    {
        get
        {
            if (verwerking is null || regels.Any(r => Getal(r.Bedrag) is null || (BtwTekst(r) is { Length: > 0 } b && Getal(b) is null)))
            {
                return [];
            }

            // Het verschil met het factuurtotaal staat onder de regels; hier de btw per regel en in totaal.
            var h = verwerking.Herkend;
            // Het formulier toont een creditnota zonder minteken; vergelijk met de btw van de factuur zonder minteken.
            var factuur = h is null ? null : new Factuurbedragen(null, h.Btwregels.Count > 0 ? (soort == Documentsoort.Creditnota ? Math.Abs(h.TotaalBtw) : h.TotaalBtw) : null, h.Regels?.Count ?? 1);
            return Bedragcontrole.Controleer([.. regels.Select(r => new Factuurregel("", r.Rekening, r.BtwCode, Getal(r.Bedrag)!.Value, Getal(BtwTekst(r))))], Codes, factuur);
        }
    }

    private async Task Open(Geopend g)
    {
        geopend = g;
        geladen = DocumentId;
        werkvoorraad = await Inkoop.Lijst(g.Wie, Id, Documentstatus.TeVerwerken);
        verwerking = await Inkoop.Verwerking(g.Wie, Id, DocumentId);
        if (verwerking is null)
        {
            return;
        }

        var herkend = verwerking.Herkend;
        var voorstel = verwerking.Voorstel;
        leverancier = voorstel?.Leverancier?.Relatie.Code ?? Nieuw;
        nieuw = new NieuweLeverancier { Naam = herkend?.Naam ?? "", Iban = herkend?.Iban, BtwNummer = herkend?.BtwNummer, KvkNummer = herkend?.KvkNummer };
        factuurnummer = herkend?.Factuurnummer ?? "";
        datum = herkend?.Factuurdatum ?? DateOnly.FromDateTime(DateTime.Today);
        vervaldatum = voorstel?.Factuur?.Vervaldatum ?? herkend?.Vervaldatum ?? datum.AddDays(30);
        omschrijving = voorstel?.Advies.Omschrijving ?? herkend?.Omschrijving ?? "";
        kenmerk = herkend?.Betalingskenmerk;
        var rekening = voorstel?.Advies.Rekeningnummer ?? "";
        // Btw verlegd ("reverse charge"): de verlegde code (binnenland, EU of buiten de EU), geen btw op de factuur.
        var verlegd = herkend is null ? null : Inkoopverwerker.VerlegdeCode(herkend, Codes);
        var standaardCode = voorstel?.Advies.BtwCode ?? verlegd?.Code ?? "I21";
        regels = voorstel?.Factuur is { } f
            ? [.. f.Regels.Select(r => new Invoerregel { Rekening = r.Rekeningnummer, BtwCode = r.BtwCode, Bedrag = Bedragen.Getal(r.Bedrag), Btw = r.Btw is { } b ? Bedragen.Getal(b) : null })]
            : verlegd is not null
                ? [new Invoerregel { Rekening = rekening, BtwCode = verlegd.Code, Bedrag = (herkend!.TotaalExclusief ?? herkend.TotaalInclusief) is { } v ? Bedragen.Getal(v) : null }]
                : herkend?.Btwregels is { Count: > 0 } btw
                    ? [.. btw.Select(b => new Invoerregel
                    {
                        Rekening = rekening,
                        BtwCode = BtwCodes.Bij(Codes, BtwRichting.Inkoop, b.Percentage)?.Code ?? "I21",
                        Bedrag = (b.Grondslag ?? (btw.Count == 1 ? herkend.TotaalExclusief : null)) is { } g2 ? Bedragen.Getal(g2) : null,
                        Btw = Bedragen.Getal(b.Btw),
                    })]
                    : [new Invoerregel { Rekening = rekening, BtwCode = standaardCode, Bedrag = Exclusief(herkend, standaardCode) is { } e ? Bedragen.Getal(e) : null }];

        // Een creditnota (negatief totaal) staat in het formulier zonder minteken; het pakket boekt hem omgekeerd.
        soort = herkend?.TotaalInclusief < 0 ? Documentsoort.Creditnota : Documentsoort.Factuur;
        (verrekenMet, bevestigHeropenen) = (null, false);
        factuurbedrag = herkend?.TotaalInclusief is { } totaal ? Bedragen.Getal(Math.Abs(totaal)) : null;
        if (soort == Documentsoort.Creditnota)
        {
            foreach (var r in regels)
            {
                r.Bedrag = Getal(r.Bedrag) is { } b ? Bedragen.Getal(Math.Abs(b)) : r.Bedrag;
                r.Btw = Getal(r.Btw) is { } regelbtw ? Bedragen.Getal(Math.Abs(regelbtw)) : r.Btw;
            }
        }

        geboekteFactuur = verwerking.Document.Status == Documentstatus.Geboekt ? await Inkoop.Geboekt(g.Wie, Id, DocumentId) : null;
        if (heropend is { } h && verwerking.Document.Status == Documentstatus.TeVerwerken)
        {
            VulMet(h);
            heropend = null;
            await LaadHistorie();
            onzeker.Clear();
            return;
        }

        await LaadHistorie();
        await ControleerHerkenning();

        // Btw van de factuur die afwijkt van het tarief (afronding van de leverancier) geldt als aangepast.
        foreach (var r in regels)
        {
            r.BtwHandmatig = Getal(r.Btw) is { } vanFactuur && Getal(BerekendeBtw(r)) is { } berekend && vanFactuur != berekend;
        }
    }

    /// <summary>
    /// Naar een ander document (volgende, vorige of uit de werkvoorraad): dezelfde pagina blijft staan, dus de gegevens
    /// en de viewer opnieuw laden.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (geopend is null || geladen == DocumentId)
        {
            return;
        }

        await SluitViewer();
        (fouten, overgenomen, doel, doelNaam) = (null, null, "omschrijving", "Omschrijving");
        aanwijzingen.Clear();
        if (!naBoeken)
        {
            vorigeGeboekt = null;
        }

        naBoeken = false;

        // Staat de factuur in een eigen venster, dan toont dat venster straks dit document.
        externVolgen = losVenster;
        await Open(geopend);
    }

    private async Task SluitViewer()
    {
        if (viewerKoppeling is not null)
        {
            try
            {
                await viewerKoppeling.InvokeVoidAsync("sluit");
                await viewerKoppeling.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Het circuit is al weg.
            }
        }

        viewerKoppeling = null;
        viewerGestart = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./factuurviewer.js");
            zelf ??= DotNetObjectReference.Create(this);
            var toetsen = await JS.InvokeAsync<IJSObjectReference>("import", "./sneltoetsen.js");
            sneltoetsen = await toetsen.InvokeAsync<IJSObjectReference>("koppel", zelf);
            await toetsen.DisposeAsync();
            weergave = Weergavekeuze.Lees(await module.InvokeAsync<string?>("leesWeergave"), AlleWeergave, AlleWeergave, EerderBekend);
            StateHasChanged();
        }

        // Eén keer: een volgende render tijdens het laden mag geen tweede viewer starten.
        if (viewerGestart || verwerking?.Document.Status is not (Documentstatus.TeVerwerken or Documentstatus.Geboekt) || viewer.Context is null)
        {
            return;
        }

        viewerGestart = true;
        zelf ??= DotNetObjectReference.Create(this);
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./factuurviewer.js");
        // In de webapp haalt de viewer de PDF bij de server; in de Windows-app (geen server) krijgt hij de inhoud mee.
        object bron = $"/a/{Id}/documenten/{DocumentId}";
        if (Diensten.GetService<IDocumentvenster>() is not null && await Inkoop.Inhoud(geopend!.Wie, Id, DocumentId) is { } inhoud)
        {
            bron = new DotNetStreamReference(new MemoryStream(inhoud.Inhoud));
        }

        await module.InvokeVoidAsync("scheiding", scheiding, viewerPaneel);

        viewerKoppeling = await module.InvokeAsync<IJSObjectReference>("toon", viewer, bron, DocumentId.ToString(), zelf);
        await viewerKoppeling.InvokeVoidAsync("doel", doelNaam);
        if (externVolgen)
        {
            externVolgen = false;
            await NaarExtern();
        }
    }

    private string? Doel(string veld) => doel == veld ? "doelveld" : null;

    private string? Onzeker(string veld) => onzeker.ContainsKey(veld) ? "onzeker" : null;

    private string? Waarom(string veld) => onzeker.GetValueOrDefault(veld);

    /// <summary>De vormen waarin de waarde van een veld op de factuur kan staan (om hem daar terug te vinden).</summary>
    private IReadOnlyList<string> Vormen(string veld) => veld.Split(':') switch
    {
        ["nummer"] => Tekstvormen.Tekst(factuurnummer),
        ["datum"] => Tekstvormen.Datum(datum),
        ["verval"] => Tekstvormen.Datum(vervaldatum),
        ["kenmerk"] => Tekstvormen.Tekst(kenmerk),
        ["totaal"] => Tekstvormen.Bedrag(Getal(factuurbedrag)),
        ["omschrijving"] => Omschrijvingssjabloon.IsSjabloon(omschrijving) ? [] : Tekstvormen.Tekst(omschrijving),
        ["naam"] => Tekstvormen.Tekst(nieuw.Naam),
        ["iban"] => Tekstvormen.Tekst(nieuw.Iban),
        ["btwnr"] => Tekstvormen.Tekst(nieuw.BtwNummer),
        ["kvk"] => Tekstvormen.Tekst(nieuw.KvkNummer),
        ["bedrag", var n] when RegelBij(n) is { } r => Tekstvormen.Bedrag(Getal(r.Bedrag)),
        ["btw", var n] when RegelBij(n) is { } r => Tekstvormen.Bedrag(Getal(BtwTekst(r))),
        ["regel", var n] when RegelBij(n) is { } r => Tekstvormen.Tekst(r.Omschrijving),
        _ => [],
    };

    private Invoerregel? RegelBij(string index) =>
        int.TryParse(index, System.Globalization.CultureInfo.InvariantCulture, out var i) && i >= 0 && i < regels.Count ? regels[i] : null;

    /// <summary>
    /// Bij een factuur uit de tekst van een PDF (geen e-factuur): welke velden de herkenning niet vond, en welke
    /// gevonden waarden niet op de factuur terug te vinden zijn. Die velden krijgen een rustige markering.
    /// </summary>
    private async Task ControleerHerkenning()
    {
        onzeker.Clear();
        if (verwerking?.Herkend is not { Bron: not Herkenningsbron.EFactuur } herkend || geopend is null)
        {
            return;
        }

        if (herkend.Factuurnummer is null)
        {
            onzeker["nummer"] = "Niet herkend";
        }

        if (herkend.Factuurdatum is null)
        {
            onzeker["datum"] = "Niet herkend";
        }

        string[] controleren = leverancier == Nieuw ? ["nummer", "datum", "kenmerk", "iban", "btwnr", "kvk"] : ["nummer", "datum", "kenmerk"];
        var velden = controleren.Where(v => !onzeker.ContainsKey(v)).Select(v => (v, Vormen(v))).Where(x => x.Item2.Count > 0)
            .ToDictionary(x => x.v, x => x.Item2);
        var plekken = await Inkoop.Vindplaatsen(geopend.Wie, Id, DocumentId, velden);

        // Vond het pakket niets terug (bijv. geen tekstlaag), dan zegt dat niets over de afzonderlijke velden.
        if (plekken.Values.Any(p => p.Count > 0))
        {
            foreach (var (veld, lijst) in plekken.Where(p => p.Value.Count == 0))
            {
                onzeker[veld] = "Niet op de factuur teruggevonden";
            }
        }
    }

    /// <summary>Laat in de viewer oplichten waar de waarde van het veld op de factuur staat.</summary>
    private async Task Markeer(string veld)
    {
        if (viewerKoppeling is null || geopend is null)
        {
            return;
        }

        var vormen = Vormen(veld);
        var plekken = vormen.Count == 0 ? [] : (await Inkoop.Vindplaatsen(geopend.Wie, Id, DocumentId, new Dictionary<string, IReadOnlyList<string>> { [veld] = vormen }))[veld];
        await viewerKoppeling.InvokeVoidAsync("markeer", plekken);
    }

    private async Task ZetWeergave(string sleutel, bool aan)
    {
        if (aan)
        {
            weergave.Add(sleutel);
        }
        else
        {
            weergave.Remove(sleutel);
        }

        if (module is not null)
        {
            await module.InvokeVoidAsync("bewaarWeergave", Weergavekeuze.Tekst(weergave, AlleWeergave));
        }
    }

    private static string Veldnaam(Factuurveld veld) => veld switch
    {
        Factuurveld.Factuurnummer => "factuurnummer",
        Factuurveld.Factuurdatum => "factuurdatum",
        Factuurveld.Vervaldatum => "vervaldatum",
        Factuurveld.Betalingskenmerk => "betalingskenmerk",
        _ => "omschrijving",
    };

    /// <summary>Het veld van het zoektemplate bij het gekozen doel, of leeg (bedragen en relatiegegevens niet).</summary>
    private Factuurveld? Templateveld => doel switch
    {
        "nummer" => Factuurveld.Factuurnummer,
        "datum" => Factuurveld.Factuurdatum,
        "verval" => Factuurveld.Vervaldatum,
        "kenmerk" => Factuurveld.Betalingskenmerk,
        "omschrijving" => Factuurveld.Omschrijving,
        _ => null,
    };

    private async Task Kies(string veld, string naam)
    {
        doel = veld;
        doelNaam = naam;
        if (viewerKoppeling is not null)
        {
            await viewerKoppeling.InvokeVoidAsync("doel", naam);
            await Markeer(veld);
        }
    }

    /// <summary>De gebruiker wees een gebied op de factuur aan: de tekst daaruit gaat naar het gekozen veld.</summary>
    [JSInvokable]
    public async Task Gebied(int pagina, double x0, double y0, double x1, double y1)
    {
        var tekst = string.Join(" ", await Inkoop.TekstInGebied(geopend!.Wie, Id, DocumentId, pagina, x0, y0, x1, y1)).Trim();
        var gelukt = tekst.Length > 0 && Vul(tekst);
        overgenomen = tekst.Length == 0 ? "Geen tekst in dit gebied." : gelukt ? $"{doelNaam}: {tekst}" : $"Geen {(doel.StartsWith("bedrag", StringComparison.Ordinal) || doel.StartsWith("btw", StringComparison.Ordinal) || doel == "totaal" ? "bedrag" : "datum")} in ‘{tekst}’.";
        if (gelukt && Templateveld is { } veld)
        {
            aanwijzingen[veld] = new Zoekgebied(veld, pagina, x0, y0, x1, y1);
        }

        if (gelukt)
        {
            onzeker.Remove(doel);
            await Markeer(doel);
        }

        await InvokeAsync(StateHasChanged);
    }

    private bool Vul(string tekst)
    {
        if (doel is "datum" or "verval")
        {
            if (Factuurtekst.Datums(tekst) is not [var d, ..])
            {
                return false;
            }

            if (doel == "datum")
            {
                datum = d;
            }
            else
            {
                vervaldatum = d;
            }

            return true;
        }

        if (doel == "totaal")
        {
            if (Factuurtekst.Bedragen(tekst) is not [.., var totaal])
            {
                return false;
            }

            factuurbedrag = Bedragen.Getal(Math.Abs(totaal));
            return true;
        }

        if (doel.Split(':') is [var soort and ("bedrag" or "btw"), var index] && int.Parse(index, System.Globalization.CultureInfo.InvariantCulture) is var i && i < regels.Count)
        {
            if (Factuurtekst.Bedragen(tekst) is not [.., var bedrag])
            {
                return false;
            }

            if (soort == "bedrag")
            {
                regels[i].Bedrag = Bedragen.Getal(bedrag);
            }
            else
            {
                ZetBtw(regels[i], Bedragen.Getal(bedrag));
            }

            return true;
        }

        if (doel.Split(':') is ["regel", var r] && int.Parse(r, System.Globalization.CultureInfo.InvariantCulture) is var j && j < regels.Count)
        {
            regels[j].Omschrijving = tekst;
            return true;
        }

        switch (doel)
        {
            case "nummer":
                factuurnummer = Zoektemplate.Factuurnummer(tekst) ?? tekst;
                break;
            case "kenmerk":
                kenmerk = Zoektemplate.Kenmerk(tekst) ?? tekst;
                break;
            case "naam":
                nieuw.Naam = tekst;
                break;
            case "iban":
                nieuw.Iban = Boekhouding.Relaties.Iban.Normaliseer(tekst);
                break;
            case "btwnr":
                nieuw.BtwNummer = tekst;
                break;
            case "kvk":
                nieuw.KvkNummer = string.Concat(tekst.Where(char.IsAsciiDigit));
                break;
            default:
                omschrijving = tekst;
                break;
        }

        return true;
    }

    [JSInvokable]
    public async Task NaarExtern()
    {
        losVenster = true;
        if (Diensten.GetService<IDocumentvenster>() is { } venster)
        {
            venster.OpenViewer(Id, DocumentId, verwerking?.Document.Bestandsnaam ?? "Factuur", () => _ = ExternGesloten());
        }
        else
        {
            await viewerKoppeling!.InvokeVoidAsync("extern", $"/a/{Id}/inkoop/{DocumentId}/document");
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task ExternGesloten()
    {
        losVenster = false;
        await InvokeAsync(StateHasChanged);
    }

    private void VoegVariabeleToe(ChangeEventArgs e)
    {
        if (e.Value is string { Length: > 0 } variabele)
        {
            omschrijving = $"{omschrijving.TrimEnd()} {variabele}".TrimStart();
        }

        variabeleKeuze++;
    }

    /// <summary>Een regel erbij (uitsplitsen): met wat er nog niet verdeeld is ten opzichte van het factuurtotaal.</summary>
    private void RegelToevoegen()
    {
        var regel = new Invoerregel { Rekening = regels[^1].Rekening, BtwCode = regels[^1].BtwCode };
        if (Verschil is { } verschil && verschil < 0 && BtwCodes.Zoek(Codes, regel.BtwCode) is { } code)
        {
            regel.Bedrag = Bedragen.Getal(code.BtwOpFactuur ? BtwBerekening.UitInclusief(-verschil, code.Percentage).Grondslag : -verschil);
        }

        regels.Add(regel);
    }

    private void Verwijder(Invoerregel regel)
    {
        regels.Remove(regel);
        if (doel.Contains(':', StringComparison.Ordinal))
        {
            doel = "omschrijving";
            doelNaam = "Omschrijving";
        }
    }

    private async Task Boek()
    {
        var ongeldig = regels.Select((r, i) => (r, i)).Where(x => Getal(x.r.Bedrag) is null || (BtwTekst(x.r) is { Length: > 0 } b && Getal(b) is null)).Select(x => $"Regel {x.i + 1}: het bedrag is niet te lezen.").ToList();
        if (ongeldig.Count > 0)
        {
            fouten = ongeldig;
            return;
        }

        var invoer = new Factuurinvoer(
            leverancier == Nieuw ? null : leverancier,
            leverancier == Nieuw ? new NieuweRelatie(nieuw.Naam, nieuw.Iban, nieuw.BtwNummer, nieuw.KvkNummer) : null,
            factuurnummer, datum, vervaldatum, omschrijving,
            [.. regels.Select(r => new Factuurregel(string.IsNullOrWhiteSpace(r.Omschrijving) ? omschrijving : r.Omschrijving.Trim(), r.Rekening.Trim(), r.BtwCode, Getal(r.Bedrag)!.Value, Getal(BtwTekst(r))))],
            kenmerk,
            [.. aanwijzingen.Values],
            soort == Documentsoort.Creditnota,
            soort == Documentsoort.Creditnota ? verrekenMet : null);
        bezig = true;
        var positie = Positie ?? 0;
        var uitkomst = await Inkoop.Boek(geopend!.Wie, Id, DocumentId, invoer);
        bezig = false;
        if (!uitkomst.IsGelukt)
        {
            fouten = uitkomst.Fouten;
            return;
        }

        // Door naar het document dat nu op deze plaats in Te verwerken staat (het volgende), of terug naar de lijst.
        vorigeGeboekt = $"{(soort == Documentsoort.Creditnota ? "Creditnota " : null)}{Variabelen.Leverancier} {factuurnummer} is geboekt.".Trim();
        await NaarVolgende(positie);
    }

    private async Task LaadHistorie()
    {
        historie = leverancier == Nieuw || geopend is null ? [] : await Inkoop.Historie(geopend.Wie, Id, leverancier);
        voorkeur = [.. historie.GroupBy(h => h.Rekening).OrderByDescending(g => g.Count()).Select(g => g.Key)];
    }

    /// <summary>Heropent een geboekte factuur: de boeking gaat terug en het formulier staat vol met wat er geboekt was.</summary>
    private async Task Heropenen()
    {
        bezig = true;
        var uitkomst = await Inkoop.Heropen(geopend!.Wie, Id, DocumentId);
        bezig = false;
        fouten = uitkomst.Fouten;
        bevestigHeropenen = false;
        if (uitkomst.IsGelukt)
        {
            heropend = uitkomst.Waarde;
            await SluitViewer();
            await Open(geopend);
        }
    }

    private void VulMet(GeboekteFactuur g)
    {
        leverancier = g.Relatie;
        factuurnummer = g.Factuurnummer;
        (datum, vervaldatum) = (g.Datum, g.Vervaldatum);
        omschrijving = g.Omschrijving;
        kenmerk = g.Betalingskenmerk;
        soort = g.Creditnota ? Documentsoort.Creditnota : Documentsoort.Factuur;
        factuurbedrag = Bedragen.Getal(g.Totaal);
        regels =
        [
            .. g.Regels.Select(r => new Invoerregel
            {
                Rekening = r.Rekeningnummer,
                BtwCode = r.BtwCode,
                Bedrag = Bedragen.Getal(r.Bedrag),
                Btw = r.Btw is { } b ? Bedragen.Getal(b) : null,
                Omschrijving = r.Omschrijving.Length > 0 ? r.Omschrijving : null,
            }),
        ];
        foreach (var r in regels)
        {
            r.BtwHandmatig = Getal(r.Btw) is { } btw && Getal(BerekendeBtw(r)) is { } berekend && btw != berekend;
        }
    }

    private async Task Terugzetten()
    {
        var uitkomst = await Inkoop.Terugzetten(geopend!.Wie, Id, DocumentId);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            await SluitViewer();
            await Open(geopend);
        }
    }

    /// <summary>Naar het document dat nu op deze plaats in Te verwerken staat, of terug naar de lijst.</summary>
    private async Task NaarVolgende(int positie)
    {
        naBoeken = true;
        var rest = await Inkoop.Lijst(geopend!.Wie, Id, Documentstatus.TeVerwerken);
        Navigatie.NavigateTo(rest.Count == 0 ? $"/a/{Id}/inkoop" : $"/a/{Id}/inkoop/{rest[Math.Min(positie, rest.Count - 1)].Id}");
    }

    /// <summary>Naar de vorige of volgende factuur in de werkvoorraad, zonder te boeken.</summary>
    private void Ga(int stap)
    {
        if (werkvoorraad is not { Count: > 0 } || Positie is not { } positie || positie + stap < 0 || positie + stap >= werkvoorraad.Count)
        {
            return;
        }

        Navigatie.NavigateTo($"/a/{Id}/inkoop/{werkvoorraad[positie + stap].Id}");
    }

    [JSInvokable]
    public async Task Sneltoets(string actie)
    {
        if (verwerking?.Document.Status != Documentstatus.TeVerwerken || bezig)
        {
            return;
        }

        switch (actie)
        {
            case "boeken":
                await Boek();
                break;
            case "volgende":
                Ga(1);
                break;
            case "vorige":
                Ga(-1);
                break;
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Het bedrag exclusief btw; staat alleen het totaal op de factuur, dan teruggerekend met het tarief.</summary>
    private decimal? Exclusief(HerkendeFactuur? herkend, string btwCode) =>
        herkend?.TotaalExclusief
        ?? (herkend?.TotaalInclusief is { } inclusief && BtwCodes.Zoek(Codes, btwCode) is { } code
            ? (code.BtwOpFactuur ? BtwBerekening.UitInclusief(inclusief, code.Percentage).Grondslag : inclusief)
            : null);

    private decimal BtwOpFactuur(Invoerregel regel)
    {
        var code = BtwCodes.Zoek(Codes, regel.BtwCode);
        return code is null || !code.BtwOpFactuur ? 0 : Getal(BtwTekst(regel)) ?? 0;
    }

    /// <summary>De btw van een regel: berekend uit bedrag en tarief, tenzij de gebruiker hem heeft aangepast.</summary>
    private string? BtwTekst(Invoerregel regel) => regel.BtwHandmatig ? regel.Btw : BerekendeBtw(regel);

    private static void ZetBtw(Invoerregel regel, string? waarde)
    {
        regel.Btw = waarde;
        regel.BtwHandmatig = true;
    }

    /// <summary>De btw uit bedrag en tarief; leeg bij verlegde btw (die staat niet op de factuur, het pakket berekent hem bij het boeken).</summary>
    private string? BerekendeBtw(Invoerregel regel) =>
        BtwCodes.Zoek(Codes, regel.BtwCode) is { Verlegd: false } code && Getal(regel.Bedrag) is { } bedrag ? Bedragen.Getal(code.Bereken(bedrag)) : null;

    private bool IsVerlegd(Invoerregel regel) => BtwCodes.Zoek(Codes, regel.BtwCode) is { Verlegd: true };

    private static decimal? Getal(string? tekst) =>
        string.IsNullOrWhiteSpace(tekst) ? null : BedragParser.TryParse(tekst, out var b) ? b : null;

    public async ValueTask DisposeAsync()
    {
        await SluitViewer();
        try
        {
            if (sneltoetsen is not null)
            {
                await sneltoetsen.InvokeVoidAsync("los");
                await sneltoetsen.DisposeAsync();
            }

            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Het circuit is al weg; niets op te ruimen in de browser.
        }

        zelf?.Dispose();
    }

    private sealed class NieuweLeverancier
    {
        public string Naam { get; set; } = "";

        public string? Iban { get; set; }

        public string? BtwNummer { get; set; }

        public string? KvkNummer { get; set; }
    }

    private sealed class Invoerregel
    {
        public string Rekening { get; set; } = "";

        public string BtwCode { get; set; } = "I21";

        public string? Bedrag { get; set; }

        public string? Btw { get; set; }

        /// <summary>De btw is met de hand (of van de factuur) gezet en wordt niet meer berekend.</summary>
        public bool BtwHandmatig { get; set; }

        /// <summary>Eigen omschrijving van deze regel; leeg = de omschrijving van de factuur.</summary>
        public string? Omschrijving { get; set; }
    }
}
