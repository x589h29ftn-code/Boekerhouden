@page "/beheer/instellingen"
@layout BeheerLayout
@attribute [Authorize(Roles = Rollen.Beheerder)]
@inject KantoorDienst Kantoor

<PageTitle>Kantoorinstellingen – Administratie</PageTitle>

<h1 class="h3 mb-3">Kantoorinstellingen</h1>
<Foutmeldingen Fouten="fouten" />
@if (bericht is not null)
{
    <div class="bericht mb-2">@bericht</div>
}
@if (invoer is not null)
{
    <div class="card card-body" style="max-width: 52rem">
        <div class="mb-3">
            <InstellingenVelden Invoer="invoer" />
        </div>
        <div><button class="btn btn-primary" @onclick="Bewaar">Opslaan</button></div>
    </div>
}
@if (weergave is not null)
{
    <h2 class="h6 sectiekop mt-4">Overzichten</h2>
    <div class="card card-body" style="max-width: 52rem">
        <div class="d-flex align-items-center flex-wrap gap-3">
            <label for="letter">Lettergrootte</label>
            <select id="letter" class="form-select form-select-sm w-auto" @bind="letter">
                @foreach (var (procent, naam) in Overzichtsweergave.Groottes)
                {
                    <option value="@procent">@naam</option>
                }
            </select>
            <span class="form-check mb-0 ms-3">
                <input id="heleeuros" class="form-check-input" type="checkbox" @bind="heleEuros" />
                <label class="form-check-label" for="heleeuros">Afronden op hele euro's</label>
            </span>
            <span class="text-secondary small" title="Voorbeeld">@(heleEuros ? Bedragen.Heel(1200.45m) : Weergave.Bedrag(1200.45m))</span>
            <button class="btn btn-outline-primary btn-sm ms-auto" @onclick="BewaarWeergave">Opslaan</button>
        </div>
    </div>
}

@code {
    private InstellingenInvoer? invoer;
    private Overzichtsweergave? weergave;
    private int letter;
    private bool heleEuros;
    private IReadOnlyList<string>? fouten;
    private string? bericht;

    [CascadingParameter]
    private Task<AuthenticationState> Status { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        invoer = InstellingenInvoer.Van(await Kantoor.Instellingen());
        weergave = await Kantoor.Weergave();
        (letter, heleEuros) = (weergave.Lettergrootte, weergave.HeleEuros);
    }

    private async Task BewaarWeergave()
    {
        var uitkomst = await Kantoor.WijzigWeergave((await Status).User.AlsUitvoerder(), new Overzichtsweergave(letter, heleEuros));
        fouten = uitkomst.Fouten;
        bericht = uitkomst.IsGelukt ? "Weergave van de overzichten opgeslagen." : null;
    }

    private async Task Bewaar()
    {
        var lijst = new List<string>();
        var nieuw = invoer!.NaarKantoor(lijst);
        if (lijst.Count > 0)
        {
            fouten = lijst;
            bericht = null;
            return;
        }

        var uitkomst = await Kantoor.Wijzig((await Status).User.AlsUitvoerder(), nieuw);
        fouten = uitkomst.Fouten;
        bericht = uitkomst.IsGelukt ? "Kantoorinstellingen opgeslagen." : null;
    }
}
