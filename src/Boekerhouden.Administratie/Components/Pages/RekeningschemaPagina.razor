@page "/a/{Id:guid}/rekeningschema"
@using Boekerhouden.Boekhouding.Grootboek
@inject GrootboekDienst Grootboek
@inject BtwDienst Btw
@inject TimeProvider Tijd

<AdministratieKader Id="Id" Titel="Rekeningschema" Actief="/rekeningschema" BijOpenen="Open">
    @if (context.Mag(Recht.Boekhouden))
    {
        <Foutmeldingen Fouten="fouten" />
        <div class="card card-body mb-3">
            <div class="row g-2 align-items-end">
                <div class="col-sm-2">
                    <label class="form-label" for="nummer">Nummer</label>
                    <input id="nummer" class="form-control" @bind="nummer" />
                </div>
                <div class="col-sm-3">
                    <label class="form-label" for="naam">Naam</label>
                    <input id="naam" class="form-control" @bind="naam" />
                </div>
                <div class="col-sm-1">
                    <label class="form-label" for="btw">Btw</label>
                    <select id="btw" class="form-select" @bind="btw" title="De btw-code die bij de rekening hoort, of variabel">
                        <option value="">variabel</option>
                        @foreach (var c in codes.Where(c => c.Actief))
                        {
                            <option value="@c.Code" title="@c.Omschrijving">@c.Code</option>
                        }
                    </select>
                </div>
                <div class="col-sm-2">
                    <label class="form-label" for="soort">Soort</label>
                    <select id="soort" class="form-select" @bind="soort">
                        <option value="@Rekeningsoort.Balans">balans</option>
                        <option value="@Rekeningsoort.Resultaat">resultaat</option>
                    </select>
                </div>
                <div class="col-sm-2">
                    <label class="form-label" for="rgs">RGS-code</label>
                    <input id="rgs" class="form-control" @bind="rgs" placeholder="WBedKanTef" />
                </div>
                <div class="col-sm-2">
                    <button class="btn btn-outline-primary w-100" @onclick="VoegToe">Toevoegen</button>
                </div>
            </div>
        </div>
    }
    @if (schema is not null)
    {
        <div class="card">
            <table class="table table-sm align-middle mb-0 overzichtstabel rekeningschema">
                <thead>
                    <tr><th>Nummer</th><th>Naam</th><th>Btw</th><th>Soort</th><th>RGS</th><th>Indeling</th><th>Functie</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in schema.Alle)
                    {
                        @if (bewerk?.Nummer == r.Nummer)
                        {
                            <tr class="bewerken">
                                <td><a href="/a/@Id/grootboek?rekening=@r.Nummer">@r.Nummer</a></td>
                                <td><input class="form-control form-control-sm" @bind="bewerk.Naam" aria-label="Naam" /></td>
                                <td>
                                    <select class="form-select form-select-sm" @bind="bewerk.Btw" aria-label="Btw-code">
                                        <option value="">variabel</option>
                                        @foreach (var c in codes.Where(c => c.Actief || c.Code == bewerk.Btw))
                                        {
                                            <option value="@c.Code" title="@c.Omschrijving">@c.Code</option>
                                        }
                                    </select>
                                </td>
                                <td class="text-secondary">@(r.IsBalans ? "balans" : "resultaat")</td>
                                <td><input class="form-control form-control-sm" @bind="bewerk.Rgs" @bind:event="oninput" aria-label="RGS-code" placeholder="@(r.IsBalans ? "BLimBanRba" : "WBedKanKan")" /></td>
                                <td class="small text-secondary">@Rekeningindeling.Groep(r with { RgsCode = string.IsNullOrWhiteSpace(bewerk.Rgs) ? null : bewerk.Rgs.Trim() }).Naam</td>
                                <td class="text-nowrap">
                                    <button class="btn btn-sm btn-primary" @onclick="Bewaar">Opslaan</button>
                                    <button class="btn btn-sm btn-link text-secondary" @onclick="() => (bewerk, fouten) = (null, null)">annuleren</button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="@(magWijzigen ? "klikbaar" : null)" @onclick="() => Bewerk(r)" title="@(magWijzigen ? "Naam, btw-code en RGS-code wijzigen" : null)">
                                <td><a href="/a/@Id/grootboek?rekening=@r.Nummer" @onclick:stopPropagation>@r.Nummer</a></td>
                                <td>@r.Naam</td>
                                <td class="text-secondary">@r.BtwCode</td>
                                <td class="text-secondary">@(r.IsBalans ? "balans" : "resultaat")</td>
                                <td class="small">@r.RgsCode</td>
                                <td class="small text-secondary">@Rekeningindeling.Groep(r).Naam</td>
                                <td class="small text-secondary">@Weergave.Tekst(r.Functie)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</AdministratieKader>

@code {
    private Geopend? geopend;
    private Boekhouding.Grootboek.Rekeningschema? schema;
    private string nummer = "";
    private string naam = "";
    private Rekeningsoort soort = Rekeningsoort.Resultaat;
    private string? rgs;
    private string? btw;
    private bool magWijzigen;
    private Bewerking? bewerk;
    private IReadOnlyList<Boekhouding.Btw.BtwCode> codes = [];
    private IReadOnlyList<string>? fouten;

    [Parameter]
    public Guid Id { get; set; }

    private async Task Open(Geopend g)
    {
        geopend = g;
        magWijzigen = g.Kop.Mag(Recht.Boekhouden);
        schema = await Grootboek.Schema(g.Wie, Id);
        codes = (await Btw.Tabel()).Op(DateOnly.FromDateTime(Tijd.GetLocalNow().DateTime));
    }

    private async Task VoegToe()
    {
        var uitkomst = await Grootboek.VoegRekeningToe(geopend!.Wie, Id, new RekeningInvoer(nummer, naam, soort, rgs, btw));
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            nummer = naam = "";
            rgs = btw = null;
            schema = await Grootboek.Schema(geopend.Wie, Id);
        }
    }

    private void Bewerk(Rekening rekening)
    {
        if (magWijzigen)
        {
            (bewerk, fouten) = (new Bewerking { Nummer = rekening.Nummer, Naam = rekening.Naam, Rgs = rekening.RgsCode, Btw = rekening.BtwCode }, null);
        }
    }

    private async Task Bewaar()
    {
        var uitkomst = await Grootboek.WijzigRekening(geopend!.Wie, Id, bewerk!.Nummer, bewerk.Naam, bewerk.Rgs, bewerk.Btw);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            bewerk = null;
            schema = await Grootboek.Schema(geopend.Wie, Id);
        }
    }

    private sealed class Bewerking
    {
        public string Nummer { get; set; } = "";

        public string Naam { get; set; } = "";

        public string? Rgs { get; set; }

        public string? Btw { get; set; }
    }
}
