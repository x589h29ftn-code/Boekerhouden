@page "/a/{Id:guid}/boeking/{Dagboek}/{Boekstuk}"
@using Boekerhouden.Boekhouding.Grootboek
@inject GrootboekDienst Grootboek
@inject BtwDienst Btw

<AdministratieKader Id="Id" Titel="Boeking" Actief="/journaal" BijOpenen="Open">
    <Acties>
        @if (detail?.Document is { } document)
        {
            <a class="btn btn-sm btn-outline-primary" href="/a/@Id/inkoop/@document" title="@detail.Documentnaam">Factuur</a>
            @if (geopend?.Kop.Mag(Recht.Invoeren) == true && detail.Herstelt is null)
            {
                <a class="btn btn-sm btn-outline-secondary" href="/a/@Id/inkoop/@document?aanpassen=true" title="De boeking aanpassen via de factuur">Aanpassen</a>
            }
        }
        else if (detail is { Vast: null } && invoer is null && geopend is not null && MagAanpassen(geopend.Kop))
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="BeginAanpassen">Aanpassen</button>
        }
    </Acties>
    <ChildContent>
        @if (geladen && detail is null)
        {
            <div class="alert alert-warning">Boeking @Dagboek @Boekstuk bestaat niet.</div>
        }
        else if (detail is { Boeking: var b })
        {
            <div class="verwerken">
            <div class="verwerken-formulier">
            <Foutmeldingen Fouten="fouten" />
            @if (bericht is not null)
            {
                <div class="bericht small mb-2">@bericht</div>
            }
            @if (invoer is null)
            {
                <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                    <span class="fw-semibold text-nowrap">@b.Post.Dagboek @b.Post.Boekstuk</span>
                    <span class="text-secondary text-nowrap">@Weergave.Datum(b.Post.Datum)</span>
                    <span class="ms-2">@b.Post.Omschrijving</span>
                    <span class="small text-secondary ms-auto" title="Volgnummer @b.Volgnummer in de keten">
                        @(detail.Versie > 1 ? $"versie {detail.Versie}, aangepast door" : "geboekt door") @b.GeboektDoor, @Weergave.DatumTijd(b.GeboektOp)
                    </span>
                </div>
                @if (detail.Herstelt is { } hersteld)
                {
                    <div class="status mb-2">Tegenboeking van <a href="@Adres(hersteld)">@hersteld</a></div>
                }
                else if (detail is { Vast: { } vast, Document: null })
                {
                    <div class="status mb-2">@vast</div>
                }
                <div class="card overzichtskaart">
                    <table class="table align-middle mb-0 overzichtstabel">
                        <thead>
                            <tr><th>Grootboek</th><th>Omschrijving</th><th>Btw</th><th>Relatie</th><th>Factuur</th><th class="text-end">Debet</th><th class="text-end">Credit</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in b.Post.Regels)
                            {
                                <tr>
                                    <td><a class="text-reset text-decoration-none" href="/a/@Id/grootboek?rekening=@Uri.EscapeDataString(r.Rekeningnummer)&@Weergave.Periodequery(new DateOnly(b.Post.Datum.Year, 1, 1), new DateOnly(b.Post.Datum.Year, 12, 31))"><span class="rekeningnummer">@r.Rekeningnummer</span> @schema?.Zoek(r.Rekeningnummer)?.Naam</a></td>
                                    <td>@(r.Omschrijving ?? b.Post.Omschrijving)</td>
                                    <td class="text-secondary">@r.BtwCode</td>
                                    <td class="text-secondary">@r.Relatie</td>
                                    <td class="text-secondary">@r.Factuurnummer</td>
                                    <td class="bedrag text-end">@(r.Bedrag > 0 ? Bedragen.Getal(r.Bedrag) : null)</td>
                                    <td class="bedrag text-end">@(r.Bedrag < 0 ? Bedragen.Getal(-r.Bedrag) : null)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="generaal">
                                <td colspan="5">Totaal</td>
                                <td class="bedrag text-end">@Bedragen.Getal(b.Post.TotaalDebet)</td>
                                <td class="bedrag text-end">@Bedragen.Getal(b.Post.TotaalDebet)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                @if (detail.Eerder is { Count: > 0 } eerder)
                {
                    <div class="form-check form-switch mt-3 small">
                        <input id="eerder" class="form-check-input" type="checkbox" @bind="toonEerder" />
                        <label class="form-check-label text-secondary" for="eerder">Eerdere versies (@eerder.Count)</label>
                    </div>
                    @if (toonEerder)
                    {
                        @foreach (var v in eerder)
                        {
                            <div class="small text-secondary mt-3 mb-1">
                                Versie @v.Versie · @Weergave.Datum(v.Boeking.Post.Datum) · @v.Boeking.Post.Omschrijving
                                <span class="ms-2" title="Volgnummer @v.Boeking.Volgnummer in de keten">@v.Boeking.GeboektDoor, @Weergave.DatumTijd(v.Boeking.GeboektOp)</span>
                            </div>
                            <div class="card eerdere-versie">
                                <table class="table table-sm align-middle mb-0 overzichtstabel">
                                    <tbody>
                                        @foreach (var r in v.Boeking.Post.Regels)
                                        {
                                            <tr>
                                                <td><span class="rekeningnummer">@r.Rekeningnummer</span> @schema?.Zoek(r.Rekeningnummer)?.Naam</td>
                                                <td>@(r.Omschrijving ?? v.Boeking.Post.Omschrijving)</td>
                                                <td class="text-secondary">@r.BtwCode</td>
                                                <td class="bedrag text-end">@(r.Bedrag > 0 ? Bedragen.Getal(r.Bedrag) : null)</td>
                                                <td class="bedrag text-end">@(r.Bedrag < 0 ? Bedragen.Getal(-r.Bedrag) : null)</td>
                                            </tr>
                                        }
                                        @if (v.Boeking.Post.Regels.Count == 0)
                                        {
                                            <tr><td class="text-secondary">Vervallen</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                }
            }
            else
            {
                <div class="d-flex align-items-center flex-wrap gap-2 mb-2 boeking-aanpassen">
                    <span class="fw-semibold text-nowrap">@b.Post.Dagboek @b.Post.Boekstuk</span>
                    <input type="date" class="form-control form-control-sm veld-datum" @bind="invoer.Datum" disabled="@VasteDatum" aria-label="Datum" title="@(VasteDatum ? "De datum hoort bij het bankafschrift of de openstaande posten" : null)" />
                    <input class="form-control form-control-sm flex-grow-1 w-auto" @bind="invoer.Omschrijving" aria-label="Omschrijving" />
                </div>
                <div class="card overzichtskaart">
                    <table class="table table-sm align-middle mb-0 overzichtstabel regeltabel">
                        <thead>
                            <tr><th style="width:30%">Grootboek</th><th>Omschrijving</th><th style="width:7rem">Btw</th><th class="text-end" style="width:8rem">Debet</th><th class="text-end" style="width:8rem">Credit</th><th style="width:1.75rem"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var regel in invoer.Regels)
                            {
                                @if (regel.Vast)
                                {
                                    <tr title="Hoort bij het bankafschrift of de openstaande posten en blijft gelijk">
                                        <td><span class="rekeningnummer">@regel.Rekening</span> @schema?.Zoek(regel.Rekening)?.Naam</td>
                                        <td class="text-secondary">@string.Join(" ", new[] { regel.Omschrijving, regel.Relatie, regel.Factuurnummer }.Where(x => !string.IsNullOrEmpty(x)))</td>
                                        <td class="text-secondary">@regel.BtwCode</td>
                                        <td class="bedrag text-end">@regel.Debet</td>
                                        <td class="bedrag text-end">@regel.Credit</td>
                                        <td></td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td><RekeningKeuze @bind-Waarde:get="regel.Rekening" @bind-Waarde:set="v => KiesRekening(regel, v)" Schema="schema" Kader="geopend" /></td>
                                        <td><input class="form-control form-control-sm" @bind="regel.Omschrijving" placeholder="@invoer.Omschrijving" aria-label="Omschrijving regel" /></td>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="regel.BtwCode" aria-label="Btw-code">
                                                <option value=""></option>
                                                @foreach (var c in codes.Where(c => c.Actief || c.Code == regel.BtwCode))
                                                {
                                                    <option value="@c.Code" title="@c.Omschrijving">@c.Code</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input class="form-control form-control-sm text-end" @bind="regel.Debet" @bind:event="oninput" aria-label="Debet" /></td>
                                        <td><input class="form-control form-control-sm text-end" @bind="regel.Credit" @bind:event="oninput" aria-label="Credit" /></td>
                                        <td><button class="btn btn-sm btn-link text-secondary p-0 regel-weg" title="Regel verwijderen" @onclick="() => invoer.Regels.Remove(regel)" disabled="@(invoer.Regels.Count <= 2)">×</button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr class="generaal">
                                <td colspan="3"><button class="btn btn-sm btn-link nog-een-regel p-0" @onclick="RegelErbij">+ Nog een regel</button></td>
                                <td class="bedrag text-end">@Bedragen.Getal(invoer.TotaalDebet)</td>
                                <td class="bedrag text-end">@Bedragen.Getal(invoer.TotaalCredit)</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="d-flex align-items-center gap-2 mt-3">
                    <button class="btn btn-primary" @onclick="Opslaan" disabled="@bezig" title="Een tegenboeking en een nieuwe boeking; deze boeking zelf blijft staan">Opslaan</button>
                    <button class="btn btn-link text-secondary" @onclick="Annuleren">Annuleren</button>
                    @if (invoer.TotaalDebet != invoer.TotaalCredit)
                    {
                        <span class="status let-op ms-2">verschil @Bedragen.Getal(invoer.TotaalDebet - invoer.TotaalCredit)</span>
                    }
                </div>
            }
            </div>
            @if (detail.Document is { } document && wie is not null)
            {
                <Factuurbeeld @key="document" Wie="wie" Administratie="Id" Document="document" />
            }
            </div>
        }
    </ChildContent>
</AdministratieKader>

@code {
    private bool geladen;
    private bool bezig;
    private Geopend? geopend;
    private Boekingsdetail? detail;
    private Uitvoerder? wie;
    private Rekeningschema? schema;
    private IReadOnlyList<Boekhouding.Grootboek.Dagboek> dagboeken = [];
    private Invoer? invoer;
    private bool toonEerder;
    private string? bericht;
    private IReadOnlyList<Boekhouding.Btw.BtwCode> codes = [];
    private IReadOnlyList<string>? fouten;

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public string Dagboek { get; set; } = "";

    [Parameter]
    public string Boekstuk { get; set; } = "";

    private bool VasteDatum => invoer?.Regels.Any(r => r.Vast) == true;

    private async Task Open(Geopend g)
    {
        (geopend, wie) = (g, g.Wie);
        await Laad();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Naar een andere boeking (bijv. via een link): dezelfde pagina, andere parameters.
        if (geopend is not null && detail is not null && (detail.Boeking.Post.Dagboek, detail.Boeking.Post.Boekstuk) != (Dagboek, Boekstuk))
        {
            await Laad();
        }
    }

    private async Task Laad()
    {
        detail = await Grootboek.Boeking(geopend!.Wie, Id, Dagboek, Boekstuk);
        schema = await Grootboek.Schema(geopend.Wie, Id);
        dagboeken = await Grootboek.Dagboeken(geopend.Wie, Id);
        (invoer, geladen) = (null, true);
    }

    /// <summary>Net als bij boeken: het memoriaal is voor het kantoor, de andere dagboeken ook voor de ondernemer.</summary>
    private bool MagAanpassen(AdministratieKop kop) =>
        kop.Mag(dagboeken.FirstOrDefault(d => d.Code == Dagboek)?.Soort == Dagboeksoort.Memoriaal ? Recht.Boekhouden : Recht.Invoeren);

    private string Adres(string dagboekBoekstuk) =>
        dagboekBoekstuk.Split(' ', 2) is [var d, var s] ? $"/a/{Id}/boeking/{Uri.EscapeDataString(d)}/{Uri.EscapeDataString(s)}" : "#";

    private async Task BeginAanpassen()
    {
        if (detail is null || schema is null)
        {
            return;
        }

        var post = detail.Boeking.Post;
        codes = (await Btw.Tabel()).Op(post.Datum);
        invoer = new Invoer
        {
            Datum = post.Datum,
            Omschrijving = post.Omschrijving,
            Regels =
            [
                .. post.Regels.Select(r => new Invoerregel
                {
                    Rekening = r.Rekeningnummer,
                    Omschrijving = r.Omschrijving == post.Omschrijving ? null : r.Omschrijving,
                    BtwCode = r.BtwCode,
                    Relatie = r.Relatie,
                    Factuurnummer = r.Factuurnummer,
                    Debet = r.Bedrag > 0 ? Bedragen.Getal(r.Bedrag) : null,
                    Credit = r.Bedrag < 0 ? Bedragen.Getal(-r.Bedrag) : null,
                    Vast = Boekingscorrectie.IsVast(schema.Zoek(r.Rekeningnummer)),
                }),
            ],
        };
        (fouten, bericht) = (null, null);
    }

    private void Annuleren() => (invoer, fouten) = (null, null);

    private void RegelErbij()
    {
        var verschil = invoer!.TotaalDebet - invoer.TotaalCredit;
        invoer.Regels.Add(new Invoerregel
        {
            Debet = verschil < 0 ? Bedragen.Getal(-verschil) : null,
            Credit = verschil > 0 ? Bedragen.Getal(verschil) : null,
        });
    }

    /// <summary>Een rekening voor de regel; hoort er een btw-code bij de rekening, dan komt die mee.</summary>
    private void KiesRekening(Invoerregel regel, string? rekening)
    {
        var nieuw = regel.Rekening != rekening;
        regel.Rekening = rekening ?? "";
        if (nieuw && schema?.Zoek(rekening)?.BtwCode is { } code)
        {
            regel.BtwCode = code;
        }
    }

    private async Task Opslaan()
    {
        var onleesbaar = invoer!.Regels.Select((r, i) => (r, i)).Where(x => !x.r.Leesbaar).Select(x => $"Regel {x.i + 1}: het bedrag is niet te lezen.").ToList();
        if (onleesbaar.Count > 0)
        {
            fouten = onleesbaar;
            return;
        }

        var post = new Journaalpost(Dagboek, Boekstuk, invoer.Datum, invoer.Omschrijving,
            [.. invoer.Regels.Select(r => new Journaalregel(r.Rekening.Trim(), r.Bedrag, Leeg(r.Omschrijving), Leeg(r.BtwCode), Leeg(r.Relatie), Leeg(r.Factuurnummer)))]);
        bezig = true;
        try
        {
            var uitkomst = await Grootboek.PasAan(geopend!.Wie, Id, Dagboek, Boekstuk, post);
            fouten = uitkomst.Fouten;
            if (uitkomst.IsGelukt)
            {
                await Laad();
                bericht = $"Aangepast: versie {uitkomst.Waarde}.";
            }
        }
        finally
        {
            bezig = false;
        }
    }

    private static string? Leeg(string? tekst) => string.IsNullOrWhiteSpace(tekst) ? null : tekst.Trim();

    private static decimal? Getal(string? tekst) =>
        string.IsNullOrWhiteSpace(tekst) ? 0m : BedragParser.TryParse(tekst, out var b) ? b : null;

    private sealed class Invoer
    {
        public DateOnly Datum { get; set; }

        public string Omschrijving { get; set; } = "";

        public List<Invoerregel> Regels { get; set; } = [];

        public decimal TotaalDebet => Regels.Sum(r => Math.Max(r.Bedrag, 0));

        public decimal TotaalCredit => Regels.Sum(r => Math.Max(-r.Bedrag, 0));
    }

    private sealed class Invoerregel
    {
        public string Rekening { get; set; } = "";

        public string? Omschrijving { get; set; }

        public string? BtwCode { get; set; }

        public string? Relatie { get; set; }

        public string? Factuurnummer { get; set; }

        public string? Debet { get; set; }

        public string? Credit { get; set; }

        public bool Vast { get; init; }

        public bool Leesbaar => Getal(Debet) is not null && Getal(Credit) is not null;

        /// <summary>Debet positief, credit negatief.</summary>
        public decimal Bedrag => (Getal(Debet) ?? 0) - (Getal(Credit) ?? 0);
    }
}
