@page "/a/{Id:guid}/verkoop"
@inject VerkoopDienst Verkoop
@inject AbonnementDienst Abonnementen
@inject VerkoopimportDienst Import
@inject NavigationManager Navigatie
@inject Meldingen Meldingen

<AdministratieKader Id="Id" Titel="Verkoop" Actief="/verkoop" BijOpenen="Open">
    <Kenmerken>
        @if (regels is not null)
        {
            var concepten = regels.Count(r => r.Status == Verkoopstatus.Concept);
            var facturen = regels.Count(r => r.Status == Verkoopstatus.Definitief);
            <span>@concepten @(concepten == 1 ? "concept" : "concepten")</span>
            <span class="scheiding">·</span>
            <span>@facturen @(facturen == 1 ? "factuur" : "facturen") in @Periodetekst</span>
            <span class="scheiding">·</span>
            <span>open @Weergave.Bedrag(regels.Sum(r => r.Openstaand ?? 0m))</span>
        }
    </Kenmerken>
    <Acties>
        <PeriodeKeuze Van="van" Tot="tot" Gewijzigd="KiesPeriode" />
        @if (geopend?.Kop.Mag(Recht.Invoeren) == true)
        {
            <label class="btn btn-outline-secondary @(bezig ? "disabled" : null)" for="verkoopbestanden" aria-busy="@(bezig ? "true" : null)" title="Verkoopfacturen uit een ander pakket: PDF, e-factuur (UBL) of scan; slepen op de pagina kan ook">Inlezen</label>
            <a class="btn btn-primary" href="/a/@Id/verkoop/nieuw"><Icoon Naam="plus" /> Nieuwe factuur</a>
        }
    </Acties>
    <ChildContent>
        @if (geopend?.Kop.Mag(Recht.Invoeren) == true)
        {
            <Sleepvlak Id="verkoopbestanden" Pagina="true" Tekst="Verkoopfacturen inlezen" Accept=".pdf,.xml,.jpg,.jpeg,.png,application/pdf,application/xml,text/xml,image/jpeg,image/png" OnChange="LeesIn" Bezig="bezig" />
        }
        @foreach (var u in ingelezen)
        {
            <div class="small mb-1 @(u.Geboekt ? "bericht" : "status let-op d-block")">@u.Melding</div>
        }
        <Foutmeldingen Fouten="bulkfouten" />
        @if (teMaken > 0)
        {
            <div class="bericht mb-3">
                @teMaken terugkerende @(teMaken == 1 ? "factuur" : "facturen") klaar om te maken · <a href="/a/@Id/verkoop/terugkerend">Bekijken en maken</a>
            </div>
        }
        @if (regels is null)
        {
            <Laadschets />
        }
        else if (regels.Count == 0)
        {
            <LegeStaat Icoon="file-text" Tekst="Geen verkoopfacturen in deze periode">
                @if (geopend?.Kop.Mag(Recht.Invoeren) == true)
                {
                    <a class="btn btn-sm btn-outline-primary" href="/a/@Id/verkoop/nieuw">Nieuwe factuur</a>
                }
            </LegeStaat>
        }
        else
        {
            <div class="zoekbalk d-flex align-items-center gap-2 mb-3">
                <input class="form-control form-control-sm zoek-tekst" type="search" placeholder="Zoek op klant, nummer of omschrijving" aria-label="Zoeken" @bind="zoek" @bind:event="oninput" />
                <span class="form-check mb-0 small ms-2">
                    <input class="form-check-input" type="checkbox" id="alleen-open" @bind="alleenOpen" />
                    <label class="form-check-label text-secondary" for="alleen-open">Alleen open</label>
                </span>
            </div>
            var zichtbaar = sortering.Pas(regels.Where(Past)).ToList();
            <div class="card overzichtskaart">
                <table class="table align-middle mb-0 overzichtstabel verkooplijst" data-sleepbaar="verkoop">
                    <thead>
                        <tr>
                            @if (magInvoeren)
                            {
                                <th class="kiesvak" title="Alle concepten kiezen"><input class="form-check-input" type="checkbox" aria-label="Alle concepten kiezen" checked="@AllesGekozen(zichtbaar)" @onchange="e => KiesAlle(zichtbaar, e.Value is true)" /></th>
                            }
                            <SorteerKop Sortering="sortering" Naam="Nummer" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Datum" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Klant" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Omschrijving" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Vervaldatum" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Excl. btw" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Totaal" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Open" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Status" Gewijzigd="StateHasChanged" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in zichtbaar)
                        {
                            <tr class="klikbaar @(gekozen.Contains(r.Id) ? "gekozen" : null)" @onclick="() => Navigatie.NavigateTo(Adres(r))" title="@(r.Status == Verkoopstatus.Concept ? $"Concept, gemaakt {Weergave.Moment(r.AangemaaktOp)}" : "Naar de factuur")">
                                @if (magInvoeren)
                                {
                                    <td class="kiesvak" @onclick:stopPropagation="true">@if (r.Status == Verkoopstatus.Concept)
                                        {
                                            <input class="form-check-input" type="checkbox" aria-label="Kiezen" checked="@gekozen.Contains(r.Id)" @onchange="e => Kies(r.Id, e.Value is true)" />
                                        }</td>
                                }
                                <td class="text-nowrap">@(r.Nummer ?? "")</td>
                                <td class="text-nowrap">@Weergave.Datum(r.Datum)</td>
                                <td title="@r.Relatie">@r.Klant</td>
                                <td class="omschrijving" title="@r.Omschrijving">@r.Omschrijving</td>
                                <td class="text-nowrap @(Vervallen(r) ? "vervallen" : null)">@Weergave.Datum(r.Vervaldatum)</td>
                                <td class="bedrag text-end">@Weergave.Bedrag(r.Exclusief)</td>
                                <td class="bedrag text-end">@Weergave.Bedrag(r.Totaal)</td>
                                <td class="bedrag text-end text-secondary">@(r.Openstaand is { } o and not 0 ? Weergave.Bedrag(o) : null)</td>
                                <td class="text-nowrap">@Stip(r)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="generaal">
                            <td colspan="@(magInvoeren ? 6 : 5)">Totaal (@Aantal(zichtbaar.Count(r => r.Status == Verkoopstatus.Definitief)))</td>
                            <td class="bedrag text-end">@Weergave.Bedrag(zichtbaar.Where(r => r.Status == Verkoopstatus.Definitief).Sum(r => r.Exclusief))</td>
                            <td class="bedrag text-end">@Weergave.Bedrag(zichtbaar.Where(r => r.Status == Verkoopstatus.Definitief).Sum(r => r.Totaal))</td>
                            <td class="bedrag text-end">@Weergave.Bedrag(zichtbaar.Sum(r => r.Openstaand ?? 0m))</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            @if (gekozen.Count > 0)
            {
                <div class="actiebalk">
                    <span>@gekozen.Count @(gekozen.Count == 1 ? "concept" : "concepten") gekozen</span>
                    <button class="btn btn-sm btn-primary" disabled="@bezig" @onclick="MaakDefinitief">Definitief maken</button>
                    <VerwijderKnop Bezig="bezig" Bevestigd="VerwijderGekozen" />
                    <button class="btn btn-sm btn-link text-secondary ms-auto" @onclick="() => gekozen.Clear()">Niets kiezen</button>
                </div>
            }
        }
    </ChildContent>
</AdministratieKader>

@code {
    private Geopend? geopend;
    private DateOnly van;
    private DateOnly tot;
    private DateOnly vandaag;
    private string zoek = "";
    private bool alleenOpen;
    private IReadOnlyList<Verkooplijstregel>? regels;
    private int teMaken;
    private bool bezig;
    private List<Verkoopinleesuitkomst> ingelezen = [];

    private readonly Sortering<Verkooplijstregel> sortering = new(
        new("Nummer", r => r.Nummer ?? "", EerstOplopend: false),
        new("Datum", r => r.Datum, EerstOplopend: false),
        new("Klant", r => r.Klant.ToUpperInvariant()),
        new("Omschrijving", r => r.Omschrijving.ToUpperInvariant()),
        new("Vervaldatum", r => r.Vervaldatum, EerstOplopend: false),
        new("Excl. btw", r => r.Exclusief, EerstOplopend: false),
        new("Totaal", r => r.Totaal, EerstOplopend: false),
        new("Open", r => r.Openstaand ?? 0m, EerstOplopend: false),
        new("Status", r => r.Stand(DateOnly.FromDateTime(DateTime.Today))));

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "van")]
    public string? VanTekst { get; set; }

    [SupplyParameterFromQuery(Name = "tot")]
    public string? TotTekst { get; set; }

    private string Periodetekst => van.Month == 1 && van.Day == 1 && tot == new DateOnly(van.Year, 12, 31) ? van.Year.ToString(System.Globalization.CultureInfo.InvariantCulture) : $"{Weergave.Datum(van)} - {Weergave.Datum(tot)}";

    private async Task Open(Geopend g)
    {
        geopend = g;
        vandaag = DateOnly.FromDateTime(DateTime.Today);
        (van, tot) = Weergave.Periode(VanTekst, TotTekst) ?? Boekhouding.Grootboek.Periode.Jaar(await Verkoop.LaatsteFactuurjaar(g.Wie, Id));
        await Laad();
    }

    private async Task Laad()
    {
        regels = await Verkoop.Lijst(geopend!.Wie, Id, van, tot);
        teMaken = await Abonnementen.TeMaken(geopend.Wie, Id);
        gekozen.IntersectWith(regels.Where(r => r.Status == Verkoopstatus.Concept).Select(r => r.Id));
    }

    // Meerdere concepten tegelijk: kiezen met het vinkje, dan definitief maken of verwijderen (regel voor regel via de
    // gewone dienst, met dezelfde controles en hetzelfde wijzigingslog).
    private readonly HashSet<Guid> gekozen = [];
    private IReadOnlyList<string>? bulkfouten;

    private bool magInvoeren => geopend?.Kop.Mag(Recht.Invoeren) == true;

    private void Kies(Guid id, bool aan)
    {
        if (aan)
        {
            gekozen.Add(id);
        }
        else
        {
            gekozen.Remove(id);
        }
    }

    private bool AllesGekozen(IReadOnlyList<Verkooplijstregel> zichtbaar) =>
        zichtbaar.Any(r => r.Status == Verkoopstatus.Concept) && zichtbaar.Where(r => r.Status == Verkoopstatus.Concept).All(r => gekozen.Contains(r.Id));

    private void KiesAlle(IReadOnlyList<Verkooplijstregel> zichtbaar, bool aan)
    {
        foreach (var r in zichtbaar.Where(r => r.Status == Verkoopstatus.Concept))
        {
            Kies(r.Id, aan);
        }
    }

    private List<Verkooplijstregel> Gekozen => [.. regels!.Where(r => gekozen.Contains(r.Id)).OrderBy(r => r.Datum).ThenBy(r => r.AangemaaktOp)];

    private async Task MaakDefinitief()
    {
        bezig = true;
        var uitkomst = await Bulk.Voer(Gekozen, async r => await Verkoop.MaakDefinitief(geopend!.Wie, Id, r.Id), Naam);
        await NaBulk(uitkomst, "definitief gemaakt");
    }

    private async Task VerwijderGekozen()
    {
        bezig = true;
        var uitkomst = await Bulk.Voer(Gekozen, r => Verkoop.VerwijderConcept(geopend!.Wie, Id, r.Id), Naam);
        await NaBulk(uitkomst, "verwijderd");
    }

    private static string Naam(Verkooplijstregel r) => $"{r.Klant} {r.Omschrijving}".Trim();

    private async Task NaBulk(Bulkuitkomst uitkomst, string wat)
    {
        gekozen.Clear();
        await Laad();
        bezig = false;
        bulkfouten = uitkomst.Fouten;
        Meldingen.Toon($"{uitkomst.Gelukt} {(uitkomst.Gelukt == 1 ? "concept" : "concepten")} {wat}{(uitkomst.Fouten.Count > 0 ? $", {uitkomst.Fouten.Count} niet" : null)}.");
    }

    private async Task KiesPeriode((DateOnly Van, DateOnly Tot) periode)
    {
        (van, tot) = periode;
        Navigatie.NavigateTo($"/a/{Id}/verkoop?{Weergave.Periodequery(van, tot)}", replace: true);
        await Laad();
    }

    private bool Past(Verkooplijstregel r) =>
        (!alleenOpen || r.Openstaand is not (null or 0)) &&
        (zoek.Length == 0 || zoek.Split(' ', StringSplitOptions.RemoveEmptyEntries).All(w =>
            r.Klant.Contains(w, StringComparison.CurrentCultureIgnoreCase) || (r.Nummer?.Contains(w, StringComparison.OrdinalIgnoreCase) ?? false) || r.Omschrijving.Contains(w, StringComparison.CurrentCultureIgnoreCase)));

    private RenderFragment Stip(Verkooplijstregel r) => r.Stand(vandaag) switch
    {
        Verkoopstand.Concept => @<Statusstip Soort="Stipsoort.Open" Titel="@r.Melding">concept</Statusstip>,
        Verkoopstand.Ingelezen => @<Statusstip Soort="@(r.Melding is null ? Stipsoort.Open : Stipsoort.LetOp)" Titel="@r.Melding">ingelezen</Statusstip>,
        Verkoopstand.Vervallen => @<Statusstip Soort="Stipsoort.LetOp" Titel="@($"Vervallen op {Weergave.Datum(r.Vervaldatum)}")">vervallen</Statusstip>,
        Verkoopstand.Open => @<Statusstip Soort="Stipsoort.Open">open</Statusstip>,
        _ => @<Statusstip Soort="Stipsoort.Klaar">betaald</Statusstip>,
    };

    private bool Vervallen(Verkooplijstregel r) => r.Openstaand is > 0 && r.Vervaldatum < vandaag;

    private async Task LeesIn(InputFileChangeEventArgs e)
    {
        bezig = true;
        ingelezen = [];
        foreach (var bestand in e.GetMultipleFiles(250))
        {
            try
            {
                await using var stream = bestand.OpenReadStream(Documenten.PdfTekst.MaximumBytes);
                ingelezen.Add(await Import.Lees(geopend!.Wie, Id, stream, bestand.Name, bestand.ContentType));
            }
            catch (IOException)
            {
                ingelezen.Add(new Verkoopinleesuitkomst(null, false, $"{bestand.Name} is groter dan {Documenten.PdfTekst.MaximumBytes / 1024 / 1024} MB en is niet ingelezen."));
            }

            StateHasChanged();
        }

        bezig = false;
        await Laad();
    }

    private static string Aantal(int n) => n == 1 ? "1 factuur" : $"{n} facturen";

    private string Adres(Verkooplijstregel r) => $"/a/{Id}/verkoop/{r.Id}";
}
