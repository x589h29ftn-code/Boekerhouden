@page "/a/{Id:guid}/instellingen/{Tab?}"
@using Boekerhouden.Boekhouding.Regels
@using Boekerhouden.Boekhouding.Bank
@inject InrichtingDienst Inrichting
@inject GrootboekDienst Grootboek
@inject Meldingen Meldingen
@inject NavigationManager Navigatie

@* Drie tabbladen (en Beginbalans): Gegevens, Btw en belastingen, Verwerken. Elk tabblad bewaart het hele formulier,
   maar laat alleen zijn eigen velden zien; de andere zijn al eerder goed bewaard, dus een fout hoort altijd bij dit
   tabblad. De fiscale indeling staat op Fiscale positie, de loonkoppelingen bij het memoriaal. *@
<AdministratieKader Id="Id" Titel="Instellingen" Actief="@Actief" BijOpenen="Open">
    @if (!context.Mag(Recht.Boekhouden))
    {
        <div class="alert alert-warning">Alleen het kantoor kan de instellingen wijzigen.</div>
    }
    else if (gegevens is not null && instellingen is not null)
    {
        <Foutmeldingen Fouten="fouten" />
        <div class="formulieren">
            @if (Deel == Instellingdeel.Gegevens)
            {
                <Formulierblok Titel="Gegevens">
                    <div class="row g-2">
                        <div class="col-md-3"><label class="form-label" for="klantnummer" title="Het nummer van de klant bij het kantoor; staat vooraan in de lijst met administraties">Klantnummer</label><input id="klantnummer" class="form-control" maxlength="20" @bind="gegevens.Klantnummer" /></div>
                        <div class="col-md-9"><label class="form-label" for="naam">Naam</label><input id="naam" class="form-control" @bind="gegevens.Naam" /></div>
                        <div class="col-md-6"><label class="form-label" for="kvk">KvK-nummer</label><input id="kvk" class="form-control" @bind="gegevens.KvkNummer" /></div>
                    </div>
                </Formulierblok>
                <Formulierblok Titel="Adres en contact">
                    <div class="row g-2">
                        <div class="col-md-6"><label class="form-label" for="straat">Straat en huisnummer</label><input id="straat" class="form-control" @bind="gegevens.Straat" /></div>
                        <div class="col-md-2"><label class="form-label" for="postcode">Postcode</label><input id="postcode" class="form-control" @bind="gegevens.Postcode" /></div>
                        <div class="col-md-3"><label class="form-label" for="plaats">Plaats</label><input id="plaats" class="form-control" @bind="gegevens.Plaats" /></div>
                        <div class="col-md-1"><label class="form-label" for="land">Land</label><input id="land" class="form-control" maxlength="2" placeholder="NL" @bind="gegevens.Land" /></div>
                        <div class="col-md-4"><label class="form-label" for="email">E-mail</label><input id="email" class="form-control" type="email" @bind="gegevens.Email" /></div>
                        <div class="col-md-4"><label class="form-label" for="telefoon">Telefoon</label><input id="telefoon" class="form-control" @bind="gegevens.Telefoon" /></div>
                        <div class="col-md-4"><label class="form-label" for="website">Website</label><input id="website" class="form-control" @bind="gegevens.Website" /></div>
                    </div>
                </Formulierblok>
                <Formulierblok Titel="Bankrekeningen">
                    @if (bankIbans.Count > 0)
                    {
                        <div class="mb-2 bank-ibans">
                            @foreach (var (iban, dagboek) in bankIbans)
                            {
                                <span class="me-3 text-nowrap" title="Van de bank: @dagboek"><span class="rekeningnummer">@Boekhouding.Relaties.Iban.Toon(iban)</span> <span class="text-secondary small">@dagboek</span></span>
                            }
                        </div>
                    }
                    <label class="form-label" for="ibans" title="Rekeningen van de onderneming die geen eigen bankdagboek hebben, bijv. een privérekening of een rekening die niet wordt ingelezen. Zo herkent Sifer ze als eigen rekening. Meerdere scheiden met een komma.">@(bankIbans.Count > 0 ? "Andere eigen rekeningen" : "Eigen bankrekeningen")</label>
                    <input id="ibans" class="form-control" @bind="gegevens.Ibans" placeholder="IBAN's, gescheiden door een komma" />
                </Formulierblok>
            }
            else if (Deel == Instellingdeel.Btw)
            {
                <Formulierblok Titel="Btw">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-6"><label class="form-label" for="btw">Btw-nummer</label><input id="btw" class="form-control" @bind="gegevens.BtwNummer" /></div>
                        <div class="col-md-6 pb-2">
                            <span class="form-check">
                                <input class="form-check-input" type="checkbox" id="btwplichtig" @bind="gegevens.BtwPlichtig" />
                                <label class="form-check-label" for="btwplichtig" title="Aan: de btw wordt apart geboekt (te vorderen en af te dragen) en komt in de btw-aangifte. Uit, bij vrijstelling of de kleineondernemersregeling: inkoop wordt inclusief btw op de kosten geboekt en er is geen btw-aangifte.">Btw-plichtig</label>
                            </span>
                        </div>
                    </div>
                </Formulierblok>
                <Formulierblok Titel="Betalingen aan de Belastingdienst">
                    @* Leeg = de rekening die Sifer zelf kiest (grijs in het veld); een rekening kiezen overschrijft die. *@
                    <div class="row g-2 belastingrekeningen">
                        @foreach (var (soort, naam) in Belastingen)
                        {
                            var s = soort;
                            <div class="col-md-6">
                                <label class="form-label" title="Op deze rekening boekt Sifer een betaling van @naam.ToLowerInvariant() aan de Belastingdienst. Leeg laten: de grijze standaardrekening.">@naam</label>
                                <RekeningKeuze Waarde="@belasting.Van(s)" WaardeChanged="w => belasting.Zet(s, w)" Schema="schema" Kader="geopend" Label="@($"Rekening {naam.ToLowerInvariant()}")" Klasse="form-control" Placeholder="@Standaard(s, context.Ondernemingsvorm)" />
                            </div>
                        }
                        <div class="col-12">
                            <span class="form-check">
                                <input class="form-check-input" type="checkbox" id="belasting-automatisch" @bind="belasting.Automatisch" />
                                <label class="form-check-label" for="belasting-automatisch" title="Een betaling aan de Belastingdienst met een geldig betalingskenmerk boekt Sifer zelf, op de rekening hierboven. Uit: hij staat klaar om na te kijken.">Betalingen met een geldig betalingskenmerk vanzelf boeken</label>
                            </span>
                        </div>
                    </div>
                </Formulierblok>
            }
            else
            {
                <InstellingenVelden Invoer="instellingen" Kantoor="kantoor" MetDocumentmap="false" Gegroepeerd="true" Schema="schema" Kader="geopend" />
                <Formulierblok Titel="Documenten">
                    <Documentmapveld Invoer="instellingen" Kantoor="kantoor" Label="Map voor facturen" Administratie="@gegevens.Naam" />
                </Formulierblok>
            }
            <Opslaanbalk Gewijzigd="Gewijzigd" Opgeslagen="opgeslagen" Bezig="bezig" Opslaan="Bewaar" Herstel="Herstel" />
        </div>
    }
</AdministratieKader>

@code {
    private Geopend? geopend;
    private Gegevens? gegevens;
    private InstellingenInvoer? instellingen;
    private Verwerkingsinstellingen? kantoor;
    private Belastingformulier belasting = new();
    private Boekhouding.Grootboek.Rekeningschema? schema;
    private IReadOnlyList<(string Iban, string Dagboek)> bankIbans = [];
    private IReadOnlyList<string> opgeslagenIbans = [];

    /// <summary>
    /// De eigen IBAN's om te bewaren: wat in het veld staat, en de IBAN's van de bankdagboeken die er al in stonden
    /// (die staan niet in het veld, maar horen er wel bij).
    /// </summary>
    private List<string> Ibans()
    {
        var vanBank = bankIbans.Select(b => b.Iban).ToHashSet(StringComparer.Ordinal);
        return [.. opgeslagenIbans.Where(x => vanBank.Contains(Boekhouding.Relaties.Iban.Normaliseer(x))), .. gegevens!.Ibans.Split(',', ';')];
    }

    private enum Instellingdeel
    {
        Gegevens,
        Btw,
        Verwerken,
    }

    /// <summary>Het tabblad uit het adres: leeg (Gegevens), <c>btw</c> of <c>verwerken</c>. Een parameter, zodat Blazor de pagina opnieuw tekent bij een ander tabblad.</summary>
    [Parameter]
    public string? Tab { get; set; }

    private Instellingdeel Deel => Tab?.ToLowerInvariant() switch
    {
        "btw" => Instellingdeel.Btw,
        "verwerken" => Instellingdeel.Verwerken,
        _ => Instellingdeel.Gegevens,
    };

    private string Actief => Deel switch
    {
        Instellingdeel.Btw => "/instellingen/btw",
        Instellingdeel.Verwerken => "/instellingen/verwerken",
        _ => "/instellingen",
    };
    private IReadOnlyList<string>? fouten;
    private string? vorige;
    private bool opgeslagen;
    private bool bezig;

    [Parameter]
    public Guid Id { get; set; }

    private async Task Open(Geopend g)
    {
        geopend = g;
        if (!g.Kop.Mag(Recht.Boekhouden))
        {
            return;
        }

        var i = await Inrichting.Instellingen(g.Wie, Id);
        bankIbans = await Grootboek.BankIbans(g.Wie, Id);

        // De IBAN's van de bankdagboeken staan er al (boven het veld); in het veld alleen de andere eigen rekeningen.
        var vanBank = bankIbans.Select(b => b.Iban).ToHashSet(StringComparer.Ordinal);
        opgeslagenIbans = i.Ibans;
        var andere = i.Ibans.Where(x => !vanBank.Contains(Boekhouding.Relaties.Iban.Normaliseer(x)));
        gegevens = new Gegevens { Klantnummer = i.Klantnummer, Naam = i.Naam, KvkNummer = i.KvkNummer, BtwNummer = i.BtwNummer, Ibans = string.Join(", ", andere), BtwPlichtig = i.BtwPlichtig };
        if (i.Contact is { } c)
        {
            (gegevens.Straat, gegevens.Postcode, gegevens.Plaats, gegevens.Land) = (c.Straat, c.Postcode, c.Plaats, c.Land);
            (gegevens.Email, gegevens.Telefoon, gegevens.Website) = (c.Email, c.Telefoon, c.Website);
        }

        instellingen = InstellingenInvoer.Van(i.Afwijkend);
        belasting = Belastingformulier.Van(i.Belasting ?? Belastinginstellingen.Leeg);
        schema = await Grootboek.Schema(g.Wie, Id);
        kantoor = i.Kantoor;
        vorige = Stand();
    }

    /// <summary>Alles wat in het formulier staat, om te zien of er iets is gewijzigd.</summary>
    private string Stand() => System.Text.Json.JsonSerializer.Serialize(new object?[] { gegevens, instellingen, belasting });

    private bool Gewijzigd => vorige is not null && Stand() != vorige;

    private async Task Herstel()
    {
        (fouten, opgeslagen) = (null, false);
        await Open(geopend!);
    }

    private async Task Bewaar()
    {
        var lijst = new List<string>();
        var afwijkend = instellingen!.NaarAfwijkend(lijst);
        if (lijst.Count > 0)
        {
            (fouten, opgeslagen) = (lijst, false);
            return;
        }

        bezig = true;
        var uitkomst = await Inrichting.WijzigInstellingen(geopend!.Wie, Id,
            new Instellingen(gegevens!.Naam, gegevens.KvkNummer, gegevens.BtwNummer, Ibans(), afwijkend,
                Contact: new Contactgegevens(gegevens.Straat, gegevens.Postcode, gegevens.Plaats, gegevens.Land, gegevens.Email, gegevens.Telefoon, gegevens.Website), BtwPlichtig: gegevens.BtwPlichtig, Belasting: belasting.Naar(), Klantnummer: gegevens.Klantnummer));
        bezig = false;
        (fouten, opgeslagen) = (uitkomst.Fouten, uitkomst.IsGelukt);
        if (uitkomst.IsGelukt)
        {
            // Op hetzelfde tabblad blijven (het volgende tabblad is één klik), met de bevestiging linksonder.
            vorige = Stand();
            Meldingen.Toon("De instellingen zijn opgeslagen.");
        }
    }

    private sealed class Belastingformulier
    {
        public string? Omzetbelasting { get; set; }

        public string? Loonheffingen { get; set; }

        public string? Vennootschapsbelasting { get; set; }

        public string? Inkomstenbelasting { get; set; }

        public string? Motorrijtuigenbelasting { get; set; }

        public bool Automatisch { get; set; }

        public static Belastingformulier Van(Belastinginstellingen b) => new()
        {
            Omzetbelasting = b.Omzetbelasting,
            Loonheffingen = b.Loonheffingen,
            Vennootschapsbelasting = b.Vennootschapsbelasting,
            Inkomstenbelasting = b.Inkomstenbelasting,
            Motorrijtuigenbelasting = b.Motorrijtuigenbelasting,
            Automatisch = b.Automatisch,
        };

        public Belastinginstellingen Naar() => new(Omzetbelasting, Loonheffingen, Vennootschapsbelasting, Inkomstenbelasting, Automatisch, Motorrijtuigenbelasting);

        public string? Van(Belastingsoort soort) => soort switch
        {
            Belastingsoort.Omzetbelasting => Omzetbelasting,
            Belastingsoort.Loonheffingen => Loonheffingen,
            Belastingsoort.Vennootschapsbelasting => Vennootschapsbelasting,
            Belastingsoort.Inkomstenbelasting => Inkomstenbelasting,
            _ => Motorrijtuigenbelasting,
        };

        public void Zet(Belastingsoort soort, string? rekening)
        {
            switch (soort)
            {
                case Belastingsoort.Omzetbelasting: Omzetbelasting = rekening; break;
                case Belastingsoort.Loonheffingen: Loonheffingen = rekening; break;
                case Belastingsoort.Vennootschapsbelasting: Vennootschapsbelasting = rekening; break;
                case Belastingsoort.Inkomstenbelasting: Inkomstenbelasting = rekening; break;
                default: Motorrijtuigenbelasting = rekening; break;
            }
        }
    }

    /// <summary>De belastingen in het blok Betalingen aan de Belastingdienst, in deze volgorde.</summary>
    private static readonly (Belastingsoort Soort, string Naam)[] Belastingen =
    [
        (Belastingsoort.Omzetbelasting, "Omzetbelasting"),
        (Belastingsoort.Loonheffingen, "Loonheffingen"),
        (Belastingsoort.Vennootschapsbelasting, "Vennootschapsbelasting"),
        (Belastingsoort.Inkomstenbelasting, "Inkomstenbelasting"),
        (Belastingsoort.Motorrijtuigenbelasting, "Motorrijtuigenbelasting"),
    ];

    /// <summary>De rekening die Sifer zelf kiest, als grijze tekst: "standaard 1810 Af te dragen btw", of "kies een rekening".</summary>
    private string Standaard(Belastingsoort soort, Boekhouding.Grootboek.Ondernemingsvorm vorm) =>
        schema is not null && Belastingherkenning.Standaardrekening(soort, schema, vorm) is { } r ? $"standaard {r.Nummer} {r.Naam}" : "kies een rekening";

    private sealed class Gegevens
    {
        public string? Klantnummer { get; set; }

        public string Naam { get; set; } = "";

        public string? KvkNummer { get; set; }

        public string? BtwNummer { get; set; }

        public string Ibans { get; set; } = "";

        public bool BtwPlichtig { get; set; } = true;

        public string? Straat { get; set; }

        public string? Postcode { get; set; }

        public string? Plaats { get; set; }

        public string? Land { get; set; }

        public string? Email { get; set; }

        public string? Telefoon { get; set; }

        public string? Website { get; set; }
    }
}
