@page "/a/{Id:guid}/instellingen"
@using Boekerhouden.Boekhouding.Regels
@inject InrichtingDienst Inrichting

<AdministratieKader Id="Id" Titel="Instellingen" Actief="/instellingen" BijOpenen="Open">
    @if (!context.Mag(Recht.Boekhouden))
    {
        <div class="alert alert-warning">De instellingen zijn voor het kantoor.</div>
    }
    else if (gegevens is not null && instellingen is not null)
    {
        <Foutmeldingen Fouten="fouten" />
        @if (bericht is not null)
        {
            <div class="bericht mb-2">@bericht</div>
        }
        <div class="card card-body" style="max-width: 52rem">
            <div class="row g-2 mb-3">
                <div class="col-12"><label class="form-label" for="naam">Naam</label><input id="naam" class="form-control" @bind="gegevens.Naam" /></div>
                <div class="col-md-6"><label class="form-label" for="kvk">KvK-nummer</label><input id="kvk" class="form-control" @bind="gegevens.KvkNummer" /></div>
                <div class="col-md-6"><label class="form-label" for="btw">Btw-nummer</label><input id="btw" class="form-control" @bind="gegevens.BtwNummer" /></div>
                <div class="col-12"><label class="form-label" for="ibans">Eigen bankrekeningen (IBAN's, gescheiden door komma's)</label><input id="ibans" class="form-control" @bind="gegevens.Ibans" /></div>
                <div class="col-md-6"><label class="form-label" for="straat">Straat en huisnummer</label><input id="straat" class="form-control" @bind="gegevens.Straat" /></div>
                <div class="col-md-2"><label class="form-label" for="postcode">Postcode</label><input id="postcode" class="form-control" @bind="gegevens.Postcode" /></div>
                <div class="col-md-3"><label class="form-label" for="plaats">Plaats</label><input id="plaats" class="form-control" @bind="gegevens.Plaats" /></div>
                <div class="col-md-1"><label class="form-label" for="land">Land</label><input id="land" class="form-control" maxlength="2" placeholder="NL" @bind="gegevens.Land" /></div>
                <div class="col-md-4"><label class="form-label" for="email">E-mail</label><input id="email" class="form-control" type="email" @bind="gegevens.Email" /></div>
                <div class="col-md-4"><label class="form-label" for="telefoon">Telefoon</label><input id="telefoon" class="form-control" @bind="gegevens.Telefoon" /></div>
                <div class="col-md-4"><label class="form-label" for="website">Website</label><input id="website" class="form-control" @bind="gegevens.Website" /></div>
            </div>
            <div class="mb-3">
                <InstellingenVelden Invoer="instellingen" Kantoor="kantoor" />
            </div>
            <div><button class="btn btn-primary" @onclick="Bewaar">Opslaan</button></div>
        </div>
    }
</AdministratieKader>

@code {
    private Geopend? geopend;
    private Gegevens? gegevens;
    private InstellingenInvoer? instellingen;
    private Verwerkingsinstellingen? kantoor;
    private IReadOnlyList<string>? fouten;
    private string? bericht;

    [Parameter]
    public Guid Id { get; set; }

    private async Task Open(Geopend g)
    {
        geopend = g;
        if (!g.Kop.Mag(Recht.Boekhouden))
        {
            return;
        }

        var i = await Inrichting.Instellingen(g.Wie, Id);
        gegevens = new Gegevens { Naam = i.Naam, KvkNummer = i.KvkNummer, BtwNummer = i.BtwNummer, Ibans = string.Join(", ", i.Ibans) };
        if (i.Contact is { } c)
        {
            (gegevens.Straat, gegevens.Postcode, gegevens.Plaats, gegevens.Land) = (c.Straat, c.Postcode, c.Plaats, c.Land);
            (gegevens.Email, gegevens.Telefoon, gegevens.Website) = (c.Email, c.Telefoon, c.Website);
        }

        instellingen = InstellingenInvoer.Van(i.Afwijkend);
        kantoor = i.Kantoor;
    }

    private async Task Bewaar()
    {
        var lijst = new List<string>();
        var afwijkend = instellingen!.NaarAfwijkend(lijst);
        if (lijst.Count > 0)
        {
            fouten = lijst;
            bericht = null;
            return;
        }

        var uitkomst = await Inrichting.WijzigInstellingen(geopend!.Wie, Id,
            new Instellingen(gegevens!.Naam, gegevens.KvkNummer, gegevens.BtwNummer, [.. gegevens.Ibans.Split(',', ';')], afwijkend,
                Contact: new Contactgegevens(gegevens.Straat, gegevens.Postcode, gegevens.Plaats, gegevens.Land, gegevens.Email, gegevens.Telefoon, gegevens.Website)));
        fouten = uitkomst.Fouten;
        bericht = uitkomst.IsGelukt ? $"Instellingen van {gegevens.Naam} opgeslagen." : null;
    }

    private sealed class Gegevens
    {
        public string Naam { get; set; } = "";

        public string? KvkNummer { get; set; }

        public string? BtwNummer { get; set; }

        public string Ibans { get; set; } = "";

        public string? Straat { get; set; }

        public string? Postcode { get; set; }

        public string? Plaats { get; set; }

        public string? Land { get; set; }

        public string? Email { get; set; }

        public string? Telefoon { get; set; }

        public string? Website { get; set; }
    }
}
