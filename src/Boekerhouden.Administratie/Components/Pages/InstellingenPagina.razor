@page "/a/{Id:guid}/instellingen"
@using Boekerhouden.Boekhouding.Regels
@inject InrichtingDienst Inrichting
@inject GrootboekDienst Grootboek

<AdministratieKader Id="Id" Titel="Instellingen" Actief="/instellingen" BijOpenen="Open">
    @if (!context.Mag(Recht.Boekhouden))
    {
        <div class="alert alert-warning">De instellingen zijn voor het kantoor.</div>
    }
    else if (gegevens is not null && instellingen is not null)
    {
        <Foutmeldingen Fouten="fouten" />
        <div class="formulieren">
            <Formulierblok Titel="Gegevens">
                <div class="row g-2">
                    <div class="col-12"><label class="form-label" for="naam">Naam</label><input id="naam" class="form-control" @bind="gegevens.Naam" /></div>
                    <div class="col-md-6"><label class="form-label" for="kvk">KvK-nummer</label><input id="kvk" class="form-control" @bind="gegevens.KvkNummer" /></div>
                    <div class="col-md-6"><label class="form-label" for="btw">Btw-nummer</label><input id="btw" class="form-control" @bind="gegevens.BtwNummer" /></div>
                    <div class="col-12">
                        <span class="form-check">
                            <input class="form-check-input" type="checkbox" id="btwplichtig" @bind="gegevens.BtwPlichtig" />
                            <label class="form-check-label" for="btwplichtig">Btw-plichtig</label>
                        </span>
                    </div>
                    <div class="col-12"><label class="form-label" for="ibans">Eigen bankrekeningen (IBAN's, gescheiden door komma's)</label><input id="ibans" class="form-control" @bind="gegevens.Ibans" /></div>
                </div>
            </Formulierblok>
            <Formulierblok Titel="Adres en contact">
                <div class="row g-2">
                    <div class="col-md-6"><label class="form-label" for="straat">Straat en huisnummer</label><input id="straat" class="form-control" @bind="gegevens.Straat" /></div>
                    <div class="col-md-2"><label class="form-label" for="postcode">Postcode</label><input id="postcode" class="form-control" @bind="gegevens.Postcode" /></div>
                    <div class="col-md-3"><label class="form-label" for="plaats">Plaats</label><input id="plaats" class="form-control" @bind="gegevens.Plaats" /></div>
                    <div class="col-md-1"><label class="form-label" for="land">Land</label><input id="land" class="form-control" maxlength="2" placeholder="NL" @bind="gegevens.Land" /></div>
                    <div class="col-md-4"><label class="form-label" for="email">E-mail</label><input id="email" class="form-control" type="email" @bind="gegevens.Email" /></div>
                    <div class="col-md-4"><label class="form-label" for="telefoon">Telefoon</label><input id="telefoon" class="form-control" @bind="gegevens.Telefoon" /></div>
                    <div class="col-md-4"><label class="form-label" for="website">Website</label><input id="website" class="form-control" @bind="gegevens.Website" /></div>
                </div>
            </Formulierblok>
            <Formulierblok Titel="Belastingdienst">
                <div class="row g-2 belastingrekeningen">
                    <div class="col-md-6"><label class="form-label">Omzetbelasting</label><RekeningKeuze @bind-Waarde="belasting.Omzetbelasting" Schema="schema" Kader="geopend" Label="Rekening omzetbelasting" Klasse="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Loonheffingen</label><RekeningKeuze @bind-Waarde="belasting.Loonheffingen" Schema="schema" Kader="geopend" Label="Rekening loonheffingen" Klasse="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Vennootschapsbelasting</label><RekeningKeuze @bind-Waarde="belasting.Vennootschapsbelasting" Schema="schema" Kader="geopend" Label="Rekening vennootschapsbelasting" Klasse="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Inkomstenbelasting</label><RekeningKeuze @bind-Waarde="belasting.Inkomstenbelasting" Schema="schema" Kader="geopend" Label="Rekening inkomstenbelasting" Klasse="form-control" /></div>
                    <div class="col-12">
                        <span class="form-check">
                            <input class="form-check-input" type="checkbox" id="belasting-automatisch" @bind="belasting.Automatisch" />
                            <label class="form-check-label" for="belasting-automatisch">Automatisch boeken bij een geldig betalingskenmerk</label>
                        </span>
                    </div>
                </div>
            </Formulierblok>
            <Formulierblok Titel="Verwerken">
                <InstellingenVelden Invoer="instellingen" Kantoor="kantoor" />
            </Formulierblok>
            <Opslaanbalk Gewijzigd="Gewijzigd" Opgeslagen="opgeslagen" Bezig="bezig" Opslaan="Bewaar" Herstel="Herstel" />
        </div>
    }
</AdministratieKader>

@code {
    private Geopend? geopend;
    private Gegevens? gegevens;
    private InstellingenInvoer? instellingen;
    private Verwerkingsinstellingen? kantoor;
    private Belastingformulier belasting = new();
    private Boekhouding.Grootboek.Rekeningschema? schema;
    private IReadOnlyList<string>? fouten;
    private string? vorige;
    private bool opgeslagen;
    private bool bezig;

    [Parameter]
    public Guid Id { get; set; }

    private async Task Open(Geopend g)
    {
        geopend = g;
        if (!g.Kop.Mag(Recht.Boekhouden))
        {
            return;
        }

        var i = await Inrichting.Instellingen(g.Wie, Id);
        gegevens = new Gegevens { Naam = i.Naam, KvkNummer = i.KvkNummer, BtwNummer = i.BtwNummer, Ibans = string.Join(", ", i.Ibans), BtwPlichtig = i.BtwPlichtig };
        if (i.Contact is { } c)
        {
            (gegevens.Straat, gegevens.Postcode, gegevens.Plaats, gegevens.Land) = (c.Straat, c.Postcode, c.Plaats, c.Land);
            (gegevens.Email, gegevens.Telefoon, gegevens.Website) = (c.Email, c.Telefoon, c.Website);
        }

        instellingen = InstellingenInvoer.Van(i.Afwijkend);
        belasting = Belastingformulier.Van(i.Belasting ?? Belastinginstellingen.Leeg);
        schema = await Grootboek.Schema(g.Wie, Id);
        kantoor = i.Kantoor;
        vorige = Stand();
    }

    /// <summary>Alles wat in het formulier staat, om te zien of er iets is gewijzigd.</summary>
    private string Stand() => System.Text.Json.JsonSerializer.Serialize(new object?[] { gegevens, instellingen, belasting });

    private bool Gewijzigd => vorige is not null && Stand() != vorige;

    private async Task Herstel()
    {
        (fouten, opgeslagen) = (null, false);
        await Open(geopend!);
    }

    private async Task Bewaar()
    {
        var lijst = new List<string>();
        var afwijkend = instellingen!.NaarAfwijkend(lijst);
        if (lijst.Count > 0)
        {
            (fouten, opgeslagen) = (lijst, false);
            return;
        }

        bezig = true;
        var uitkomst = await Inrichting.WijzigInstellingen(geopend!.Wie, Id,
            new Instellingen(gegevens!.Naam, gegevens.KvkNummer, gegevens.BtwNummer, [.. gegevens.Ibans.Split(',', ';')], afwijkend,
                Contact: new Contactgegevens(gegevens.Straat, gegevens.Postcode, gegevens.Plaats, gegevens.Land, gegevens.Email, gegevens.Telefoon, gegevens.Website), BtwPlichtig: gegevens.BtwPlichtig, Belasting: belasting.Naar()));
        bezig = false;
        (fouten, opgeslagen) = (uitkomst.Fouten, uitkomst.IsGelukt);
        if (uitkomst.IsGelukt)
        {
            vorige = Stand();
        }
    }

    private sealed class Belastingformulier
    {
        public string? Omzetbelasting { get; set; }

        public string? Loonheffingen { get; set; }

        public string? Vennootschapsbelasting { get; set; }

        public string? Inkomstenbelasting { get; set; }

        public bool Automatisch { get; set; }

        public static Belastingformulier Van(Belastinginstellingen b) => new()
        {
            Omzetbelasting = b.Omzetbelasting,
            Loonheffingen = b.Loonheffingen,
            Vennootschapsbelasting = b.Vennootschapsbelasting,
            Inkomstenbelasting = b.Inkomstenbelasting,
            Automatisch = b.Automatisch,
        };

        public Belastinginstellingen Naar() => new(Omzetbelasting, Loonheffingen, Vennootschapsbelasting, Inkomstenbelasting, Automatisch);
    }

    private sealed class Gegevens
    {
        public string Naam { get; set; } = "";

        public string? KvkNummer { get; set; }

        public string? BtwNummer { get; set; }

        public string Ibans { get; set; } = "";

        public bool BtwPlichtig { get; set; } = true;

        public string? Straat { get; set; }

        public string? Postcode { get; set; }

        public string? Plaats { get; set; }

        public string? Land { get; set; }

        public string? Email { get; set; }

        public string? Telefoon { get; set; }

        public string? Website { get; set; }
    }
}
