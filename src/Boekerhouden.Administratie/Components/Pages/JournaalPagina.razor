@page "/a/{Id:guid}/journaal"
@inject GrootboekDienst Grootboek
@inject NavigationManager Navigatie

<AdministratieKader Id="Id" Titel="Journaal" Actief="/journaal" BijOpenen="Open" KopVast="true">
    <Kenmerken>
        @if (posten is not null)
        {
            var gevonden = Gevonden.Count;
            <span>@(gevonden == posten.Count ? $"{posten.Count}" : $"{gevonden} van {posten.Count}") @(posten.Count == 1 ? "boeking" : "boekingen")</span>
        }
    </Kenmerken>
    <Acties>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Controleer" title="Is er buiten de app iets gewijzigd?">Keten controleren</button>
        @if (geopend is not null)
        {
            <PeriodeKeuze Van="van" Tot="tot" Gewijzigd="KiesPeriode" />
        }
    </Acties>
    <ChildContent>
        @if (keten is not null)
        {
            <div class="bericht mb-3">
                @if (keten.Count == 0)
                {
                    <span class="vinkje-in"><Icoon Naam="circle-check" /> De keten is heel.</span>
                }
                else
                {
                    <span class="status fout">De keten breekt bij volgnummer @string.Join(", ", keten).</span>
                }
            </div>
        }
        @if (posten is { Count: > 0 })
        {
            <div class="d-flex align-items-center gap-2 mb-2 onderkop">
                <select class="form-select form-select-sm w-auto" aria-label="Dagboek" @bind="dagboek">
                    <option value="">Alle dagboeken</option>
                    @foreach (var d in posten.Select(p => p.Post.Dagboek).Distinct().Order())
                    {
                        <option value="@d">@d</option>
                    }
                </select>
                <input class="form-control form-control-sm kaartzoeken" placeholder="Zoeken op omschrijving, boekstuk, rekening, bedrag, relatie of factuurnummer" aria-label="Zoeken"
                       @bind="zoek" @bind:event="oninput" />
            </div>
        }
        @if (posten is { Count: 0 })
        {
            <LegeStaat Icoon="file-text" Tekst="Geen boekingen in deze periode" />
        }
        else if (posten is not null && Gevonden.Count == 0)
        {
            <LegeStaat Icoon="search" Tekst="Geen boekingen gevonden">
                @if (!AlleJaren)
                {
                    <button class="btn btn-sm btn-outline-primary alle-jaren" @onclick="ZoekInAlleJaren">Zoeken in alle boekjaren</button>
                }
            </LegeStaat>
        }
        else if (posten is not null)
        {
            <div class="card">
                <table class="table table-sm align-middle mb-0" data-sleepbaar="journaal">
                    <thead>
                        <tr>
                            <SorteerKop Sortering="sortering" Naam="#" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Datum" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Dagboek" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Boekstuk" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Omschrijving" Klasse="rekt" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Bedrag" Klasse="text-end" Gewijzigd="StateHasChanged" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in sortering.Pas(Gevonden))
                        {
                            <tr class="klikbaar" @onclick="() => OpenBoeking(p)" title="Openen: bekijken of aanpassen">
                                <td class="text-secondary text-nowrap" title="Geboekt door @p.GeboektDoor op @Weergave.DatumTijd(p.GeboektOp)">
                                    <button type="button" class="btn btn-sm btn-link text-secondary p-0 me-1 regels-tonen" title="Regels tonen" aria-label="Regels tonen" @onclick="() => Wissel(p.Volgnummer)" @onclick:stopPropagation="true"><Icoon Naam="@(open.Contains(p.Volgnummer) ? "chevron-down" : "chevron-right")" /></button>@p.Volgnummer
                                </td>
                                <td class="text-nowrap">@Weergave.Datum(p.Post.Datum)</td>
                                <td>@p.Post.Dagboek</td>
                                <td class="text-nowrap">@p.Post.Boekstuk</td>
                                <td class="text-truncate" title="@p.Post.Omschrijving">@p.Post.Omschrijving</td>
                                <td class="bedrag text-end">@Weergave.Bedrag(p.Post.TotaalDebet)</td>
                            </tr>
                            @if (open.Contains(p.Volgnummer))
                            {
                                @foreach (var r in p.Post.Regels)
                                {
                                    <tr class="small">
                                        <td></td>
                                        <td colspan="3" class="text-secondary"><a href="/a/@Id/grootboek?rekening=@Uri.EscapeDataString(r.Rekeningnummer)&@Weergave.Periodequery(van, tot)" title="De grootboekkaart van deze rekening">@r.Rekeningnummer @schema?.Zoek(r.Rekeningnummer)?.Naam</a></td>
                                        <td class="text-secondary">@r.Omschrijving @r.BtwCode</td>
                                        <td class="bedrag text-end">@Weergave.Bedrag(r.Bedrag)</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
</AdministratieKader>

@code {
    private Geopend? geopend;
    private IReadOnlyList<GeboektePost>? posten;

    private readonly Sortering<GeboektePost> sortering = new(
        new("#", p => p.Volgnummer, EerstOplopend: false),
        new("Datum", p => p.Post.Datum, EerstOplopend: false),
        new("Dagboek", p => p.Post.Dagboek),
        new("Boekstuk", p => p.Post.Boekstuk),
        new("Omschrijving", p => p.Post.Omschrijving.ToUpperInvariant()),
        new("Bedrag", p => p.Post.TotaalDebet, EerstOplopend: false));
    private IReadOnlyList<long>? keten;
    private Boekhouding.Grootboek.Rekeningschema? schema;
    private string? zoek;
    private string dagboek = "";

    /// <summary>De boekingen die bij het dagboek en de zoektekst passen.</summary>
    private IReadOnlyList<GeboektePost> Gevonden =>
        [.. (posten ?? []).Where(p => (dagboek.Length == 0 || p.Post.Dagboek == dagboek) && Boekhouding.Grootboek.Journaalzoeker.Past(p.Post, zoek, schema))];
    private readonly HashSet<long> open = [];
    private DateOnly van;
    private DateOnly tot;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "van")]
    public string? VanTekst { get; set; }

    [SupplyParameterFromQuery(Name = "tot")]
    public string? TotTekst { get; set; }

    /// <summary>Standaard het laatste boekjaar: na jaren boeken staan er tienduizenden boekingen in het journaal.</summary>
    private async Task Open(Geopend g)
    {
        geopend = g;
        schema = await Grootboek.Schema(g.Wie, Id);
        boekjaren = await Grootboek.Boekjaren(g.Wie, Id);
        (van, tot) = Weergave.Periode(VanTekst, TotTekst) ?? Boekhouding.Grootboek.Periode.Jaar(boekjaren[0]);
        await Laad();
    }

    private async Task Laad() => posten = await Grootboek.Posten(geopend!.Wie, Id, van: van, tot: tot);

    private async Task KiesPeriode((DateOnly Van, DateOnly Tot) periode)
    {
        (van, tot) = periode;
        Navigatie.NavigateTo($"/a/{Id}/journaal?{Weergave.Periodequery(van, tot)}", replace: true);
        open.Clear();
        await Laad();
    }

    private async Task Controleer() => keten = await Grootboek.ControleerKeten(geopend!.Wie, Id);

    /// <summary>De boeking openen (bekijken of aanpassen); de terugknop brengt je weer hier, in dezelfde periode.</summary>
    private void OpenBoeking(GeboektePost p) =>
        Navigatie.NavigateTo($"/a/{Id}/boeking/{Uri.EscapeDataString(p.Post.Dagboek)}/{Uri.EscapeDataString(p.Post.Boekstuk)}?terug={Uri.EscapeDataString($"/a/{Id}/journaal?{Weergave.Periodequery(van, tot)}")}");

    private IReadOnlyList<int>? boekjaren;

    /// <summary>Staat de periode al op alle boekjaren?</summary>
    private bool AlleJaren => boekjaren is { Count: > 0 } j && van <= new DateOnly(j.Min(), 1, 1) && tot >= new DateOnly(j.Max(), 12, 31);

    /// <summary>Niets gevonden in deze periode: dezelfde zoekopdracht over alle boekjaren.</summary>
    private async Task ZoekInAlleJaren()
    {
        boekjaren ??= await Grootboek.Boekjaren(geopend!.Wie, Id);
        await KiesPeriode((new DateOnly(boekjaren.Min(), 1, 1), new DateOnly(boekjaren.Max(), 12, 31)));
    }

    private void Wissel(long volgnummer)
    {
        if (!open.Remove(volgnummer))
        {
            open.Add(volgnummer);
        }
    }
}
