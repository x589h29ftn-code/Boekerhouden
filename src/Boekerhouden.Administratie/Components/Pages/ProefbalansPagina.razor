@page "/a/{Id:guid}/proefbalans"
@inject GrootboekDienst Grootboek

<AdministratieKader Id="Id" Titel="Proefbalans" Actief="/proefbalans" BijOpenen="Open">
    <Acties>
        <span class="form-check form-switch mb-0 small text-nowrap">
            <input class="form-check-input" type="checkbox" id="met-nul" @bind="metNul" />
            <label class="form-check-label" for="met-nul">ook zonder saldo</label>
        </span>
        <JaarKeuze Jaren="jaren" @bind-Jaar="jaar" @bind-Jaar:after="Laad" />
    </Acties>
    <ChildContent>
        @if (proefbalans is not null)
        {
            <div class="card">
                <table class="table table-sm table-hover align-middle mb-0" data-sleepbaar="proefbalans">
                    <thead>
                        <tr><th>Rekening</th><th>RGS</th><th class="text-end">Debet</th><th class="text-end">Credit</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in proefbalans.Regels.Where(r => metNul || r.Saldo != 0))
                        {
                            <tr>
                                <td><a href="/a/@Id/grootboek?rekening=@r.Rekening.Nummer&jaar=@jaar"><span class="nr">@r.Rekening.Nummer</span> @r.Rekening.Naam</a></td>
                                <td class="small text-secondary">@r.Rekening.RgsCode</td>
                                <td class="bedrag text-end">@(r.Saldo > 0 ? Bedragen.Getal(r.Saldo) : null)</td>
                                <td class="bedrag text-end">@(r.Saldo < 0 ? Bedragen.Getal(-r.Saldo) : null)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-semibold">
                            <td colspan="2">Totaal</td>
                            <td class="bedrag text-end">@Bedragen.Getal(proefbalans.Regels.Where(r => r.Saldo > 0).Sum(r => r.Saldo))</td>
                            <td class="bedrag text-end">@Bedragen.Getal(-proefbalans.Regels.Where(r => r.Saldo < 0).Sum(r => r.Saldo))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="small text-secondary mt-2">Resultaat @jaar: <span class="bedrag text-body">@Bedragen.Getal(proefbalans.Resultaat)</span></p>
        }
    </ChildContent>
</AdministratieKader>

@code {
    private Geopend? geopend;
    private IReadOnlyList<int> jaren = [];
    private int jaar;
    private bool metNul;
    private Boekhouding.Grootboek.Proefbalans? proefbalans;

    [Parameter]
    public Guid Id { get; set; }

    private async Task Open(Geopend g)
    {
        geopend = g;
        jaren = await Grootboek.Boekjaren(g.Wie, Id);
        jaar = jaren[0];
        await Laad();
    }

    private async Task Laad() => proefbalans = await Grootboek.Proefbalans(geopend!.Wie, Id, jaar);
}
