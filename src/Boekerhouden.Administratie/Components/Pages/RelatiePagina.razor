@page "/a/{Id:guid}/relaties/{Code}"
@using Boekerhouden.Boekhouding.Herkenning
@inject InrichtingDienst Inrichting
@inject GrootboekDienst Grootboek

<AdministratieKader Id="Id" Titel="@(geleerd?.Relatie.Naam ?? "Relatie")" Actief="/relaties" BijOpenen="Open">
    <Foutmeldingen Fouten="fouten" />
    @if (bericht is not null)
    {
        <div class="bericht mb-2">@bericht</div>
    }
    @if (geladen && geleerd is null)
    {
        <div class="alert alert-warning">Deze relatie bestaat niet. <a href="/a/@Id/relaties">Naar relaties</a></div>
    }
    else if (geleerd is { Relatie: var r } g)
    {
        <div class="small text-secondary mb-3">
            @string.Join(" · ", new[] { string.Join(", ", r.Ibans.Select(Boekhouding.Relaties.Iban.Toon)), r.BtwNummer, r.KvkNummer is null ? null : $"KvK {r.KvkNummer}" }.Where(x => !string.IsNullOrEmpty(x)))
        </div>

        <h2 class="h6 sectiekop">Gegevens</h2>
        <div class="card card-body mb-4 relatiegegevens">
            <fieldset disabled="@(!context.Mag(Recht.Invoeren))">
                <div class="row g-2">
                    <div class="col-md-4"><label class="form-label" for="rn">Naam</label><input id="rn" class="form-control form-control-sm" @bind="gegevens.Naam" /></div>
                    <div class="col-md-3"><label class="form-label" for="rb">Btw-nummer</label><input id="rb" class="form-control form-control-sm" @bind="gegevens.BtwNummer" /></div>
                    <div class="col-md-2"><label class="form-label" for="rk">KvK-nummer</label><input id="rk" class="form-control form-control-sm" @bind="gegevens.KvkNummer" /></div>
                    <div class="col-md-3"><label class="form-label" for="rt">Standaardrekening inkoop</label><input id="rt" class="form-control form-control-sm" @bind="gegevens.Tegenrekening" /></div>
                </div>
                <div class="form-check mt-3 mb-2">
                    <input class="form-check-input" type="checkbox" id="klant" @bind="gegevens.IsKlant" />
                    <label class="form-check-label" for="klant">Klant: deze relatie krijgt verkoopfacturen</label>
                </div>
                @if (gegevens.IsKlant)
                {
                    <div class="row g-2">
                        <div class="col-md-4"><label class="form-label" for="ks">Straat en huisnummer</label><input id="ks" class="form-control form-control-sm" @bind="gegevens.Straat" /></div>
                        <div class="col-md-2"><label class="form-label" for="kp">Postcode</label><input id="kp" class="form-control form-control-sm" @bind="gegevens.Postcode" /></div>
                        <div class="col-md-3"><label class="form-label" for="kpl">Plaats</label><input id="kpl" class="form-control form-control-sm" @bind="gegevens.Plaats" /></div>
                        <div class="col-md-1"><label class="form-label" for="kl">Land</label><input id="kl" class="form-control form-control-sm" maxlength="2" placeholder="NL" @bind="gegevens.Land" /></div>
                        <div class="col-md-2"><label class="form-label" for="kt">Termijn (dagen)</label><input id="kt" class="form-control form-control-sm text-end" @bind="gegevens.Termijn" /></div>
                        <div class="col-md-4"><label class="form-label" for="ke">E-mail voor facturen</label><input id="ke" class="form-control form-control-sm" type="email" @bind="gegevens.Email" /></div>
                        <div class="col-md-3"><label class="form-label" for="kc">Contactpersoon</label><input id="kc" class="form-control form-control-sm" @bind="gegevens.Contactpersoon" /></div>
                        <div class="col-md-3"><label class="form-label" for="ko">Omzetrekening</label><input id="ko" class="form-control form-control-sm" @bind="gegevens.Omzetrekening" /></div>
                        <div class="col-md-2"><label class="form-label" for="kv">Btw-code verkoop</label><input id="kv" class="form-control form-control-sm" placeholder="V21" @bind="gegevens.Verkoopbtwcode" /></div>
                    </div>
                }
                @if (context.Mag(Recht.Invoeren))
                {
                    <button class="btn btn-sm btn-outline-primary mt-3" @onclick="BewaarGegevens">Opslaan</button>
                }
            </fieldset>
        </div>

        <h2 class="h6 sectiekop">Geleerd bij inkoopfacturen</h2>
        <div class="card mb-4">
            <div class="card-body">
                @if (g.Inkoop is { } i)
                {
                    <div class="d-flex align-items-start gap-3 regel-met-acties">
                        <div>
                            <div><span class="rekeningnummer">@i.Keuze.Rekeningnummer</span> @schema?.Zoek(i.Keuze.Rekeningnummer)?.Naam <span class="text-secondary ms-2">@i.Keuze.BtwCode</span></div>
                            <div class="small text-secondary mt-1">
                                @(i.OpRij == 1 ? "1 keer" : $"{i.OpRij} keer op rij") bevestigd ·
                                @(i.OpRij >= g.Drempel
                                    ? i.Bovengrens is { } grens ? $"automatisch tot {Bedragen.Euro(grens)}" : "automatisch"
                                    : $"automatisch na nog {g.Drempel - i.OpRij} keer")
                                @if (i.Omschrijving is { } o)
                                {
                                    <span> · omschrijving ‘@o’</span>
                                }
                            </div>
                        </div>
                        @if (context.Mag(Recht.Boekhouden))
                        {
                            @if (bevestigVergeten)
                            {
                                <span class="ms-auto d-inline-flex align-items-center gap-2">
                                    <span class="small">Zeker weten?</span>
                                    <button class="btn btn-sm btn-danger" @onclick="Vergeet">Ja, vergeten</button>
                                    <button class="btn btn-sm btn-link text-secondary px-1" @onclick="() => bevestigVergeten = false">annuleren</button>
                                </span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-link text-secondary ms-auto acties" title="Het pakket begint weer bij nul: eerst zelf kiezen, dan een voorstel" @onclick="() => bevestigVergeten = true">Vergeten</button>
                            }
                        }
                    </div>
                }
                else
                {
                    <span class="text-secondary">Nog niets geleerd.</span>
                }
            </div>
            @if (g.Bevestigingen.Count > 0)
            {
                <table class="table table-sm align-middle mb-0 overzichtstabel">
                    <thead>
                        <tr><th>Bevestigd</th><th>Rekening</th><th>Btw</th><th class="text-end">Bedrag</th><th>IBAN</th><th>Postcodes</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var b in g.Bevestigingen.Reverse())
                        {
                            <tr>
                                <td>@Weergave.DatumTijd(b.Tijdstip)</td>
                                <td title="@schema?.Zoek(b.Bevestiging.Keuze.Rekeningnummer)?.Naam">@b.Bevestiging.Keuze.Rekeningnummer</td>
                                <td>@b.Bevestiging.Keuze.BtwCode</td>
                                <td class="bedrag text-end">@(b.Bevestiging.Bedrag is { } bedrag ? Weergave.Bedrag(bedrag) : null)</td>
                                <td class="small">@(b.Bevestiging.Iban is { } iban ? Boekhouding.Relaties.Iban.Toon(iban) : null)</td>
                                <td class="small">@string.Join(", ", (b.Bevestiging.Postcodes ?? []).Select(Boekhouding.Relaties.Postcode.Toon))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <h2 class="h6 sectiekop">Zelf controleren</h2>
        <div class="card card-body mb-4 zelf-controleren">
            @if (context.Mag(Recht.Boekhouden))
            {
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <label for="vanaf">Vanaf</label>
                    <input id="vanaf" class="form-control form-control-sm text-end veld-smal" @bind="vanaf" placeholder="bedrag" title="Facturen vanaf dit bedrag (inclusief btw) komen altijd ter controle" />
                    <label for="afwijking" class="ms-3">of bij meer dan</label>
                    <input id="afwijking" class="form-control form-control-sm text-end veld-procent" @bind="afwijking" placeholder="%" title="Afwijking ten opzichte van de vorige factuur, hoger of lager" />
                    <span>% verschil met de vorige factuur</span>
                    <button class="btn btn-sm btn-outline-primary ms-3" @onclick="BewaarControle">Opslaan</button>
                </div>
            }
            else
            {
                <span class="text-secondary">@(r.ControleVanaf is null && r.ControleAfwijking is null ? "Geen eigen grens." : Controle(r))</span>
            }
        </div>

        <h2 class="h6 sectiekop">Plekken op de factuur</h2>
        <div class="card mb-4">
            @if (g.Plekken.Count == 0)
            {
                <div class="card-body text-secondary">Nog geen plekken.</div>
            }
            else
            {
                <table class="table table-sm align-middle mb-0 overzichtstabel">
                    <tbody>
                        @foreach (var p in g.Plekken)
                        {
                            <tr class="regel-met-acties">
                                <td>@Veldnaam(p.Veld)</td>
                                <td class="text-secondary" title="@($"{p.X0:0}, {p.Y0:0} – {p.X1:0}, {p.Y1:0} (PDF-punten)")">pagina @p.Pagina</td>
                                <td class="text-secondary">@(p.Voorrang ? "gaat voor" : "vult aan")</td>
                                <td class="text-end">
                                    @if (context.Mag(Recht.Boekhouden))
                                    {
                                        <button class="btn btn-sm btn-link text-secondary p-0 acties" @onclick="() => VergeetPlek(p.Veld)">Vergeten</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (g.Regels.Count > 0)
        {
            <h2 class="h6 sectiekop">Regels</h2>
            <div class="card mb-4">
                <ul class="list-unstyled mb-0 card-body">
                    @foreach (var regel in g.Regels)
                    {
                        <li><a href="/a/@Id/regels">@regel.Regel.Naam</a> <span class="text-secondary small ms-2">@regel.Regel.Rekeningnummer @regel.Regel.BtwCode@(regel.Regel.Automatisch ? " · automatisch" : null)</span></li>
                    }
                </ul>
            </div>
        }

        <a class="small" href="/a/@Id/relaties">Naar relaties</a>
    }
</AdministratieKader>

@code {
    private Geopend? geopend;
    private bool geladen;
    private GeleerdeLeverancier? geleerd;
    private Boekhouding.Grootboek.Rekeningschema? schema;
    private bool bevestigVergeten;
    private IReadOnlyList<string>? fouten;
    private string? bericht;

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public string Code { get; set; } = "";

    private string? vanaf;
    private string? afwijking;
    private Relatieformulier gegevens = new();

    private async Task BewaarGegevens()
    {
        int? termijn = string.IsNullOrWhiteSpace(gegevens.Termijn) ? null : int.TryParse(gegevens.Termijn, out var t) ? t : -1;
        var r = geleerd!.Relatie;
        var uitkomst = await Inrichting.WijzigRelatie(geopend!.Wie, Id, r.Id, new RelatieInvoer(gegevens.Naam, gegevens.BtwNummer, gegevens.KvkNummer, gegevens.Tegenrekening,
            new Klantgegevens(gegevens.IsKlant, gegevens.Straat, gegevens.Postcode, gegevens.Plaats, gegevens.Land, gegevens.Email, gegevens.Contactpersoon, termijn,
                gegevens.Omzetrekening, gegevens.Verkoopbtwcode)));
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            await Open(geopend);
            bericht = $"Gegevens van {gegevens.Naam} opgeslagen.";
        }
    }

    /// <summary>De gegevens van de relatie zoals ze in het formulier staan.</summary>
    private sealed class Relatieformulier
    {
        public string Naam { get; set; } = "";

        public string? BtwNummer { get; set; }

        public string? KvkNummer { get; set; }

        public string? Tegenrekening { get; set; }

        public bool IsKlant { get; set; }

        public string? Straat { get; set; }

        public string? Postcode { get; set; }

        public string? Plaats { get; set; }

        public string? Land { get; set; }

        public string? Termijn { get; set; }

        public string? Email { get; set; }

        public string? Contactpersoon { get; set; }

        public string? Omzetrekening { get; set; }

        public string? Verkoopbtwcode { get; set; }

        public static Relatieformulier Van(RelatieRegel r) => new()
        {
            Naam = r.Naam,
            BtwNummer = r.BtwNummer,
            KvkNummer = r.KvkNummer,
            Tegenrekening = r.Tegenrekening,
            IsKlant = r.Klant?.IsKlant ?? false,
            Straat = r.Klant?.Straat,
            Postcode = r.Klant?.Postcode,
            Plaats = r.Klant?.Plaats,
            Land = r.Klant?.Land,
            Termijn = r.Klant?.Betalingstermijn?.ToString(System.Globalization.CultureInfo.InvariantCulture),
            Email = r.Klant?.Email,
            Contactpersoon = r.Klant?.Contactpersoon,
            Omzetrekening = r.Klant?.Omzetrekening,
            Verkoopbtwcode = r.Klant?.Verkoopbtwcode,
        };
    }

    private async Task Open(Geopend g)
    {
        geopend = g;
        geleerd = await Inrichting.Geleerd(g.Wie, Id, Code);
        if (geleerd is not null)
        {
            gegevens = Relatieformulier.Van(geleerd.Relatie);
        }

        vanaf = geleerd?.Relatie.ControleVanaf is { } v ? Bedragen.Getal(v) : null;
        afwijking = geleerd?.Relatie.ControleAfwijking is { } a ? a.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("nl-NL")) : null;
        schema = await Grootboek.Schema(g.Wie, Id);
        geladen = true;
    }

    private static string Veldnaam(Factuurveld veld) => veld switch
    {
        Factuurveld.Factuurnummer => "Factuurnummer",
        Factuurveld.Factuurdatum => "Factuurdatum",
        Factuurveld.Vervaldatum => "Vervaldatum",
        Factuurveld.Betalingskenmerk => "Betalingskenmerk",
        Factuurveld.Totaal => "Bedrag (inclusief btw)",
        Factuurveld.Exclusief => "Bedrag exclusief btw",
        Factuurveld.Btw => "Btw",
        _ => "Omschrijving",
    };

    private async Task Vergeet()
    {
        var uitkomst = await Inrichting.VergeetGeleerd(geopend!.Wie, Id, Code);
        (fouten, bevestigVergeten) = (uitkomst.Fouten, false);
        if (uitkomst.IsGelukt)
        {
            bericht = "Vergeten; het pakket begint weer bij nul.";
            await Open(geopend);
        }
    }

    private static string Controle(RelatieRegel r) =>
        string.Join(" of ", new[] { r.ControleVanaf is { } v ? $"vanaf {Bedragen.Euro(v)}" : null, r.ControleAfwijking is { } a ? $"bij meer dan {a:0.##}% verschil met de vorige factuur" : null }.Where(x => x is not null));

    private async Task BewaarControle()
    {
        var invoerfouten = new List<string>();
        var grens = Lees(vanaf, "Het bedrag", invoerfouten);
        var procent = Lees(afwijking?.TrimEnd('%', ' '), "Het percentage", invoerfouten);
        if (invoerfouten.Count > 0)
        {
            fouten = invoerfouten;
            return;
        }

        var uitkomst = await Inrichting.ZetControle(geopend!.Wie, Id, Code, grens, procent);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            await Open(geopend);
            bericht = geleerd?.Relatie is { ControleVanaf: null, ControleAfwijking: null } ? "Geen eigen grens meer." : $"Facturen {Controle(geleerd!.Relatie)} controleer je voortaan zelf.";
        }
    }

    private static decimal? Lees(string? tekst, string naam, List<string> fouten)
    {
        if (string.IsNullOrWhiteSpace(tekst))
        {
            return null;
        }

        if (BedragParser.TryParse(tekst, out var getal))
        {
            return getal;
        }

        fouten.Add($"{naam} ‘{tekst}’ is niet te lezen.");
        return null;
    }

    private async Task VergeetPlek(Factuurveld veld)
    {
        var uitkomst = await Inrichting.VergeetPlek(geopend!.Wie, Id, Code, veld);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            bericht = $"Plek van {Veldnaam(veld).ToLowerInvariant()} vergeten.";
            await Open(geopend);
        }
    }
}
