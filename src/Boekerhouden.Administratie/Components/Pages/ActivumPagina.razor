@page "/a/{Id:guid}/activa/nieuw"
@page "/a/{Id:guid}/activa/{ActivumId:guid}"
@using System.Globalization
@using Boekerhouden.Boekhouding.Activa
@using Boekerhouden.Boekhouding.Grootboek
@using Boekerhouden.Domain
@inject ActivaDienst Activa
@inject GrootboekDienst Grootboek
@inject NavigationManager Navigatie

<AdministratieKader Id="Id" Titel="@Titel" Actief="/activa" BijOpenen="Open">
    <Kenmerken>
        <a href="/a/@Id/activa" class="text-secondary"><Icoon Naam="arrow-left" /> Vaste activa</a>
        @if (detail is { } d)
        {
            <span class="scheiding">·</span>
            <span title="@($"{d.AangemaaktDoor}, {Weergave.DatumTijd(d.AangemaaktOp)}")">nr. @d.Nummer</span>
            @if (d.BuitenGebruikOp is { } weg)
            {
                <span class="scheiding">·</span>
                <span>gedesinvesteerd @Weergave.Datum(weg)</span>
            }
            else
            {
                <span class="scheiding">·</span>
                <span title="Aanschafwaarde @Weergave.Bedrag(d.Aanschafwaarde), afgeschreven @Weergave.Bedrag(d.Afgeschreven)">boekwaarde @Weergave.Bedrag(d.Boekwaarde)</span>
                @if (d.PerMaand != 0)
                {
                    <span class="scheiding">·</span>
                    <span>per maand @Weergave.Bedrag(d.PerMaand)</span>
                }
                <span class="scheiding">·</span>
                <span>restwaarde @Weergave.Bedrag(d.Restwaarde)</span>
            }
        }
    </Kenmerken>
    <Acties>
        @if (aanschaf?.Document is { } factuur)
        {
            <button class="btn btn-outline-secondary @(toonFactuur ? "active" : null)" title="@aanschaf.Documentnaam" @onclick="() => toonFactuur = !toonFactuur">Factuur</button>
        }
        @if (mag && detail is { TeBoeken: > 0 } t)
        {
            <button class="btn btn-outline-secondary" disabled="@bezig" title="@t.TeBoeken @(t.TeBoeken == 1 ? "maand" : "maanden"), elk een eigen memoriaalboeking" @onclick="AfschrijvenTotVorigeMaand">Afschrijven t/m @VorigeMaand.ToString("MMMM", Nederlands)</button>
        }
    </Acties>
    <ChildContent>
        <div class="verwerken">
        <div class="verwerken-formulier">
        <Foutmeldingen Fouten="fouten" />
        @if (bericht is not null)
        {
            <div class="bericht mb-2">@bericht</div>
        }
        @if (f is null || schema is null)
        {
            <Laadschets />
        }
        else
        {
            <fieldset class="verkoopformulier activumformulier" disabled="@(!mag)">
                <div class="formulier-rij">
                    <label for="omschrijving">Omschrijving</label>
                    <input id="omschrijving" class="form-control form-control-sm" style="max-width:32rem" maxlength="200" @bind="f.Omschrijving" />
                </div>
                <div class="formulier-rij">
                    <label for="aanschafdatum">Aanschaf</label>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <DatumVeld Id="aanschafdatum" @bind-Waarde="f.Aanschafdatum" Uit="Vast" />
                        <input id="aanschafwaarde" class="form-control form-control-sm text-end" style="width:9rem" aria-label="Aanschafwaarde" @bind="f.Aanschafwaarde" disabled="@Vast" />
                        @if (detail?.Invoer.Bron is { } bron && bron.Split(' ', 2) is [var dagboek, var boekstuk])
                        {
                            <a class="small" href="/a/@Id/boeking/@dagboek/@boekstuk" title="De boeking van de aanschaf">@bron</a>
                        }
                        else if (f.Bron is { } nieuwBron)
                        {
                            <span class="small text-secondary">@nieuwBron</span>
                        }
                    </div>
                </div>
                <div class="formulier-rij">
                    <label for="methode">Afschrijven</label>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <select id="methode" class="form-select form-select-sm w-auto" @bind="f.Methode" disabled="@Vast">
                            <option value="@Afschrijvingsmethode.Lineair">lineair</option>
                            <option value="@Afschrijvingsmethode.Geen">niet (bijv. grond)</option>
                        </select>
                        @if (f.Methode == Afschrijvingsmethode.Lineair)
                        {
                            <span class="small text-secondary">vanaf</span>
                            <DatumVeld Id="begin" @bind-Waarde="f.Begin" Uit="Vast" Label="Eerste maand" />
                            <span class="small text-secondary">in</span>
                            <input id="looptijd" class="form-control form-control-sm text-end" style="width:5rem" aria-label="Looptijd in maanden" @bind="f.Looptijd" disabled="@IsWeg" />
                            <span class="small text-secondary" title="@(f.Looptijd is > 0 and var l ? $"{l / 12m:0.#} jaar" : null)">maanden@(f.Looptijd is > 0 and var lt ? $" ({Procent(1200m / lt)} per jaar)" : null)</span>
                        }
                    </div>
                </div>
                @if (detail is { Herzieningen.Count: > 0 } metHerziening)
                {
                    <div class="formulier-rij">
                        <span class="text-secondary small">Gewijzigd</span>
                        <div class="herzieningen">
                            @foreach (var h in metHerziening.Herzieningen!)
                            {
                                <div class="herziening">
                                    <span>vanaf @h.Maand.ToString("MMMM yyyy", Nl): @Procent(h.PercentagePerJaar) per jaar</span>
                                    @if (mag && !metHerziening.Plan.Any(m => m.Geboekt && m.Maand >= h.Maand))
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0 ms-3 regelactie text-secondary" disabled="@bezig" @onclick="() => VerwijderHerziening(h.Maand)">Verwijderen</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (f.Methode == Afschrijvingsmethode.Lineair)
                {
                    <div class="formulier-rij">
                        <label for="restwaarde">Restwaarde</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input id="restwaarde" class="form-control form-control-sm text-end" style="width:9rem" placeholder="0,00" @bind="f.Restwaarde" disabled="@IsWeg" />
                            @if (detail is { Desinvesteringen.Count: > 0 } d && d.Restwaarde != (f.Invoer()?.Restwaarde ?? 0m))
                            {
                                <span class="small text-secondary" title="Na de gedeeltelijke desinvestering">nu @Weergave.Bedrag(d.Restwaarde)</span>
                            }
                        </div>
                    </div>
                }
                <div class="formulier-rij">
                    <label for="activarekening">Activarekening</label>
                    <span style="width:22rem"><RekeningKeuze Id="activarekening" Waarde="@f.Activarekening" WaardeChanged="KiesActivarekening" Schema="schema" Kader="geopend" Label="Activarekening" /></span>
                </div>
                <div class="formulier-rij">
                    <label for="afschrijvingsrekening">Afschrijving</label>
                    <span style="width:22rem"><RekeningKeuze Id="afschrijvingsrekening" @bind-Waarde="f.Afschrijvingsrekening" Schema="schema" Kader="geopend" Label="Cumulatieve afschrijving (balans)" /></span>
                </div>
                <div class="formulier-rij">
                    <label for="kostenrekening">Kosten</label>
                    <span style="width:22rem"><RekeningKeuze Id="kostenrekening" @bind-Waarde="f.Kostenrekening" Schema="schema" Kader="geopend" Label="Afschrijvingskosten (W&amp;V)" /></span>
                </div>
                <div class="formulier-rij">
                    <span></span>
                    <span class="d-flex gap-2 align-items-center flex-wrap">
                        <span class="form-check mb-0 small">
                            <input class="form-check-input" type="checkbox" id="eerder" @bind="f.Eerder" disabled="@Vast" />
                            <label class="form-check-label text-secondary" for="eerder">Al eerder afgeschreven</label>
                        </span>
                        @if (f.Eerder)
                        {
                            <input class="form-control form-control-sm text-end" style="width:9rem" aria-label="Al afgeschreven vóór de eerste maand" @bind="f.VoorBegin" disabled="@Vast" />
                        }
                    </span>
                </div>
                @if (Privegebruikcontrole.IsVervoermiddel(schema.Zoek(f.Activarekening ?? ""), f.Omschrijving))
                {
                    <div class="formulier-rij">
                        <label for="privegebruik">Privégebruik</label>
                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            <select id="privegebruik" class="form-select form-select-sm w-auto" @bind="f.Privegebruik">
                                @foreach (var keuze in Enum.GetValues<Privegebruik>())
                                {
                                    <option value="@keuze">@Privegebruikcontrole.Naam(keuze)</option>
                                }
                            </select>
                            @if (f.Privegebruik == Privegebruik.JaForfait)
                            {
                                <input class="form-control form-control-sm text-end" style="width:9rem" aria-label="Cataloguswaarde" placeholder="cataloguswaarde"
                                       title="Cataloguswaarde inclusief btw en bpm" @bind="f.Cataloguswaarde" />
                                @if (Forfait() is { } forfait)
                                {
                                    <span class="small text-secondary" title="Btw privégebruik volgens het forfait over @forfait.Jaar, naar rato van de maanden in gebruik">btw @forfait.Jaar: @Weergave.Bedrag(forfait.Bedrag)</span>
                                }
                            }
                        </div>
                    </div>
                }
                <div class="formulier-rij">
                    <label for="notitie">Notitie</label>
                    <input id="notitie" class="form-control form-control-sm" style="max-width:32rem" maxlength="1000" @bind="f.Notitie" />
                </div>
                <Foutmeldingen Fouten="formfouten" />
                <div class="d-flex align-items-center gap-2 mt-3">
                    <button class="btn btn-primary" disabled="@bezig" @onclick="Bewaar">Opslaan</button>
                    <a class="btn btn-link text-secondary" href="/a/@Id/activa">Annuleren</a>
                    @if (detail is { Vast: false, BuitenGebruikOp: null })
                    {
                        <VerwijderKnop Bezig="bezig" Bevestigd="Verwijder" />
                    }
                </div>
            </fieldset>

            @if (aanschaf is { Boeking: var ab })
            {
                <h2 class="h6 sectiekop mt-4">Aanschaf</h2>
                <div class="d-flex align-items-center flex-wrap gap-2 mb-2 small">
                    <a href="/a/@Id/boeking/@ab.Post.Dagboek/@ab.Post.Boekstuk">@ab.Post.Dagboek @ab.Post.Boekstuk</a>
                    <span class="text-secondary">@Weergave.Datum(ab.Post.Datum)</span>
                    <span>@ab.Post.Omschrijving</span>
                    @if (aanschaf.Document is { } doc && geopend is not null)
                    {
                        <span class="ms-auto d-flex gap-3">
                            <a href="/a/@Id/inkoop/@doc">Factuur openen</a>
                            <DocumentOpenen Wie="geopend.Wie" Administratie="Id" Document="doc" Tekst="Origineel" Klasse="btn btn-link btn-sm p-0" />
                        </span>
                    }
                </div>
                <div class="card overzichtskaart aanschafboeking">
                    <table class="table table-sm align-middle mb-0 overzichtstabel">
                        <thead>
                            <tr><th>Grootboek</th><th>Omschrijving</th><th>Btw</th><th>Relatie</th><th class="text-end">Debet</th><th class="text-end">Credit</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in ab.Post.Regels)
                            {
                                <tr class="@(r.Rekeningnummer == f.Activarekening ? null : "text-secondary")">
                                    <td><span class="rekeningnummer">@r.Rekeningnummer</span>@(schema.Zoek(r.Rekeningnummer)?.Naam)</td>
                                    <td>@r.Omschrijving</td>
                                    <td>@r.BtwCode</td>
                                    <td>@r.Relatie</td>
                                    <td class="bedrag text-end">@(r.Bedrag > 0 ? Weergave.Bedrag(r.Bedrag) : null)</td>
                                    <td class="bedrag text-end">@(r.Bedrag < 0 ? Weergave.Bedrag(-r.Bedrag) : null)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (detail is { BuitenGebruikOp: null, Invoer.Methode: Afschrijvingsmethode.Lineair } && mag)
            {
                <div class="mt-4">
                    <Uitklapformulier Tekst="Afschrijving wijzigen">
                        <div class="verkoopformulier herzien">
                            <div class="formulier-rij">
                                <label for="herzien-vanaf">Vanaf</label>
                                <div class="d-flex"><span style="width:9.5rem"><DatumVeld Id="herzien-vanaf" @bind-Waarde="herzien.Vanaf" /></span></div>
                            </div>
                            <div class="formulier-rij">
                                <label for="herzien-procent">Per jaar</label>
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <input id="herzien-procent" class="form-control form-control-sm text-end" style="width:6rem" @bind="herzien.Percentage" @bind:event="oninput" />
                                    <span class="small text-secondary">% van de aanschafwaarde</span>
                                    @if (Vooruitblik() is { } v)
                                    {
                                        <span class="small text-secondary ms-3">@Weergave.Bedrag(v.PerMaand) per maand, klaar in @v.Eind.ToString("MMMM yyyy", Nl)</span>
                                    }
                                </div>
                            </div>
                            <div class="formulier-rij">
                                <span></span>
                                <span><button class="btn btn-sm btn-primary" disabled="@bezig" @onclick="Herzie">Wijzigen</button></span>
                            </div>
                        </div>
                    </Uitklapformulier>
                </div>
            }

            @if (detail is { BuitenGebruikOp: null } && mag)
            {
                <div class="mt-4">
                    <Uitklapformulier Tekst="Desinvesteren">
                        <div class="verkoopformulier desinvesteren">
                            <div class="formulier-rij">
                                <label for="soort">Soort</label>
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <select id="soort" class="form-select form-select-sm w-auto" @bind="weg.Soort" @bind:after="Herbereken">
                                        <option value="@Desinvesteringssoort.Verkoop">verkoop</option>
                                        <option value="@Desinvesteringssoort.Inruil">inruil</option>
                                        <option value="@Desinvesteringssoort.Sloop">sloop of afstoten zonder opbrengst</option>
                                    </select>
                                    <select class="form-select form-select-sm w-auto" aria-label="Deel" @bind="weg.Omvang" @bind:after="Herbereken">
                                        <option value="geheel">het hele actief</option>
                                        <option value="deel">een deel</option>
                                    </select>
                                    @if (weg.Gedeeltelijk)
                                    {
                                        <input class="form-control form-control-sm text-end" style="width:5rem" aria-label="Deel in procenten" @bind="weg.Deel" @bind:after="Herbereken" />
                                        <span class="small text-secondary">%</span>
                                    }
                                </div>
                            </div>
                            <div class="formulier-rij">
                                <label for="wegdatum">Datum</label>
                                <span style="width:9.5rem"><DatumVeld Id="wegdatum" Waarde="weg.Datum" WaardeChanged="KiesDatum" /></span>
                            </div>
                            @if (weg.Soort != Desinvesteringssoort.Sloop)
                            {
                                <div class="formulier-rij">
                                    <label for="opbrengst">@(weg.Soort == Desinvesteringssoort.Inruil ? "Inruilwaarde" : "Opbrengst")</label>
                                    <div class="d-flex gap-2 align-items-center flex-wrap">
                                        <input id="opbrengst" class="form-control form-control-sm text-end" style="width:9rem" placeholder="0,00" title="Zonder btw" @bind="weg.Opbrengst" @bind:after="Herbereken" />
                                        <span class="small text-secondary">staat op</span>
                                        <span style="width:20rem"><RekeningKeuze Waarde="@weg.Opbrengstrekening" WaardeChanged="KiesOpbrengstrekening" Schema="schema" Kader="geopend" Label="Rekening met de opbrengst" /></span>
                                    </div>
                                </div>
                            }
                            <div class="formulier-rij">
                                <label>Boekresultaat</label>
                                <span style="width:20rem"><RekeningKeuze Waarde="@weg.Resultaatrekening" WaardeChanged="KiesResultaatrekening" Schema="schema" Kader="geopend" Label="Rekening voor de boekwinst of het boekverlies" /></span>
                            </div>
                            @if (voorstel is { } v)
                            {
                                @if (v.EerstAfschrijven.Count > 0)
                                {
                                    <div class="formulier-rij">
                                        <span></span>
                                        <span class="form-check mb-0 small">
                                            <input class="form-check-input" type="checkbox" id="eerst" @bind="weg.EerstAfschrijven" @bind:after="Herbereken" />
                                            <label class="form-check-label" for="eerst">Eerst afschrijven t/m @v.EerstAfschrijven[^1].Datum.ToString("MMMM yyyy", Nederlands): @v.EerstAfschrijven.Count @(v.EerstAfschrijven.Count == 1 ? "maand" : "maanden"), @Weergave.Bedrag(v.EerstAfschrijven.Sum(e => e.Bedrag))</label>
                                        </span>
                                    </div>
                                }
                                @if (v.Bedragen is { } b)
                                {
                                    <div class="formulier-rij">
                                        <span></span>
                                        <span class="small">
                                            Boekwaarde @Weergave.Bedrag(b.Boekwaarde)
                                            <span class="text-secondary" title="Aanschafwaarde min cumulatieve afschrijving">(@Weergave.Bedrag(b.Aanschaf) − @Weergave.Bedrag(b.Afschrijving))</span>,
                                            @(weg.Soort == Desinvesteringssoort.Inruil ? "inruilwaarde" : "opbrengst") @Weergave.Bedrag(b.Opbrengst):
                                            @(b.Resultaat >= 0 ? "boekwinst" : "boekverlies") @Weergave.Bedrag(Math.Abs(b.Resultaat))
                                        </span>
                                    </div>
                                }
                                @if (v.Boeking.Count > 0)
                                {
                                    <table class="table table-sm align-middle mb-2 mt-2 overzichtstabel desinvesteringsboeking">
                                        <thead>
                                            <tr><th>Rekening</th><th>Omschrijving</th><th class="text-end">Debet</th><th class="text-end">Credit</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in v.Boeking)
                                            {
                                                <tr>
                                                    <td><span class="rekeningnummer">@r.Rekening</span>@r.Naam</td>
                                                    <td class="text-secondary">@r.Omschrijving</td>
                                                    <td class="bedrag text-end">@(r.Bedrag > 0 ? Weergave.Bedrag(r.Bedrag) : null)</td>
                                                    <td class="bedrag text-end">@(r.Bedrag < 0 ? Weergave.Bedrag(-r.Bedrag) : null)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                @foreach (var fout in v.Fouten)
                                {
                                    <div class="small text-secondary">@fout</div>
                                }
                            }
                            <div class="mt-2">
                                <button class="btn btn-sm btn-primary" disabled="@(bezig || voorstel is not { Fouten.Count: 0, Boeking.Count: > 0 })" @onclick="Desinvesteer">Boeken</button>
                            </div>
                        </div>
                    </Uitklapformulier>
                </div>
            }

            @if (detail is { Desinvesteringen.Count: > 0 } dd)
            {
                <h2 class="h6 sectiekop mt-4">Desinvesteringen</h2>
                <div class="card overzichtskaart">
                    <table class="table table-sm align-middle mb-0 overzichtstabel desinvesteringen">
                        <thead>
                            <tr><th>Datum</th><th>Soort</th><th class="text-end">Boekwaarde</th><th class="text-end">Opbrengst</th><th class="text-end">Resultaat</th><th>Boeking</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var x in dd.Desinvesteringen)
                            {
                                <tr class="@(x.Tegenboeking is null ? null : "text-secondary")">
                                    <td>@Weergave.Datum(x.Datum)</td>
                                    <td>@Soort(x.Soort)@(x.Deel == 100 ? null : $" {x.Deel:0.##}%")</td>
                                    <td class="bedrag text-end" title="Aanschafwaarde @Weergave.Bedrag(x.Aanschaf), afgeschreven @Weergave.Bedrag(x.Afschrijving)">@Weergave.Bedrag(x.Boekwaarde)</td>
                                    <td class="bedrag text-end"><Euro Waarde="x.Opbrengst" LeegBijNul="true" /></td>
                                    <td class="bedrag text-end">@Weergave.Bedrag(x.Resultaat)</td>
                                    <td>@if (x.Boekstuk.Split(' ', 2) is [var xd, var xb])
                                        {
                                            <a href="/a/@Id/boeking/@xd/@xb">@x.Boekstuk</a>
                                        }</td>
                                    <td class="text-end">@if (x.Tegenboeking is { } tegen)
                                        {
                                            <span class="status" title="Tegenboeking @tegen">teruggedraaid</span>
                                        }
                                        else if (x.Laatste && mag)
                                        {
                                            <button class="btn btn-sm btn-link p-0 regelactie" disabled="@bezig" @onclick="() => Terugdraaien(x.Id)">Terugdraaien</button>
                                        }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Plan is { Count: > 0 } plan)
            {
                <h2 class="h6 sectiekop mt-4">Afschrijvingsplan</h2>
                <div class="card overzichtskaart afschrijvingsplan">
                    <table class="table table-sm align-middle mb-0 overzichtstabel">
                        <thead>
                            <tr><th>Periode</th><th class="text-end">Afschrijving</th><th class="text-end">Cumulatief</th><th class="text-end">Boekwaarde</th><th>Boeking</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var jaar in plan.GroupBy(m => m.Maand.Year))
                            {
                                var j = jaar.Key;
                                var laatste = jaar.Last();
                                var geboekt = jaar.Count(m => m.Geboekt);
                                <tr class="klikbaar planjaar" @onclick="() => Wissel(j)">
                                    <td><span class="pijl"><Icoon Naam="@(openJaren.Contains(j) ? "chevron-down" : "chevron-right")" /></span>@j</td>
                                    <td class="bedrag text-end">@Weergave.Bedrag(jaar.Sum(m => m.Bedrag))</td>
                                    <td class="bedrag text-end">@Weergave.Bedrag(laatste.Cumulatief)</td>
                                    <td class="bedrag text-end">@Weergave.Bedrag(laatste.Boekwaarde)</td>
                                    <td class="text-secondary small">@(geboekt == 0 ? null : geboekt == jaar.Count() ? "geboekt" : $"{geboekt} van {jaar.Count()} maanden geboekt")</td>
                                </tr>
                                @if (openJaren.Contains(j))
                                {
                                    @foreach (var m in jaar)
                                    {
                                        <tr class="@(m.Geboekt ? null : "text-secondary")">
                                            <td class="ps-4">@m.Maand.ToString("MMMM", Nederlands)</td>
                                            <td class="bedrag text-end">@Weergave.Bedrag(m.Bedrag)</td>
                                            <td class="bedrag text-end">@Weergave.Bedrag(m.Cumulatief)</td>
                                            <td class="bedrag text-end">@Weergave.Bedrag(m.Boekwaarde)</td>
                                            <td>@if (detail?.Boekstukken.GetValueOrDefault(m.Maand) is { } maandstuk && maandstuk.Split(' ', 2) is [var maandDagboek, var maandBoekstuk])
                                                {
                                                    <a href="/a/@Id/boeking/@maandDagboek/@maandBoekstuk">@maandstuk</a>
                                                }</td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        </div>
        @if (toonFactuur && aanschaf?.Document is { } document && geopend is not null)
        {
            <Factuurbeeld @key="document" Wie="geopend.Wie" Administratie="Id" Document="document" />
        }
        </div>
    </ChildContent>
</AdministratieKader>

@code {
    private static readonly CultureInfo Nederlands = CultureInfo.GetCultureInfo("nl-NL");

    /// <summary>De btw privégebruik volgens het forfait over dit jaar (of het jaar van buiten gebruik), als de cataloguswaarde er is.</summary>
    private (int Jaar, decimal Bedrag)? Forfait()
    {
        var jaar = Math.Min(DateTime.Today.Year, detail?.BuitenGebruikOp?.Year ?? int.MaxValue);
        if (f?.Invoer() is not { Cataloguswaarde: { } } invoer)
        {
            return null;
        }

        var v = new Vervoermiddel(Guid.Empty, 0, invoer.Omschrijving, invoer.Aanschafdatum, invoer.BeginAfschrijving, detail?.BuitenGebruikOp, invoer.Privegebruik, invoer.Cataloguswaarde);
        return Privegebruikcontrole.Verwacht(v, jaar) is { } bedrag ? (jaar, bedrag) : null;
    }

    private sealed class Formulier
    {
        public string Omschrijving { get; set; } = "";
        public DateOnly Aanschafdatum { get; set; }
        public string? Aanschafwaarde { get; set; }
        public string? Restwaarde { get; set; }
        public DateOnly Begin { get; set; }
        public int? Looptijd { get; set; } = 60;
        public Afschrijvingsmethode Methode { get; set; }
        public string? Activarekening { get; set; }
        public string? Afschrijvingsrekening { get; set; }
        public string? Kostenrekening { get; set; }
        public bool Eerder { get; set; }
        public string? VoorBegin { get; set; }
        public string? Bron { get; set; }
        public string? Notitie { get; set; }
        public Privegebruik Privegebruik { get; set; }
        public string? Cataloguswaarde { get; set; }

        public static Formulier Van(ActivumInvoer i) => new()
        {
            Omschrijving = i.Omschrijving,
            Aanschafdatum = i.Aanschafdatum,
            Aanschafwaarde = Bedragen.Getal(i.Aanschafwaarde),
            Restwaarde = i.Restwaarde == 0 ? null : Bedragen.Getal(i.Restwaarde),
            Begin = i.BeginAfschrijving,
            Looptijd = i.Looptijd,
            Methode = i.Methode,
            Activarekening = i.Activarekening,
            Afschrijvingsrekening = i.Afschrijvingsrekening,
            Kostenrekening = i.Kostenrekening,
            Eerder = i.AfgeschrevenVoorBegin != 0,
            VoorBegin = i.AfgeschrevenVoorBegin == 0 ? null : Bedragen.Getal(i.AfgeschrevenVoorBegin),
            Bron = i.Bron,
            Notitie = i.Notitie,
            Privegebruik = i.Privegebruik,
            Cataloguswaarde = i.Cataloguswaarde is { } c ? Bedragen.Getal(c) : null,
        };

        /// <summary>De invoer, of leeg als een bedrag niet te lezen is.</summary>
        public ActivumInvoer? Invoer()
        {
            static decimal? Lees(string? tekst) => string.IsNullOrWhiteSpace(tekst) ? 0m : BedragParser.TryParse(tekst, out var b) ? b : null;
            if (Lees(Aanschafwaarde) is not { } aanschaf || Lees(Restwaarde) is not { } rest || Lees(Eerder ? VoorBegin : null) is not { } voor
                || Lees(Privegebruik == Privegebruik.JaForfait ? Cataloguswaarde : null) is not { } catalogus)
            {
                return null;
            }

            return new ActivumInvoer(Omschrijving, Aanschafdatum, aanschaf, rest, Begin, Looptijd ?? 0, Methode, Activarekening ?? "", Afschrijvingsrekening ?? "",
                Kostenrekening ?? "", voor, Bron, Notitie, Privegebruik, catalogus == 0 ? null : catalogus);
        }
    }

    private sealed class Desinvesteringsformulier
    {
        public Desinvesteringssoort Soort { get; set; }
        /// <summary>"geheel" of "deel" (een keuzelijst bindt niet goed aan true/false).</summary>
        public string Omvang { get; set; } = "geheel";

        public bool Gedeeltelijk => Omvang == "deel";
        public string? Deel { get; set; } = "50";
        public DateOnly Datum { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string? Opbrengst { get; set; }
        public string? Opbrengstrekening { get; set; }
        public string? Resultaatrekening { get; set; }
        public bool EerstAfschrijven { get; set; } = true;

        public Desinvesteringsinvoer Invoer()
        {
            var deel = !Gedeeltelijk ? 100m : BedragParser.TryParse(Deel ?? "", out var d) ? d : -1m;
            var opbrengst = string.IsNullOrWhiteSpace(Opbrengst) ? 0m : BedragParser.TryParse(Opbrengst, out var o) ? o : -1m;
            return new Desinvesteringsinvoer(Datum, Soort, deel, opbrengst, Opbrengstrekening, Resultaatrekening, EerstAfschrijven);
        }
    }

    private Geopend? geopend;
    private Rekeningschema? schema;
    private Activumdetail? detail;
    private Formulier? f;
    private Desinvesteringsformulier weg = new();
    private IReadOnlyList<string>? formfouten;
    private readonly Herzieningsformulier herzien = new();
    private static readonly System.Globalization.CultureInfo Nl = System.Globalization.CultureInfo.GetCultureInfo("nl-NL");

    private sealed class Herzieningsformulier
    {
        public DateOnly Vanaf { get; set; }

        public string? Percentage { get; set; }
    }

    private static string Procent(decimal procent) => $"{procent.ToString("0.##", Nl)}%";

    /// <summary>Wat de wijziging doet: het nieuwe bedrag per maand en de laatste maand (zonder latere desinvesteringen).</summary>
    private (decimal PerMaand, DateOnly Eind)? Vooruitblik()
    {
        if (detail is null || !BedragParser.TryParse(herzien.Percentage ?? "", out var procent) || procent is <= 0 or > 100)
        {
            return null;
        }

        var vanaf = new DateOnly(herzien.Vanaf.Year, herzien.Vanaf.Month, 1);
        var perMaand = Math.Round((detail.Aanschafwaarde - detail.Restwaarde) * procent / 100m / 12m, 2, MidpointRounding.AwayFromZero);
        var over = detail.Boekwaarde - detail.Restwaarde - detail.Plan.Where(m => !m.Geboekt && m.Maand < vanaf).Sum(m => m.Bedrag);
        return perMaand <= 0 || over <= 0 ? null : (perMaand, vanaf.AddMonths((int)Math.Ceiling(over / perMaand) - 1));
    }

    private void ZetHerzienVoorstel()
    {
        herzien.Vanaf = detail?.Plan.FirstOrDefault(m => !m.Geboekt)?.Maand ?? new DateOnly(DateTime.Today.Year + 1, 1, 1);
        var huidig = detail?.Herzieningen is { Count: > 0 } h ? h[^1].PercentagePerJaar : detail is { Invoer.Looptijd: > 0 } d ? 1200m / d.Invoer.Looptijd : 0m;
        herzien.Percentage = huidig > 0 ? huidig.ToString("0.##", Nl) : null;
    }

    private async Task Herzie()
    {
        if (!BedragParser.TryParse(herzien.Percentage ?? "", out var procent))
        {
            fouten = ["Het percentage is niet te lezen."];
            return;
        }

        bezig = true;
        var uitkomst = await Activa.Herzie(geopend!.Wie, Id, detail!.Id, herzien.Vanaf, procent);
        bezig = false;
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            await Herlaad($"Afschrijving gewijzigd: vanaf {herzien.Vanaf.ToString("MMMM yyyy", Nl)} {Procent(procent)} per jaar.");
        }
    }

    private async Task VerwijderHerziening(DateOnly maand)
    {
        bezig = true;
        var uitkomst = await Activa.VerwijderHerziening(geopend!.Wie, Id, detail!.Id, maand);
        bezig = false;
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            await Herlaad("Wijziging van de afschrijving verwijderd.");
        }
    }
    private Boekingsdetail? aanschaf;
    private bool toonFactuur;
    private Desinvesteringsvoorstel? voorstel;
    private readonly HashSet<int> openJaren = [];
    private bool mag;
    private bool bezig;
    private string? bericht;
    private IReadOnlyList<string> fouten = [];

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public Guid? ActivumId { get; set; }

    /// <summary>Nieuw uit een aanschaf: de boeking (bijv. "INK 2026-0012") en de activarekening.</summary>
    [SupplyParameterFromQuery(Name = "bron")]
    public string? Bron { get; set; }

    [SupplyParameterFromQuery(Name = "rekening")]
    public string? BronRekening { get; set; }

    private string Titel => detail?.Invoer.Omschrijving ?? "Nieuw actief";

    private bool Vast => detail is { Vast: true } or { BuitenGebruikOp: not null };

    private bool IsWeg => detail?.BuitenGebruikOp is not null;

    private static DateOnly VorigeMaand => DateOnly.FromDateTime(DateTime.Today) is var d ? new DateOnly(d.Year, d.Month, 1).AddDays(-1) : default;

    private static string Soort(Desinvesteringssoort soort) => soort switch
    {
        Desinvesteringssoort.Inruil => "inruil",
        Desinvesteringssoort.Sloop => "sloop",
        _ => "verkoop",
    };

    /// <summary>Het plan: zoals opgeslagen, of bij een nieuw actief een voorbeeld uit het formulier.</summary>
    private IReadOnlyList<Afschrijvingsmaand>? Plan =>
        detail is not null ? detail.Plan
        : f?.Invoer()?.NaarDomein() is { } a && !a.Controleer().Any() ? Afschrijvingsplan.Maak(a) : null;

    private async Task Open(Geopend g)
    {
        geopend = g;
        mag = g.Kop.Mag(Recht.Boekhouden);
        schema = await Grootboek.Schema(g.Wie, Id);
        if (ActivumId is { } id)
        {
            detail = await Activa.Open(g.Wie, Id, id);
            if (detail is null)
            {
                fouten = ["Dit actief bestaat niet (meer)."];
                return;
            }

            f = Formulier.Van(detail.Invoer);
            ZetHerzienVoorstel();
            if (detail.Invoer.Bron is { } bron && bron.Split(' ', 2) is [var dagboek, var boekstuk])
            {
                aanschaf = await Grootboek.Boeking(g.Wie, Id, dagboek, boekstuk);
            }

            await StartDesinvestering();
            return;
        }

        var vandaag = DateOnly.FromDateTime(DateTime.Today);
        f = new Formulier { Aanschafdatum = vandaag, Begin = new DateOnly(vandaag.Year, vandaag.Month, 1) };
        if (Bron is not null && (await Activa.Kandidaten(g.Wie, Id)).FirstOrDefault(k => k.Boekstuk == Bron && (BronRekening is null || k.Rekening == BronRekening)) is { } kandidaat)
        {
            f = Formulier.Van(kandidaat.Voorstel);
        }
    }

    private void Wissel(int jaar)
    {
        if (!openJaren.Remove(jaar))
        {
            openJaren.Add(jaar);
        }
    }

    private async Task KiesActivarekening(string? rekening)
    {
        f!.Activarekening = rekening;
        if (rekening is { Length: > 0 } && detail is null && string.IsNullOrEmpty(f.Afschrijvingsrekening) && string.IsNullOrEmpty(f.Kostenrekening))
        {
            var (afschrijving, kosten, looptijd) = await Activa.Rekeningvoorstel(geopend!.Wie, Id, rekening);
            (f.Afschrijvingsrekening, f.Kostenrekening, f.Looptijd) = (afschrijving, kosten, looptijd);
        }
    }

    private async Task Bewaar()
    {
        if (f!.Invoer() is not { } invoer)
        {
            formfouten = ["Een bedrag is niet te lezen."];
            return;
        }

        bezig = true;
        var uitkomst = await Activa.Bewaar(geopend!.Wie, Id, detail?.Id, invoer);
        formfouten = uitkomst.Fouten;
        bezig = false;
        if (!uitkomst.IsGelukt)
        {
            return;
        }

        if (detail is null)
        {
            Navigatie.NavigateTo($"/a/{Id}/activa/{uitkomst.Waarde}");
            return;
        }

        await Herlaad("Opgeslagen.");
    }

    private async Task Verwijder()
    {
        bezig = true;
        var uitkomst = await Activa.Verwijder(geopend!.Wie, Id, detail!.Id);
        fouten = uitkomst.Fouten;
        bezig = false;
        if (uitkomst.IsGelukt)
        {
            Navigatie.NavigateTo($"/a/{Id}/activa");
        }
    }

    /// <summary>Het jaar met de eerste maand die nog niet geboekt is staat open; de rekeningen van de vorige desinvestering als voorstel.</summary>
    private async Task StartDesinvestering()
    {
        openJaren.Clear();
        openJaren.Add(detail!.Plan.FirstOrDefault(m => !m.Geboekt)?.Maand.Year ?? DateTime.Today.Year);
        if (weg.Resultaatrekening is null && weg.Opbrengstrekening is null)
        {
            (weg.Opbrengstrekening, weg.Resultaatrekening) = await Activa.VorigeDesinvesteringsrekeningen(geopend!.Wie, Id);
        }

        await Herbereken();
    }

    private async Task Herbereken()
    {
        if (detail is { BuitenGebruikOp: null } && mag)
        {
            voorstel = await Activa.VoorstelDesinvestering(geopend!.Wie, Id, detail.Id, weg.Invoer());
        }
    }

    private async Task KiesDatum(DateOnly datum)
    {
        weg.Datum = datum;
        await Herbereken();
    }

    private async Task KiesOpbrengstrekening(string? rekening)
    {
        weg.Opbrengstrekening = rekening;
        await Herbereken();
    }

    private async Task KiesResultaatrekening(string? rekening)
    {
        weg.Resultaatrekening = rekening;
        await Herbereken();
    }

    private async Task Desinvesteer()
    {
        bezig = true;
        var uitkomst = await Activa.Desinvesteer(geopend!.Wie, Id, detail!.Id, weg.Invoer());
        fouten = uitkomst.Fouten;
        bezig = false;
        if (uitkomst.IsGelukt)
        {
            weg = new() { Opbrengstrekening = weg.Opbrengstrekening, Resultaatrekening = weg.Resultaatrekening };
            await Herlaad("Gedesinvesteerd.");
        }
    }

    private async Task Terugdraaien(long desinvestering)
    {
        bezig = true;
        var uitkomst = await Activa.TerugdraaienDesinvestering(geopend!.Wie, Id, desinvestering);
        fouten = uitkomst.Fouten;
        bezig = false;
        if (uitkomst.IsGelukt)
        {
            await Herlaad("Teruggedraaid met een tegenboeking.");
        }
    }

    private async Task AfschrijvenTotVorigeMaand()
    {
        bezig = true;
        var uitkomst = await Activa.Afschrijven(geopend!.Wie, Id, VorigeMaand, Afschrijvingsfrequentie.Maand, detail!.Id);
        fouten = uitkomst.Fouten;
        bezig = false;
        if (uitkomst.IsGelukt)
        {
            await Herlaad($"{uitkomst.Waarde} {(uitkomst.Waarde == 1 ? "afschrijvingsboeking" : "afschrijvingsboekingen")} in het memoriaal.");
        }
    }

    private async Task Herlaad(string melding)
    {
        detail = await Activa.Open(geopend!.Wie, Id, detail!.Id);
        f = Formulier.Van(detail!.Invoer);
        (bericht, formfouten) = (melding, null);
        ZetHerzienVoorstel();
        await StartDesinvestering();
    }
}
