@page "/a/{Id:guid}/bank"
@using Boekerhouden.Boekhouding.Afletteren
@using Boekerhouden.Boekhouding.Bank
@using Boekerhouden.Boekhouding.Relaties
@inject BankDienst Bank
@inject InkoopDienst Inkoop

<AdministratieKader Id="Id" Titel="Bank" Actief="/bank" BijOpenen="Open">
    @if (context.Mag(Recht.Invoeren))
    {
        <div class="card card-body mb-3 inlezen">
            <label class="form-label fw-semibold mb-1" for="afschriften">Afschriften inlezen</label>
            <InputFile id="afschriften" class="form-control" multiple accept=".mt940,.940,.sta,.swi,.txt,.xml,.camt" OnChange="LeesIn" disabled="@bezig" />
            @if (bezig)
            {
                <div class="status mt-2">bezig met inlezen…</div>
            }
            @foreach (var (bestand, uitkomst) in uitkomsten)
            {
                @if (uitkomst.Waarde is { } w)
                {
                    <div class="small mt-1">@bestand: @Samenvatting(w)</div>
                    @foreach (var m in w.Meldingen)
                    {
                        <div class="small status let-op">@m</div>
                    }
                }
                else
                {
                    <div class="small mt-1 status let-op">@string.Join(" ", uitkomst.Fouten)</div>
                }
            }
        </div>
    }

    <div class="d-flex align-items-center mb-2 werklijsten">
        <nav class="nav nav-underline small" aria-label="Werklijsten">
            <button class="nav-link @(lijst == Werklijst.Mutaties ? "active" : null)" @onclick="() => Toon(Werklijst.Mutaties)">@(ookGeboekt ? "Mutaties" : "Te verwerken")</button>
            <button class="nav-link @(lijst == Werklijst.OpenPosten ? "active" : null)" @onclick="() => Toon(Werklijst.OpenPosten)">Openstaande posten</button>
            <button class="nav-link @(lijst == Werklijst.Verschillen ? "active" : null)" @onclick="() => Toon(Werklijst.Verschillen)">Verschillen</button>
        </nav>
        @if (lijst == Werklijst.Mutaties)
        {
            <span class="form-check form-switch ms-auto mb-0">
                <input class="form-check-input" type="checkbox" id="ookgeboekt" checked="@ookGeboekt" @onchange="WisselGeboekt" />
                <label class="form-check-label small text-secondary" for="ookgeboekt">ook geboekt</label>
            </span>
        }
    </div>
    @if (lijst == Werklijst.OpenPosten || lijst == Werklijst.Verschillen)
    {
        var posten = lijst == Werklijst.OpenPosten ? openPosten : openPosten?.Where(p => p.Deels).ToList();
        @if (lijst == Werklijst.Verschillen && vraagposten is { Rekening: { } vraagrekening, Saldo: var vraagsaldo })
        {
            <div class="small mb-2">
                <a href="/a/@Id/grootboek?rekening=@vraagrekening">Vraagposten</a>
                <span class="bedrag ms-2">@Bedragen.Getal(vraagsaldo)</span>
            </div>
        }
        @if (posten is { Count: 0 })
        {
            <div class="card card-body text-center text-secondary py-4">@(lijst == Werklijst.OpenPosten ? "Geen openstaande posten." : "Geen deelbetalingen.")</div>
        }
        else if (posten is not null)
        {
            <div class="card">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>Vervalt</th><th>Relatie</th><th>Factuur</th><th class="text-end">Bedrag</th><th class="text-end">Open</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in posten)
                        {
                            var dagen = Vandaag.DayNumber - p.Vervaldatum.DayNumber;
                            <tr>
                                <td class="text-nowrap">@Weergave.Datum(p.Vervaldatum)</td>
                                <td title="@(p.Soort == Boekhouding.Facturen.Factuursoort.Inkoop ? "Crediteur" : "Debiteur")">@p.Naam</td>
                                <td>
                                    @if (p.DocumentId is { } document)
                                    {
                                        <a href="/a/@Id/inkoop/@document" title="@Weergave.Datum(p.Datum)">@p.Factuurnummer</a>
                                    }
                                    else
                                    {
                                        <span title="@Weergave.Datum(p.Datum)">@p.Factuurnummer</span>
                                    }
                                </td>
                                <td class="bedrag text-end"><Euro Waarde="p.Bedrag" /></td>
                                <td class="bedrag text-end"><Euro Waarde="p.Openstaand" /></td>
                                <td class="small">
                                    @if (dagen > 0)
                                    {
                                        <span class="status">@dagen @(dagen == 1 ? "dag" : "dagen") vervallen</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (mutaties is { Count: 0 })
    {
        <div class="card card-body text-center text-secondary py-4">Niets te verwerken.</div>
    }
    else if (mutaties is not null)
    {
        <div class="card">
            <table class="table table-hover align-middle mb-0 bankmutaties">
                <thead>
                    <tr><th>Datum</th><th>Tegenpartij</th><th>Omschrijving</th><th class="text-end">Bedrag</th><th>Waarom</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in mutaties)
                    {
                        var open = gekozen?.Mutatie.Id == m.Id;
                        <tr class="@(m.Status == Banktransactiestatus.TeVerwerken ? "kiesbaar" : null) @(open ? "table-active" : null)" @onclick="() => Kies(m)">
                            <td class="text-nowrap">@Weergave.Datum(m.Datum)</td>
                            <td title="@(m.TegenIban is { } iban ? Iban.Toon(iban) : null)">@m.TegenNaam</td>
                            <td class="small omschrijving" title="@m.Omschrijving">@m.Omschrijving</td>
                            <td class="bedrag text-end"><Euro Waarde="m.Bedrag" /></td>
                            <td class="small text-secondary">
                                @if (m.Status == Banktransactiestatus.Geboekt)
                                {
                                    <span class="status" title="@m.Melding">geboekt</span>
                                }
                                else
                                {
                                    @m.Melding
                                }
                            </td>
                        </tr>
                        @if (open && gekozen is not null)
                        {
                            <tr class="verwerkpaneel">
                                <td colspan="5">
                                    <Foutmeldingen Fouten="fouten" />
                                    @if (gekozen.Voorstel.Afletteren.Kandidaten.Count > 0)
                                    {
                                        <div class="mb-3">
                                            <div class="paneelkop">Afletteren</div>
                                            @foreach (var k in gekozen.Voorstel.Afletteren.Kandidaten)
                                            {
                                                <div class="d-flex align-items-center gap-2 py-1 kandidaat">
                                                    <span>@string.Join(", ", k.Posten.Select(Post))</span>
                                                    <span class="small text-secondary" title="@(k.Verschil == 0 ? null : $"verschil {Bedragen.Getal(k.Verschil)}")">@k.Reden@(k.Zekerheid == Zekerheid.Zeker ? " · zeker" : null)</span>
                                                    @if (mag)
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => Afletteren(k.Posten.Select(p => p.Id).ToList())" @onclick:stopPropagation>Afletteren</button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (mag && gekozen.OpenPosten.Count > 0)
                                    {
                                        <div class="mb-3">
                                            <div class="paneelkop">Openstaande post</div>
                                            <div class="d-flex gap-2 align-items-start">
                                                <div class="openposten">
                                                    @foreach (var p in gekozen.OpenPosten)
                                                    {
                                                        <label class="form-check d-block mb-0">
                                                            <input class="form-check-input" type="checkbox" checked="@zelfGekozen.Contains(p.Id)" @onchange="() => WisselPost(p.Id)" />
                                                            <span class="form-check-label">@Post(p)</span>
                                                            <span class="small text-secondary ms-1">@Weergave.Datum(p.Datum)</span>
                                                        </label>
                                                    }
                                                </div>
                                                <button class="btn btn-sm btn-outline-primary ms-auto text-nowrap" disabled="@(zelfGekozen.Count == 0)" @onclick="() => Afletteren(zelfGekozen)">Afletteren</button>
                                            </div>
                                        </div>
                                    }
                                    @if (mag)
                                    {
                                        <div class="mb-3">
                                            <label class="paneelkop d-block" for="factuur">Factuur uploaden</label>
                                            <InputFile id="factuur" class="form-control form-control-sm" accept=".pdf,.xml,application/pdf,application/xml,text/xml" OnChange="UploadFactuur" disabled="@bezig" />
                                            @if (factuurUitkomst is { } fu)
                                            {
                                                <div class="small mt-1 @(fu.DocumentId is null || fu.Status == Documentstatus.Quarantaine ? "status let-op" : null)">
                                                    @fu.Melding
                                                    @if (fu.DocumentId is { } doc && fu.Status == Documentstatus.TeVerwerken)
                                                    {
                                                        <a class="ms-1" href="/a/@Id/inkoop/@doc">Factuur verwerken</a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <div class="paneelkop" title="@gekozen.Voorstel.Advies.Reden">Op rekening</div>
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-3">
                                                    <label class="form-label small mb-0" for="rekening">Rekening</label>
                                                    <RekeningKeuze Id="rekening" @bind-Waarde="rekening" Schema="gekozen.Schema" />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label small mb-0" for="btw">Btw</label>
                                                    <select id="btw" class="form-select form-select-sm" @bind="btwCode">
                                                        <option value="">geen</option>
                                                        @foreach (var c in gekozen.BtwCodes)
                                                        {
                                                            <option value="@c.Code" title="@c.Omschrijving">@c.Code</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-5">
                                                    <label class="form-label small mb-0" for="omschrijving">Omschrijving</label>
                                                    <input id="omschrijving" class="form-control form-control-sm" @bind="omschrijving" placeholder="@Standaardomschrijving(gekozen.Mutatie)" />
                                                </div>
                                                <div class="col-md-2 text-end">
                                                    <button class="btn btn-sm btn-primary" disabled="@string.IsNullOrWhiteSpace(rekening)" @onclick="OpRekening">Boeken</button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</AdministratieKader>

@code {
    private const int MaximumBestanden = 20;

    private Geopend? geopend;
    private IReadOnlyList<BankmutatieRegel>? mutaties;
    private List<(string Bestand, Uitkomst<Bankinlezing> Uitkomst)> uitkomsten = [];
    private bool bezig;
    private bool ookGeboekt;
    private bool mag;
    private Bankverwerking? gekozen;
    private List<Guid> zelfGekozen = [];
    private string? rekening;
    private string? btwCode;
    private string? omschrijving;
    private IReadOnlyList<string>? fouten;
    private Inleesuitkomst? factuurUitkomst;

    // De werklijsten: de mutaties, de openstaande posten (op vervaldatum) en de verschillen (deelbetalingen, vraagposten).
    private enum Werklijst
    {
        Mutaties,
        OpenPosten,
        Verschillen,
    }

    private Werklijst lijst;
    private IReadOnlyList<OpenpostRegel>? openPosten;
    private (string? Rekening, decimal Saldo)? vraagposten;

    private static DateOnly Vandaag => DateOnly.FromDateTime(DateTime.Today);

    [Parameter]
    public Guid Id { get; set; }

    private async Task Open(Geopend g)
    {
        geopend = g;
        mag = g.Kop.Mag(Recht.Invoeren);
        await Laad();
    }

    private async Task Laad()
    {
        mutaties = await Bank.Lijst(geopend!.Wie, Id, ookGeboekt);
        if (lijst != Werklijst.Mutaties)
        {
            openPosten = await Bank.OpenPosten(geopend.Wie, Id);
            vraagposten = await Bank.Vraagposten(geopend.Wie, Id);
        }
    }

    private async Task Toon(Werklijst werklijst)
    {
        lijst = werklijst;
        gekozen = null;
        await Laad();
    }

    /// <summary>Een factuur bij deze mutatie: inlezen zoals bij inkoop; na het boeken wordt hij op de mutatie afgeletterd.</summary>
    private async Task UploadFactuur(InputFileChangeEventArgs e)
    {
        bezig = true;
        try
        {
            await using var stream = e.File.OpenReadStream(Boekerhouden.Documenten.PdfTekst.MaximumBytes);
            factuurUitkomst = await Inkoop.Lees(geopend!.Wie, Id, stream, e.File.Name, e.File.ContentType, gekozen!.Mutatie.Id);
        }
        catch (IOException)
        {
            factuurUitkomst = new Inleesuitkomst(null, null, $"{e.File.Name} is te groot.");
        }

        bezig = false;
        if (factuurUitkomst.IsGeboekt)
        {
            gekozen = null;
            await Laad();
        }
    }

    private async Task WisselGeboekt(ChangeEventArgs e)
    {
        ookGeboekt = e.Value is true;
        gekozen = null;
        await Laad();
    }

    private async Task Kies(BankmutatieRegel m)
    {
        fouten = null;
        if (m.Status != Banktransactiestatus.TeVerwerken || gekozen?.Mutatie.Id == m.Id)
        {
            gekozen = null;
            return;
        }

        factuurUitkomst = null;
        gekozen = await Bank.Verwerking(geopend!.Wie, Id, m.Id);
        zelfGekozen = [];
        // Kan de mutatie de betaling van een factuur zijn, dan geen rekening vooraf: anders staat de kost er twee keer in.
        var advies = gekozen?.Voorstel.Afletteren.Kandidaten.Count == 0 ? gekozen.Voorstel.Advies : null;
        rekening = advies?.Rekeningnummer;
        btwCode = advies?.BtwCode;
        omschrijving = null;
    }

    private void WisselPost(Guid post)
    {
        if (!zelfGekozen.Remove(post))
        {
            zelfGekozen.Add(post);
        }
    }

    private async Task Afletteren(List<Guid> posten) =>
        await Na(await Bank.Afletteren(geopend!.Wie, Id, gekozen!.Mutatie.Id, posten));

    private async Task OpRekening() =>
        await Na(await Bank.OpRekening(geopend!.Wie, Id, gekozen!.Mutatie.Id, rekening ?? "", btwCode, omschrijving));

    private async Task Na(Uitkomst uitkomst)
    {
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            gekozen = null;
            await Laad();
        }
    }

    private async Task LeesIn(InputFileChangeEventArgs e)
    {
        bezig = true;
        uitkomsten = [];
        gekozen = null;
        foreach (var bestand in e.GetMultipleFiles(MaximumBestanden))
        {
            try
            {
                await using var stream = bestand.OpenReadStream(BankDienst.MaximumBytes);
                uitkomsten.Add((bestand.Name, await Bank.Lees(geopend!.Wie, Id, stream, bestand.Name)));
            }
            catch (IOException)
            {
                uitkomsten.Add((bestand.Name, Uitkomst<Bankinlezing>.Mislukt($"{bestand.Name} is groter dan {BankDienst.MaximumBytes / 1024 / 1024} MB en is niet ingelezen.")));
            }

            StateHasChanged();
        }

        bezig = false;
        await Laad();
    }

    private static string Samenvatting(Bankinlezing w)
    {
        var delen = new List<string> { w.Nieuw == 1 ? "1 nieuwe mutatie" : $"{w.Nieuw} nieuwe mutaties" };
        if (w.Automatisch > 0)
        {
            delen.Add($"{w.Automatisch} automatisch geboekt");
        }

        if (w.Dubbel > 0)
        {
            delen.Add($"{w.Dubbel} al ingelezen");
        }

        return string.Join(", ", delen);
    }

    private string Post(Boekhouding.Facturen.OpenPost p) =>
        $"{gekozen?.Relaties.FirstOrDefault(r => r.Code == p.Relatie)?.Naam ?? p.Relatie} {p.Factuurnummer} {Bedragen.Getal(p.Openstaand)}";

    private static string Standaardomschrijving(BankmutatieRegel m) =>
        string.Join(" – ", new[] { m.TegenNaam, m.Omschrijving }.Where(t => !string.IsNullOrWhiteSpace(t)));
}
