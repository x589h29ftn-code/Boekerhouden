@page "/a/{Id:guid}/bank"
@using Boekerhouden.Boekhouding.Afletteren
@using Boekerhouden.Boekhouding.Bank
@using Boekerhouden.Boekhouding.Regels
@using Boekerhouden.Boekhouding.Relaties
@inject BankDienst Bank
@inject GrootboekDienst Grootboek
@inject BtwDienst Btwtabel
@inject InkoopDienst Inkoop
@inject InrichtingDienst Inrichting
@inject IJSRuntime JS
@inject IServiceProvider Diensten
@inject Meldingen Meldingen

<AdministratieKader Id="Id" Titel="Bank" Actief="/bank" BijOpenen="Open">
    <Kenmerken>
        @foreach (var b in stand)
        {
            <span>@b.Naam @Iban.Toon(b.Iban)</span>
            <span class="scheiding">·</span>
            @if (b.Tot is { } tot)
            {
                <span>afschrift t/m @Weergave.Datum(tot)</span>
                <span class="scheiding">·</span>
                <span>saldo <strong>@Weergave.Bedrag(b.Saldo ?? 0m)</strong></span>
            }
            else
            {
                <span>nog geen afschrift</span>
            }
            <span class="scheiding">·</span>
            <span>@(b.TeVerwerken == 0 ? "alles verwerkt" : $"{b.TeVerwerken} te verwerken")</span>
            <br />
        }
    </Kenmerken>
    <Acties>
        @if (geopend?.Kop.Mag(Recht.Invoeren) == true)
        {
            <label class="btn btn-sm btn-outline-secondary @(bezig ? "disabled" : null)" for="bankpdf" title="Een rekeningafschrift dat alleen als PDF bestaat omzetten naar MT940 (om te bewaren of in te lezen)">PDF omzetten</label>
            <InputFile id="bankpdf" class="d-none" accept=".pdf,application/pdf" OnChange="ZetPdfOm" disabled="@bezig" />
            <label class="btn btn-sm btn-primary @(bezig ? "disabled" : null)" for="afschriften" aria-busy="@(bezig ? "true" : null)" title="MT940, CAMT.053 of een PDF-afschrift; slepen op de pagina kan ook">Afschrift inlezen</label>
        }
    </Acties>
    <ChildContent>
    @if (context.Mag(Recht.Invoeren))
    {
        <div class="inlezen">
            <Sleepvlak Id="afschriften" Pagina="true" Tekst="Afschriften inlezen" Accept=".mt940,.940,.sta,.swi,.txt,.xml,.camt,.pdf" OnChange="LeesIn" Bezig="bezig" />
            @if (omzetting is { } o)
            {
                <div class="bericht small mt-1 d-flex align-items-center flex-wrap gap-2">
                    <span title="@Omzettitel(o)">@Boekhouding.Relaties.Iban.Toon(o.Afschrift.Iban), @(o.Afschrift.Begindatum is { } van ? Weergave.Datum(van) : null) t/m @(o.Afschrift.Einddatum is { } tot ? Weergave.Datum(tot) : null), @o.Afschrift.Mutaties.Count mutaties, sluit op @Weergave.Bedrag(o.Afschrift.Eindsaldo)</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="BewaarMt940">MT940 downloaden</button>
                    <button class="btn btn-sm btn-primary" disabled="@bezig" @onclick="LeesOmzettingIn">Inlezen</button>
                </div>
            }
            @if (omzetfout is not null)
            {
                <div class="small mt-1 status let-op d-block">@omzetfout</div>
            }
            @foreach (var (bestand, uitkomst) in uitkomsten)
            {
                @if (uitkomst.Waarde is { } w)
                {
                    <div class="small mt-1 inleesregel">
                        <span>@bestand: @Samenvatting(w)</span>
                        @if (w.Meldingen.Count > 0)
                        {
                            <span class="let-op ms-2" title="@string.Join(Environment.NewLine, w.Meldingen)">@Meldingtekst(w)</span>
                        }
                    </div>
                }
                else
                {
                    <div class="small mt-1 status let-op">@string.Join(" ", uitkomst.Fouten)</div>
                }
            }
        </div>
    }

    <div class="d-flex align-items-center mb-2 werklijsten">
        <nav class="nav nav-underline small" aria-label="Werklijsten">
            <button class="nav-link @(lijst == Werklijst.Mutaties ? "active" : null)" @onclick="() => Toon(Werklijst.Mutaties)">@(ookGeboekt ? "Mutaties" : "Te verwerken")</button>
            <button class="nav-link @(lijst == Werklijst.OpenPosten ? "active" : null)" @onclick="() => Toon(Werklijst.OpenPosten)">Openstaande posten</button>
            <button class="nav-link @(lijst == Werklijst.Verschillen ? "active" : null)" @onclick="() => Toon(Werklijst.Verschillen)">Verschillen</button>
        </nav>
        @if (lijst == Werklijst.Mutaties)
        {
            @if (opnieuw is { } o)
            {
                <span class="small text-secondary ms-3">@InkoopPagina.Samenvatting(o)</span>
            }
            <div class="ms-auto d-flex align-items-center gap-3">
                @if (mag && (mutaties?.Count(m => m.MogelijkDubbel && m.Status == Banktransactiestatus.TeVerwerken) ?? 0) is > 0 and var dubbel)
                {
                    <button class="btn btn-sm btn-link p-0 let-op dubbelbericht" title="Alle mogelijk dubbele mutaties aanvinken" @onclick="KiesDubbel">@dubbel mogelijk dubbel</button>
                }
                @if (mag && mutaties?.Any(m => m.Status == Banktransactiestatus.TeVerwerken) == true)
                {
                    <button class="btn btn-sm btn-outline-secondary" disabled="@bezig" title="Alle mutaties in Te verwerken opnieuw herkennen: afletteren, regels (ook autoherkenning) en wat er geleerd is" aria-busy="@(bezig ? "true" : null)" @onclick="VerwerkOpnieuw">Opnieuw herkennen</button>
                }
                <button class="btn btn-sm btn-outline-secondary" title="De openstaande posten in een eigen venster, bijv. op een tweede beeldscherm" @onclick="OpenpostenExtern"><Icoon Naam="app-window" /><span>Posten in venster</span></button>
                <span class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="ookgeboekt" checked="@ookGeboekt" @onchange="WisselGeboekt" />
                    <label class="form-check-label small text-secondary" for="ookgeboekt">Ook geboekt</label>
                </span>
            </div>
        }
    </div>
    @if (lijst == Werklijst.OpenPosten || lijst == Werklijst.Verschillen)
    {
        var posten = lijst == Werklijst.OpenPosten ? openPosten : openPosten?.Where(p => p.Deels).ToList();
        @if (lijst == Werklijst.Verschillen && vraagposten is { Rekening: { } vraagrekening, Saldo: var vraagsaldo })
        {
            <div class="small mb-2">
                <a href="/a/@Id/grootboek?rekening=@vraagrekening">Vraagposten</a>
                <span class="bedrag ms-2">@Weergave.Bedrag(vraagsaldo)</span>
            </div>
        }
        @if (posten is { Count: 0 })
        {
            <div class="leeg-regel">@(lijst == Werklijst.OpenPosten ? "Geen openstaande posten." : "Geen deelbetalingen.")</div>
        }
        else if (posten is not null)
        {
            <div class="card">
                <table class="table table-sm align-middle mb-0" data-sleepbaar="bank-werklijst">
                    <thead>
                        <tr>
                            <SorteerKop Sortering="postsortering" Naam="Vervalt" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="postsortering" Naam="Relatie" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="postsortering" Naam="Factuur" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="postsortering" Naam="Bedrag" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="postsortering" Naam="Open" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in postsortering.Pas(posten))
                        {
                            var dagen = Vandaag.DayNumber - p.Vervaldatum.DayNumber;
                            <tr>
                                <td class="text-nowrap">@Weergave.Datum(p.Vervaldatum)</td>
                                <td title="@(p.Soort == Boekhouding.Facturen.Factuursoort.Inkoop ? "Crediteur" : "Debiteur")">@p.Naam</td>
                                <td>
                                    @if (p.DocumentId is { } document)
                                    {
                                        <a href="/a/@Id/inkoop/@document" title="@Weergave.Datum(p.Datum)">@p.Factuurnummer</a>
                                    }
                                    else
                                    {
                                        <span title="@Weergave.Datum(p.Datum)">@p.Factuurnummer</span>
                                    }
                                </td>
                                <td class="bedrag text-end"><Euro Waarde="p.Bedrag" /></td>
                                <td class="bedrag text-end"><Euro Waarde="p.Openstaand" /></td>
                                <td class="small">
                                    @if (dagen > 0)
                                    {
                                        <span class="status">@dagen @(dagen == 1 ? "dag" : "dagen") vervallen</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (mutaties is { Count: 0 })
    {
        <LegeStaat Icoon="circle-check" Tekst="Alle mutaties zijn verwerkt">
            @if (context.Mag(Recht.Invoeren))
            {
                <label class="btn btn-sm btn-outline-primary" for="afschriften">Afschrift inlezen</label>
            }
        </LegeStaat>
    }
    else if (mutaties is not null)
    {
        var zichtbaar = mutatiesortering.Pas(mutaties.Where(PastFilter)).ToList();
        var teKiezen = zichtbaar.Where(m => m.Status == Banktransactiestatus.TeVerwerken).ToList();
        <div class="row g-3 bankwerk">
            <div class="@(gekozen is null ? "col-12" : "col-lg-5")">
                @if (gekozen is null)
                {
                    <Foutmeldingen Fouten="fouten" />
                }
                <div class="card">
                    <table class="table table-sm table-hover align-middle mb-0 bankmutaties @(geselecteerd.Count > 0 ? "met-keuze" : null)" data-sleepbaar="bankmutaties">
                        <thead>
                            <tr>
                                @if (mag)
                                {
                                    <th class="kiesvak" data-breedte="24">
                                        <input class="form-check-input" type="checkbox" aria-label="Alle zichtbare mutaties kiezen" title="Alle zichtbare mutaties"
                                               checked="@(teKiezen.Count > 0 && teKiezen.All(m => geselecteerd.Contains(m.Id)))" @onchange="e => KiesAlles(teKiezen, e.Value is true)" />
                                    </th>
                                }
                                <SorteerKop Sortering="mutatiesortering" Naam="Datum" Breedte="112" Gewijzigd="StateHasChanged" />
                                <SorteerKop Sortering="mutatiesortering" Naam="Tegenpartij" Tekst="Tegenpartij en omschrijving" Klasse="rekt" Gewijzigd="StateHasChanged" />
                                <SorteerKop Sortering="mutatiesortering" Naam="Bedrag" Klasse="text-end" Breedte="128" Gewijzigd="StateHasChanged" />
                            </tr>
                            <tr class="filterrij">
                                @if (mag)
                                {
                                    <th></th>
                                }
                                <th><input class="form-control form-control-sm" placeholder="Filter" aria-label="Filter op datum" @bind="filterDatum" @bind:event="oninput" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Filter op naam of omschrijving" aria-label="Filter op naam of omschrijving" @bind="filterTekst" @bind:event="oninput" /></th>
                                <th><input class="form-control form-control-sm text-end" placeholder="Filter" aria-label="Filter op bedrag" title="Een bedrag (ook een deel, bijv. 199) of van-tot (bijv. 10-50); zonder minteken telt af en bij" @bind="filterBedrag" @bind:event="oninput" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in zichtbaar)
                            {
                                var open = gekozen?.Mutatie.Id == m.Id;
                                <tr class="@(m.Status == Banktransactiestatus.TeVerwerken ? "kiesbaar" : "geboekt") @(open ? "table-active" : null) @(verwerkt == m.Id ? "verwerkt" : null)" @onclick="() => Kies(m)"
                                    tabindex="0" data-toetsrij @key="m.Id">
                                    @if (mag)
                                    {
                                        <td class="kiesvak" @onclick:stopPropagation>
                                            @if (m.Status == Banktransactiestatus.TeVerwerken)
                                            {
                                                <input class="form-check-input" type="checkbox" aria-label="Kiezen" checked="@geselecteerd.Contains(m.Id)" @onchange="e => KiesMutatie(m.Id, e.Value is true)" />
                                            }
                                        </td>
                                    }
                                    <td class="text-nowrap datum">@Weergave.Datum(m.Datum)</td>
                                    <td class="omschrijving" title="@string.Join(Environment.NewLine, new[] { m.TegenNaam, m.TegenIban is { } iban ? Iban.Toon(iban) : null, m.Omschrijving, m.Melding }.Where(t => !string.IsNullOrWhiteSpace(t)))"
                                        @ondblclick="() => KiesPosten(m)" @ondblclick:stopPropagation>
                                        <span class="regeltekst">
                                            <span class="regeltekst-tekst">@if (m.TegenNaam is { Length: > 0 })
                                                {
                                                    <span>@m.TegenNaam</span>
                                                }<span class="small text-secondary ms-1">@m.Omschrijving</span></span>
                                            @if (m.MogelijkDubbel && m.Status == Banktransactiestatus.TeVerwerken)
                                            {
                                                <Statusstip Soort="Stipsoort.LetOp">dubbel?</Statusstip>
                                            }
                                        </span>
                                    </td>
                                    <td class="bedrag text-end text-nowrap"><Euro Waarde="m.Bedrag" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (mag && geselecteerd.Count > 0)
                {
                    var selectie = mutaties.Where(m => geselecteerd.Contains(m.Id)).ToList();
                    <div class="actiebalk" role="region" aria-label="Gekozen mutaties">
                        <span class="small fw-semibold text-nowrap">@selectie.Count gekozen</span>
                        <span class="small bedrag text-nowrap"><Euro Waarde="selectie.Sum(m => m.Bedrag)" /></span>
                        <div class="flex-grow-1" style="min-width:14rem"><RekeningKeuze Id="selectie-rekening" @bind-Waarde="selectieRekening" Schema="schema" Kader="geopend" Label="Rekening voor de selectie" /></div>
                        <select class="form-select form-select-sm w-auto" @bind="selectieBtw" aria-label="Btw voor de selectie">
                            <option value="">Geen btw</option>
                            @foreach (var c in btwcodes.Where(c => c.Actief))
                            {
                                <option value="@c.Code" title="@c.Code · @c.Omschrijving">@c.Kort</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-primary" disabled="@(bezig || string.IsNullOrWhiteSpace(selectieRekening))" @onclick="BoekSelectie">Boeken</button>
                        <VerwijderKnop Klasse="p-0" Bezig="bezig" Titel="De gekozen mutaties verdwijnen uit Te verwerken (bijv. dubbel ingelezen); een geboekte mutatie kan niet weg" Bevestigd="VerwijderSelectie" />
                        <button class="btn btn-sm btn-link text-secondary p-0" @onclick="() => geselecteerd.Clear()">Selectie wissen</button>
                    </div>
                }
            </div>
            <div class="@(gekozen is null ? "d-none" : "col-lg-7")">
                @if (gekozen is { } g)
                {
                    <div class="card card-body verwerkpaneel">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="me-auto min-w-0">
                                <div class="paneelnaam text-truncate">@Weergave.Tegenpartij(g.Mutatie.TegenNaam, g.Mutatie.Omschrijving)</div>
                                <div class="bedrag fs-5"><Euro Waarde="g.Mutatie.Bedrag" /></div>
                                @if (mag && g.Mutatie.Status == Banktransactiestatus.TeVerwerken)
                                {
                                    <VerwijderKnop Klasse="p-0 mt-1" Bezig="bezig" Titel="De mutatie verdwijnt uit Te verwerken (bijv. dubbel ingelezen)" Bevestigd="VerwijderGekozen" />
                                }
                            </div>
                            @if (g.Saldo is { } saldo)
                            {
                                <div class="banksaldo" title="Het saldo in het grootboek aan het eind van @saldo.Jaar, en op het afschrift voor en na deze mutatie">
                                    <div class="fw-semibold"><span class="rekeningnummer">@saldo.Rekening</span> @saldo.Naam</div>
                                    <dl>
                                        <dt>Eindsaldo @saldo.Jaar</dt><dd><Euro Waarde="saldo.Eindsaldo" /></dd>
                                        <dt>Voor boeking</dt><dd><Euro Waarde="saldo.VoorBoeking" /></dd>
                                        <dt>Na boeking</dt><dd><Euro Waarde="saldo.NaBoeking" /></dd>
                                    </dl>
                                </div>
                            }
                        </div>
                        <div class="transactiegegevens mb-3">
                            <div class="transactiegegevens-kop">Transactiegegevens</div>
                            <dl>
                                <dt>Datum</dt><dd>@Weergave.Datum(g.Mutatie.Datum)</dd>
                                @if (g.Mutatie.TegenNaam is { Length: > 0 } tegenNaam)
                                {
                                    <dt>Naam</dt><dd>@tegenNaam</dd>
                                }
                                @if (g.Mutatie.TegenIban is { } tegen)
                                {
                                    <dt>Tegenrekening</dt><dd>@Iban.Toon(tegen)</dd>
                                }
                                <dt>Omschrijving</dt><dd>@g.Mutatie.Omschrijving</dd>
                                @if (g.Mutatie.Betalingskenmerk is { Length: > 0 } kenmerk)
                                {
                                    <dt>Kenmerk</dt><dd>@kenmerk</dd>
                                }
                                @if (g.Mutatie.EndToEndId is { Length: > 0 } referentie)
                                {
                                    <dt>Referentie</dt><dd>@referentie</dd>
                                }
                                <dt>Bedrag</dt><dd><Euro Waarde="g.Mutatie.Bedrag" /></dd>
                            </dl>
                        </div>
                        @if (mag && g.Mutatie.Status == Banktransactiestatus.TeVerwerken && g.Mutatie.MogelijkDubbel)
                        {
                            <div class="d-flex align-items-center gap-2 mb-3 dubbelcontrole">
                                <span class="small status let-op me-auto">@g.Mutatie.Melding</span>
                                <button class="btn btn-sm btn-outline-secondary text-nowrap" disabled="@bezig" @onclick="GeenDubbel">Niet dubbel</button>
                            </div>
                        }
                        <Foutmeldingen Fouten="fouten" />
                        @if (g.Voorstel.Afletteren.Kandidaten.Count > 0)
                        {
                            <div class="mb-3">
                                <div class="paneelkop">Voorstel</div>
                                @foreach (var k in g.Voorstel.Afletteren.Kandidaten)
                                {
                                    <div class="d-flex align-items-center gap-2 py-1 kandidaat">
                                        <span>@string.Join(", ", k.Posten.Select(Post))</span>
                                        <span class="small text-secondary" title="@(k.Verschil == 0 ? null : $"verschil {Weergave.Bedrag(k.Verschil)}")">@k.Reden@(k.Zekerheid == Zekerheid.Zeker ? " · zeker" : null)</span>
                                        @if (mag && k.Korting)
                                        {
                                            <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => OpenVenster(k.Posten.Select(p => p.Id).ToList(), afboeken: true)">Afletteren…</button>
                                        }
                                        else if (mag)
                                        {
                                            <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => Afletteren(k.Posten.Select(p => p.Id).ToList())">Afletteren</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (mag)
                        {
                            <div class="mb-2">
                                <div class="paneelkop mb-0" title="@g.Voorstel.Advies.Reden">Regels</div>
                                <table class="table table-sm align-middle mb-0 bankregels">
                                    <thead>
                                        <tr><th>Factuurnummer</th><th>Rekening</th>@if (!ZonderBtw)
                                            {
                                                <th>Btw</th>
                                            }<th class="text-end">Bedrag</th><th>Omschrijving</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < regels.Count; i++)
                                        {
                                            var regel = regels[i];
                                            var n = i;
                                            var post = regel.Post is { } pid ? g.OpenPosten.FirstOrDefault(p => p.Id == pid) : null;
                                            <tr class="regel-hover">
                                                <td>
                                                    <PostKeuze Id="@($"regel-factuur-{n}")" Waarde="regel.Post" WaardeChanged="p => KiesPost(regel, p)" Verwerking="g" Kader="geopend"
                                                               Uitgesloten="@([.. regels.Where(r => r != regel && r.Post is not null).Select(r => r.Post!.Value)])" />
                                                </td>
                                                <td>
                                                    @if (post is not null)
                                                    {
                                                        <span class="small text-secondary text-truncate d-block" title="@Rekeningnaam(g, Postrekening(g, post))">@Rekeningnaam(g, Postrekening(g, post))</span>
                                                    }
                                                    else
                                                    {
                                                        <RekeningKeuze Id="@($"regel-rekening-{n}")" @bind-Waarde:get="regel.Rekening" @bind-Waarde:set="w => KiesRekening(regel, w)" Schema="g.Schema" Kader="geopend" />
                                                    }
                                                </td>
                                                @if (!ZonderBtw)
                                                {
                                                    <td>
                                                        <select id="@($"regel-btw-{n}")" class="form-select form-select-sm" @bind="regel.BtwCode" disabled="@(post is not null)" aria-label="Btw">
                                                            <option value="">geen</option>
                                                            @foreach (var c in g.BtwCodes.Where(c => c.Actief))
                                                            {
                                                                <option value="@c.Code" title="@c.Code · @c.Omschrijving">@c.Kort</option>
                                                            }
                                                        </select>
                                                    </td>
                                                }
                                                <td><input id="@($"regel-bedrag-{n}")" class="form-control form-control-sm text-end" @bind="regel.Bedrag" aria-label="Bedrag" /></td>
                                                <td><input id="@($"regel-omschrijving-{n}")" class="form-control form-control-sm" @bind="regel.Omschrijving" aria-label="Omschrijving" placeholder="@(post is not null ? $"Betaling {post.Factuurnummer}" : Standaardomschrijving(g.Mutatie))" /></td>
                                                <td>
                                                    @if (regels.Count > 1)
                                                    {
                                                        <button class="btn btn-sm btn-link text-secondary regelactie p-0" title="Regel weghalen" aria-label="Regel weghalen" @onclick="() => regels.RemoveAt(n)"><Icoon Naam="x" /></button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-3 small mb-3 totalen">
                                <button class="btn btn-sm btn-outline-primary" @onclick="RegelErbij"><Icoon Naam="plus" /> Regel toevoegen</button>
                                <span>Posten <Euro Waarde="Postentotaal" /></span>
                                <span>Regels <Euro Waarde="Regeltotaal" /></span>
                                <span class="@(Verschil == 0 ? "text-secondary" : "status let-op")">Verschil <Euro Waarde="Verschil" /></span>
                                <button class="btn btn-sm btn-primary ms-auto" disabled="@bezig" @onclick="Boeken">Boeken</button>
                            </div>
                            @if (magRegels)
                            {
                                <div class="mb-3 autoherkenning">
                                    @if (g.Regel is { } treffer)
                                    {
                                        <div class="d-flex align-items-center gap-2 mb-1 small regeltreffer">
