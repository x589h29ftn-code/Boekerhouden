    private void BewerkBank(Bankstand b) =>
        (nieuweBank, bankfouten) = (new NieuweBank { Code = b.Dagboek, Naam = b.Naam, Iban = b.Iban is { } i ? Iban.Toon(i) : null, Rekening = b.Rekening ?? "", Bestaand = true }, null);

    private async Task VoegBankToe()
    {
        if (nieuweBank!.Bestaand)
        {
            bezig = true;
            var gewijzigd = await Bank.WijzigBank(geopend!.Wie, Id, nieuweBank.Code, nieuweBank.Naam, nieuweBank.Iban, nieuweBank.Rekening ?? "");
            bezig = false;
            bankfouten = gewijzigd.Fouten;
            if (gewijzigd.IsGelukt)
            {
                (nieuweBank, bankfouten) = (null, null);
                await Laad();
                Meldingen.Toon("Bankrekening opgeslagen.");
            }

            return;
        }

        bezig = true;
        var uitkomst = await Bank.VoegBankToe(geopend!.Wie, Id, nieuweBank!.Code, nieuweBank.Naam, nieuweBank.Iban, nieuweBank.Rekening ?? "");
        bezig = false;
        bankfouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            (nieuweBank, bankfouten) = (null, null);
            await Laad();
            KiesBank(uitkomst.Waarde);
            Meldingen.Toon($"Bankrekening {uitkomst.Waarde} toegevoegd.");
        }
    }

    private sealed class NieuweBank
    {
        public string Code { get; set; } = "";

