@page "/a/{Id:guid}/bank"
@using Boekerhouden.Boekhouding.Afletteren
@using Boekerhouden.Boekhouding.Bank
@using Boekerhouden.Boekhouding.Regels
@using Boekerhouden.Boekhouding.Relaties
@inject BankDienst Bank
@inject InkoopDienst Inkoop
@inject InrichtingDienst Inrichting
@inject IJSRuntime JS
@inject IServiceProvider Diensten

<AdministratieKader Id="Id" Titel="Bank" Actief="/bank" BijOpenen="Open">
    @if (context.Mag(Recht.Invoeren))
    {
        <div class="mb-4 inlezen">
            <Sleepvlak Id="afschriften" Tekst="Afschriften hierheen slepen of kiezen" Soorten="MT940 of CAMT.053" Accept=".mt940,.940,.sta,.swi,.txt,.xml,.camt" OnChange="LeesIn" Bezig="bezig" />
            @foreach (var (bestand, uitkomst) in uitkomsten)
            {
                @if (uitkomst.Waarde is { } w)
                {
                    <div class="small mt-1">@bestand: @Samenvatting(w)</div>
                    @foreach (var m in w.Meldingen)
                    {
                        <div class="small status let-op">@m</div>
                    }
                }
                else
                {
                    <div class="small mt-1 status let-op">@string.Join(" ", uitkomst.Fouten)</div>
                }
            }
        </div>
    }

    <div class="d-flex align-items-center mb-2 werklijsten">
        <nav class="nav nav-underline small" aria-label="Werklijsten">
            <button class="nav-link @(lijst == Werklijst.Mutaties ? "active" : null)" @onclick="() => Toon(Werklijst.Mutaties)">@(ookGeboekt ? "Mutaties" : "Te verwerken")</button>
            <button class="nav-link @(lijst == Werklijst.OpenPosten ? "active" : null)" @onclick="() => Toon(Werklijst.OpenPosten)">Openstaande posten</button>
            <button class="nav-link @(lijst == Werklijst.Verschillen ? "active" : null)" @onclick="() => Toon(Werklijst.Verschillen)">Verschillen</button>
        </nav>
        @if (lijst == Werklijst.Mutaties)
        {
            @if (opnieuw is { } o)
            {
                <span class="small text-secondary ms-3">@InkoopPagina.Samenvatting(o)</span>
            }
            <div class="ms-auto d-flex align-items-center gap-3">
                @if (mag && mutaties?.Any(m => m.Status == Banktransactiestatus.TeVerwerken) == true)
                {
                    <button class="btn btn-sm btn-outline-secondary" disabled="@bezig" title="Alle mutaties in Te verwerken opnieuw herkennen: afletteren, regels (ook autoherkenning) en wat er geleerd is" @onclick="VerwerkOpnieuw">Opnieuw herkennen</button>
                }
                <button class="btn btn-sm btn-outline-secondary" title="De openstaande posten in een eigen venster, bijv. op een tweede beeldscherm" @onclick="OpenpostenExtern">Openstaande posten &#x29c9;</button>
                <span class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="ookgeboekt" checked="@ookGeboekt" @onchange="WisselGeboekt" />
                    <label class="form-check-label small text-secondary" for="ookgeboekt">ook geboekt</label>
                </span>
            </div>
        }
    </div>
    @if (lijst == Werklijst.OpenPosten || lijst == Werklijst.Verschillen)
    {
        var posten = lijst == Werklijst.OpenPosten ? openPosten : openPosten?.Where(p => p.Deels).ToList();
        @if (lijst == Werklijst.Verschillen && vraagposten is { Rekening: { } vraagrekening, Saldo: var vraagsaldo })
        {
            <div class="small mb-2">
                <a href="/a/@Id/grootboek?rekening=@vraagrekening">Vraagposten</a>
                <span class="bedrag ms-2">@Bedragen.Getal(vraagsaldo)</span>
            </div>
        }
        @if (posten is { Count: 0 })
        {
            <div class="card card-body text-center text-secondary py-4">@(lijst == Werklijst.OpenPosten ? "Geen openstaande posten." : "Geen deelbetalingen.")</div>
        }
        else if (posten is not null)
        {
            <div class="card">
                <table class="table table-sm align-middle mb-0" data-sleepbaar="bank-werklijst">
                    <thead>
                        <tr>
                            <SorteerKop Sortering="postsortering" Naam="Vervalt" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="postsortering" Naam="Relatie" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="postsortering" Naam="Factuur" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="postsortering" Naam="Bedrag" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="postsortering" Naam="Open" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in postsortering.Pas(posten))
                        {
                            var dagen = Vandaag.DayNumber - p.Vervaldatum.DayNumber;
                            <tr>
                                <td class="text-nowrap">@Weergave.Datum(p.Vervaldatum)</td>
                                <td title="@(p.Soort == Boekhouding.Facturen.Factuursoort.Inkoop ? "Crediteur" : "Debiteur")">@p.Naam</td>
                                <td>
                                    @if (p.DocumentId is { } document)
                                    {
                                        <a href="/a/@Id/inkoop/@document" title="@Weergave.Datum(p.Datum)">@p.Factuurnummer</a>
                                    }
                                    else
                                    {
                                        <span title="@Weergave.Datum(p.Datum)">@p.Factuurnummer</span>
                                    }
                                </td>
                                <td class="bedrag text-end"><Euro Waarde="p.Bedrag" /></td>
                                <td class="bedrag text-end"><Euro Waarde="p.Openstaand" /></td>
                                <td class="small">
                                    @if (dagen > 0)
                                    {
                                        <span class="status">@dagen @(dagen == 1 ? "dag" : "dagen") vervallen</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (mutaties is { Count: 0 })
    {
        <div class="card card-body text-center text-secondary py-4">Niets te verwerken.</div>
    }
    else if (mutaties is not null)
    {
        <div class="row g-3 bankwerk">
            <div class="col-lg-5">
                <div class="card">
                    <table class="table table-sm table-hover align-middle mb-0 bankmutaties" data-sleepbaar="bankmutaties">
                        <thead>
                            <tr>
                                <SorteerKop Sortering="mutatiesortering" Naam="Datum" Gewijzigd="StateHasChanged" />
                                <SorteerKop Sortering="mutatiesortering" Naam="Tegenpartij" Tekst="Tegenpartij en omschrijving" Gewijzigd="StateHasChanged" />
                                <SorteerKop Sortering="mutatiesortering" Naam="Bedrag" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in mutatiesortering.Pas(mutaties))
                            {
                                var open = gekozen?.Mutatie.Id == m.Id;
                                <tr class="@(m.Status == Banktransactiestatus.TeVerwerken ? "kiesbaar" : "geboekt") @(open ? "table-active" : null)" @onclick="() => Kies(m)">
                                    <td class="text-nowrap">@Weergave.Datum(m.Datum)</td>
                                    <td class="omschrijving" title="@string.Join(Environment.NewLine, new[] { m.TegenNaam, m.TegenIban is { } iban ? Iban.Toon(iban) : null, m.Omschrijving, m.Melding }.Where(t => !string.IsNullOrWhiteSpace(t)))"
                                        @ondblclick="() => KiesPosten(m)" @ondblclick:stopPropagation>
                                        @if (m.TegenNaam is { Length: > 0 })
                                        {
                                            <span>@m.TegenNaam</span>
                                        }
                                        <span class="small text-secondary ms-1">@m.Omschrijving</span>
                                    </td>
                                    <td class="bedrag text-end text-nowrap"><Euro Waarde="m.Bedrag" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-lg-7">
                @if (gekozen is { } g)
                {
                    <div class="card card-body verwerkpaneel">
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <span class="fw-semibold text-truncate">@(g.Mutatie.TegenNaam ?? "Onbekende tegenpartij")</span>
                            <span class="small text-secondary">@(g.Mutatie.TegenIban is { } tegen ? Iban.Toon(tegen) : null)</span>
                            <span class="ms-auto bedrag fs-5"><Euro Waarde="g.Mutatie.Bedrag" /></span>
                        </div>
                        <div class="small text-secondary mb-3">@Weergave.Datum(g.Mutatie.Datum) · @g.Mutatie.Omschrijving</div>
                        <Foutmeldingen Fouten="fouten" />
                        @if (g.Voorstel.Afletteren.Kandidaten.Count > 0)
                        {
                            <div class="mb-3">
                                <div class="paneelkop">Voorstel</div>
                                @foreach (var k in g.Voorstel.Afletteren.Kandidaten)
                                {
                                    <div class="d-flex align-items-center gap-2 py-1 kandidaat">
                                        <span>@string.Join(", ", k.Posten.Select(Post))</span>
                                        <span class="small text-secondary" title="@(k.Verschil == 0 ? null : $"verschil {Bedragen.Getal(k.Verschil)}")">@k.Reden@(k.Zekerheid == Zekerheid.Zeker ? " · zeker" : null)</span>
                                        @if (mag && k.Korting)
                                        {
                                            <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => OpenVenster(k.Posten.Select(p => p.Id).ToList(), afboeken: true)">Afletteren…</button>
                                        }
                                        else if (mag)
                                        {
                                            <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => Afletteren(k.Posten.Select(p => p.Id).ToList())">Afletteren</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (mag)
                        {
                            <div class="mb-2">
                                <div class="d-flex align-items-center">
                                    <div class="paneelkop mb-0" title="@g.Voorstel.Advies.Reden">Regels</div>
                                    <button class="btn btn-sm btn-link ms-auto" title="Meer openstaande posten tegelijk (of dubbelklik op de mutatie)" @onclick="KiesMeer">Posten kiezen…</button>
                                    <button class="btn btn-sm btn-link" @onclick="RegelErbij">+ regel</button>
                                </div>
                                <table class="table table-sm align-middle mb-0 bankregels">
                                    <thead>
                                        <tr><th>Factuurnummer</th><th>Rekening</th><th>Btw</th><th class="text-end">Bedrag</th><th>Omschrijving</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < regels.Count; i++)
                                        {
                                            var regel = regels[i];
                                            var n = i;
                                            var post = regel.Post is { } pid ? g.OpenPosten.FirstOrDefault(p => p.Id == pid) : null;
                                            <tr class="regel-hover">
                                                <td>
                                                    <PostKeuze Id="@($"regel-factuur-{n}")" Waarde="regel.Post" WaardeChanged="p => KiesPost(regel, p)" Verwerking="g" Kader="geopend"
                                                               Uitgesloten="@([.. regels.Where(r => r != regel && r.Post is not null).Select(r => r.Post!.Value)])" />
                                                </td>
                                                <td>
                                                    @if (post is not null)
                                                    {
                                                        <span class="small text-secondary text-truncate d-block" title="@Rekeningnaam(g, Postrekening(g, post))">@Rekeningnaam(g, Postrekening(g, post))</span>
                                                    }
                                                    else
                                                    {
                                                        <RekeningKeuze Id="@($"regel-rekening-{n}")" @bind-Waarde:get="regel.Rekening" @bind-Waarde:set="w => KiesRekening(regel, w)" Schema="g.Schema" Kader="geopend" />
                                                    }
                                                </td>
                                                <td>
                                                    <select id="@($"regel-btw-{n}")" class="form-select form-select-sm" @bind="regel.BtwCode" disabled="@(post is not null)" aria-label="Btw">
                                                        <option value="">geen</option>
                                                        @foreach (var c in g.BtwCodes.Where(c => c.Actief))
                                                        {
                                                            <option value="@c.Code" title="@c.Code · @c.Omschrijving">@c.Kort</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td><input id="@($"regel-bedrag-{n}")" class="form-control form-control-sm text-end" @bind="regel.Bedrag" aria-label="Bedrag" /></td>
                                                <td><input id="@($"regel-omschrijving-{n}")" class="form-control form-control-sm" @bind="regel.Omschrijving" aria-label="Omschrijving" placeholder="@(post is not null ? $"Betaling {post.Factuurnummer}" : Standaardomschrijving(g.Mutatie))" /></td>
                                                <td>
                                                    @if (regels.Count > 1)
                                                    {
                                                        <button class="btn btn-sm btn-link text-secondary regelactie p-0" title="Regel weghalen" @onclick="() => regels.RemoveAt(n)">&times;</button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-3 small mb-3 totalen">
                                <span>Posten <Euro Waarde="Postentotaal" /></span>
                                <span>Regels <Euro Waarde="Regeltotaal" /></span>
                                <span class="@(Verschil == 0 ? "text-secondary" : "status let-op")">Verschil <Euro Waarde="Verschil" /></span>
                                <button class="btn btn-sm btn-primary ms-auto" disabled="@bezig" @onclick="Boeken">Boeken</button>
                            </div>
                            @if (magRegels)
                            {
                                <div class="mb-3 autoherkenning">
                                    <label class="form-check form-switch mb-1">
                                        <input class="form-check-input" type="checkbox" @bind="autoOpen" />
                                        <span class="form-check-label paneelkop">Autoherkenning</span>
                                    </label>
                                    @if (autoOpen)
                                    {
                                        <div class="row g-2 align-items-end">
                                            <div class="col-md-4">
                                                <label class="form-label small mb-0" for="auto-tekst">Tekst bevat</label>
                                                <input id="auto-tekst" class="form-control form-control-sm" @bind="autoTekst" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small mb-0" for="auto-van">Bedrag van</label>
                                                <input id="auto-van" class="form-control form-control-sm text-end" @bind="autoVan" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small mb-0" for="auto-tot">tot</label>
                                                <input id="auto-tot" class="form-control form-control-sm text-end" @bind="autoTot" />
                                            </div>
                                            <div class="col-md-4">
                                                @if (g.Mutatie.TegenIban is { } autoIbanTekst)
                                                {
                                                    <label class="form-check mb-0 small">
                                                        <input class="form-check-input" type="checkbox" @bind="autoIban" />
                                                        <span class="form-check-label">tegenrekening @Iban.Toon(autoIbanTekst)</span>
                                                    </label>
                                                }
                                                <label class="form-check mb-0 small">
                                                    <input class="form-check-input" type="checkbox" @bind="autoAutomatisch" />
                                                    <span class="form-check-label">automatisch boeken</span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mt-2">
                                            <span class="small text-secondary">@(regels.FirstOrDefault(r => r.Post is null) is { Rekening: { Length: > 0 } ar } ag ? $"→ {Rekeningnaam(g, ar)}{(ag.BtwCode is { Length: > 0 } ab ? $", {ab}" : null)}" : "Kies hierboven de rekening.")</span>
                                            <button class="btn btn-sm btn-outline-primary ms-auto" disabled="@(bezig || string.IsNullOrWhiteSpace(regels.FirstOrDefault(r => r.Post is null)?.Rekening))" @onclick="BewaarAutoherkenning">Opslaan en toepassen</button>
                                        </div>
                                    }
                                </div>
                            }
                            <div>
                                <label class="paneelkop d-block" for="factuur">Factuur uploaden</label>
                                <InputFile id="factuur" class="form-control form-control-sm" accept=".pdf,.xml,.jpg,.jpeg,.png,application/pdf,application/xml,text/xml,image/jpeg,image/png" OnChange="UploadFactuur" disabled="@bezig" />
                                @if (factuurUitkomst is { } fu)
                                {
                                    <div class="small mt-1 @(fu.DocumentId is null || fu.Status == Documentstatus.Quarantaine ? "status let-op" : null)">
                                        @fu.Melding
                                        @if (fu.DocumentId is { } doc && fu.Status == Documentstatus.TeVerwerken)
                                        {
                                            <a class="ms-1" href="/a/@Id/inkoop/@doc">Factuur verwerken</a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    @if (venster is { } v && gekozen is not null)
    {
        <OpenpostenVenster Verwerking="gekozen" Kader="geopend" Voorgekozen="v.Posten" Afboeken="v.Afboeken" Kiezen="v.Kiezen" Fouten="fouten"
                           Afletteren="AfletterenUitVenster" Gesloten="() => venster = null" />
    }
</AdministratieKader>

@code {
    private const int MaximumBestanden = 20;

    private Geopend? geopend;
    private IReadOnlyList<BankmutatieRegel>? mutaties;

    private readonly Sortering<BankmutatieRegel> mutatiesortering = new(
        new("Datum", m => m.Datum, EerstOplopend: false),
        new("Tegenpartij", m => (m.TegenNaam ?? m.Omschrijving).ToUpperInvariant()),
        new("Bedrag", m => m.Bedrag, EerstOplopend: false));

    private readonly Sortering<OpenpostRegel> postsortering = new(
        new("Vervalt", p => p.Vervaldatum),
        new("Relatie", p => p.Naam.ToUpperInvariant()),
        new("Factuur", p => p.Factuurnummer),
        new("Bedrag", p => p.Bedrag, EerstOplopend: false),
        new("Open", p => p.Openstaand, EerstOplopend: false));
    private List<(string Bestand, Uitkomst<Bankinlezing> Uitkomst)> uitkomsten = [];
    private bool bezig;
    private bool ookGeboekt;
    private bool mag;
    private Bankverwerking? gekozen;
    private (List<Guid> Posten, bool Afboeken, bool Kiezen)? venster;
    private List<Regelinvoer> regels = [];
    private bool magRegels;
    private bool autoOpen;
    private string? autoTekst;
    private string? autoVan;
    private string? autoTot;
    private bool autoIban;
    private bool autoAutomatisch = true;

    /// <summary>Een regel in het verwerkpaneel: een deel van de mutatie op een openstaande post of op een grootboekrekening.</summary>
    private sealed class Regelinvoer
    {
        public Guid? Post { get; set; }

        public string? Rekening { get; set; }

        public string? BtwCode { get; set; }

        public string? Bedrag { get; set; }

        public string? Omschrijving { get; set; }

        public decimal Waarde => BedragParser.TryParse(Bedrag ?? "", out var b) ? b : 0m;
    }
    private IReadOnlyList<string>? fouten;
    private Inleesuitkomst? factuurUitkomst;
    private Herverwerking? opnieuw;

    // De werklijsten: de mutaties, de openstaande posten (op vervaldatum) en de verschillen (deelbetalingen, vraagposten).
    private enum Werklijst
    {
        Mutaties,
        OpenPosten,
        Verschillen,
    }

    private Werklijst lijst;
    private IReadOnlyList<OpenpostRegel>? openPosten;
    private (string? Rekening, decimal Saldo)? vraagposten;

    private static DateOnly Vandaag => DateOnly.FromDateTime(DateTime.Today);

    [Parameter]
    public Guid Id { get; set; }

    private async Task Open(Geopend g)
    {
        geopend = g;
        mag = g.Kop.Mag(Recht.Invoeren);
        magRegels = g.Kop.Mag(Recht.Boekhouden);
        await Laad();
    }

    private async Task Laad()
    {
        mutaties = await Bank.Lijst(geopend!.Wie, Id, ookGeboekt);
        if (lijst != Werklijst.Mutaties)
        {
            openPosten = await Bank.OpenPosten(geopend.Wie, Id);
            vraagposten = await Bank.Vraagposten(geopend.Wie, Id);
        }
    }

    private async Task VerwerkOpnieuw()
    {
        bezig = true;
        gekozen = null;
        opnieuw = await Bank.VerwerkOpnieuw(geopend!.Wie, Id);
        bezig = false;
        await Laad();
    }

    private async Task Toon(Werklijst werklijst)
    {
        lijst = werklijst;
        gekozen = null;
        await Laad();
    }

    /// <summary>Een factuur bij deze mutatie: inlezen zoals bij inkoop; na het boeken wordt hij op de mutatie afgeletterd.</summary>
    private async Task UploadFactuur(InputFileChangeEventArgs e)
    {
        bezig = true;
        try
        {
            await using var stream = e.File.OpenReadStream(Boekerhouden.Documenten.PdfTekst.MaximumBytes);
            factuurUitkomst = await Inkoop.Lees(geopend!.Wie, Id, stream, e.File.Name, e.File.ContentType, gekozen!.Mutatie.Id);
        }
        catch (IOException)
        {
            factuurUitkomst = new Inleesuitkomst(null, null, $"{e.File.Name} is te groot.");
        }

        bezig = false;
        if (factuurUitkomst.IsGeboekt)
        {
            gekozen = null;
            await Laad();
        }
    }

    private async Task WisselGeboekt(ChangeEventArgs e)
    {
        ookGeboekt = e.Value is true;
        gekozen = null;
        await Laad();
    }

    private async Task Kies(BankmutatieRegel m)
    {
        fouten = null;
        if (m.Status != Banktransactiestatus.TeVerwerken || gekozen?.Mutatie.Id == m.Id)
        {
            gekozen = null;
            return;
        }

        factuurUitkomst = null;
        gekozen = await Bank.Verwerking(geopend!.Wie, Id, m.Id);
        venster = null;
        // Kan de mutatie de betaling van een factuur zijn, dan geen rekening vooraf: anders staat de kost er twee keer in.
        var advies = gekozen?.Voorstel.Afletteren.Kandidaten.Count == 0 ? gekozen.Voorstel.Advies : null;
        regels = [new Regelinvoer { Rekening = advies?.Rekeningnummer, BtwCode = advies?.BtwCode, Bedrag = Bedragen.Getal(Math.Abs(m.Bedrag)) }];

        // Autoherkenning: de naam van de tegenpartij (of de eerste woorden van de omschrijving) en een ruime bandbreedte.
        autoOpen = false;
        autoTekst = m.TegenNaam is { Length: > 0 } naam ? naam.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0] : string.Join(' ', m.Omschrijving.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(3));
        autoVan = "1";
        autoTot = Bedragen.Getal(Math.Ceiling(Math.Abs(m.Bedrag) * 1.5m / 10m) * 10m);
        autoIban = m.TegenIban is not null;
        autoAutomatisch = true;
    }

    private decimal Teken => gekozen is { } g ? Math.Sign(g.Mutatie.Bedrag) : 1;

    private decimal Postentotaal => Teken * regels.Where(r => r.Post is not null).Sum(r => r.Waarde);

    private decimal Regeltotaal => Teken * regels.Where(r => r.Post is null).Sum(r => r.Waarde);

    private decimal Verschil => (gekozen?.Mutatie.Bedrag ?? 0m) - Postentotaal - Regeltotaal;

    private static string Postrekening(Bankverwerking g, Boekhouding.Facturen.OpenPost post) =>
        g.Schema.Alle.FirstOrDefault(r => r.Functie == (post.Soort == Boekhouding.Facturen.Factuursoort.Verkoop ? Boekhouding.Grootboek.Rekeningfunctie.Debiteuren : Boekhouding.Grootboek.Rekeningfunctie.Crediteuren))?.Nummer ?? "";

    /// <summary>Een post op een regel: dan geen rekening of btw, en als bedrag wat er openstaat (aan te passen voor een deel).</summary>
    private void KiesPost(Regelinvoer regel, Guid? post)
    {
        regel.Post = post;
        if (post is { } id && gekozen?.OpenPosten.FirstOrDefault(p => p.Id == id) is { } open)
        {
            (regel.Rekening, regel.BtwCode) = (null, null);
            regel.Bedrag = Bedragen.Getal(Math.Abs(open.Openstaand));
        }
    }

    private void KiesMeer() => venster = ([.. regels.Where(r => r.Post is not null).Select(r => r.Post!.Value)], false, true);

    /// <summary>Gekozen in het venster: per post een regel (een lege regel wordt eerst gebruikt), weggevinkte posten eraf.</summary>
    private void NeemPosten(IReadOnlyList<Guid> posten)
    {
        regels.RemoveAll(r => r.Post is { } p && !posten.Contains(p));
        foreach (var post in posten.Where(p => regels.All(r => r.Post != p)))
        {
            var regel = regels.FirstOrDefault(r => r.Post is null && string.IsNullOrWhiteSpace(r.Rekening)) ?? new Regelinvoer();
            if (!regels.Contains(regel))
            {
                regels.Add(regel);
            }

            KiesPost(regel, post);
        }

        if (regels.Count == 0)
        {
            regels.Add(new Regelinvoer());
        }
    }

    private void RegelErbij() =>
        regels.Add(new Regelinvoer { Bedrag = Verschil == 0 ? null : Bedragen.Getal(Math.Abs(Verschil)) });

    /// <summary>
    /// Boeken zoals het paneel staat: alleen hele posten (een verschil blijft op de post openstaan, te veel wordt te
    /// vorderen), of posten (ook een deel) en regels samen precies het bedrag.
    /// </summary>
    private async Task Boeken()
    {
        bezig = true;
        var ingevuld = regels.Where(r => r.Post is not null || !string.IsNullOrWhiteSpace(r.Rekening) || r.Waarde != 0).ToList();
        var posten = ingevuld.Where(r => r.Post is not null).ToList();
        var heel = posten.Count > 0 && posten.Count == ingevuld.Count
                   && posten.All(r => gekozen!.OpenPosten.FirstOrDefault(p => p.Id == r.Post) is { } open && Math.Abs(open.Openstaand) == r.Waarde);
        var uitkomst = heel
            ? await Bank.Afletteren(geopend!.Wie, Id, gekozen!.Mutatie.Id, [.. posten.Select(r => r.Post!.Value)])
            : await Bank.Verdeel(geopend!.Wie, Id, gekozen!.Mutatie.Id, [],
                [.. ingevuld.Select(r => new Bankregelinvoer(r.Rekening ?? "", r.BtwCode, r.Waarde,
                    string.IsNullOrWhiteSpace(r.Omschrijving) ? (r.Post is null ? Standaardomschrijving(gekozen.Mutatie) : null) : r.Omschrijving, r.Post))]);
        bezig = false;
        await Na(uitkomst);
    }

    /// <summary>
    /// Een regel van deze mutatie maken: tekst in de naam (of de omschrijving), eventueel de tegenrekening, het bedrag
    /// tussen van en tot, naar de rekening en btw van de eerste regel; dan alle mutaties in Te verwerken opnieuw.
    /// </summary>
    private async Task BewaarAutoherkenning()
    {
        if (gekozen is not { } g || regels.FirstOrDefault(r => r.Post is null) is not { Rekening: { Length: > 0 } rekening } eerste)
        {
            return;
        }

        var tekst = autoTekst?.Trim();
        decimal? van = BedragParser.TryParse(autoVan ?? "", out var v) ? v : null;
        decimal? tot = BedragParser.TryParse(autoTot ?? "", out var t) ? t : null;
        if (string.IsNullOrEmpty(tekst) && !autoIban)
        {
            fouten = ["Vul de tekst in of kies de tegenrekening."];
            return;
        }

        var inNaam = tekst is { Length: > 0 } && g.Mutatie.TegenNaam?.Contains(tekst, StringComparison.OrdinalIgnoreCase) == true;
        var regel = new Verwerkingsregel(
            $"{(string.IsNullOrEmpty(tekst) ? Iban.Toon(g.Mutatie.TegenIban!) : tekst)} → {Rekeningnaam(g, rekening)}",
            rekening,
            string.IsNullOrWhiteSpace(eerste.BtwCode) ? null : eerste.BtwCode,
            Automatisch: autoAutomatisch,
            Soort: Verwerkingssoort.Bankmutatie,
            NaamBevat: inNaam ? tekst : null,
            OmschrijvingBevat: inNaam || string.IsNullOrEmpty(tekst) ? null : tekst,
            BedragVan: van,
            BedragTot: tot,
            TegenIban: autoIban ? g.Mutatie.TegenIban : null,
            Richting: g.Mutatie.Bedrag < 0 ? Regelrichting.Betaling : Regelrichting.Ontvangst);
        bezig = true;
        var uitkomst = await Inrichting.VoegRegelToe(geopend!.Wie, Id, regel);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            opnieuw = await Bank.VerwerkOpnieuw(geopend.Wie, Id);
            gekozen = null;
            await Laad();
        }

        bezig = false;
    }

    private static string Rekeningnaam(Bankverwerking g, string nummer) =>
        g.Schema.Zoek(nummer) is { } r ? $"{r.Nummer} {r.Naam}" : nummer;

    /// <summary>Dubbelklik op de omschrijving: de mutatie openen en meteen het venster met openstaande posten.</summary>
    private async Task KiesPosten(BankmutatieRegel m)
    {
        if (!mag || m.Status != Banktransactiestatus.TeVerwerken)
        {
            return;
        }

        if (gekozen?.Mutatie.Id != m.Id)
        {
            await Kies(m);
        }

        OpenVenster([.. gekozen?.Voorstel.Afletteren.Kandidaten.FirstOrDefault()?.Posten.Select(p => p.Id) ?? []]);
    }

    private void OpenVenster(List<Guid> posten, bool afboeken = false)
    {
        fouten = null;
        venster = (posten, afboeken, false);
    }

    private async Task AfletterenUitVenster((IReadOnlyList<Guid> Posten, Verschilafboeking? Verschil) keuze)
    {
        // Gekozen voor het paneel: de posten erin, de rest op de regel.
        if (venster is { Kiezen: true })
        {
            NeemPosten(keuze.Posten);
            venster = null;
            return;
        }

        var uitkomst = await Bank.Afletteren(geopend!.Wie, Id, gekozen!.Mutatie.Id, keuze.Posten, keuze.Verschil);
        if (uitkomst.IsGelukt)
        {
            venster = null;
        }

        await Na(uitkomst);
    }

    private async Task Afletteren(List<Guid> posten) =>
        await Na(await Bank.Afletteren(geopend!.Wie, Id, gekozen!.Mutatie.Id, posten));


    /// <summary>De openstaande posten in een eigen venster: in de Windows-app een tweede venster, in de webapp een pop-up.</summary>
    private async Task OpenpostenExtern()
    {
        if (Diensten.GetService<IDocumentvenster>() is { } venster)
        {
            venster.OpenOpenposten(Id, $"Openstaande posten – {geopend?.Kop.Naam}");
            return;
        }

        await JS.InvokeVoidAsync("open", $"/a/{Id}/bank/openstaand", $"openposten-{Id:N}", "popup,width=1100,height=900");
    }

    private async Task Na(Uitkomst uitkomst)
    {
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            gekozen = null;
            await Laad();
        }
    }

    private async Task LeesIn(InputFileChangeEventArgs e)
    {
        bezig = true;
        uitkomsten = [];
        gekozen = null;
        foreach (var bestand in e.GetMultipleFiles(MaximumBestanden))
        {
            try
            {
                await using var stream = bestand.OpenReadStream(BankDienst.MaximumBytes);
                uitkomsten.Add((bestand.Name, await Bank.Lees(geopend!.Wie, Id, stream, bestand.Name)));
            }
            catch (IOException)
            {
                uitkomsten.Add((bestand.Name, Uitkomst<Bankinlezing>.Mislukt($"{bestand.Name} is groter dan {BankDienst.MaximumBytes / 1024 / 1024} MB en is niet ingelezen.")));
            }

            StateHasChanged();
        }

        bezig = false;
        await Laad();
    }

    private static string Samenvatting(Bankinlezing w)
    {
        var delen = new List<string> { w.Nieuw == 1 ? "1 nieuwe mutatie" : $"{w.Nieuw} nieuwe mutaties" };
        if (w.Automatisch > 0)
        {
            delen.Add($"{w.Automatisch} automatisch geboekt");
        }

        if (w.Dubbel > 0)
        {
            delen.Add($"{w.Dubbel} al ingelezen");
        }

        return string.Join(", ", delen);
    }

    private string Post(Boekhouding.Facturen.OpenPost p) =>
        $"{gekozen?.Relaties.FirstOrDefault(r => r.Code == p.Relatie)?.Naam ?? p.Relatie} {p.Factuurnummer} {Bedragen.Getal(p.Openstaand)}";

    private static string Standaardomschrijving(BankmutatieRegel m) =>
        string.Join(" – ", new[] { m.TegenNaam, m.Omschrijving }.Where(t => !string.IsNullOrWhiteSpace(t)));

    /// <summary>Een rekening op een regel; hoort er een btw-code bij de rekening, dan komt die mee.</summary>
    private void KiesRekening(Regelinvoer regel, string? waarde)
    {
        var nieuw = regel.Rekening != waarde;
        regel.Rekening = waarde;
        if (nieuw && gekozen?.Schema.Zoek(waarde)?.BtwCode is { } code && gekozen.BtwCodes.Any(c => c.Code == code))
        {
            regel.BtwCode = code;
        }
    }
}
