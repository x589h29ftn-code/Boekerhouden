    }

    private async Task Open(Geopend g)
    {
        geopend = g;
        mag = g.Kop.Mag(Recht.Invoeren);
        magRegels = g.Kop.Mag(Recht.Boekhouden);
        // Een andere administratie: niets van de vorige blijft staan.
        klikken++;
        (schema, gekozen, venster, omzetting, omzetfout, opnieuw, nieuweBank, bankfouten, factuurUitkomst, fouten) =
            (null, null, null, null, null, null, null, null, null, null);
        uitkomsten = [];
        regels = [];
        geselecteerd.Clear();
        await Laad();
    }

    private async Task Laad()
    {
        mutaties = await Bank.Lijst(geopend!.Wie, Id, ookGeboekt);
        metConcept = await Concepten.Met(geopend.Wie, Id, Conceptsoort.Bank);
        stand = await Bank.Stand(geopend.Wie, Id);
        schema = await Grootboek.Schema(geopend.Wie, Id);
        if (btwcodes.Count == 0)
        {
            btwcodes = (await Btwtabel.Tabel()).Op(DateOnly.FromDateTime(DateTime.Today));
        }

        geselecteerd.IntersectWith(mutaties.Where(m => m.Status == Banktransactiestatus.TeVerwerken).Select(m => m.Id));
        if (lijst != Werklijst.Mutaties)
        {
            openPosten = await Bank.OpenPosten(geopend.Wie, Id);
            vraagposten = await Bank.Vraagposten(geopend.Wie, Id);
        }
    }

    private async Task VerwerkOpnieuw()
    {
        if (bezig)
        {
            return;
        }

        bezig = true;
        gekozen = null;
        opnieuw = await Bank.VerwerkOpnieuw(geopend!.Wie, Id);
        bezig = false;
        await Laad();
    }

    private async Task Toon(Werklijst werklijst)
    {
        lijst = werklijst;
        gekozen = null;
        await Laad();
    }

    /// <summary>Een factuur bij deze mutatie: inlezen zoals bij inkoop; na het boeken wordt hij op de mutatie afgeletterd.</summary>
    private async Task UploadFactuur(InputFileChangeEventArgs e)
    {
        if (gekozen is not { } g || bezig)
        {
            return;
        }

        bezig = true;
        Inleesuitkomst uitkomst;
        try
        {
            await using var stream = e.File.OpenReadStream(Boekerhouden.Documenten.PdfTekst.MaximumBytes);
            uitkomst = await Inkoop.Lees(geopend!.Wie, Id, stream, e.File.Name, e.File.ContentType, g.Mutatie.Id);
        }
        catch (IOException)
        {
            uitkomst = new Inleesuitkomst(null, null, $"{e.File.Name} is te groot.");
        }
        finally
        {
            bezig = false;
        }

        if (uitkomst.Dubbel)
        {
            Meldingen.Toon(uitkomst.Melding);
        }

        // Intussen een andere mutatie aangeklikt: de uitkomst hoort niet in dat paneel.
        var nogDeze = gekozen?.Mutatie.Id == g.Mutatie.Id;
        if (nogDeze)
        {
            factuurUitkomst = uitkomst;
        }

        if (uitkomst.IsGeboekt)
        {
            if (nogDeze)
            {
                gekozen = null;
            }

            await Laad();
        }
    }

    private async Task WisselGeboekt(ChangeEventArgs e)
    {
        ookGeboekt = e.Value is true;
        gekozen = null;
        await Laad();
    }

    private async Task Kies(BankmutatieRegel m)
    {
        fouten = null;
        if (m.Status != Banktransactiestatus.TeVerwerken || gekozen?.Mutatie.Id == m.Id)
        {
            klikken++;
            gekozen = null;
            return;
        }

        factuurUitkomst = null;
        var klik = ++klikken;
        var verwerking = await Bank.Verwerking(geopend!.Wie, Id, m.Id);
        if (klik != klikken)
        {
            // Intussen is er een andere mutatie aangeklikt: die gaat voor.
            return;
        }

        gekozen = verwerking;
        venster = null;
        // Kan de mutatie de betaling van een factuur zijn, dan geen rekening vooraf: anders staat de kost er twee keer in.
        var advies = gekozen?.Voorstel.Afletteren.Kandidaten.Count == 0 ? gekozen.Voorstel.Advies : null;
        regels = [new Regelinvoer
        {
            Rekening = advies?.Rekeningnummer,
            BtwCode = advies?.BtwCode,
            Bedrag = Bedragen.Getal(Math.Abs(m.Bedrag)),
            // Herkend (bijv. de Belastingdienst) of een regel met een vaste omschrijving: de omschrijving staat al klaar,
            // zoals "Omzetbelasting 3e kwartaal 2026" of "Huur november 2026" (de variabelen gevuld met de mutatie).
            Omschrijving = advies?.Bron is Adviesbron.Herkend or Adviesbron.Regel ? advies.Omschrijving : null,
        }];

        // Autoherkenning: de naam van de tegenpartij (of de eerste woorden van de omschrijving) en een ruime bandbreedte.
        (autoOpen, autoOmschrijving) = (false, null);
        autoTekst = m.TegenNaam is { Length: > 0 } naam ? naam.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0] : string.Join(' ', m.Omschrijving.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(3));
        autoVan = "1";
        autoTot = Bedragen.Getal(Math.Ceiling(Math.Abs(m.Bedrag) * 1.5m / 10m) * 10m);
        autoIban = m.TegenIban is not null;
        autoAutomatisch = true;
        autoBtw = advies?.BtwCode;
        bewerkRegel = null;

        // Tussentijds bewaard: de regels zoals ze waren.
        if (gekozen is not null && metConcept.Contains(m.Id)
            && await Concepten.Lees<List<Bankconceptregel>>(geopend.Wie, Id, Conceptsoort.Bank, m.Id) is { Inhoud: { Count: > 0 } bewaard }
            && klik == klikken && gekozen?.Mutatie.Id == m.Id)
        {
            // Een post die intussen (via een andere mutatie) betaald is, valt weg: die regel kan niet meer.
            regels = [.. bewaard.Where(x => x.Post is not { } p || gekozen.OpenPosten.Any(o => o.Id == p))
                .Select(x => new Regelinvoer { Post = x.Post, Rekening = x.Rekening, BtwCode = x.BtwCode, Bedrag = x.Bedrag, Omschrijving = x.Omschrijving, Btwbedrag = x.Btwbedrag })];
            if (regels.Count == 0)
            {
                regels = [new Regelinvoer { Bedrag = Bedragen.Getal(Math.Abs(m.Bedrag)) }];
            }
        }
    }

    private IReadOnlySet<Guid> metConcept = new HashSet<Guid>();

    /// <summary>Telt de klikken op een mutatie: alleen het antwoord op de laatste klik mag het paneel vullen.</summary>
    private int klikken;

    /// <summary>Een regel van een tussentijds bewaarde bankmutatie.</summary>
    public sealed record Bankconceptregel(Guid? Post, string? Rekening, string? BtwCode, string? Bedrag, string? Omschrijving, string? Btwbedrag = null);

    /// <summary>Tussentijds bewaren: de regels van deze mutatie, om later verder te gaan.</summary>
    private async Task BewaarConcept()
    {
        if (gekozen is not { } g)
        {
            return;
        }

        bezig = true;
        await Concepten.Bewaar(geopend!.Wie, Id, Conceptsoort.Bank, g.Mutatie.Id,
            regels.Select(x => new Bankconceptregel(x.Post, x.Rekening, x.BtwCode, x.Bedrag, x.Omschrijving, x.Btwbedrag)).ToList(),
            $"{g.Mutatie.TegenNaam ?? g.Mutatie.Omschrijving} {Weergave.Datum(g.Mutatie.Datum)}".Trim());
        metConcept = await Concepten.Met(geopend.Wie, Id, Conceptsoort.Bank);
        bezig = false;
        Meldingen.Toon("Mutatie bewaard");
    }

    /// <summary>Het bewaarde concept weg en de regels weer zoals het pakket ze voorstelde.</summary>
    private async Task OpnieuwBeginnen()
    {
        if (gekozen is not { } g)
        {
            return;
        }

        await Concepten.Verwijder(geopend!.Wie, Id, Conceptsoort.Bank, g.Mutatie.Id);
        metConcept = await Concepten.Met(geopend.Wie, Id, Conceptsoort.Bank);
        var mutatie = mutaties?.FirstOrDefault(x => x.Id == g.Mutatie.Id);
        gekozen = null;
        if (mutatie is not null)
        {
            await Kies(mutatie);
        }
    }

    private decimal Teken => gekozen is { } g ? Math.Sign(g.Mutatie.Bedrag) : 1;

    private decimal Postentotaal => Teken * regels.Where(r => r.Post is not null).Sum(r => r.Waarde);

    private decimal Regeltotaal => Teken * regels.Where(r => r.Post is null).Sum(r => r.Waarde);

    private decimal Verschil => (gekozen?.Mutatie.Bedrag ?? 0m) - Postentotaal - Regeltotaal;

    private static string Postrekening(Bankverwerking g, Boekhouding.Facturen.OpenPost post) =>
        g.Schema.Alle.FirstOrDefault(r => r.Functie == (post.Soort == Boekhouding.Facturen.Factuursoort.Verkoop ? Boekhouding.Grootboek.Rekeningfunctie.Debiteuren : Boekhouding.Grootboek.Rekeningfunctie.Crediteuren))?.Nummer ?? "";

    /// <summary>Een post op een regel: dan geen rekening of btw, en als bedrag wat er openstaat (aan te passen voor een deel).</summary>
    private void KiesPost(Regelinvoer regel, Guid? post)
    {
        regel.Post = post;
        if (post is { } id && gekozen?.OpenPosten.FirstOrDefault(p => p.Id == id) is { } open)
        {
            (regel.Rekening, regel.BtwCode) = (null, null);
            // In de richting van de mutatie: een creditnota (het andere teken) komt er met een min op, zodat hij het
            // te betalen bedrag verlaagt in plaats van verhoogt.
            regel.Bedrag = Bedragen.Getal(Teken * open.Openstaand);
        }
    }


    /// <summary>Gekozen in het venster: per post een regel (een lege regel wordt eerst gebruikt), weggevinkte posten eraf.</summary>
    private void NeemPosten(IReadOnlyList<Guid> posten)
    {
        regels.RemoveAll(r => r.Post is { } p && !posten.Contains(p));
        foreach (var post in posten.Where(p => regels.All(r => r.Post != p)))
        {
            var regel = regels.FirstOrDefault(r => r.Post is null && string.IsNullOrWhiteSpace(r.Rekening)) ?? new Regelinvoer();
            if (!regels.Contains(regel))
            {
                regels.Add(regel);
            }

            KiesPost(regel, post);
        }

        if (regels.Count == 0)
        {
            regels.Add(new Regelinvoer());
        }
    }

    /// <summary>
    /// Een regel erbij met wat er nog ontbreekt. De bedragen op de regels staan in de richting van de mutatie (bij een
    /// afschrijving zonder min): is er te veel verdeeld (5.000 op een afschrijving van 4.557,62), dan krijgt de nieuwe
    /// regel het verschil met een min (-442,38), zodat het verschil nul wordt.
    /// </summary>
    private void RegelErbij() =>
        regels.Add(new Regelinvoer { Bedrag = Verschil == 0 ? null : Bedragen.Getal(Teken * Verschil) });

    /// <summary>
    /// Boeken zoals het paneel staat: alleen hele posten (een verschil blijft op de post openstaan, te veel wordt te
    /// vorderen), of posten (ook een deel) en regels samen precies het bedrag.
    /// </summary>
    private async Task Boeken()
    {
        var ingevuld = regels.Where(r => r.Post is not null || !string.IsNullOrWhiteSpace(r.Rekening) || r.Waarde != 0).ToList();
        var posten = ingevuld.Where(r => r.Post is not null).ToList();
        var heel = posten.Count > 0 && posten.Count == ingevuld.Count
                   && posten.All(r => gekozen!.OpenPosten.FirstOrDefault(p => p.Id == r.Post) is { } open && Teken * open.Openstaand == r.Waarde);

        // Met een verschil wordt er niet geboekt (alleen hele posten mogen een verschil laten openstaan op de post).
        if (!heel && Verschil != 0)
        {
            fouten = [$"Er is nog een verschil van {Bedragen.Getal(Verschil)}: de regels moeten precies op het bedrag van de mutatie sluiten."];
            return;
        }

        if (bezig)
        {
            return;
        }

        bezig = true;
        var mutatie = gekozen!.Mutatie.Id;
        var uitkomst = heel
            ? await Bank.Afletteren(geopend!.Wie, Id, gekozen!.Mutatie.Id, [.. posten.Select(r => r.Post!.Value)])
            : await Bank.Verdeel(geopend!.Wie, Id, gekozen!.Mutatie.Id, [],
                [.. ingevuld.Select(r => new Bankregelinvoer(r.Rekening ?? "", r.BtwCode, r.Waarde,
                    string.IsNullOrWhiteSpace(r.Omschrijving) ? (r.Post is null ? Standaardomschrijving(gekozen.Mutatie) : null) : r.Omschrijving, r.Post,
                    r.Post is null && Btwvolgenscode(gekozen, r) is not null ? r.Btwwaarde : null))]);
        await Na(uitkomst, mutatie);
    }

    /// <summary>
    /// Een regel van deze mutatie maken: tekst in de naam (of de omschrijving), eventueel de tegenrekening, het bedrag
    /// tussen van en tot, naar de rekening en btw van de eerste regel; dan alle mutaties in Te verwerken opnieuw.
    /// </summary>
    private async Task BewaarAutoherkenning()
    {
        if (gekozen is not { } g || regels.FirstOrDefault(r => r.Post is null) is not { Rekening: { Length: > 0 } rekening } eerste)
        {
            return;
        }

        var tekst = autoTekst?.Trim();
        decimal? van = BedragParser.TryParse(autoVan ?? "", out var v) ? v : null;
        decimal? tot = BedragParser.TryParse(autoTot ?? "", out var t) ? t : null;
        if (string.IsNullOrEmpty(tekst) && !autoIban)
        {
            fouten = ["Vul de tekst in of kies de tegenrekening."];
            return;
        }

        var inNaam = tekst is { Length: > 0 } && g.Mutatie.TegenNaam?.Contains(tekst, StringComparison.OrdinalIgnoreCase) == true;
        var regel = new Verwerkingsregel(
            bewerkRegel?.Regel.Naam ?? $"{(string.IsNullOrEmpty(tekst) ? Iban.Toon(g.Mutatie.TegenIban!) : tekst)} naar {Rekeningnaam(g, rekening)}",
            rekening,
            NietBtwPlichtig || string.IsNullOrWhiteSpace(autoBtw) ? null : autoBtw,
            Automatisch: autoAutomatisch,
            Soort: Verwerkingssoort.Bankmutatie,
            NaamBevat: inNaam ? tekst : null,
            OmschrijvingBevat: inNaam || string.IsNullOrEmpty(tekst) ? null : tekst,
            BedragVan: van,
            BedragTot: tot,
            TegenIban: autoIban ? g.Mutatie.TegenIban : null,
            Richting: g.Mutatie.Bedrag < 0 ? Regelrichting.Betaling : Regelrichting.Ontvangst,
            Omschrijving: Leeg(autoOmschrijving));
        if (bewerkRegel is { } bestaand)
        {
            // Wat de gebruiker niet in het paneel ziet, blijft zoals het was (soort en relatie).
            regel = regel with
            {
                Soort = bestaand.Regel.Soort,
                Relatie = bestaand.Regel.Relatie,
                Richting = bestaand.Regel.Richting,
                // Het veld waar de regel al op zocht (naam of omschrijving) houdt de tekst; had hij geen van beide, dan
                // zoals bij een nieuwe regel.
                NaamBevat = bestaand.Regel.NaamBevat is not null ? Leeg(tekst)
                    : bestaand.Regel.OmschrijvingBevat is not null ? null : regel.NaamBevat,
                OmschrijvingBevat = bestaand.Regel.NaamBevat is not null ? null
                    : bestaand.Regel.OmschrijvingBevat is not null ? Leeg(tekst) : regel.OmschrijvingBevat,
            };
        }

        bezig = true;
        var uitkomst = bewerkRegel is { } b
            ? await Inrichting.WijzigRegel(geopend!.Wie, Id, b.Id, regel)
            : await Inrichting.VoegRegelToe(geopend!.Wie, Id, regel);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            bewerkRegel = null;
            opnieuw = await Bank.VerwerkOpnieuw(geopend.Wie, Id);
            gekozen = null;
            await Laad();
        }

        bezig = false;
    }

    private static string Rekeningnaam(Bankverwerking g, string nummer) =>
        g.Schema.Zoek(nummer) is { } r ? $"{r.Nummer} {r.Naam}" : nummer;

    /// <summary>Dubbelklik op de omschrijving: de mutatie openen en meteen het venster met openstaande posten.</summary>
    private async Task KiesPosten(BankmutatieRegel m)
    {
        if (!mag || m.Status != Banktransactiestatus.TeVerwerken)
        {
            return;
        }

        if (gekozen?.Mutatie.Id != m.Id)
        {
            await Kies(m);
        }

        OpenVenster([.. gekozen?.Voorstel.Afletteren.Kandidaten.FirstOrDefault()?.Posten.Select(p => p.Id) ?? []]);
    }

    private void OpenVenster(List<Guid> posten, bool afboeken = false)
    {
        fouten = null;
        venster = (posten, afboeken, false);
    }

    private async Task AfletterenUitVenster((IReadOnlyList<Guid> Posten, Verschilafboeking? Verschil) keuze)
    {
        // Gekozen voor het paneel: de posten erin, de rest op de regel.
        if (venster is { Kiezen: true })
        {
            NeemPosten(keuze.Posten);
            venster = null;
            return;
        }

        if (bezig)
        {
            return;
        }

        bezig = true;
        var mutatie = gekozen!.Mutatie.Id;
        var uitkomst = await Bank.Afletteren(geopend!.Wie, Id, mutatie, keuze.Posten, keuze.Verschil);
        if (uitkomst.IsGelukt)
        {
            venster = null;
        }

        await Na(uitkomst, mutatie);
    }

    private async Task Afletteren(List<Guid> posten)
    {
        if (bezig)
        {
            return;
        }

        bezig = true;
        var mutatie = gekozen!.Mutatie.Id;
        await Na(await Bank.Afletteren(geopend!.Wie, Id, mutatie, posten), mutatie);
    }


    /// <summary>De openstaande posten in een eigen venster: in de Windows-app een tweede venster, in de webapp een pop-up.</summary>
    private async Task OpenpostenExtern()
