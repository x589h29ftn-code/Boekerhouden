    private void KiesBank(string? code)
    {
        (gekozen, Bankkeuze) = (null, code);
        geselecteerd.Clear();
        Navigatie.NavigateTo(code is null ? $"/a/{Id}/bank" : $"/a/{Id}/bank?bank={Uri.EscapeDataString(code)}", replace: true);
