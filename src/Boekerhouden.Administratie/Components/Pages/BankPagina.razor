        await JS.InvokeVoidAsync("open", $"/a/{Id}/bank/openstaand", $"openposten-{Id:N}", "popup,width=1100,height=900");
    }

    /// <summary>
    /// Na het verwerken: de regel licht op en schuift weg (verwerkt), dan staat de volgende mutatie in Te verwerken
    /// klaar in het paneel, zodat je door kunt zonder te klikken.
    /// </summary>
    /// <remarks>
    /// <c>bezig</c> blijft aan tot de volgende mutatie klaarstaat (en gaat altijd weer uit): een tweede klik in die
    /// tijd boekt niet nog eens en opent niets anders.
    /// </remarks>
    private async Task Na(Uitkomst uitkomst, Guid mutatie)
    {
        bezig = true;
        try
        {
            await NaVerwerken(uitkomst, mutatie);
        }
        finally
        {
            bezig = false;
        }
    }

    private async Task NaVerwerken(Uitkomst uitkomst, Guid mutatie)
    {
        // Het concept van de mutatie ruimt de dienst bij het boeken zelf op. Is er intussen een andere mutatie
        // aangeklikt, dan blijft die staan: alleen de lijst wordt bijgewerkt.
        var klik = klikken;
        fouten = gekozen?.Mutatie.Id == mutatie ? uitkomst.Fouten : null;
        if (uitkomst.IsGelukt)
        {
            // De volgende mutatie binnen het filter: wie op "Albert" filtert, krijgt de volgende van Albert.
            var lijst = mutatiesortering.Pas((mutaties ?? []).Where(PastFilter)).ToList();
            var plek = lijst.FindIndex(m => m.Id == mutatie);
            verwerkt = mutatie;
            StateHasChanged();
            await Task.Delay(VerwerktDuur);
            verwerkt = null;
            if (klik != klikken)
            {
                await Laad();
                return;
            }

            gekozen = null;
            await Laad();
            var zichtbaar = mutatiesortering.Pas((mutaties ?? []).Where(PastFilter)).ToList();
            var daarna = zichtbaar.Skip(Math.Max(plek, 0)).Concat(zichtbaar)
                .FirstOrDefault(m => m.Status == Banktransactiestatus.TeVerwerken);
            if (plek >= 0 && daarna is not null && klik == klikken)
            {
                await Kies(daarna);
            }
        }
    }

    private Pdfomzetting? omzetting;
    private string? omzetfout;

    private async Task ZetPdfOm(InputFileChangeEventArgs e)
    {
        bezig = true;
        (omzetting, omzetfout) = (null, null);
        try
        {
            await using var stream = e.File.OpenReadStream(BankDienst.MaximumBytes);
            var uitkomst = await Bank.PdfNaarMt940(geopend!.Wie, Id, stream, e.File.Name);
            (omzetting, omzetfout) = (uitkomst.Waarde, uitkomst.IsGelukt ? null : string.Join(" ", uitkomst.Fouten));
            if (omzetting is not null)
            {
                await BewaarMt940();
            }
        }
        catch (IOException)
        {
            omzetfout = $"{e.File.Name} is groter dan {BankDienst.MaximumBytes / 1024 / 1024} MB.";
        }
        finally
        {
            bezig = false;
        }
    }

    private async Task BewaarMt940()
    {
        if (omzetting is { } o)
        {
            await JS.Bewaar(o.Mt940, o.Bestandsnaam, "text/plain");
        }
    }

    private async Task LeesOmzettingIn()
    {
        if (omzetting is not { } o)
        {
            return;
        }

        bezig = true;
        uitkomsten = [(o.Bestandsnaam, await Bank.Lees(geopend!.Wie, Id, new MemoryStream(o.Mt940), o.Bestandsnaam))];
        omzetting = null;
        bezig = false;
        await Laad();
    }

    private async Task LeesIn(InputFileChangeEventArgs e)
    {
        bezig = true;
        uitkomsten = [];
        gekozen = null;
        foreach (var bestand in e.GetMultipleFiles(MaximumBestanden))
        {
            try
            {
                await using var stream = bestand.OpenReadStream(BankDienst.MaximumBytes);
                uitkomsten.Add((bestand.Name, await Bank.Lees(geopend!.Wie, Id, stream, bestand.Name)));
            }
            catch (IOException)
            {
                uitkomsten.Add((bestand.Name, Uitkomst<Bankinlezing>.Mislukt($"{bestand.Name} is groter dan {BankDienst.MaximumBytes / 1024 / 1024} MB en is niet ingelezen.")));
            }

            StateHasChanged();
        }

        bezig = false;
        await Laad();
    }

    /// <summary>Kort wat er bij het inlezen opviel; de volledige meldingen staan in de tooltip.</summary>
    private static string Meldingtekst(Bankinlezing w) =>
        w.Meldingen.Count == 1 && w.Meldingen[0].Contains(" overlapt met ", StringComparison.Ordinal) ? "overlapt met een eerder afschrift"
        : w.Meldingen.Count == 1 ? "1 melding" : $"{w.Meldingen.Count} meldingen";

    private static string Samenvatting(Bankinlezing w)
    {
        var delen = new List<string> { w.Nieuw == 1 ? "1 nieuwe mutatie" : $"{w.Nieuw} nieuwe mutaties" };
        if (w.Automatisch > 0)
        {
            delen.Add($"{w.Automatisch} automatisch geboekt");
        }

        if (w.Dubbel > 0)
        {
            delen.Add($"{w.Dubbel} al ingelezen");
        }

        if (w.MogelijkDubbel > 0)
        {
            delen.Add($"{w.MogelijkDubbel} mogelijk dubbel");
        }

        return string.Join(", ", delen);
    }

