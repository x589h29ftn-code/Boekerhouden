@code {
    private const int MaximumBestanden = 20;

    private Geopend? geopend;

    /// <summary>De administratie is niet btw-plichtig: geen btw op het scherm en in de boekingen.</summary>
    private bool NietBtwPlichtig => geopend?.Kop.BtwPlichtig == false;

    /// <summary>Geen btw op het scherm: niet btw-plichtig en geen regel met een btw-code (een oude boeking houdt zijn btw).</summary>
    private bool ZonderBtw => NietBtwPlichtig && regels.All(r => string.IsNullOrEmpty(r.BtwCode));
    private IReadOnlyList<BankmutatieRegel>? mutaties;

    /// <summary>Per bankrekening het laatste afschrift en wat er te verwerken is: de regel onder de titel.</summary>
    private IReadOnlyList<Bankstand> stand = [];

    /// <summary>De mutatie die net verwerkt is: hij licht op en schuift weg (zie uitstraling.css, tr.verwerkt).</summary>
    private Guid? verwerkt;

    private static readonly TimeSpan VerwerktDuur = TimeSpan.FromMilliseconds(280);

    private readonly HashSet<Guid> geselecteerd = [];
    private string? selectieRekening;
    private string selectieBtw = "";
    private string filterDatum = "";
    private string filterTekst = "";
    private string filterBedrag = "";

    private Boekhouding.Grootboek.Rekeningschema? schema;
    private IReadOnlyList<Boekhouding.Btw.BtwCode> btwcodes = [];

    /// <summary>
    /// De filters boven de kolommen: datum (zoals getoond, bijv. "03-2026"), tekst in naam, tegenrekening of
    /// omschrijving (alle woorden), en het bedrag: een deel ("199"), of van-tot ("10-50"); zonder minteken telt het
    /// bedrag af en bij, met minteken alleen afschrijvingen.
    /// </summary>
    private bool PastFilter(BankmutatieRegel m)
    {
        if (GeldigeBank is { } bank && stand.Count > 1 && m.Dagboek != bank)
        {
            return false;
        }

        if (filterDatum.Length > 0 && !Weergave.Datum(m.Datum).Contains(filterDatum.Trim(), StringComparison.Ordinal))
        {
            return false;
        }

        if (filterTekst.Length > 0)
        {
            var tekst = $"{m.TegenNaam} {m.TegenIban} {m.Omschrijving}";
            if (!filterTekst.Split(' ', StringSplitOptions.RemoveEmptyEntries).All(w => tekst.Contains(w, StringComparison.CurrentCultureIgnoreCase)))
            {
                return false;
            }
        }

        var bedrag = filterBedrag.Trim();
        if (bedrag.Length == 0)
        {
            return true;
        }

        var negatief = bedrag.StartsWith('-') || bedrag.StartsWith('\u2212');
        if (negatief && m.Bedrag >= 0)
        {
            return false;
        }

        var zonderTeken = bedrag.TrimStart('-', '\u2212').Trim();
        var grenzen = zonderTeken.Split('-', 2, StringSplitOptions.TrimEntries);
        if (grenzen.Length == 2 && BedragParser.TryParse(grenzen[0], out var van) && BedragParser.TryParse(grenzen[1], out var tot))
        {
            var abs = Math.Abs(m.Bedrag);
            return abs >= Math.Min(van, tot) && abs <= Math.Max(van, tot);
        }

        return Bedragen.Getal(Math.Abs(m.Bedrag)).Replace(".", "", StringComparison.Ordinal).Contains(zonderTeken.Replace(".", "", StringComparison.Ordinal), StringComparison.Ordinal);
    }

    private void KiesMutatie(Guid id, bool aan)
    {
        if (aan)
        {
            geselecteerd.Add(id);
        }
        else
        {
            geselecteerd.Remove(id);
        }
    }

    private void KiesAlles(IReadOnlyList<BankmutatieRegel> lijst, bool aan)
    {
        foreach (var m in lijst)
        {
            KiesMutatie(m.Id, aan);
        }
    }

    private async Task BoekSelectie()
    {
        if (bezig)
        {
            return;
        }

        bezig = true;
        var kiezen = Zichtbaargekozen;
        var aantal = kiezen.Count;
        var uitkomst = await Bank.OpRekening(geopend!.Wie, Id, [.. kiezen], selectieRekening ?? "", string.IsNullOrEmpty(selectieBtw) ? null : selectieBtw);
        fouten = uitkomst.Fouten;
        if (uitkomst.Waarde is { } bulk)
        {
            Meldingen.Toon($"{bulk.Geboekt} van {aantal} mutaties geboekt op {selectieRekening} {schema?.Zoek(selectieRekening!)?.Naam}{(string.IsNullOrEmpty(selectieBtw) ? null : $", {selectieBtw}")}.");

            // Wat niet lukte, blijft gekozen, met de reden erbij.
            geselecteerd.RemoveWhere(id => !bulk.Mislukt.Contains(id));
            fouten = bulk.Redenen.Count > 0 ? bulk.Redenen : null;
            gekozen = null;
        }

        bezig = false;
        await Laad();
    }


    private static string Omzettitel(Pdfomzetting o) =>
        $"{o.Bestandsnaam}{(o.Afschrift.Nummer is { } nr ? $", afschrift {nr}" : null)}; beginsaldo {Weergave.Bedrag(o.Afschrift.Beginsaldo)}, eindsaldo {Weergave.Bedrag(o.Afschrift.Eindsaldo)}";

    /// <summary>Elke nieuwe bevestiging een nieuw element, zodat de korte melding opnieuw verschijnt.</summary>

    private void KiesDubbel()
    {
        foreach (var m in (mutaties ?? []).Where(m => m.MogelijkDubbel && m.Status == Banktransactiestatus.TeVerwerken && PastFilter(m)))
        {
            geselecteerd.Add(m.Id);
        }
    }

    private Task VerwijderSelectie() => Verwijder([.. Zichtbaargekozen]);

    /// <summary>
    /// De gekozen mutaties die nu in de lijst staan (tab en filters): alleen daarop werken Boeken en Verwijderen, zodat
    /// een vinkje bij een mutatie die door een ander filter uit beeld is, niet ongezien meegaat.
    /// </summary>
    private IReadOnlyList<Guid> Zichtbaargekozen =>
        [.. (mutaties ?? []).Where(m => geselecteerd.Contains(m.Id) && m.Status == Banktransactiestatus.TeVerwerken && PastFilter(m)).Select(m => m.Id)];

    private Task VerwijderGekozen() => gekozen is { } g ? Verwijder([g.Mutatie.Id]) : Task.CompletedTask;

    private async Task Verwijder(IReadOnlyList<Guid> weg)
    {
        if (bezig)
        {
            return;
        }

        bezig = true;
        var uitkomst = await Bank.Verwijder(geopend!.Wie, Id, weg);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            Meldingen.Toon(uitkomst.Waarde == 1 ? "1 mutatie verwijderd." : $"{uitkomst.Waarde} mutaties verwijderd.");
            geselecteerd.ExceptWith(weg);
            if (gekozen is { } g && weg.Contains(g.Mutatie.Id))
            {
                gekozen = null;
            }
        }

        bezig = false;
        await Laad();
    }

    private async Task GeenDubbel()
    {
        if (gekozen is not { } g || bezig)
        {
            return;
        }

        bezig = true;
        var klik = klikken;
        Uitkomst uitkomst;
        try
        {
            uitkomst = await Bank.GeenDubbel(geopend!.Wie, Id, g.Mutatie.Id);
            await Laad();
        }
        finally
        {
            bezig = false;
        }

        if (klik != klikken)
        {
            // Intussen een andere mutatie aangeklikt: die blijft staan.
            return;
        }

        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt && (mutaties ?? []).FirstOrDefault(m => m.Id == g.Mutatie.Id) is { Status: Banktransactiestatus.TeVerwerken } m)
        {
            // Opnieuw openen: het paneel (regels, voorstel) hoort nu bij een gewone mutatie.
            gekozen = null;
            await Kies(m);
            fouten = uitkomst.Fouten;
        }
    }

    private readonly Sortering<BankmutatieRegel> mutatiesortering = new(
        new("Datum", m => m.Datum, EerstOplopend: false),
        new("Rekening", m => m.Dagboek),
        new("Tegenpartij", m => (m.TegenNaam ?? m.Omschrijving).ToUpperInvariant()),
        new("Bedrag", m => m.Bedrag, EerstOplopend: false));

    private readonly Sortering<OpenpostRegel> postsortering = new(
        new("Vervalt", p => p.Vervaldatum),
        new("Relatie", p => p.Naam.ToUpperInvariant()),
        new("Factuur", p => p.Factuurnummer),
        new("Bedrag", p => p.Bedrag, EerstOplopend: false),
        new("Open", p => p.Openstaand, EerstOplopend: false));
    private List<(string Bestand, Uitkomst<Bankinlezing> Uitkomst)> uitkomsten = [];
    private bool bezig;
    private bool ookGeboekt;
    private bool mag;
    private Bankverwerking? gekozen;
    private (List<Guid> Posten, bool Afboeken, bool Kiezen)? venster;
    private List<Regelinvoer> regels = [];
    private bool magRegels;
    private bool autoOpen;
    private string? autoTekst;
    private string? autoVan;
    private string? autoTot;
    private bool autoIban;
    private bool autoAutomatisch = true;
    private string? autoBtw;
    private string? autoOmschrijving;
    private int autoVariabeleKeuze;
    private Regeltreffer? bewerkRegel;

    private void VoegAutoVariabeleToe(ChangeEventArgs e)
    {
        if (e.Value is string { Length: > 0 } variabele)
        {
            autoOmschrijving = $"{autoOmschrijving?.TrimEnd()} {variabele}".TrimStart();
        }

        autoVariabeleKeuze++;
    }

    private static string Bandbreedte(Verwerkingsregel regel) =>
        (regel.BedragVan, regel.BedragTot) switch
        {
            (null, { } tot) => $"tot en met {Weergave.Bedrag(tot)}",
            ({ } van, null) => $"vanaf {Weergave.Bedrag(van)}",
            ({ } van, { } tot) => $"{Weergave.Bedrag(van)} – {Weergave.Bedrag(tot)}",
            _ => "",
        };

    /// <summary>Het paneel Autoherkenning opent voor een nieuwe regel: met de btw van de eerste regel.</summary>
    private void NaOpenAuto()
    {
        if (autoOpen)
        {
            bewerkRegel = null;
            autoBtw = regels.FirstOrDefault(r => r.Post is null)?.BtwCode;
            autoOmschrijving = null;
        }
    }

    /// <summary>
    /// Een regel die (bijna) past aanpassen vanaf de mutatie: het paneel met de waarden van de regel; past het bedrag
    /// niet, dan alvast de grens die het bedrag van deze mutatie meeneemt.
    /// </summary>
    private void RegelAanpassen(Regeltreffer treffer)
    {
        var regel = treffer.Regel;
        var bedrag = Math.Abs(gekozen!.Mutatie.Bedrag);
        bewerkRegel = treffer;
        autoOpen = true;
        autoTekst = regel.NaamBevat ?? regel.OmschrijvingBevat;
        autoVan = regel.BedragVan is { } van ? Bedragen.Getal(Math.Min(van, Math.Floor(bedrag))) : null;
        autoTot = regel.BedragTot is { } tot ? Bedragen.Getal(Math.Max(tot, Math.Ceiling(bedrag))) : null;
        autoIban = regel.TegenIban is not null;
        autoAutomatisch = regel.Automatisch;
        autoBtw = regel.BtwCode;
        autoOmschrijving = regel.Omschrijving;
        if (regels.FirstOrDefault(r => r.Post is null) is { } eerste)
        {
            (eerste.Rekening, eerste.BtwCode) = (regel.Rekeningnummer, regel.BtwCode);
        }
    }

    /// <summary>Een regel in het verwerkpaneel: een deel van de mutatie op een openstaande post of op een grootboekrekening.</summary>
    private sealed class Regelinvoer
    {
        public Guid? Post { get; set; }

        public string? Rekening { get; set; }

        /// <summary>De btw-code; een andere code maakt een btw-bedrag met de hand leeg (dat hoorde bij de oude code).</summary>
        public string? BtwCode
        {
            get => btwCode;
            set
            {
                if (value != btwCode)
                {
                    Btwbedrag = null;
                }

                btwCode = value;
            }
        }

        private string? btwCode;

        /// <summary>Het bedrag; een ander bedrag maakt een btw-bedrag met de hand leeg (dat hoorde bij het oude bedrag).</summary>
        public string? Bedrag
        {
            get => bedrag;
            set
            {
                if (value != bedrag && bedrag is not null)
                {
                    Btwbedrag = null;
                }

                bedrag = value;
            }
        }

        private string? bedrag;

        public string? Omschrijving { get; set; }

        /// <summary>Het btw-bedrag met de hand; leeg = volgens de btw-code.</summary>
        public string? Btwbedrag { get; set; }

        public decimal Waarde => BedragParser.TryParse(Bedrag ?? "", out var b) ? b : 0m;

        public decimal? Btwwaarde => BedragParser.TryParse(Btwbedrag ?? "", out var b) ? Math.Abs(b) : null;
    }

    /// <summary>Het btw-bedrag in het bedrag van de regel volgens de btw-code (zonder teken), of leeg zonder btw.</summary>
    private static decimal? Btwvolgenscode(Bankverwerking g, Regelinvoer regel) =>
        Boekhouding.Btw.BtwCodes.Zoek(g.BtwCodes, regel.BtwCode) is { BtwOpFactuur: true } code
            ? Math.Abs(Boekhouding.Btw.BtwBerekening.UitInclusief(regel.Waarde, code.Percentage).Btw)
            : null;
    private IReadOnlyList<string>? fouten;
    private Inleesuitkomst? factuurUitkomst;
    private Herverwerking? opnieuw;

