@page "/a/{Id:guid}"
@inject DashboardDienst Dashboards

<AdministratieKader Id="Id" Titel="Dashboard" BijOpenen="Open">
    <Acties>
        @if (aanpassen)
        {
            <button class="btn btn-link text-secondary" @onclick="ZetStandaard">Standaard</button>
            <button class="btn btn-link text-secondary" @onclick="Annuleer">Annuleren</button>
            <button class="btn btn-primary" disabled="@bezig" @onclick="Bewaar">Klaar</button>
        }
        else
        {
            <button class="btn btn-outline-secondary" @onclick="BeginAanpassen"><Icoon Naam="sliders-horizontal" /> Aanpassen</button>
        }
    </Acties>
    <ChildContent>
        <Foutmeldingen Fouten="fouten" />
        @if (dashboard is null)
        {
            <Laadschets />
        }
        else
        {
            <div class="dashboard @(aanpassen ? "aanpassen" : null)">
                @for (var i = 0; i < indeling.Count; i++)
                {
                    var index = i;
                    var keuze = indeling[i];
                    <section class="widget @(Breed(keuze.Soort) ? "breed" : null)" data-widget="@keuze.Soort.ToString().ToLowerInvariant()" @key="keuze.Soort">
                        <header class="widgetkop">
                            <h2>@Titel(keuze)</h2>
                            @if (aanpassen)
                            {
                                <span class="widgetacties">
                                    @if (Widgetkeuze.Opties(keuze.Soort) is { Count: > 0 } opties)
                                    {
                                        <select class="form-select form-select-sm w-auto" aria-label="Keuze" value="@keuze.Geldig" @onchange="e => ZetOptie(index, e.Value as string)">
                                            @foreach (var o in opties)
                                            {
                                                <option value="@o">@Optienaam(o)</option>
                                            }
                                        </select>
                                    }
                                    <button class="icoonknop" title="Eerder" aria-label="Eerder" disabled="@(index == 0)" @onclick="() => Verplaats(index, -1)"><Icoon Naam="arrow-up" /></button>
                                    <button class="icoonknop" title="Later" aria-label="Later" disabled="@(index == indeling.Count - 1)" @onclick="() => Verplaats(index, 1)"><Icoon Naam="arrow-down" /></button>
                                    <button class="icoonknop" title="Weghalen" aria-label="Weghalen" @onclick="() => Haalweg(index)"><Icoon Naam="x" /></button>
                                </span>
                            }
                            else if (Link(keuze.Soort) is { } pad)
                            {
                                <a class="widgetlink" href="@pad" title="Openen" aria-label="Openen"><Icoon Naam="chevron-right" /></a>
                            }
                        </header>
                        <div class="widgetinhoud">
                            @Inhoud(keuze)
                        </div>
                    </section>
                }
                @if (aanpassen && Beschikbaar.Any())
                {
                    <section class="widget toevoegen breed">
                        <header class="widgetkop"><h2>Toevoegen</h2></header>
                        <div class="widgetinhoud d-flex flex-wrap gap-2">
                            @foreach (var soort in Beschikbaar)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Voegtoe(soort)"><Icoon Naam="plus" /> @Naam(soort)</button>
                            }
                        </div>
                    </section>
                }
                @if (indeling.Count == 0 && !aanpassen)
                {
                    <div class="leeg-blok breed">Er staat niets op het dashboard. Kies Aanpassen om widgets toe te voegen.</div>
                }
            </div>
        }
    </ChildContent>
</AdministratieKader>

@code {
    private Geopend? geopend;
    private IReadOnlyList<Widgetkeuze> opgeslagen = [];
    private List<Widgetkeuze> indeling = [];
    private Dashboard? dashboard;
    private bool aanpassen;
    private bool bezig;
    private IReadOnlyList<string>? fouten;

    [Parameter]
    public Guid Id { get; set; }

    private IEnumerable<Widget> Beschikbaar => Enum.GetValues<Widget>().Where(w => indeling.All(k => k.Soort != w));

    private async Task Open(Geopend g)
    {
        geopend = g;
        opgeslagen = await Dashboards.Indeling(g.Wie, Id);
        indeling = [.. opgeslagen];
        await Laad();
    }

    private async Task Laad() => dashboard = await Dashboards.Laad(geopend!.Wie, Id, indeling);

    private void BeginAanpassen() => (aanpassen, fouten) = (true, null);

    private async Task Annuleer()
    {
        (aanpassen, indeling) = (false, [.. opgeslagen]);
        await Laad();
    }

    private async Task ZetStandaard()
    {
        indeling = [.. DashboardDienst.Standaard];
        await Laad();
    }

    private async Task Bewaar()
    {
        bezig = true;
        var uitkomst = await Dashboards.BewaarIndeling(geopend!.Wie, Id, indeling);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            (aanpassen, opgeslagen) = (false, [.. indeling]);
        }

        bezig = false;
    }

    private void Verplaats(int index, int richting) =>
        (indeling[index], indeling[index + richting]) = (indeling[index + richting], indeling[index]);

    private void Haalweg(int index) => indeling.RemoveAt(index);

    private async Task Voegtoe(Widget soort)
    {
        var keuze = new Widgetkeuze(soort);
        indeling.Add(keuze with { Optie = keuze.Geldig });
        await Laad();
    }

    private async Task ZetOptie(int index, string? optie)
    {
        indeling[index] = indeling[index] with { Optie = optie };
        await Laad();
    }

    private static bool Breed(Widget soort) => soort is Widget.Maandgrafiek or Widget.Liquiditeit or Widget.Marge;

    private static string Naam(Widget soort) => soort switch
    {
        Widget.Liquide => "Bank en kas",
        Widget.Btw => "Btw",
        Widget.Inkoop => "Inkoopfacturen te verwerken",
        Widget.Bankmutaties => "Bankmutaties te verwerken",
        Widget.Debiteuren => "Openstaande debiteuren",
        Widget.Crediteuren => "Openstaande crediteuren",
        Widget.Maandgrafiek => "Omzet en resultaat per maand",
        Widget.Kerncijfers => "Kerncijfers",
        Widget.Verkoop => "Verkoop",
        Widget.Aansluitingen => "Aansluitingen",
        Widget.Liquiditeit => "Liquiditeit",
        Widget.Marge => "Brutomarge",
        _ => soort.ToString(),
    };

    private static string Optienaam(string optie) => optie switch
    {
        Widgetkeuze.Maand => "Per maand",
        Widgetkeuze.Kwartaal => "Per kwartaal",
        Widgetkeuze.Inkoop => "Met inkoop",
        Widgetkeuze.Kosten => "Met alle kosten",
        Widgetkeuze.VorigJaar => "Tegen vorig jaar",
        _ => optie,
    };

    private string Titel(Widgetkeuze keuze) => keuze.Soort switch
    {
        Widget.Btw when dashboard?.Btw is { } btw => $"Btw {btw.Afgelopen.Naam}",
        Widget.Maandgrafiek when dashboard?.Maandgrafiek is { } grafiek => $"Omzet, {(keuze.Geldig == Widgetkeuze.Kosten ? "kosten" : "inkoop")} en resultaat {grafiek.Jaar}",
        Widget.Kerncijfers when dashboard?.Kerncijfers is { } k => $"Kerncijfers t/m {Weergave.Datum(k.Dit.Tot)}",
        Widget.Liquiditeit => "Liquiditeit, bank en kas per maand",
        Widget.Marge when dashboard?.Marge is { } marge => keuze.Geldig == Widgetkeuze.Kwartaal
            ? $"Brutomarge per kwartaal {marge.Van.Year}"
            : $"Brutomarge t/m {Weergave.Datum(marge.Tot)}, tegen vorig jaar",
        _ => Naam(keuze.Soort),
    };

    /// <summary>Een pagina van deze administratie.</summary>
    private string Pad(string pad) => $"/a/{Id}{pad}";

    /// <summary>
    /// De kolommenbalans van een vaste periode: het dashboard geeft de periode altijd mee, zodat de pagina niet opent
    /// op het jaar waarin de gebruiker daar het laatst werkte.
    /// </summary>
    private string Kolommenbalans(DateOnly van, DateOnly tot, bool perMaand = false, bool vorigJaar = false) =>
        Pad($"/kolommenbalans?{Weergave.Periodequery(van, tot)}{(perMaand ? "&weergave=maand" : null)}{(vorigJaar ? "&vergelijk=jaar" : null)}");

    private string Grootboekkaart(string rekening, DateOnly van, DateOnly tot) =>
        Pad($"/grootboek?rekening={Uri.EscapeDataString(rekening)}&{Weergave.Periodequery(van, tot)}");

    private DateOnly Vandaag => dashboard?.Vandaag ?? DateOnly.FromDateTime(DateTime.Today);

    private DateOnly Nieuwjaar => new(Vandaag.Year, 1, 1);

    /// <summary>Waar de pijl in de kop van een widget naartoe gaat.</summary>
    private string? Link(Widget soort) => soort switch
    {
        Widget.Liquide or Widget.Bankmutaties => Pad("/bank"),
        Widget.Aansluitingen => Pad("/aansluitingen"),
        Widget.Btw when dashboard?.Btw is { } btw => Kolommenbalans(btw.Afgelopen.Van, btw.Afgelopen.Tot),
        Widget.Inkoop => Pad("/inkoop"),
        Widget.Debiteuren => Pad("/debiteuren"),
        Widget.Crediteuren => Pad("/crediteuren"),
        Widget.Maandgrafiek => Kolommenbalans(Nieuwjaar, new DateOnly(Vandaag.Year, 12, 31), perMaand: true),
        Widget.Kerncijfers => Kolommenbalans(Nieuwjaar, Vandaag, vorigJaar: true),
        Widget.Verkoop => Pad($"/verkoop?{Weergave.Periodequery(Nieuwjaar, new DateOnly(Vandaag.Year, 12, 31))}"),
        Widget.Liquiditeit when dashboard?.Liquiditeit is [var eerste, ..] => Kolommenbalans(eerste.Maand, Vandaag, perMaand: true),
        Widget.Marge => Kolommenbalans(Nieuwjaar, Vandaag, vorigJaar: true),
        _ => null,
    };

    private static string Aantal(int aantal, string enkel, string meer) => $"{aantal} {(aantal == 1 ? enkel : meer)}";

    private RenderFragment Inhoud(Widgetkeuze keuze) => keuze.Soort switch
    {
        Widget.Liquide when dashboard!.Liquide is { } rekeningen => @<div>
            <a class="kerngetal" href="@Pad("/bank")">@Weergave.BedragHeel(rekeningen.Sum(r => r.Saldo))</a>
            <table class="widgettabel">
                @foreach (var (r, heel) in rekeningen.Zip(Weergave.HeleEuros(rekeningen.Select(r => r.Saldo))))
                {
                    <tr title="@(r.Afschrift is { } a ? $"Laatste afschrift t/m {Weergave.Datum(a.Datum)}: {Weergave.BedragHeel(a.Saldo)}" : $"Rekening {r.Rekening}")">
                        <td><a href="@Grootboekkaart(r.Rekening, Nieuwjaar, Vandaag)">@r.Naam</a></td>
                        <td class="text-end">
                            @if (r.Afschrift is { } afschrift && afschrift.Saldo != r.Saldo)
                            {
                                <a class="let-op me-2" href="@Pad("/aansluitingen")">afschrift @Weergave.BedragHeel(afschrift.Saldo)</a>
                            }
                            @Weergave.BedragHeel(heel)
                        </td>
                    </tr>
                }
            </table>
        </div>,
        Widget.Btw when dashboard!.Btw is { } btw => @<div>
            <a class="kerngetal" href="@Kolommenbalans(btw.Afgelopen.Van, btw.Afgelopen.Tot)">@Weergave.BedragHeel(Math.Abs(btw.TeBetalen))</a>
            <div class="widgetregel">@(btw.TeBetalen >= 0 ? "te betalen" : "terug te vragen"), saldo per @Weergave.Datum(btw.Afgelopen.Tot)</div>
            <a class="widgetregel zacht d-block" href="@Kolommenbalans(btw.Lopend.Van, btw.Lopend.Tot)" title="De btw die in de lopende periode al is geboekt">@btw.Lopend.Naam tot nu: @Weergave.BedragHeel(Math.Abs(btw.Lopende)) @(btw.Lopende >= 0 ? "te betalen" : "terug")</a>
        </div>,
        Widget.Inkoop when dashboard!.Inkoop is { } inkoop => @<div>
            <a class="kerngetal" href="@Pad("/inkoop")">@inkoop.Aantal</a>
            <div class="widgetregel">@(inkoop.Aantal == 0 ? "alles verwerkt" : $"{(inkoop.Aantal == 1 ? "factuur" : "facturen")}, samen {Weergave.BedragHeel(inkoop.Totaal)}")</div>
        </div>,
        Widget.Bankmutaties when dashboard!.Bankmutaties is { } mutaties => @<div>
            <a class="kerngetal" href="@Pad("/bank")">@mutaties.Aantal</a>
            <div class="widgetregel">
                @if (mutaties.Oudste is { } oudste)
                {
                    <span>oudste van @Weergave.Datum(oudste)</span>
                }
                else
                {
                    <span>alles verwerkt</span>
                }
            </div>
            @if (mutaties.MogelijkDubbel > 0)
            {
                <a class="widgetregel let-op d-block" href="@Pad("/bank")">@Aantal(mutaties.MogelijkDubbel, "mogelijk dubbel", "mogelijk dubbel")</a>
            }
        </div>,
        Widget.Debiteuren when dashboard!.Debiteuren is { } open => Openstaand(open, Pad("/debiteuren")),
        Widget.Crediteuren when dashboard!.Crediteuren is { } open => Openstaand(open, Pad("/crediteuren")),
        Widget.Maandgrafiek when dashboard!.Maandgrafiek is { } grafiek => @<Maandgrafiek Maanden="grafiek.Maanden" AlleKosten="@(keuze.Geldig == Widgetkeuze.Kosten)" Tot="Vandaag"
            Adres="@(m => Kolommenbalans(m, m.AddMonths(1).AddDays(-1)))" />,
        Widget.Liquiditeit when dashboard!.Liquiditeit is { } maanden => @<Liquiditeitsgrafiek Maanden="maanden" Adres="@(m => Kolommenbalans(m.Maand, m.Tot))" />,
        Widget.Kerncijfers when dashboard!.Kerncijfers is { } k => @<table class="widgettabel">
            <thead>
                <tr>
                    <th></th>
                    <th class="text-end"><a href="@Kolommenbalans(k.Dit.Van, k.Dit.Tot)">@k.Dit.Van.Year</a></th>
                    <th class="text-end"><a href="@Kolommenbalans(k.Vorig.Van, k.Vorig.Tot)">@k.Vorig.Van.Year</a></th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Omzet</td><td class="text-end">@Weergave.BedragHeel(k.Dit.Omzet)</td><td class="text-end zacht">@Weergave.BedragHeel(k.Vorig.Omzet)</td></tr>
                <tr><td>Kosten</td><td class="text-end">@Weergave.BedragHeel(k.Dit.Kosten)</td><td class="text-end zacht">@Weergave.BedragHeel(k.Vorig.Kosten)</td></tr>
                <tr class="totaal"><td>Resultaat</td><td class="text-end">@Weergave.BedragHeel(k.Dit.Resultaat)</td><td class="text-end zacht">@Weergave.BedragHeel(k.Vorig.Resultaat)</td></tr>
            </tbody>
        </table>,
        Widget.Verkoop when dashboard!.Verkoop is { } verkoop => @<table class="widgettabel">
            <tr><td><a href="@Link(Widget.Verkoop)">Conceptfacturen</a></td><td class="text-end">@verkoop.Concepten</td></tr>
            <tr><td><a href="@Pad("/verkoop/terugkerend")">Terugkerend te maken</a></td><td class="text-end">@verkoop.Terugkerend</td></tr>
        </table>,
        Widget.Aansluitingen when dashboard!.Aansluitingen is { } aansluiting => @<div>
            @if (aansluiting.SluitenNiet.Count == 0)
            {
                <a class="kerngetal" href="@Pad("/aansluitingen")">Sluit</a>
                <div class="widgetregel">@Aantal(aansluiting.Totaal, "aansluiting", "aansluitingen") gecontroleerd</div>
            }
            else
            {
                <a class="kerngetal" href="@Pad("/aansluitingen")">@aansluiting.SluitenNiet.Count</a>
                <div class="widgetregel let-op" title="@string.Join(", ", aansluiting.SluitenNiet)">@(aansluiting.SluitenNiet.Count == 1 ? "sluit niet" : "sluiten niet"): @string.Join(", ", aansluiting.SluitenNiet)</div>
            }
        </div>,
        Widget.Marge when dashboard!.Marge is { Groepen.Count: 0 } => @<div class="widgetregel zacht">Geen margegroepen in het <a href="@Pad("/rekeningschema")">rekeningschema</a></div>,
        Widget.Marge when dashboard!.Marge is { } marge && keuze.Geldig == Widgetkeuze.Kwartaal => Kwartaalmarge(marge),
        Widget.Marge when dashboard!.Marge is { } marge => Margetegenvorigjaar(marge),
        _ => @<div class="widgetregel zacht">Bezig met laden</div>,
    };

    /// <summary>Een marge in procenten van de omzet, bijv. "34,5%"; leeg zonder omzet.</summary>
    private static string Procent(decimal? procent) =>
        procent is { } p ? p.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("nl-NL")) + "%" : "";

    private static string Afwijking(decimal bedrag) => bedrag > 0 ? "+" + Weergave.BedragHeel(bedrag) : Weergave.BedragHeel(bedrag);

    private RenderFragment Margetegenvorigjaar(Margestand marge) => @<table class="widgettabel margetabel">
        @{
            var omzet = Weergave.HeleEuros(marge.Groepen.Select(g => g.Dit.Omzet));
            var inkoop = Weergave.HeleEuros(marge.Groepen.Select(g => g.Dit.Inkoop));
            var bruto = Weergave.HeleEuros(marge.Groepen.Select(g => g.Dit.Brutomarge));
            var vorig = Weergave.HeleEuros(marge.Groepen.Select(g => g.Vorig.Brutomarge));
        }
        <thead>
            <tr>
                <th></th>
                <th class="text-end">Omzet</th>
                <th class="text-end">Inkoop</th>
                <th class="text-end"><a href="@Kolommenbalans(marge.Van, marge.Tot)">Brutomarge</a></th>
                <th class="text-end">%</th>
                <th class="text-end"><a href="@Kolommenbalans(marge.VorigVan, marge.VorigTot)">Vorig jaar</a></th>
                <th class="text-end">%</th>
                <th class="text-end">Afwijking</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < marge.Groepen.Count; i++)
            {
                var g = marge.Groepen[i];
                <tr>
                    <td>@g.Groep</td>
                    <td class="text-end">@Weergave.BedragHeel(omzet[i])</td>
                    <td class="text-end">@Weergave.BedragHeel(inkoop[i])</td>
                    <td class="text-end">@Weergave.BedragHeel(bruto[i])</td>
                    <td class="text-end">@Procent(g.Dit.Percentage)</td>
                    <td class="text-end zacht" title="@($"Omzet {Weergave.BedragHeel(g.Vorig.Omzet)}, inkoop {Weergave.BedragHeel(g.Vorig.Inkoop)}")">@Weergave.BedragHeel(vorig[i])</td>
                    <td class="text-end zacht">@Procent(g.Vorig.Percentage)</td>
                    <td class="text-end">@Afwijking(bruto[i] - vorig[i])</td>
                </tr>
            }
            @if (marge.Groepen.Count > 1)
            {
                var t = marge.Totaal;
                <tr class="totaal">
                    <td>Totaal</td>
                    <td class="text-end">@Weergave.BedragHeel(t.Dit.Omzet)</td>
                    <td class="text-end">@Weergave.BedragHeel(t.Dit.Inkoop)</td>
                    <td class="text-end">@Weergave.BedragHeel(t.Dit.Brutomarge)</td>
                    <td class="text-end">@Procent(t.Dit.Percentage)</td>
                    <td class="text-end zacht">@Weergave.BedragHeel(t.Vorig.Brutomarge)</td>
                    <td class="text-end zacht">@Procent(t.Vorig.Percentage)</td>
                    <td class="text-end">@Afwijking(Domain.Afronding.OpHeleEuro(t.Dit.Brutomarge) - Domain.Afronding.OpHeleEuro(t.Vorig.Brutomarge))</td>
                </tr>
            }
        </tbody>
    </table>;

    private RenderFragment Kwartaalmarge(Margestand marge) => @<table class="widgettabel margetabel">
        <thead>
            <tr>
                <th></th>
                @for (var k = 0; k < marge.Totaal.Kwartalen.Count; k++)
                {
                    var van = new DateOnly(marge.Van.Year, (k * 3) + 1, 1);
                    var tot = k == marge.Totaal.Kwartalen.Count - 1 ? marge.Tot : van.AddMonths(3).AddDays(-1);
                    <th class="text-end" colspan="2"><a href="@Kolommenbalans(van, tot)">@($"{k + 1}e kwartaal")</a></th>
                }
                <th class="text-end" colspan="2"><a href="@Kolommenbalans(marge.Van, marge.Tot)">@marge.Van.Year</a></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var g in marge.Groepen.Count > 1 ? [.. marge.Groepen, marge.Totaal] : marge.Groepen)
            {
                <tr class="@(ReferenceEquals(g, marge.Totaal) ? "totaal" : null)">
                    <td>@g.Groep</td>
                    @foreach (var k in g.Kwartalen.Append(g.Dit))
                    {
                        <td class="text-end" title="@($"Omzet {Weergave.BedragHeel(k.Omzet)}, inkoop {Weergave.BedragHeel(k.Inkoop)}")">@Weergave.BedragHeel(k.Brutomarge)</td>
                        <td class="text-end zacht procent">@Procent(k.Percentage)</td>
                    }
                </tr>
            }
        </tbody>
    </table>;

    private static RenderFragment Openstaand(Openstaand open, string adres) => @<div>
        <a class="kerngetal" href="@adres">@Weergave.BedragHeel(open.Totaal)</a>
        <div class="widgetregel">@(open.Aantal == 1 ? "1 factuur" : $"{open.Aantal} facturen")</div>
        @if (open.AantalVervallen > 0)
        {
            <a class="widgetregel let-op d-block" href="@adres">@open.AantalVervallen vervallen, samen @Weergave.BedragHeel(open.Vervallen)</a>
        }
    </div>;
}
