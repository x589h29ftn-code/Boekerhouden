@page "/a/{Id:guid}/inkoop"
@using Boekerhouden.Documenten
@inject InkoopDienst Inkoop
@inject Meldingen Meldingen
@inject ConceptDienst Concepten

<AdministratieKader Id="Id" Titel="Inkoop" Actief="/inkoop" BijOpenen="Open">
    <Kenmerken>
        @if (stand is { } st)
        {
            <span>bezig: @st.Gedaan van @st.Totaal</span>
        }
        else if (teVerwerken is { Count: 0 })
        {
            <span>alles verwerkt</span>
        }
        else if (teVerwerken is { } lijst)
        {
            <span><strong>@lijst.Count</strong> te verwerken</span>
            <span class="scheiding">·</span>
            <span title="@Weergave.DatumTijd(lijst.Min(d => d.IngelezenOp))">oudste ingelezen @Weergave.Moment(lijst.Min(d => d.IngelezenOp))</span>
            @if (opnieuw is { } o)
            {
                <span class="scheiding">·</span>
                <span>@Samenvatting(o)</span>
            }
        }
    </Kenmerken>
    <Acties>
        @if (geopend?.Kop.Mag(Recht.Invoeren) == true)
        {
            @if (teVerwerken is { Count: > 0 })
            {
                <button class="btn btn-sm btn-outline-secondary" disabled="@bezig" title="Opnieuw door de facturen in Te verwerken, met wat het pakket nu weet (relaties, regels, wat er geleerd is)" @onclick="VerwerkOpnieuw">Opnieuw herkennen</button>
            }
            <label class="btn btn-sm btn-primary @(bezig ? "disabled" : null)" for="bestanden" aria-busy="@(bezig ? "true" : null)" title="PDF, e-factuur (UBL) of foto; slepen op de pagina kan ook">Facturen inlezen</label>
        }
    </Acties>
    <ChildContent>
        @if (context.Mag(Recht.Invoeren))
        {
            <div class="inlezen">
                <Sleepvlak Id="bestanden" Pagina="true" Tekst="Facturen inlezen" Accept=".pdf,.xml,.jpg,.jpeg,.png,application/pdf,application/xml,text/xml,image/jpeg,image/png" OnChange="LeesIn" Bezig="bezig" />
                @foreach (var u in uitkomsten.Where(u => u.Status == Documentstatus.Quarantaine || u.DocumentId is null))
                {
                    <div class="small mb-1 status let-op">@u.Melding</div>
                }
            </div>
        }
        <Foutmeldingen Fouten="bulkfouten" />
        @if (teVerwerken is { Count: 0 })
        {
            <LegeStaat Icoon="inbox" Tekst="Geen documenten te verwerken">
                @if (geopend?.Kop.Mag(Recht.Invoeren) == true)
                {
                    <label class="btn btn-sm btn-outline-primary" for="bestanden">Facturen inlezen</label>
                }
            </LegeStaat>
        }
        else if (teVerwerken is not null)
        {
            <div class="card mb-4">
                <table class="table table-sm table-hover align-middle mb-0" data-sleepbaar="inkoop-werkvoorraad">
                <thead>
                        <tr>
                            @if (magInvoeren)
                            {
                                <th class="kiesvak"><input class="form-check-input" type="checkbox" aria-label="Alles kiezen" checked="@(gekozen.Count > 0 && gekozen.Count == teVerwerken.Count)" @onchange="e => KiesAlle(e.Value is true)" /></th>
                            }
                            <SorteerKop Sortering="sortering" Naam="Leverancier" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Factuurnummer" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Factuurdatum" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Bedrag" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Waarom" Gewijzigd="StateHasChanged" />
                            <SorteerKop Sortering="sortering" Naam="Ingelezen" Gewijzigd="StateHasChanged" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in sortering.Pas(teVerwerken))
                        {
                            <tr class="@(gekozen.Contains(d.Id) ? "gekozen" : null)">
                                @if (magInvoeren)
                                {
                                    <td class="kiesvak"><input class="form-check-input" type="checkbox" aria-label="Kiezen" checked="@gekozen.Contains(d.Id)" @onchange="e => Kies(d.Id, e.Value is true)" /></td>
                                }
                                <td><a href="/a/@Id/inkoop/@d.Id">@(d.Leverancier ?? d.Bestandsnaam)</a></td>
                                <td>@d.Factuurnummer</td>
                                <td class="text-nowrap">@(d.Factuurdatum is { } fd ? Weergave.Datum(fd) : null)</td>
                                <td class="bedrag text-end"><Euro Waarde="d.Totaal" /></td>
                                <td class="small text-secondary">@if (metConcept.Contains(d.Id))
                                    {
                                        <span class="status me-1 concept-markering">bewaard</span>
                                    }@d.Melding</td>
                                <td class="small text-secondary text-nowrap" title="@d.IngelezenDoor, @Weergave.DatumTijd(d.IngelezenOp)">@Weergave.Moment(d.IngelezenOp)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (gekozen.Count > 0)
            {
                <div class="actiebalk">
                    <span>@gekozen.Count @(gekozen.Count == 1 ? "document" : "documenten") gekozen</span>
                    <VerwijderKnop Bezig="bezig" Titel="De gekozen documenten verdwijnen uit Te verwerken" Bevestigd="VerwijderGekozen" />
                    <button class="btn btn-sm btn-link text-secondary ms-auto" @onclick="() => gekozen.Clear()">Niets kiezen</button>
                </div>
            }
        }
    </ChildContent>
</AdministratieKader>

@code {
    private const int MaximumBestanden = 250;

    private Geopend? geopend;
    private IReadOnlyList<DocumentRegel>? teVerwerken;
    private IReadOnlySet<Guid> metConcept = new HashSet<Guid>();

    private readonly Sortering<DocumentRegel> sortering = new(
        new("Leverancier", d => (d.Leverancier ?? d.Bestandsnaam).ToUpperInvariant()),
        new("Factuurnummer", d => d.Factuurnummer),
        new("Factuurdatum", d => d.Factuurdatum, EerstOplopend: false),
        new("Bedrag", d => d.Totaal, EerstOplopend: false),
        new("Waarom", d => d.Melding),
        new("Ingelezen", d => d.IngelezenOp, EerstOplopend: false));
    private List<Inleesuitkomst> uitkomsten = [];
    private bool bezig;
    private Herverwerking? opnieuw;
    private (int Gedaan, int Totaal)? stand;

    [Parameter]
    public Guid Id { get; set; }

    private async Task Open(Geopend g)
    {
        geopend = g;
        await Laad();
    }

    private async Task Laad()
    {
        teVerwerken = [.. (await Inkoop.Lijst(geopend!.Wie, Id)).Where(d => d.Status == Documentstatus.TeVerwerken)];
        metConcept = await Concepten.Met(geopend.Wie, Id, Conceptsoort.Inkoop);
        gekozen.IntersectWith(teVerwerken.Select(d => d.Id));
    }

    // Meerdere documenten tegelijk verwijderen (bijv. dubbel ingelezen of niet voor deze administratie): regel voor
    // regel via InkoopDienst.Verwijder, met dezelfde controles en hetzelfde wijzigingslog.
    private readonly HashSet<Guid> gekozen = [];
    private IReadOnlyList<string>? bulkfouten;

    private bool magInvoeren => geopend?.Kop.Mag(Recht.Invoeren) == true;

    private void Kies(Guid id, bool aan)
    {
        if (aan)
        {
            gekozen.Add(id);
        }
        else
        {
            gekozen.Remove(id);
        }
    }

    private void KiesAlle(bool aan)
    {
        gekozen.Clear();
        if (aan)
        {
            gekozen.UnionWith(teVerwerken!.Select(d => d.Id));
        }
    }

    private async Task VerwijderGekozen()
    {
        bezig = true;
        var documenten = teVerwerken!.Where(d => gekozen.Contains(d.Id)).ToList();
        var uitkomst = await Bulk.Voer(documenten, d => Inkoop.Verwijder(geopend!.Wie, Id, d.Id), d => d.Leverancier ?? d.Bestandsnaam);
        gekozen.Clear();
        await Laad();
        bezig = false;
        bulkfouten = uitkomst.Fouten;
        Meldingen.Toon($"{uitkomst.Gelukt} {(uitkomst.Gelukt == 1 ? "document" : "documenten")} verwijderd{(uitkomst.Fouten.Count > 0 ? $", {uitkomst.Fouten.Count} niet" : null)}.");
    }

    private async Task VerwerkOpnieuw()
    {
        bezig = true;

        // De stand op het scherm, niet bij elk document (dat zou bij honderden facturen alleen het scherm bezighouden).
        var voortgang = new Progress<(int Gedaan, int Totaal)>(v =>
        {
            if (v.Gedaan % 10 == 0)
            {
                stand = v;
                _ = InvokeAsync(StateHasChanged);
            }
        });
        opnieuw = await Inkoop.VerwerkOpnieuw(geopend!.Wie, Id, voortgang);
        (bezig, stand) = (false, null);
        await Laad();
    }

    internal static string Samenvatting(Herverwerking h) =>
        $"{h.Bekeken} bekeken, {(h.Geboekt == 0 ? "niets" : h.Geboekt.ToString(System.Globalization.CultureInfo.InvariantCulture))} automatisch geboekt";

    private async Task LeesIn(InputFileChangeEventArgs e)
    {
        bezig = true;
        uitkomsten = [];
        foreach (var bestand in e.GetMultipleFiles(MaximumBestanden))
        {
            try
            {
                await using var stream = bestand.OpenReadStream(PdfTekst.MaximumBytes);
                uitkomsten.Add(await Inkoop.Lees(geopend!.Wie, Id, stream, bestand.Name, bestand.ContentType));
            }
            catch (IOException)
            {
                uitkomsten.Add(new Inleesuitkomst(null, null, $"{bestand.Name} is groter dan {PdfTekst.MaximumBytes / 1024 / 1024} MB en is niet ingelezen."));
            }

            StateHasChanged();
        }

        bezig = false;
        MeldDubbel([.. uitkomsten.Where(u => u.Dubbel).Select(u => u.Melding)]);
        await Laad();
    }

    /// <summary>Dubbel ingelezen facturen kort melden (linksonder), ook als de rest goed ging.</summary>
    private void MeldDubbel(IReadOnlyList<string> meldingen)
    {
        if (meldingen.Count == 1)
        {
            Meldingen.Toon(meldingen[0]);
        }
        else if (meldingen.Count > 1)
        {
            Meldingen.Toon($"{meldingen.Count} dubbele facturen niet opnieuw ingelezen.");
        }
    }
}
