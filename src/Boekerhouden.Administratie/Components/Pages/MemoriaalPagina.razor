@page "/a/{Id:guid}/memoriaal"
@using Boekerhouden.Boekhouding.Grootboek
@inject GrootboekDienst Grootboek
@inject ActivaDienst Activa
@inject LoonjournaalDienst Loonjournaal
@inject TimeProvider Tijd
@inject NavigationManager Navigatie

<AdministratieKader Id="Id" Titel="Memoriaal" Actief="/memoriaal" BijOpenen="Open">
    <Acties>
        @if (geopend?.Kop.Mag(Recht.Boekhouden) == true)
        {
            @* Alles wat een nieuwe boeking begint, achter één knop. *@
            <span class="knopmenu memoriaal-nieuw">
                <button class="btn btn-sm btn-outline-secondary" aria-expanded="@(menuOpen ? "true" : "false")" @onclick="() => menuOpen = !menuOpen">Nieuw <Icoon Naam="chevron-down" /></button>
                @if (menuOpen)
                {
                    <span class="menu">
                        <button type="button" @onclick="() => { menuOpen = false; NieuweBoeking(); }">Nieuwe boeking</button>
                        @if (gekozen is not null)
                        {
                            <button type="button" title="Een nieuwe boeking met dezelfde regels, een maand later" @onclick="() => { menuOpen = false; Kopieer(gekozen.Post); }">Deze boeking kopiëren</button>
                        }
                        @if (posten is { Count: > 0 })
                        {
                            <button type="button" title="Een eerdere boeking overnemen, bijv. de loonjournaalpost van vorige maand" @onclick="() => { menuOpen = false; KopieKiezen(); }">Boeking kopiëren…</button>
                        }
                        <label for="loonjournaal" title="Het journaal uit het salarispakket (PDF) als boeking" @onclick="() => menuOpen = false">Loonjournaal importeren…</label>
                    </span>
                }
            </span>
        }
    </Acties>
    <ChildContent>
        @if (!context.Mag(Recht.Boekhouden))
        {
            <div class="alert alert-warning">Het memoriaal is voor het kantoor.</div>
        }
        else if (geopend is not null && schema is not null && dagboek is not null)
        {
            <ul class="nav nav-tabs memoriaal-dagboeken mb-3">
                @foreach (var d in memorialen)
                {
                    <li class="nav-item">
                        <a class="nav-link @(d.Code == dagboek.Code ? "active" : null)" href="/a/@Id/memoriaal?dagboek=@Uri.EscapeDataString(d.Code)" title="@d.Code">@d.Naam</a>
                    </li>
                }
                <li class="nav-item">
                    <button class="nav-link text-secondary" title="Een memoriaal erbij, bijv. voor lonen of de accountant" @onclick="() => nieuwDagboek = new()"><Icoon Naam="plus" /> Dagboek</button>
                </li>
            </ul>
            @if (nieuwDagboek is not null)
            {
                <div class="card card-body mb-3">
                    <Foutmeldingen Fouten="dagboekfouten" />
                    <div class="d-flex align-items-end flex-wrap gap-2">
                        <div>
                            <label class="form-label small" for="dagboekcode">Code</label>
                            <input id="dagboekcode" class="form-control form-control-sm veld-boekstuk" @bind="nieuwDagboek.Code" placeholder="MLON" />
                        </div>
                        <div class="flex-grow-1">
                            <label class="form-label small" for="dagboeknaam">Naam</label>
                            <input id="dagboeknaam" class="form-control form-control-sm" @bind="nieuwDagboek.Naam" placeholder="Memoriaal lonen" />
                        </div>
                        <button class="btn btn-sm btn-primary" @onclick="VoegDagboekToe">Toevoegen</button>
                        <button class="btn btn-sm btn-link text-secondary" @onclick="() => (nieuwDagboek, dagboekfouten) = (null, null)">Annuleren</button>
                    </div>
                </div>
            }
            @if (bericht is not null)
            {
                <div class="bericht mb-2">@bericht</div>
            }
            <InputFile id="loonjournaal" class="d-none" accept=".pdf,application/pdf" OnChange="LeesLoonjournaal" />
            <Foutmeldingen Fouten="loonfouten" />
            @if (kopieBron is not null && posten is { Count: > 0 })
            {
                <div class="card card-body mb-3 kopie-kiezen">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <label class="small text-secondary" for="kopiebron">Kopiëren van</label>
                        <select id="kopiebron" class="form-select form-select-sm w-auto" @bind="kopieBron">
                            @foreach (var p in posten)
                            {
                                <option value="@p.Post.Boekstuk">@Weergave.Datum(p.Post.Datum) · @p.Post.Boekstuk · @p.Post.Omschrijving</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-primary" @onclick="KopieerBron">Kopiëren</button>
                        <button class="btn btn-sm btn-link text-secondary" @onclick="() => kopieBron = null">Annuleren</button>
                    </div>
                </div>
            }
            @if (loon is { } lj)
            {
                <div class="card card-body mb-3 loonjournaal">
                    <div class="d-flex align-items-baseline flex-wrap gap-2 mb-2">
                        <span class="fw-semibold">Loonjournaal</span>
                        <span class="small text-secondary" title="@lj.Bestandsnaam">@lj.Journaal.Werkgever@(lj.Journaal.PeriodeVan is { } van ? $" · periode {van} t/m {lj.Journaal.PeriodeTot}" : null)</span>
                    </div>
                    @foreach (var signaal in lj.Signalen)
                    {
                        <div class="status let-op d-block small mb-1">@signaal</div>
                    }
                    <table class="table table-sm align-middle mb-2 overzichtstabel regeltabel">
                        <thead>
                            <tr><th>Salarispakket</th><th style="width:34%">Rekening</th><th class="text-end" style="width:9rem">Debet</th><th class="text-end" style="width:9rem">Credit</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var k in loonregels)
                            {
                                <tr>
                                    <td><span class="rekeningnummer">@k.Regel.Nummer</span> @k.Regel.Naam</td>
                                    <td title="@Bronnaam(k.Bron)"><RekeningKeuze @bind-Waarde="k.Rekening" Schema="schema" Kader="geopend" Label="@($"Rekening voor {k.Regel.Naam}")" /></td>
                                    <td class="bedrag text-end">@(k.Regel.Bedrag > 0 ? Weergave.Bedrag(k.Regel.Bedrag) : null)</td>
                                    <td class="bedrag text-end">@(k.Regel.Bedrag < 0 ? Weergave.Bedrag(-k.Regel.Bedrag) : null)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="generaal">
                                <td colspan="2"></td>
                                <td class="bedrag text-end">@Weergave.Bedrag(lj.Journaal.Debet)</td>
                                <td class="bedrag text-end">@Weergave.Bedrag(lj.Journaal.Credit)</td>
                            </tr>
                        </tfoot>
                    </table>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <label class="small text-secondary" for="loonmaand">Periode</label>
                        <input id="loonmaand" type="month" class="form-control form-control-sm w-auto" @bind="loonMaand" @bind:format="yyyy-MM" />
                        <input class="form-control form-control-sm" style="max-width:24rem" aria-label="Omschrijving" @bind="loonOmschrijving" />
                        <button class="btn btn-sm btn-primary" disabled="@(lj.Journaal.Debet != lj.Journaal.Credit || loonregels.Any(k => string.IsNullOrWhiteSpace(k.Rekening)))" @onclick="LoonNaarBoeking">Naar boeking</button>
                        <button class="btn btn-sm btn-link text-secondary" @onclick="() => loon = null">Annuleren</button>
                        @if (lj.Journaal.Debet != lj.Journaal.Credit)
                        {
                            <span class="status let-op">Niet in balans</span>
                        }
                        else if (loonregels.Any(k => string.IsNullOrWhiteSpace(k.Rekening)))
                        {
                            <span class="status">Kies bij elke regel een rekening</span>
                        }
                    </div>
                </div>
            }
            <div class="card card-body mb-4 @(loon is not null || kopieBron is not null ? "d-none" : null)">
                <BoekingBewerken @key="formulier" Kader="geopend" Schema="schema" Dagboek="@dagboek.Code" Post="gekozen?.Post" Voorbeeld="kopie" VoorbeeldOpDatum="kopieOpDatum" Datum="vandaag"
                                 Opgeslagen="Opgeslagen" Geannuleerd="@(gekozen is null && kopie is null ? default : EventCallback.Factory.Create(this, NieuweBoeking))" />
            </div>

            @if (posten is { Count: > 0 })
            {
                <h2 class="h6 sectiekop">Geboekt in @dagboek.Naam</h2>
                <div class="card">
                    <table class="table table-sm align-middle mb-0 overzichtstabel memoriaal-lijst" data-sleepbaar="memoriaal">
                        <thead>
                            <tr>
                                <th class="kiesvak"><input class="form-check-input" type="checkbox" aria-label="Alles kiezen" checked="@(geselecteerd.Count > 0 && geselecteerd.Count == posten.Count)" @onchange="e => KiesAlle(e.Value is true)" /></th>
                                <SorteerKop Sortering="sortering" Naam="Datum" Gewijzigd="StateHasChanged" />
                                <SorteerKop Sortering="sortering" Naam="Boekstuk" Gewijzigd="StateHasChanged" />
                                <SorteerKop Sortering="sortering" Naam="Omschrijving" Gewijzigd="StateHasChanged" />
                                <SorteerKop Sortering="sortering" Naam="Bedrag" Klasse="text-end" Gewijzigd="StateHasChanged" />
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in sortering.Pas(posten))
                            {
                                <tr class="klikbaar regel-met-acties @(p.Post.Boekstuk == gekozen?.Post.Boekstuk ? "gemarkeerd" : null) @(geselecteerd.Contains(p.Post.Boekstuk) ? "gekozen" : null)" @onclick="() => Kies(p)" title="Geboekt door @p.GeboektDoor op @Weergave.DatumTijd(p.GeboektOp)">
                                    <td class="kiesvak" @onclick:stopPropagation><input class="form-check-input" type="checkbox" aria-label="Kiezen" checked="@geselecteerd.Contains(p.Post.Boekstuk)" @onchange="e => KiesPost(p.Post.Boekstuk, e.Value is true)" /></td>
                                    <td class="text-nowrap">@Weergave.Datum(p.Post.Datum)</td>
                                    <td class="text-nowrap">@p.Post.Boekstuk</td>
                                    <td>@p.Post.Omschrijving@if (teActiveren.Contains($"{p.Post.Dagboek} {p.Post.Boekstuk}"))
                                        {
                                            <button class="btn btn-sm btn-link p-0 ms-2 regelactie" disabled="@bezigActiveren" title="Een vast actief maken van de aanschaf op de activarekening" @onclick="() => Activeer(p.Post)" @onclick:stopPropagation>Activeren</button>
                                        }</td>
                                    <td class="bedrag text-end text-nowrap">
                                        <button class="btn btn-sm btn-link p-0 me-2 regelactie memoriaal-kopieer" title="Een nieuwe boeking met dezelfde regels, een maand later" @onclick="() => Kopieer(p.Post)" @onclick:stopPropagation>Kopiëren</button>@Weergave.Bedrag(p.Post.TotaalDebet)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (geselecteerd.Count > 0)
                {
                    <div class="actiebalk">
                        <span>@geselecteerd.Count @(geselecteerd.Count == 1 ? "boeking" : "boekingen") gekozen</span>
                        <label class="small text-secondary" for="kopieermaand">Kopiëren naar</label>
                        <input id="kopieermaand" type="month" class="form-control form-control-sm w-auto" @bind="kopieerMaand" @bind:format="yyyy-MM" />
                        <button class="btn btn-sm btn-primary" disabled="@bezigKopieren" @onclick="KopieerGekozen">Kopiëren</button>
                        <button class="btn btn-sm btn-link text-secondary ms-auto" @onclick="() => geselecteerd.Clear()">Niets kiezen</button>
                    </div>
                }
            }
            else if (posten is not null)
            {
                <div class="text-secondary small">Nog geen boekingen in @dagboek.Naam.</div>
            }
        }
    </ChildContent>
</AdministratieKader>

@code {
    private Geopend? geopend;
    private Rekeningschema? schema;
    private IReadOnlyList<Boekhouding.Grootboek.Dagboek> memorialen = [];
    private Boekhouding.Grootboek.Dagboek? dagboek;
    private IReadOnlyList<GeboektePost>? posten;
    private GeboektePost? gekozen;
    private Journaalpost? kopie;
    private readonly HashSet<string> geselecteerd = [];
    private DateTime kopieerMaand;
    private bool bezigKopieren;

    private void KiesPost(string boekstuk, bool aan)
    {
        if (aan)
        {
            geselecteerd.Add(boekstuk);
        }
        else
        {
            geselecteerd.Remove(boekstuk);
        }

        StelMaandVoor();
    }

    private void KiesAlle(bool aan)
    {
        geselecteerd.Clear();
        if (aan)
        {
            geselecteerd.UnionWith(posten!.Select(p => p.Post.Boekstuk));
        }

        StelMaandVoor();
    }

    /// <summary>Voorstel: de maand na de laatste gekozen boeking.</summary>
    private void StelMaandVoor()
    {
        if (posten?.Where(p => geselecteerd.Contains(p.Post.Boekstuk)).Select(p => p.Post.Datum).DefaultIfEmpty().Max() is { Year: > 1 } laatste)
        {
            kopieerMaand = new DateTime(laatste.Year, laatste.Month, 1).AddMonths(1);
        }
    }

    /// <summary>De gekozen boekingen kopiëren naar de gekozen maand: elk een nieuwe boeking, zoals één voor één.</summary>
    private async Task KopieerGekozen()
    {
        bezigKopieren = true;
        var gekozenPosten = posten!.Where(p => geselecteerd.Contains(p.Post.Boekstuk)).OrderBy(p => p.Post.Datum).ThenBy(p => p.Post.Boekstuk, StringComparer.Ordinal).ToList();
        var uitkomst = await Bulk.Voer(gekozenPosten,
            async p => (Uitkomst)await Grootboek.KopieerNaarMaand(geopend!.Wie, Id, p.Post.Dagboek, p.Post.Boekstuk, kopieerMaand.Year, kopieerMaand.Month),
            p => p.Post.Boekstuk);
        geselecteerd.Clear();
        bezigKopieren = false;
        await Laad();
        var maandnaam = kopieerMaand.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("nl-NL"));
        bericht = uitkomst.Fouten.Count == 0
            ? $"{uitkomst.Gelukt} {(uitkomst.Gelukt == 1 ? "boeking" : "boekingen")} gekopieerd naar {maandnaam}."
            : $"{uitkomst.Gelukt} gekopieerd naar {maandnaam}; niet gelukt: {string.Join(" ", uitkomst.Fouten)}";
    }

    private readonly Sortering<GeboektePost> sortering = new(
        new("Datum", p => p.Post.Datum, EerstOplopend: false),
        new("Boekstuk", p => p.Post.Boekstuk),
        new("Omschrijving", p => p.Post.Omschrijving.ToUpperInvariant()),
        new("Bedrag", p => p.Post.TotaalDebet, EerstOplopend: false));
    private DateOnly vandaag;
    private int formulier;
    private string? bericht;
    private NieuwDagboek? nieuwDagboek;
    private IReadOnlyList<string>? dagboekfouten;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "dagboek")]
    public string? DagboekCode { get; set; }

    /// <summary>Het boekstuk om te kopiëren (vanaf de boekingpagina).</summary>
    [SupplyParameterFromQuery(Name = "kopie")]
    public string? KopieVan { get; set; }

    private async Task Open(Geopend g)
    {
        geopend = g;
        if (!g.Kop.Mag(Recht.Boekhouden))
        {
            return;
        }

        schema = await Grootboek.Schema(g.Wie, Id);
        vandaag = DateOnly.FromDateTime(Tijd.GetLocalNow().Date);
        await Laad();
        teActiveren = await Activa.TeActiveren(g.Wie, Id);
        if (KopieVan is not null && posten?.FirstOrDefault(p => p.Post.Boekstuk == KopieVan) is { } bron)
        {
            Kopieer(bron.Post);
        }
    }

    /// <summary>Een ander memoriaal (tab): dezelfde pagina, andere query.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (geopend is not null && dagboek is not null && dagboek.Code != DagboekCode && DagboekCode is not null)
        {
            (bericht, gekozen, kopie) = (null, null, null);
            await Laad();
        }
    }

    private async Task Laad()
    {
        memorialen = [.. (await Grootboek.Dagboeken(geopend!.Wie, Id)).Where(d => d.Soort == Dagboeksoort.Memoriaal)];
        dagboek = memorialen.FirstOrDefault(d => d.Code == DagboekCode) ?? memorialen.FirstOrDefault();
        posten = dagboek is null
            ? []
            : [.. (await Grootboek.Posten(geopend.Wie, Id, dagboek.Code)).OrderByDescending(p => p.Post.Datum).ThenByDescending(p => p.Post.Boekstuk, StringComparer.Ordinal)];
        formulier++;
    }

    private void Kies(GeboektePost post)
    {
        (gekozen, kopie, bericht) = (post, null, null);
        formulier++;
    }

    private void Kopieer(Journaalpost post)
    {
        (gekozen, kopie, kopieOpDatum, bericht, kopieBron) = (null, post, false, null, null);
        formulier++;
    }

    private void NieuweBoeking()
    {
        (gekozen, kopie, kopieOpDatum, bericht) = (null, null, false, null);
        formulier++;
    }

    private bool menuOpen;
    private bool kopieOpDatum;
    private string? kopieBron;
    private Loonjournaalvoorstel? loon;
    private List<Loonregel> loonregels = [];
    private DateTime loonMaand;
    private string loonOmschrijving = "";
    private IReadOnlyList<string>? loonfouten;

    /// <summary>Kiezen welke boeking wordt overgenomen: de nieuwste staat voorgeselecteerd.</summary>
    private void KopieKiezen() => (kopieBron, loon) = (posten!.First().Post.Boekstuk, null);

    private void KopieerBron()
    {
        if (posten?.FirstOrDefault(p => p.Post.Boekstuk == kopieBron) is { } bron)
        {
            Kopieer(bron.Post);
        }
    }

    private async Task LeesLoonjournaal(InputFileChangeEventArgs e)
    {
        (loonfouten, kopieBron, bericht, menuOpen) = (null, null, null, false);
        try
        {
            await using var stream = e.File.OpenReadStream(LoonjournaalDienst.MaximumBytes);
            var uitkomst = await Loonjournaal.Lees(geopend!.Wie, Id, stream, e.File.Name);
            loonfouten = uitkomst.IsGelukt ? null : uitkomst.Fouten;
            if (uitkomst.Waarde is { } v)
            {
                loon = v;
                loonregels = [.. v.Koppelingen.Select(k => new Loonregel(k.Regel, k.Rekening, k.Bron))];
                var (jaar, periode) = Periode(v.Journaal.PeriodeTot) ?? (vandaag.Year, vandaag.Month);
                loonMaand = new DateTime(jaar, Math.Clamp(periode, 1, 12), 1);
                loonOmschrijving = v.Journaal.PeriodeVan is { } van && v.Journaal.PeriodeTot is { } tot && van != tot
                    ? $"Loonjournaal {van} t/m {tot}"
                    : $"Loonjournaal {loonMaand.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("nl-NL"))}";
            }
        }
        catch (IOException)
        {
            loonfouten = [$"{e.File.Name} is groter dan {LoonjournaalDienst.MaximumBytes / 1024 / 1024} MB."];
        }
    }

    /// <summary>Een periode als 2025-13 (vier weken) of 2025-3 (maand): het jaar en het periodenummer.</summary>
    private static (int Jaar, int Periode)? Periode(string? tekst) =>
        tekst?.Split('-') is [var j, var p] && int.TryParse(j, out var jaar) && int.TryParse(p, out var periode) ? (jaar, periode) : null;

    private static string Bronnaam(Boekhouding.Loon.Loonkoppelbron bron) => bron switch
    {
        Boekhouding.Loon.Loonkoppelbron.Onthouden => "Zoals de vorige keer",
        Boekhouding.Loon.Loonkoppelbron.ZelfdeNummer => "Hetzelfde rekeningnummer",
        Boekhouding.Loon.Loonkoppelbron.ZelfdeNaam => "Een rekening met dezelfde naam",
        _ => "Kies de rekening",
    };

    /// <summary>De koppelingen onthouden en het loonjournaal als nieuwe boeking in het formulier zetten, op de laatste dag van de periode.</summary>
    private async Task LoonNaarBoeking()
    {
        var keuzes = loonregels.Select(k => (k.Regel, Rekening: k.Rekening!.Trim())).ToList();
        var uitkomst = await Loonjournaal.Onthoud(geopend!.Wie, Id, keuzes);
        loonfouten = uitkomst.IsGelukt ? null : uitkomst.Fouten;
        if (!uitkomst.IsGelukt)
        {
            return;
        }

        var datum = DateOnly.FromDateTime(loonMaand).AddMonths(1).AddDays(-1);
        var post = Boekhouding.Loon.Loonkoppelingen.Boeking(dagboek!.Code, datum, loonOmschrijving.Trim(), keuzes.Select(k => (k.Rekening, k.Regel)));
        (gekozen, kopie, kopieOpDatum, loon) = (null, post, true, null);
        formulier++;
    }

    private sealed class Loonregel(Boekhouding.Loon.Loonjournaalregel regel, string? rekening, Boekhouding.Loon.Loonkoppelbron bron)
    {
        public Boekhouding.Loon.Loonjournaalregel Regel { get; } = regel;

        public string? Rekening { get; set; } = rekening;

        public Boekhouding.Loon.Loonkoppelbron Bron { get; } = bron;
    }

    private async Task Opgeslagen(string melding)
    {
        (gekozen, kopie) = (null, null);
        await Laad();
        bericht = melding;
        teActiveren = await Activa.TeActiveren(geopend!.Wie, Id);
    }

    /// <summary>Boekingen met een aanschaf op een activarekening die nog geen vast actief is.</summary>
    private IReadOnlySet<string> teActiveren = new HashSet<string>();
    private bool bezigActiveren;

    private async Task Activeer(Journaalpost post)
    {
        bezigActiveren = true;
        var uitkomst = await Activa.Activeer(geopend!.Wie, Id, $"{post.Dagboek} {post.Boekstuk}");
        bericht = uitkomst.IsGelukt
            ? $"{post.Boekstuk}: {uitkomst.Waarde!.Count} {(uitkomst.Waarde.Count == 1 ? "vast actief" : "vaste activa")} gemaakt (Boekhouden, Vaste activa)."
            : string.Join(" ", uitkomst.Fouten);
        teActiveren = await Activa.TeActiveren(geopend.Wie, Id);
        bezigActiveren = false;
    }

    private async Task VoegDagboekToe()
    {
        var uitkomst = await Grootboek.VoegMemoriaalToe(geopend!.Wie, Id, nieuwDagboek!.Code, nieuwDagboek.Naam);
        dagboekfouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            var code = nieuwDagboek.Code.Trim().ToUpperInvariant();
            (nieuwDagboek, gekozen) = (null, null);
            Navigatie.NavigateTo($"/a/{Id}/memoriaal?dagboek={Uri.EscapeDataString(code)}");
        }
    }

