@page "/"
@inject AdministratieDienst AdministratieDienst
@inject KantooroverzichtDienst Kantooroverzicht
@inject TimeProvider Tijd

<PageTitle>Administraties - Administratie</PageTitle>

<div class="d-flex align-items-center mb-3 gap-3">
    <h1 class="h3 mb-0 me-auto">Administraties</h1>
    <span class="form-check small text-nowrap mb-0">
        <input class="form-check-input" type="checkbox" id="ook-gearchiveerd" @bind="ookGearchiveerd" @bind:after="Laad" />
        <label class="form-check-label text-secondary" for="ook-gearchiveerd">Ook gearchiveerd</label>
    </span>
    <input class="form-control w-auto" type="search" placeholder="Zoek op naam" aria-label="Zoeken"
           @bind="zoek" @bind:event="oninput" @bind:after="Laad" />
    <AuthorizeView Roles="@Rollen.Kantoor">
        <a class="btn btn-primary" href="/administraties/nieuw">Nieuwe administratie</a>
    </AuthorizeView>
</div>

@if (melding is not null)
{
    <div class="melding-kort" role="status" @key="meldingnummer">@melding</div>
}
<Foutmeldingen Fouten="fouten" />

@if (standen is not null && lijst is { Count: > 0 })
{
    <div class="werklijst mb-3" aria-label="Te doen">
        @foreach (var soort in Enum.GetValues<Werksoort>())
        {
            var met = standen.Values.Where(w => Aantal(w, soort) > 0).ToList();
            if (met.Count == 0)
            {
                continue;
            }

            <button type="button" class="werkitem @(filter == soort ? "actief" : null)" aria-pressed="@(filter == soort)" @onclick="() => filter = filter == soort ? null : soort">
                <span class="werkitem-aantal">@met.Sum(w => Aantal(w, soort)).ToString("N0", Nl)</span>
                <span class="werkitem-naam">@Werknaam(soort, met.Sum(w => Aantal(w, soort)))</span>
                <span class="werkitem-detail">@(soort == Werksoort.Debiteuren ? Weergave.BedragHeel(Math.Abs(met.Sum(w => w.VervallenBedrag))) + ", " : null)@met.Count @(met.Count == 1 ? "administratie" : "administraties")</span>
            </button>
        }
        @if (standen.Values.All(w => w.Leeg))
        {
            <span class="status">Alles verwerkt</span>
        }
    </div>
}

@if (lijst is null)
{
    <Laadschets />
}
else if (lijst.Count == 0)
{
    <div class="leeg-blok">
        @if (string.IsNullOrWhiteSpace(zoek))
        {
            <span>Je hebt nog geen toegang tot een administratie.</span>
        }
        else
        {
            <span>Geen administraties gevonden voor ‘@zoek’.</span>
        }
    </div>
}
else
{
    <div class="card">
        <table class="table table-sm table-hover align-middle mb-0 administratielijst" data-sleepbaar="kantooroverzicht">
            <thead>
                <tr>
                    <th>Naam</th><th>Rechtsvorm</th><th>Jouw rol</th>
                    <th class="text-end werk">Inkoop</th><th class="text-end werk">Bank</th><th class="werk">Bank t/m</th><th class="text-end werk">Verkoop</th>
                    <th class="text-end werk">Vervallen debiteuren</th><th class="werk">Afgesloten t/m</th><th class="rekt"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Zichtbaar)
                {
                    var ws = standen?.GetValueOrDefault(a.Id);
                    <tr class="@(a.Gearchiveerd is null ? null : "gearchiveerd")">
                        <td><a href="/a/@a.Id" title="@Kenmerken(a)">@a.Naam</a></td>
                        <td>@Weergave.Tekst(a.Ondernemingsvorm)</td>
                        <td><span class="status">@Weergave.Tekst(a.Rol)</span></td>
                        <td class="text-end">@if (ws is { Inkoop: > 0 })
                            {
                                <a href="/a/@a.Id/inkoop">@ws.Inkoop</a>
                            }</td>
                        <td class="text-end">@if (ws is { Bank: > 0 })
                            {
                                <a href="/a/@a.Id/bank" title="oudste mutatie @(ws.OudsteBank is { } o ? Weergave.Datum(o) : null)">@ws.Bank</a>
                            }</td>
                        <td class="text-nowrap">@if (ws?.AfschriftTot is { } bankTot)
                            {
                                <span class="@(bankTot < vandaag.AddDays(-45) ? "let-op" : null)" title="@(bankTot < vandaag.AddDays(-45) ? "Langer dan 45 dagen geen afschrift" : null)">@Weergave.Datum(bankTot)</span>
                            }</td>
                        <td class="text-end">@if (ws is { Concepten: > 0 })
                            {
                                <a href="/a/@a.Id/verkoop" title="@ws.Concepten @(ws.Concepten == 1 ? "concept" : "concepten")">@ws.Concepten</a>
                            }</td>
                        <td class="text-end text-nowrap">@if (ws is { Vervallen: > 0 })
                            {
                                <a href="/a/@a.Id/debiteuren" title="@ws.Vervallen @(ws.Vervallen == 1 ? "factuur" : "facturen") over de vervaldatum">@Weergave.BedragHeel(Math.Abs(ws.VervallenBedrag))</a>
                            }</td>
                        <td class="text-nowrap">@if (ws?.AfgeslotenTot is { } af)
                            {
                                <a class="text-reset" href="/a/@a.Id/perioden">@af.ToString("MMM yyyy", Nl)</a>
                            }</td>
                        <td class="text-end text-nowrap">
                            @if (a.Gearchiveerd is { } op)
                            {
                                <span class="status me-2" title="Gearchiveerd @Weergave.DatumTijd(op): alleen inzien">gearchiveerd</span>
                            }
                            <span class="regelacties">
                                @if (a.Rol == Lidmaatschapsrol.Kantoor)
                                {
                                    @if (a.Gearchiveerd is null)
                                    {
                                        <button class="btn btn-sm btn-link text-secondary p-0" disabled="@bezig" title="Einde van de klantrelatie: daarna alleen inzien" @onclick="() => Archiveer(a)">Archiveren</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-link text-secondary p-0" disabled="@bezig" @onclick="() => Herstel(a)">Uit archief halen</button>
                                    }
                                }
                                @if (beheerder)
                                {
                                    <button class="btn btn-sm btn-link text-secondary p-0 ms-3" disabled="@bezig" @onclick="() => KiesVerwijderen(a)">Verwijderen</button>
                                }
                            </span>
                        </td>
                    </tr>
                    @if (verwijderen is { } v && v.Id == a.Id && voorwaarden is { } w)
                    {
                        <tr class="verwijderregel">
                            <td colspan="10">
                                <div class="d-flex align-items-center flex-wrap gap-3 py-1">
                                    <span class="small">@w.Boekingen @(w.Boekingen == 1 ? "boeking" : "boekingen")@(w.Bewaarplicht is { } tot ? $", bewaarplicht tot {Weergave.Datum(tot)}" : null). Alles gaat weg; het wijzigingslog blijft.</span>
                                    <input class="form-control form-control-sm w-auto" placeholder="Typ de naam ter bevestiging" aria-label="Naam ter bevestiging" @bind="bevestigNaam" @bind:event="oninput" />
                                    @if (w.Bewaarplicht is { } eind && eind >= DateOnly.FromDateTime(DateTime.Today))
                                    {
                                        <span class="form-check small mb-0">
                                            <input class="form-check-input" type="checkbox" id="bewaarplicht" @bind="bewaarplichtGezien" />
                                            <label class="form-check-label" for="bewaarplicht">Ik weet dat de bewaarplicht nog loopt</label>
                                        </span>
                                    }
                                    <button class="btn btn-sm btn-danger" disabled="@(bezig || bevestigNaam?.Trim() != w.Naam)" @onclick="Verwijder">Definitief verwijderen</button>
                                    <button class="btn btn-sm btn-link text-secondary p-0" @onclick="() => verwijderen = null">Annuleren</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<AdministratieKop>? lijst;
    private string? zoek;
    private bool ookGearchiveerd;
    private bool beheerder;
    private bool bezig;
    private string? melding;
    private int meldingnummer;
    private IReadOnlyList<string>? fouten;
    private AdministratieKop? verwijderen;
    private Verwijdervoorwaarden? voorwaarden;
    private string? bevestigNaam;
    private bool bewaarplichtGezien;
    private Uitvoerder wie = Uitvoerder.Systeem;
    private IReadOnlyDictionary<Guid, Werkstand>? standen;
    private Werksoort? filter;
    private DateOnly vandaag;
    private static readonly System.Globalization.CultureInfo Nl = System.Globalization.CultureInfo.GetCultureInfo("nl-NL");

    [CascadingParameter]
    private Task<AuthenticationState> Authenticatie { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var gebruiker = (await Authenticatie).User;
        wie = gebruiker.AlsUitvoerder();
        beheerder = gebruiker.IsInRole(Rollen.Beheerder);
        vandaag = DateOnly.FromDateTime(Tijd.GetLocalNow().DateTime);
        await Laad();
    }

    private async Task Laad()
    {
        lijst = await AdministratieDienst.Lijst(wie, zoek, ookGearchiveerd);
        standen = await Kantooroverzicht.Stand(wie);
    }

    /// <summary>De administraties in de tabel: met een gekozen soort werk alleen die met dat werk, de meeste bovenaan.</summary>
    private IEnumerable<AdministratieKop> Zichtbaar => filter is { } soort && standen is not null
        ? lijst!.Where(a => standen.TryGetValue(a.Id, out var w) && Aantal(w, soort) > 0).OrderByDescending(a => Aantal(standen[a.Id], soort))
        : lijst!;

    private static int Aantal(Werkstand w, Werksoort soort) => soort switch
    {
        Werksoort.Inkoop => w.Inkoop,
        Werksoort.Bank => w.Bank,
        Werksoort.Verkoop => w.Concepten,
        _ => w.Vervallen,
    };

    private static string Werknaam(Werksoort soort, int aantal) => soort switch
    {
        Werksoort.Inkoop => aantal == 1 ? "inkoopfactuur te verwerken" : "inkoopfacturen te verwerken",
        Werksoort.Bank => aantal == 1 ? "bankmutatie te verwerken" : "bankmutaties te verwerken",
        Werksoort.Verkoop => aantal == 1 ? "verkoopconcept" : "verkoopconcepten",
        _ => aantal == 1 ? "debiteur vervallen" : "debiteuren vervallen",
    };

    private static string? Kenmerken(AdministratieKop a) =>
        string.Join(" · ", new[] { a.KvkNummer is { } k ? $"KvK {k}" : null, a.BtwNummer is { } b ? $"btw {b}" : null }.Where(t => t is not null)) is { Length: > 0 } t ? t : null;

    private void Meld(string tekst)
    {
        meldingnummer++;
        melding = tekst;
    }

    private async Task Archiveer(AdministratieKop a)
    {
        bezig = true;
        var uitkomst = await AdministratieDienst.Archiveer(wie, a.Id);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            Meld($"{a.Naam} is gearchiveerd.");
        }

        bezig = false;
        await Laad();
    }

    private async Task Herstel(AdministratieKop a)
    {
        bezig = true;
        var uitkomst = await AdministratieDienst.Herstel(wie, a.Id);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            Meld($"{a.Naam} is weer in gebruik.");
        }

        bezig = false;
        await Laad();
    }

    private async Task KiesVerwijderen(AdministratieKop a)
    {
        (verwijderen, bevestigNaam, bewaarplichtGezien, fouten) = (a, null, false, null);
        voorwaarden = await AdministratieDienst.Voorwaarden(wie, a.Id);
    }

    private async Task Verwijder()
    {
        if (verwijderen is not { } a)
        {
            return;
        }

        bezig = true;
        var uitkomst = await AdministratieDienst.Verwijder(wie, a.Id, bevestigNaam ?? "", bewaarplichtGezien);
        fouten = uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            Meld($"{a.Naam} is verwijderd.");
            verwijderen = null;
        }

        bezig = false;
        await Laad();
    }
}
