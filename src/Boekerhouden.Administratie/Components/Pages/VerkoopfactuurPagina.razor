    /// <summary>De factuur zoals hij nu is ingevuld, in de lay-out (zonder logo: dat staat er als losse afbeelding over).</summary>
    private string Voorbeeldpagina(Layoutgegevens layout, IReadOnlyList<BtwCode> codes)
    {
        var klant = Gekozen?.Gegevens ?? (weergave is { Ingelezen: true } w ? w.Factuur.Klant : new Partij("", new()));
        var factuur = new Verkoopfactuur(invoer.Relatie, klant, weergave?.Ingelezen == true ? invoer.Factuurnummer : null, invoer.Datum, invoer.Vervaldatum,
            invoer.Omschrijving ?? "", [.. invoer.Regels.Select(r => r.Domein()).OfType<Verkoopregel>()]);
        try
        {
            voorbeeldHtml = Export.FactuurHtml.Pagina(new Export.Verkoopbeeld(factuur, verkoop!.Afzender, codes, invoer.Referentie, invoer.Tekst, Concept: true), layout.Ontwerp, null, ontwerper: false);
        }
        catch (ArgumentException)
        {
            // Halverwege het typen kan een regel nog niet kloppen: dan blijft het vorige voorbeeld staan.
        }

        return voorbeeldHtml;
    }

