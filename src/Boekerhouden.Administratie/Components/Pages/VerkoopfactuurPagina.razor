    /// <summary>Het formulier zoals de gebruiker het invult (tekst, nog niet gecontroleerd).</summary>
    private sealed class Formulier
    {
        public string Relatie { get; set; } = "";

        public DateOnly Datum { get; set; }

        public DateOnly Vervaldatum { get; set; }

        public string? Omschrijving { get; set; }

        public string? Referentie { get; set; }

        public string? Tekst { get; set; }

        public List<Verkoopregelinvoer> Regels { get; } = [];

        public bool Verdelen { get; set; }

        public DateOnly VerdeelVan { get; set; }

        public DateOnly VerdeelTot { get; set; }

        public string? Verdeelrekening { get; set; }

        public Guid? LayoutId { get; set; }

        public string? Factuurnummer { get; set; }

        public static Formulier Van(Verkoopinvoer v)
        {
            var f = new Formulier
            {
                Relatie = v.Relatie,
                Datum = v.Datum,
                Vervaldatum = v.Vervaldatum,
                Omschrijving = v.Omschrijving,
                Referentie = v.Referentie,
                Tekst = v.Tekst,
                Verdelen = v.Verdeling is not null,
                VerdeelVan = v.Verdeling?.Van ?? v.Datum,
                VerdeelTot = v.Verdeling?.Tot ?? v.Datum,
                Verdeelrekening = v.Verdeling?.Rekening,
                LayoutId = v.LayoutId,
                Factuurnummer = v.Factuurnummer,
            };
            f.Regels.AddRange(v.Regels.Select(Verkoopregelinvoer.Van));
            if (f.Regels.Count == 0)
            {
                f.Regels.Add(new Verkoopregelinvoer { Aantal = "1", BtwCode = "V21" });
            }

            return f;
        }
    }

