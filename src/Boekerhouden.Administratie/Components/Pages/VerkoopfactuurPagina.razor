    private string BtwKort(string code, DateOnly datum) => BtwCodes.Zoek(verkoop!.Btwtabel.Op(datum), code)?.Kort ?? code;

    private static string Aantal(decimal aantal) => aantal.ToString("0.####", Nl);

    private static string Prijs(decimal prijs) => decimal.Round(prijs, 2) == prijs ? Weergave.Bedrag(prijs) : prijs.ToString("#,0.00##", Nl).Replace('-', '−');

    /// <summary>Het formulier zoals de gebruiker het invult (tekst, nog niet gecontroleerd).</summary>
    private sealed class Formulier
    {
        public string Relatie { get; set; } = "";

        public DateOnly Datum { get; set; }

        public DateOnly Vervaldatum { get; set; }

        public string? Omschrijving { get; set; }

        public string? Referentie { get; set; }

        public string? Tekst { get; set; }

        public List<Regelformulier> Regels { get; } = [];

        public bool Verdelen { get; set; }

        public DateOnly VerdeelVan { get; set; }

        public DateOnly VerdeelTot { get; set; }

        public string? Verdeelrekening { get; set; }

        public Guid? LayoutId { get; set; }

        public static Formulier Van(Verkoopinvoer v)
        {
            var f = new Formulier
            {
                Relatie = v.Relatie,
                Datum = v.Datum,
                Vervaldatum = v.Vervaldatum,
                Omschrijving = v.Omschrijving,
                Referentie = v.Referentie,
                Tekst = v.Tekst,
                Verdelen = v.Verdeling is not null,
                VerdeelVan = v.Verdeling?.Van ?? v.Datum,
                VerdeelTot = v.Verdeling?.Tot ?? v.Datum,
                Verdeelrekening = v.Verdeling?.Rekening,
                LayoutId = v.LayoutId,
            };
            f.Regels.AddRange(v.Regels.Select(r => new Regelformulier
            {
                Omschrijving = r.Omschrijving,
                Aantal = Aantal(r.Aantal),
                Eenheid = r.Eenheid,
                Prijs = r.Prijs.ToString("0.00##", Nl),
                Korting = r.Korting == 0 ? null : r.Korting.ToString("0.##", Nl),
                Rekening = r.Rekeningnummer,
                BtwCode = r.BtwCode,
            }));
            if (f.Regels.Count == 0)
            {
                f.Regels.Add(new Regelformulier { Aantal = "1", BtwCode = "V21" });
            }

            return f;
        }
    }

    private sealed class Regelformulier
    {
        public string? Omschrijving { get; set; }

        public string? Aantal { get; set; }

        public string? Eenheid { get; set; }

        public string? Prijs { get; set; }

        public string? Korting { get; set; }

        public string? Rekening { get; set; }

        public string BtwCode { get; set; } = "V21";

        /// <summary>De regel als die te lezen is (aantal en prijs als getal), anders leeg.</summary>
        public Verkoopregel? Domein()
        {
            if (!Domain.BedragParser.TryParse(Aantal ?? "", out var aantal) || !Domain.BedragParser.TryParse(Prijs ?? "", out var prijs))
            {
                return null;
            }

            var korting = string.IsNullOrWhiteSpace(Korting) ? 0m : Domain.BedragParser.TryParse(Korting.TrimEnd('%', ' '), out var k) ? k : -1m;
            return new Verkoopregel(Omschrijving ?? "", aantal, prijs, Rekening ?? "", BtwCode, Eenheid, korting);
        }
    }

