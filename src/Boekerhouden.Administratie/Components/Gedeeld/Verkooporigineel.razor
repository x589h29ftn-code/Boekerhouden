@* Het origineel van een ingelezen verkoopfactuur naast het formulier: een PDF in de factuurviewer (een foto wordt met
   tekstherkenning een PDF van één pagina). Met Aangewezen kan de gebruiker een gebied aanwijzen, zoals bij inkoop:
   de tekst daaruit gaat naar het veld met de focus. Een e-factuur (XML) heeft geen beeld. *@
@using Boekerhouden.Documenten
@implements IAsyncDisposable
@inject VerkoopimportDienst Import
@inject IJSRuntime JS

@if (Paneel)
{
    <div @ref="scheiding" class="verwerken-scheiding" title="Sleep om de factuur breder of smaller te maken; dubbelklik voor de standaardbreedte"></div>
    <div @ref="paneel" class="verwerken-viewer">
        @Beeld
    </div>
}
else
{
    @Beeld
}

@code {
    private RenderFragment Beeld => @<text>
        @if (afbeelding is not null)
        {
            <div class="factuurviewer verkoop-scan"><img src="@afbeelding" alt="@naam" /></div>
        }
        else if (geenBeeld)
        {
            <div class="factuurviewer"><div class="p-4 text-secondary">Dit document is niet als PDF te tonen.</div></div>
        }
        else
        {
            <div @ref="viewer" class="factuurviewer"></div>
        }
    </text>;

    private ElementReference scheiding;
    private ElementReference paneel;
    private bool gekoppeld;

    /// <summary>Als paneel rechts van het formulier, met de versleepbare scheiding van het verwerkscherm van inkoop.</summary>
    [Parameter]
    public bool Paneel { get; set; }

    private ElementReference viewer;
    private IJSObjectReference? module;
    private IJSObjectReference? koppeling;
    private Guid getoond;
    private string? afbeelding;
    private string? naam;
    private bool geenBeeld;
    private IReadOnlyList<Tekstwoord> woorden = [];
    private DotNetObjectReference<Verkooporigineel>? zelf;

    /// <summary>De tekst in een aangewezen gebied, met het veld dat de focus had (data-doel en data-doelnaam).</summary>
    public sealed record Aanwijzing(string? Veld, string? Naam, string Tekst);

    /// <summary>Gezet = een gebied aanwijzen kan (een concept); anders alleen bekijken.</summary>
    [Parameter]
    public EventCallback<Aanwijzing> Aangewezen { get; set; }

    [Parameter, EditorRequired]
    public Uitvoerder Wie { get; set; } = default!;

    [Parameter]
    public Guid Administratie { get; set; }

    [Parameter]
    public Guid Factuur { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (getoond == Factuur)
        {
            return;
        }

        getoond = Factuur;
        await Sluit();
        if (Paneel && !gekoppeld)
        {
            gekoppeld = true;
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./factuurviewer.js");
            await module.InvokeVoidAsync("scheiding", scheiding, paneel);
        }

        (afbeelding, geenBeeld) = (null, false);
        woorden = [];
        if (await Import.Beeld(Wie, Administratie, Factuur) is not { } beeld)
        {
            geenBeeld = true;
        }
        else if (beeld.Pdf is { } pdf)
        {
            woorden = beeld.Woorden;
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./factuurviewer.js");
            var bron = new DotNetStreamReference(new MemoryStream(pdf));
            koppeling = Aangewezen.HasDelegate && woorden.Count > 0
                ? await module.InvokeAsync<IJSObjectReference>("wijsAan", viewer, bron, Factuur.ToString(), zelf ??= DotNetObjectReference.Create(this))
                : await module.InvokeAsync<IJSObjectReference>("bekijk", viewer, bron, Factuur.ToString());
            return;
        }
        else if (beeld.Afbeelding is { } foto)
        {
            (afbeelding, naam) = ($"data:{foto.Inhoudstype};base64,{Convert.ToBase64String(foto.Inhoud)}", beeld.Bestandsnaam);
        }
        else
        {
            geenBeeld = true;
        }

        StateHasChanged();
    }

    /// <summary>De gebruiker wees een gebied aan (factuurviewer.js): de tekst daaruit gaat naar het formulier.</summary>
    [JSInvokable]
    public Task Gebied(string? veld, string? naam, int pagina, double x0, double y0, double x1, double y1) =>
        Aangewezen.InvokeAsync(new(veld, naam, string.Join(" ", PdfTekst.InGebied(woorden, pagina, x0, y0, x1, y1)).Trim()));

    private async Task Sluit()
    {
        try
        {
            if (koppeling is not null)
            {
                await koppeling.InvokeVoidAsync("sluit");
                await koppeling.DisposeAsync();
                koppeling = null;
            }
        }
        catch (JSDisconnectedException)
        {
            // Het circuit is al weg.
        }
    }

    public async ValueTask DisposeAsync()
    {
        await Sluit();
        zelf?.Dispose();
        try
        {
            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Het circuit is al weg.
        }
    }
}
