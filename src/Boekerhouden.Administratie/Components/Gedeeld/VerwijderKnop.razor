@* Verwijderen in twee stappen: eerst de knop, dan "Ja, verwijderen" om het zeker te weten. *@

@if (bevestigen)
{
    <span class="d-inline-flex align-items-center gap-2 @Klasse">
        <span class="small">Zeker weten?</span>
        <button class="btn btn-sm btn-danger" disabled="@Bezig" @onclick="Bevestig">Ja, verwijderen</button>
        <button class="btn btn-sm btn-link text-secondary px-1" @onclick="() => bevestigen = false">annuleren</button>
    </span>
}
else
{
    <button class="btn btn-sm btn-link text-secondary verwijderknop @Klasse" disabled="@Bezig"
            title="@(Geboekt ? "De boeking wordt teruggedraaid (tegenboeking) en de factuur verdwijnt" : "De factuur verdwijnt uit de administratie")"
            @onclick="() => bevestigen = true">Verwijderen</button>
}

@code {
    private bool bevestigen;

    [Parameter]
    public bool Geboekt { get; set; }

    /// <summary>Extra klassen, bijv. <c>ms-auto</c> om rechts te staan.</summary>
    [Parameter]
    public string? Klasse { get; set; } = "ms-auto";

    [Parameter]
    public bool Bezig { get; set; }

    [Parameter, EditorRequired]
    public EventCallback Bevestigd { get; set; }

    private async Task Bevestig()
    {
        bevestigen = false;
        await Bevestigd.InvokeAsync();
    }
}
