@* Kop, zijmenu en toegangscontrole van een pagina binnen een administratie. Pas na de controle laadt de pagina haar
   gegevens (BijOpenen); zonder lidmaatschap dezelfde melding als bij een administratie die niet bestaat. Het zijmenu
   is gegroepeerd en in te klappen (het hele menu en per groep); die stand onthoudt de browser. *@
@implements IAsyncDisposable
@inject AdministratieDienst AdministratieDienst
@inject Menustaat Staat
@inject IJSRuntime JS

@if (!geladen)
{
    <p class="text-secondary">Laden…</p>
}
else if (kop is null)
{
    <div class="alert alert-warning">Deze administratie bestaat niet of je hebt er geen toegang toe. <a href="/">Naar de administraties</a></div>
}
else
{
    <PageTitle>@Titel – @kop.Naam</PageTitle>
    <div class="administratie @(Staat.Ingeklapt ? "menu-ingeklapt" : null)">
        <nav class="zijmenu" aria-label="Administratie">
            <div class="zijmenu-kop">
                <a class="zijmenu-naam" href="/a/@kop.Id" title="@kop.Naam" tabindex="@(Staat.Ingeklapt ? -1 : 0)">@kop.Naam</a>
                <button type="button" class="zijmenu-knop" title="@(Staat.Ingeklapt ? "Menu uitklappen" : "Menu inklappen")" aria-expanded="@(!Staat.Ingeklapt)" @onclick="WisselMenu">«</button>
            </div>
            <div class="zijmenu-groepen" inert="@Staat.Ingeklapt">
                @foreach (var (groep, items) in Menu)
                {
                    var zichtbaar = items.Where(i => kop.Mag(i.Recht)).ToList();
                    if (zichtbaar.Count == 0)
                    {
                        continue;
                    }

                    var open = !Staat.Dicht.Contains(groep) || zichtbaar.Any(i => i.Pad == Actief);
                    <div class="zijmenu-groep @(open ? "open" : null)">
                        <button type="button" class="zijmenu-groepkop" aria-expanded="@open" @onclick="() => WisselGroep(groep)">
                            @groep <span class="pijl" aria-hidden="true">▾</span>
                        </button>
                        <div class="zijmenu-items" inert="@(!open)">
                            <div>
                                @foreach (var (pad, naam, _) in zichtbaar)
                                {
                                    <a class="zijmenu-link @(pad == Actief ? "actief" : null)" href="@($"/a/{kop.Id}{pad}")" aria-current="@(pad == Actief ? "page" : null)">@naam</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </nav>
        <div class="administratie-inhoud">
            <nav aria-label="kruimelpad">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Administraties</a></li>
                    <li class="breadcrumb-item"><a href="/a/@kop.Id">@kop.Naam</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Titel</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center flex-wrap gap-3 mb-3">
                <h1 class="h3 mb-0 me-auto">@Titel</h1>
                @Acties
            </div>
            @ChildContent(kop)
        </div>
    </div>
}

@code {
    /// <summary>Het menu per groep: boekhouden, rapportages en inrichting.</summary>
    private static readonly (string Groep, (string Pad, string Naam, Recht Recht)[] Items)[] Menu =
    [
        ("Boekhouden",
        [
            ("/inkoop", "Inkoop", Recht.Lezen),
            ("/bank", "Bank", Recht.Lezen),
            ("/memoriaal", "Memoriaal", Recht.Boekhouden),
            ("/journaal", "Journaal", Recht.Lezen),
        ]),
        ("Rapportages",
        [
            ("", "Balans en W&V", Recht.Lezen),
            ("/kolommenbalans", "Kolommenbalans", Recht.Lezen),
            ("/proefbalans", "Proefbalans", Recht.Lezen),
            ("/grootboek", "Grootboekkaart", Recht.Lezen),
        ]),
        ("Inrichting",
        [
            ("/relaties", "Relaties", Recht.Lezen),
            ("/regels", "Regels", Recht.Lezen),
            ("/rekeningschema", "Rekeningschema", Recht.Lezen),
            ("/instellingen", "Instellingen", Recht.Boekhouden),
        ]),
    ];

    private IJSObjectReference? module;

    private bool geladen;
    private AdministratieKop? kop;

    [CascadingParameter]
    private Task<AuthenticationState> Authenticatie { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid Id { get; set; }

    [Parameter, EditorRequired]
    public string Titel { get; set; } = "";

    /// <summary>Het pad van de pagina in het menu, bijv. "/grootboek"; leeg voor balans en W&amp;V.</summary>
    [Parameter]
    public string Actief { get; set; } = "";

    [Parameter]
    public RenderFragment? Acties { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<AdministratieKop> ChildContent { get; set; } = default!;

    /// <summary>Na de toegangscontrole: de administratie en de ingelogde gebruiker, om de gegevens te laden.</summary>
    [Parameter]
    public EventCallback<Geopend> BijOpenen { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (geladen && kop?.Id == Id)
        {
            return;
        }

        var wie = (await Authenticatie).User.AlsUitvoerder();
        kop = await AdministratieDienst.Open(wie, Id);
        if (kop is not null)
        {
            await BijOpenen.InvokeAsync(new Geopend(kop, wie));
        }

        geladen = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // De stand van het menu staat in de browser; één keer per sessie inlezen.
        if (!firstRender || Staat.Gelezen)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./menu.js");
        if (Staat.Lees(await module.InvokeAsync<string?>("lees")))
        {
            StateHasChanged();
        }
    }

    private async Task WisselMenu()
    {
        Staat.Ingeklapt = !Staat.Ingeklapt;
        await Bewaar();
    }

    private async Task WisselGroep(string groep)
    {
        if (!Staat.Dicht.Remove(groep))
        {
            Staat.Dicht.Add(groep);
        }

        await Bewaar();
    }

    private async Task Bewaar()
    {
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./menu.js");
        await module.InvokeVoidAsync("bewaar", Staat.Tekst());
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Het circuit is al weg.
        }
    }
}
