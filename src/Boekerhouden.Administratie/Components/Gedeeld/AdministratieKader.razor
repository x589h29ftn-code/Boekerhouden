@* Kop, menu en toegangscontrole van een pagina binnen een administratie. Pas na de controle laadt de pagina haar
   gegevens (BijOpenen); zonder lidmaatschap dezelfde melding als bij een administratie die niet bestaat. Het menu staat
   links in een zijbalk: bovenaan de administratie (met een wisselaar naar een andere, op dezelfde pagina), dan de
   groepen met hun pagina's. De zijbalk kan smal (toetsen.js onthoudt dat per browser). *@
@inject AdministratieDienst AdministratieDienst
@inject NavigationManager Navigatie
@inject TimeProvider Tijd
@inject KantooroverzichtDienst Kantooroverzicht
@inject Zijbalkstand Zijbalk

@if (!geladen)
{
    <Laadschets />
}
else if (kop is null)
{
    <div class="alert alert-warning">Deze administratie bestaat niet of je hebt er geen toegang toe. <a href="/">Naar de administraties</a></div>
}
else
{
    <PageTitle>@Kopnaam - @kop.Naam</PageTitle>
    <div class="administratie">
        <aside class="zijbalk" aria-label="Administratie">
            <button type="button" class="zijbalk-wissel" data-zijbalk title="Menu smaller of breder" aria-label="Menu smaller of breder"><Icoon Naam="chevron-left" /></button>
            <div class="wisselaar @(wisselen ? "open" : null)">
                <button type="button" class="wisselaar-knop" title="@kop.Naam" aria-haspopup="listbox" aria-expanded="@wisselen" @onclick="OpenWisselaar">
                    <span class="wisselaar-naam">@kop.Naam</span>
                    <span class="wisselaar-vorm">@Weergave.Tekst(kop.Ondernemingsvorm)</span>
                    <span class="pijl"><Icoon Naam="chevron-down" /></span>
                </button>
                @if (wisselen)
                {
                    <div class="wisselaar-achter" @onclick="() => wisselen = false"></div>
                    <div class="wisselaar-paneel">
                        <input class="form-control form-control-sm" placeholder="Administratie zoeken" aria-label="Administratie zoeken" @ref="wisselveld"
                               @bind="wisselzoek" @bind:event="oninput" @onkeydown="WisselToets" />
                        <div class="wisselaar-lijst" role="listbox">
                            @foreach (var a in Gevonden)
                            {
                                <a class="wisselaar-item @(a.Id == kop.Id ? "actief" : null)" role="option" href="@($"/a/{a.Id}{Actief}")" @onclick="() => wisselen = false">
                                    <span>@a.Naam</span><span class="wisselaar-vorm">@Weergave.Tekst(a.Ondernemingsvorm)</span>
                                </a>
                            }
                            @if (Gevonden.Count == 0)
                            {
                                <div class="leeg-regel">Geen administratie gevonden.</div>
                            }
                        </div>
                        <a class="wisselaar-alle" href="/">Alle administraties</a>
                    </div>
                }
            </div>
            <nav class="zijmenu">
                <a class="zijmenu-link @(Actief.Length == 0 ? "actief" : null)" href="/a/@kop.Id" title="Overzicht" aria-current="@(Actief.Length == 0 ? "page" : null)"><Icoon Naam="house" /><span class="zijmenu-naam">Overzicht</span></a>
                @foreach (var groep in Administratiemenu.Groepen)
                {
                    var zichtbaar = groep.Items.Where(i => i.Zichtbaar(kop)).ToList();
                    if (zichtbaar.Count == 0)
                    {
                        continue;
                    }

                    var open = !groep.Inklapbaar || Zijbalk.IsOpen(groep.Naam) || zichtbaar.Any(i => i.Pad == MenuPad);
                    @if (groep.Inklapbaar)
                    {
                        <button type="button" class="zijmenu-groep inklapbaar @(open ? "open" : null)" aria-expanded="@(open ? "true" : "false")" @onclick="() => Zijbalk.Wissel(groep.Naam)">@groep.Naam<Icoon Naam="caret-right" /></button>
                    }
                    else
                    {
                        <div class="zijmenu-groep">@groep.Naam</div>
                    }
                    <div class="zijmenu-items @(open ? null : "dicht")"><div class="zijmenu-binnen">
                        @foreach (var item in zichtbaar)
                        {
                            var aantal = aantallen?.Bij(item.Pad) ?? 0;
                            <a class="zijmenu-link @(item.Pad == MenuPad ? "actief" : null)" href="@($"/a/{kop.Id}{item.Pad}")" title="@(aantal > 0 ? $"{item.Naam}: {aantal} te verwerken" : item.Naam)" aria-current="@(item.Pad == MenuPad ? "page" : null)" tabindex="@(open ? null : "-1")">@if (item.Icoon is { } icoon)
                                {
                                    <Icoon Naam="@icoon" />
                                }<span class="zijmenu-naam">@item.Naam</span>@if (aantal > 0)
                                {
                                    <span class="zijmenu-aantal">@aantal</span>
                                }</a>
                        }
                    </div></div>
                }
            </nav>
        </aside>
        <div class="administratie-inhoud @(KopVast ? "kop-vast" : null)">
            @* Alleen op papier (afdrukken.css): welke administratie, en wanneer en door wie afgedrukt. *@
            <div class="afdrukkop">
                <span><strong>@kop.Naam</strong>@(kop.KvkNummer is { } kvkNummer ? $" · KvK {kvkNummer}" : null)</span>
                <span>Afgedrukt <span class="afdrukmoment">@Tijd.GetLocalNow().ToString("d-M-yyyy HH:mm", System.Globalization.CultureInfo.GetCultureInfo("nl-NL"))</span>@(wie is null ? null : $" door {wie.Naam}")</span>
            </div>
            <div class="d-flex align-items-center flex-wrap gap-3 mb-3">
                @if (TerugAdres is { } terug)
                {
                    <a class="terug" href="@terug" title="Terug" aria-label="Terug"><Icoon Naam="arrow-left" /></a>
                }
                <div class="me-auto paginakop">
                    @if (TerugAdres is { } kruimelterug && Kruimels(kruimelterug) is { Count: > 0 } kruimels)
                    {
                        <nav class="kruimel" aria-label="Kruimelpad">
                            @foreach (var (naam, adres) in kruimels)
                            {
                                <a href="@adres">@naam</a>
                                <Icoon Naam="caret-right" />
                            }
                            <span>@Titel</span>
                        </nav>
                    }
                    <h1 class="h3 mb-0">@Kopnaam@if (kop.Gearchiveerd is not null)
                        {
                            <span class="status ms-2 fs-6" title="Uit het archief halen kan bij Administraties">gearchiveerd, alleen inzien</span>
                        }</h1>
                    @if (Kenmerken is not null)
                    {
                        <div class="kopkenmerken">@Kenmerken</div>
                    }
                </div>
                @Acties
            </div>
            @if (Tabs is { } tabgroep)
            {
                <nav class="nav nav-underline paginatabs" aria-label="@tabgroep.Naam">
                    @foreach (var tab in tabgroep.Tabs.Where(t => t.Zichtbaar(kop)))
                    {
                        <a class="nav-link @(tab.Pad == Actief ? "active" : null)" href="@($"/a/{kop.Id}{tab.Pad}")" aria-current="@(tab.Pad == Actief ? "page" : null)">@tab.Naam</a>
                    }
                </nav>
            }
            @ChildContent(kop)
            @if (OveralSlepen && kop.Mag(Recht.Invoeren) && wie is not null)
            {
                <Overalinlezen Wie="wie" Administratie="Id" Ingelezen="VerversAantallen" />
            }
        </div>
    </div>
    <footer class="statusbalk">
        <span title="@(kop.KvkNummer is { } kvk ? $"KvK {kvk}" : null)">@kop.Naam</span>
        <span class="scheiding">·</span>
        <span>@Weergave.Tekst(kop.Ondernemingsvorm)</span>
        <span class="ms-auto">@wie?.Naam</span>
        <span class="scheiding">·</span>
        <span>@Weergave.Tekst(kop.Rol)</span>
        <span class="scheiding">·</span>
        <span>@vandaag.ToString("dddd d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("nl-NL"))</span>
    </footer>
}

@code {
    private bool wisselen;
    private string? wisselzoek;
    private ElementReference wisselveld;
    private IReadOnlyList<AdministratieKop>? alle;

    private bool geladen;
    private AdministratieKop? kop;
    private Uitvoerder? wie;
    private DateOnly vandaag;
    private Zijbalkaantallen? aantallen;

    [CascadingParameter]
    private Task<AuthenticationState> Authenticatie { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid Id { get; set; }

    [Parameter, EditorRequired]
    public string Titel { get; set; } = "";

    /// <summary>Het pad van de pagina in het menu, bijv. "/grootboek"; leeg voor het dashboard.</summary>
    /// <summary>Een regel onder de titel met wat je op deze pagina wilt weten, bijv. het saldo en de datum van het laatste afschrift.</summary>
    [Parameter]
    public RenderFragment? Kenmerken { get; set; }

    [Parameter]
    public string Actief { get; set; } = "";

    [Parameter]
    public RenderFragment? Acties { get; set; }

    /// <summary>
    /// De kop (titel en acties) blijft bovenaan staan bij het scrollen, met een eventuele balk eronder (class
    /// <c>onderkop</c>, bijv. zoeken); de kolomkoppen van de tabellen schuiven eronder aan (kolommen.js meet de hoogte).
    /// </summary>
    [Parameter]
    public bool KopVast { get; set; }

    /// <summary>Waar de pijl linksboven naartoe gaat (bijv. terug naar de lijst waaruit je kwam); alleen binnen deze administratie.</summary>
    [Parameter]
    public string? Terug { get; set; }

    /// <summary>De regel in het menu die oplicht: bij een tabblad (bijv. Inkoop, geboekt) de regel van de groep.</summary>
    private string MenuPad => Administratiemenu.MenuPad(Actief);

    /// <summary>
    /// De tabbladen bovenaan, als deze pagina er zelf een is (het adres is het pad van de tab): niet op een pagina die
    /// alleen bij de groep hoort, zoals een factuur of het splitsen van een stapel.
    /// </summary>
    private Tabgroep? Tabs => Administratiemenu.GroepVan(Actief) is { } groep && TerugAdres is null
        && string.Equals(Navigatie.ToBaseRelativePath(Navigatie.Uri).Split('?', '#')[0].TrimEnd('/'), $"a/{Id}{Actief}", StringComparison.OrdinalIgnoreCase)
        ? groep : null;

    /// <summary>
    /// Het kruimelpad naar de pagina waar de pijl terug naartoe gaat: de groep en het tabblad (Inkoop › Geboekt) of de
    /// regel in het menu (Kolommenbalans); leeg als dat adres geen pagina uit het menu is.
    /// </summary>
    private List<(string Naam, string Adres)> Kruimels(string terug)
    {
        var pad = terug[$"/a/{Id}".Length..].Split('?', '#')[0].TrimEnd('/');
        if (Administratiemenu.GroepVan(pad) is { } groep)
        {
            var eerste = groep.Tabs[0];
            return pad == eerste.Pad
                ? [(groep.Naam, terug)]
                : [(groep.Naam, $"/a/{Id}{eerste.Pad}"), (groep.Tabs.First(t => t.Pad == pad).Naam, terug)];
        }

        return Administratiemenu.AllePaginas().FirstOrDefault(p => p.Item.Pad == pad).Item is { } item ? [(item.Naam, terug)] : [];
    }

    /// <summary>De pagina's met een eigen sleepvlak (inlezen, afschriften, loonjournaal, activastaat, beginbalans):
    /// daar niet overal slepen, anders vangen twee vlakken hetzelfde bestand.</summary>
    private static readonly HashSet<string> EigenSleepvlak = new(StringComparer.Ordinal) { "/inkoop", "/verkoop", "/bank", "/memoriaal", "/activa", "/beginbalans" };

    /// <summary>Overal slepen op deze pagina: niet op een pagina met een eigen sleepvlak of een detailpagina.</summary>
    private bool OveralSlepen => TerugAdres is null && !EigenSleepvlak.Contains(Actief);

    private async Task VerversAantallen()
    {
        if (wie is not null)
        {
            aantallen = await Kantooroverzicht.Aantallen(wie, Id);
        }
    }

    /// <summary>De titel: bij tabbladen de naam van de groep (Inkoop, Facturen maken), anders die van de pagina.</summary>
    private string Kopnaam => Tabs?.Naam ?? Titel;

    private string? TerugAdres => Terug is { } t && t.StartsWith($"/a/{Id}/", StringComparison.OrdinalIgnoreCase) && !t.Contains("//", StringComparison.Ordinal) ? t : null;

    [Parameter, EditorRequired]
    public RenderFragment<AdministratieKop> ChildContent { get; set; } = default!;

    /// <summary>Na de toegangscontrole: de administratie en de ingelogde gebruiker, om de gegevens te laden.</summary>
    [Parameter]
    public EventCallback<Geopend> BijOpenen { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (geladen && kop?.Id == Id)
        {
            return;
        }

        wie = (await Authenticatie).User.AlsUitvoerder();
        vandaag = DateOnly.FromDateTime(Tijd.GetLocalNow().DateTime);
        kop = await AdministratieDienst.Open(wie, Id);
        if (kop is not null)
        {
            aantallen = await Kantooroverzicht.Aantallen(wie, Id);
            await BijOpenen.InvokeAsync(new Geopend(kop, wie));
        }

        geladen = true;
    }

    /// <summary>De administraties voor de wisselaar: de geopende eerst, dan op naam; hooguit twaalf.</summary>
    private List<AdministratieKop> Gevonden =>
        [.. (alle ?? []).Where(a => string.IsNullOrWhiteSpace(wisselzoek) || a.Naam.Contains(wisselzoek.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderBy(a => a.Id == kop?.Id ? 0 : 1).ThenBy(a => a.Naam, StringComparer.CurrentCultureIgnoreCase).Take(12)];

    private async Task OpenWisselaar()
    {
        wisselen = !wisselen;
        if (wisselen)
        {
            wisselzoek = null;
            alle ??= await AdministratieDienst.Lijst(wie!);
            StateHasChanged();
            await Task.Yield();
            await wisselveld.FocusAsync();
        }
    }

    private void WisselToets(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            wisselen = false;
        }
        else if (e.Key == "Enter" && Gevonden.FirstOrDefault(a => a.Id != kop?.Id) is { } eerste)
        {
            wisselen = false;
            Navigatie.NavigateTo($"/a/{eerste.Id}{Actief}");
        }
    }
}
