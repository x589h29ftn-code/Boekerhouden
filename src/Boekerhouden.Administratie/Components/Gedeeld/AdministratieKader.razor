@* Kop, menu en toegangscontrole van een pagina binnen een administratie. Pas na de controle laadt de pagina haar
   gegevens (BijOpenen); zonder lidmaatschap dezelfde melding als bij een administratie die niet bestaat. Het menu staat
   horizontaal boven de inhoud (zo blijft de volle breedte voor de gegevens); de onderdelen van een groep verschijnen
   bij aanwijzen of aanklikken. *@
@inject AdministratieDienst AdministratieDienst

@if (!geladen)
{
    <p class="text-secondary">Laden…</p>
}
else if (kop is null)
{
    <div class="alert alert-warning">Deze administratie bestaat niet of je hebt er geen toegang toe. <a href="/">Naar de administraties</a></div>
}
else
{
    <PageTitle>@Titel – @kop.Naam</PageTitle>
    <div class="administratie">
        <nav class="admmenu" aria-label="Administratie">
            <a class="admmenu-naam" href="/a/@kop.Id" title="@kop.Naam">@kop.Naam</a>
            @foreach (var (groep, items) in Menu)
            {
                var zichtbaar = items.Where(i => kop.Mag(i.Recht)).ToList();
                if (zichtbaar.Count == 0)
                {
                    continue;
                }

                var actief = zichtbaar.Any(i => i.Pad == Actief);
                <div class="admmenu-groep @(actief ? "actief" : null) @(open == groep ? "open" : null)" @onmouseleave="() => Sluit(groep)">
                    <button type="button" class="admmenu-kop" aria-haspopup="true" aria-expanded="@(open == groep)" @onclick="() => Wissel(groep)">
                        @groep <span class="pijl" aria-hidden="true">▾</span>
                    </button>
                    <div class="admmenu-items">
                        @foreach (var (pad, naam, _) in zichtbaar)
                        {
                            <a class="admmenu-link @(pad == Actief ? "actief" : null)" href="@($"/a/{kop.Id}{pad}")" aria-current="@(pad == Actief ? "page" : null)" @onclick="() => open = null">@naam</a>
                        }
                    </div>
                </div>
            }
        </nav>
        <div class="administratie-inhoud">
            <div class="d-flex align-items-center flex-wrap gap-3 mb-3">
                <h1 class="h3 mb-0 me-auto">@Titel</h1>
                @Acties
            </div>
            @ChildContent(kop)
        </div>
    </div>
}

@code {
    /// <summary>Het menu per groep: boekhouden (verwerken), dagboeken (terugvinden), rapportages en inrichting.</summary>
    private static readonly (string Groep, (string Pad, string Naam, Recht Recht)[] Items)[] Menu =
    [
        ("Boekhouden",
        [
            ("/inkoop", "Inkoop", Recht.Lezen),
            ("/bank", "Bank", Recht.Lezen),
            ("/memoriaal", "Memoriaal", Recht.Boekhouden),
        ]),
        ("Dagboeken",
        [
            ("/inkoopboek", "Inkopen", Recht.Lezen),
            ("/journaal", "Journaal", Recht.Lezen),
        ]),
        ("Rapportages",
        [
            ("", "Balans en W&V", Recht.Lezen),
            ("/kolommenbalans", "Kolommenbalans", Recht.Lezen),
            ("/proefbalans", "Proefbalans", Recht.Lezen),
            ("/grootboek", "Grootboekkaart", Recht.Lezen),
        ]),
        ("Inrichting",
        [
            ("/relaties", "Relaties", Recht.Lezen),
            ("/regels", "Regels", Recht.Lezen),
            ("/rekeningschema", "Rekeningschema", Recht.Lezen),
            ("/instellingen", "Instellingen", Recht.Boekhouden),
        ]),
    ];

    /// <summary>De groep die is opengeklikt (aanwijzen opent hem ook, via CSS).</summary>
    private string? open;

    private bool geladen;
    private AdministratieKop? kop;

    [CascadingParameter]
    private Task<AuthenticationState> Authenticatie { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid Id { get; set; }

    [Parameter, EditorRequired]
    public string Titel { get; set; } = "";

    /// <summary>Het pad van de pagina in het menu, bijv. "/grootboek"; leeg voor balans en W&amp;V.</summary>
    [Parameter]
    public string Actief { get; set; } = "";

    [Parameter]
    public RenderFragment? Acties { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<AdministratieKop> ChildContent { get; set; } = default!;

    /// <summary>Na de toegangscontrole: de administratie en de ingelogde gebruiker, om de gegevens te laden.</summary>
    [Parameter]
    public EventCallback<Geopend> BijOpenen { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (geladen && kop?.Id == Id)
        {
            return;
        }

        var wie = (await Authenticatie).User.AlsUitvoerder();
        kop = await AdministratieDienst.Open(wie, Id);
        if (kop is not null)
        {
            await BijOpenen.InvokeAsync(new Geopend(kop, wie));
        }

        geladen = true;
    }

    private void Wissel(string groep) => open = open == groep ? null : groep;

    private void Sluit(string groep)
    {
        if (open == groep)
        {
            open = null;
        }
    }
}
