@* Kop, menu en toegangscontrole van een pagina binnen een administratie. Pas na de controle laadt de pagina haar
   gegevens (BijOpenen); zonder lidmaatschap dezelfde melding als bij een administratie die niet bestaat. Het menu staat
   links in een zijbalk: bovenaan de administratie (met een wisselaar naar een andere, op dezelfde pagina), dan de
   groepen met hun pagina's. De zijbalk kan smal (toetsen.js onthoudt dat per browser). *@
@inject AdministratieDienst AdministratieDienst
@inject NavigationManager Navigatie
@inject TimeProvider Tijd

@if (!geladen)
{
    <Laadschets />
}
else if (kop is null)
{
    <div class="alert alert-warning">Deze administratie bestaat niet of je hebt er geen toegang toe. <a href="/">Naar de administraties</a></div>
}
else
{
    <PageTitle>@Titel - @kop.Naam</PageTitle>
    <div class="administratie">
        <aside class="zijbalk" aria-label="Administratie">
            <button type="button" class="zijbalk-wissel" data-zijbalk title="Menu smaller of breder" aria-label="Menu smaller of breder"><Icoon Naam="chevron-left" /></button>
            <div class="wisselaar @(wisselen ? "open" : null)">
                <button type="button" class="wisselaar-knop" title="@kop.Naam" aria-haspopup="listbox" aria-expanded="@wisselen" @onclick="OpenWisselaar">
                    <span class="wisselaar-naam">@kop.Naam</span>
                    <span class="wisselaar-vorm">@Weergave.Tekst(kop.Ondernemingsvorm)</span>
                    <span class="pijl"><Icoon Naam="chevron-down" /></span>
                </button>
                @if (wisselen)
                {
                    <div class="wisselaar-achter" @onclick="() => wisselen = false"></div>
                    <div class="wisselaar-paneel">
                        <input class="form-control form-control-sm" placeholder="Administratie zoeken" aria-label="Administratie zoeken" @ref="wisselveld"
                               @bind="wisselzoek" @bind:event="oninput" @onkeydown="WisselToets" />
                        <div class="wisselaar-lijst" role="listbox">
                            @foreach (var a in Gevonden)
                            {
                                <a class="wisselaar-item @(a.Id == kop.Id ? "actief" : null)" role="option" href="@($"/a/{a.Id}{Actief}")" @onclick="() => wisselen = false">
                                    <span>@a.Naam</span><span class="wisselaar-vorm">@Weergave.Tekst(a.Ondernemingsvorm)</span>
                                </a>
                            }
                            @if (Gevonden.Count == 0)
                            {
                                <div class="leeg-regel">Geen administratie gevonden.</div>
                            }
                        </div>
                        <a class="wisselaar-alle" href="/">Alle administraties</a>
                    </div>
                }
            </div>
            <nav class="zijmenu">
                <a class="zijmenu-link @(Actief.Length == 0 ? "actief" : null)" href="/a/@kop.Id" aria-current="@(Actief.Length == 0 ? "page" : null)">Overzicht</a>
                @foreach (var groep in Administratiemenu.Groepen)
                {
                    var zichtbaar = groep.Items.Where(i => i.Zichtbaar(kop)).ToList();
                    if (zichtbaar.Count == 0)
                    {
                        continue;
                    }

                    <div class="zijmenu-groep">@groep.Naam</div>
                    @foreach (var item in zichtbaar)
                    {
                        <a class="zijmenu-link @(item.Pad == Actief ? "actief" : null)" href="@($"/a/{kop.Id}{item.Pad}")" aria-current="@(item.Pad == Actief ? "page" : null)">@item.Naam</a>
                    }
                }
            </nav>
        </aside>
        <div class="administratie-inhoud">
            <div class="d-flex align-items-center flex-wrap gap-3 mb-3">
                @if (TerugAdres is { } terug)
                {
                    <a class="terug" href="@terug" title="Terug" aria-label="Terug"><Icoon Naam="arrow-left" /></a>
                }
                <div class="me-auto paginakop">
                    <h1 class="h3 mb-0">@Titel@if (kop.Gearchiveerd is not null)
                        {
                            <span class="status ms-2 fs-6" title="Uit het archief halen kan bij Administraties">gearchiveerd, alleen inzien</span>
                        }</h1>
                    @if (Kenmerken is not null)
                    {
                        <div class="kopkenmerken">@Kenmerken</div>
                    }
                </div>
                @Acties
            </div>
            @ChildContent(kop)
        </div>
    </div>
    <footer class="statusbalk">
        <span title="@(kop.KvkNummer is { } kvk ? $"KvK {kvk}" : null)">@kop.Naam</span>
        <span class="scheiding">·</span>
        <span>@Weergave.Tekst(kop.Ondernemingsvorm)</span>
        <span class="ms-auto">@wie?.Naam</span>
        <span class="scheiding">·</span>
        <span>@Weergave.Tekst(kop.Rol)</span>
        <span class="scheiding">·</span>
        <span>@vandaag.ToString("dddd d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("nl-NL"))</span>
    </footer>
}

@code {
    private bool wisselen;
    private string? wisselzoek;
    private ElementReference wisselveld;
    private IReadOnlyList<AdministratieKop>? alle;

    private bool geladen;
    private AdministratieKop? kop;
    private Uitvoerder? wie;
    private DateOnly vandaag;

    [CascadingParameter]
    private Task<AuthenticationState> Authenticatie { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid Id { get; set; }

    [Parameter, EditorRequired]
    public string Titel { get; set; } = "";

    /// <summary>Het pad van de pagina in het menu, bijv. "/grootboek"; leeg voor het dashboard.</summary>
    /// <summary>Een regel onder de titel met wat je op deze pagina wilt weten, bijv. het saldo en de datum van het laatste afschrift.</summary>
    [Parameter]
    public RenderFragment? Kenmerken { get; set; }

    [Parameter]
    public string Actief { get; set; } = "";

    [Parameter]
    public RenderFragment? Acties { get; set; }

    /// <summary>Waar de pijl linksboven naartoe gaat (bijv. terug naar de lijst waaruit je kwam); alleen binnen deze administratie.</summary>
    [Parameter]
    public string? Terug { get; set; }

    private string? TerugAdres => Terug is { } t && t.StartsWith($"/a/{Id}/", StringComparison.OrdinalIgnoreCase) && !t.Contains("//", StringComparison.Ordinal) ? t : null;

    [Parameter, EditorRequired]
    public RenderFragment<AdministratieKop> ChildContent { get; set; } = default!;

    /// <summary>Na de toegangscontrole: de administratie en de ingelogde gebruiker, om de gegevens te laden.</summary>
    [Parameter]
    public EventCallback<Geopend> BijOpenen { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (geladen && kop?.Id == Id)
        {
            return;
        }

        wie = (await Authenticatie).User.AlsUitvoerder();
        vandaag = DateOnly.FromDateTime(Tijd.GetLocalNow().DateTime);
        kop = await AdministratieDienst.Open(wie, Id);
        if (kop is not null)
        {
            await BijOpenen.InvokeAsync(new Geopend(kop, wie));
        }

        geladen = true;
    }

    /// <summary>De administraties voor de wisselaar: de geopende eerst, dan op naam; hooguit twaalf.</summary>
    private List<AdministratieKop> Gevonden =>
        [.. (alle ?? []).Where(a => string.IsNullOrWhiteSpace(wisselzoek) || a.Naam.Contains(wisselzoek.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderBy(a => a.Id == kop?.Id ? 0 : 1).ThenBy(a => a.Naam, StringComparer.CurrentCultureIgnoreCase).Take(12)];

    private async Task OpenWisselaar()
    {
        wisselen = !wisselen;
        if (wisselen)
        {
            wisselzoek = null;
            alle ??= await AdministratieDienst.Lijst(wie!);
            StateHasChanged();
            await Task.Yield();
            await wisselveld.FocusAsync();
        }
    }

    private void WisselToets(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            wisselen = false;
        }
        else if (e.Key == "Enter" && Gevonden.FirstOrDefault(a => a.Id != kop?.Id) is { } eerste)
        {
            wisselen = false;
            Navigatie.NavigateTo($"/a/{eerste.Id}{Actief}");
        }
    }
}
