@* De verwerkingsinstellingen. Met Kantoor erbij (in een administratie) betekent een leeg veld "zoals het kantoor";
   de waarde van het kantoor staat dan grijs in het veld. *@
@using Boekerhouden.Boekhouding.Facturen
@using Boekerhouden.Boekhouding.Regels

<div class="row g-2">
    <div class="col-md-6">
        <label class="form-label" for="drempel" title="Kies je zoveel keer achter elkaar dezelfde rekening bij een leverancier, dan boekt Sifer zijn facturen daarna zelf.@Leeg">Vanzelf boeken na … keer dezelfde rekening</label>
        <input id="drempel" type="number" min="1" max="10" class="form-control" @bind="Invoer.Drempel" placeholder="@Grijs(Kantoor?.Drempel.ToString())" />
    </div>
    <div class="col-md-6">
        <label class="form-label" for="bandbreedte" title="Een factuur boekt Sifer zelf tot zoveel keer het hoogste bedrag dat je bij deze leverancier eerder hebt goedgekeurd (1,25 = 25% hoger); daarboven eerst nakijken.@Leeg">Vanzelf boeken tot … keer het hoogste bedrag</label>
        <input id="bandbreedte" class="form-control" @bind="Invoer.Bandbreedte" placeholder="@Grijs(Kantoor?.Bandbreedte.ToString("0.##", Nl))" />
    </div>
    <div class="col-md-6">
        <label class="form-label" for="termijn" title="Staat er geen vervaldatum op de factuur, dan rekent Sifer met zoveel dagen na de factuurdatum.@Leeg">Betalingstermijn in dagen</label>
        <input id="termijn" type="number" min="0" max="365" class="form-control" @bind="Invoer.Betalingstermijn" placeholder="@Grijs(Kantoor?.Betalingstermijn.ToString())" />
    </div>
    <div class="col-md-6">
        <label class="form-label" for="limiet" title="Facturen boven dit bedrag (inclusief btw) boekt Sifer nooit zelf; die kijk je altijd na.">Nooit vanzelf boeken boven</label>
        @if (Kantoor is null)
        {
            <input id="limiet" class="form-control" @bind="Invoer.Limiet" placeholder="geen grens" />
        }
        else
        {
            <div class="input-group">
                <select id="limiet" class="form-select" @bind="Invoer.LimietKeuze" aria-label="Limiet">
                    <option value="@InstellingenInvoer.Kantoor">standaard: @(Kantoor.Limiet is { } l ? Bedragen.Euro(l) : "geen grens")</option>
                    <option value="@InstellingenInvoer.GeenLimiet">geen grens</option>
                    <option value="@InstellingenInvoer.EigenLimiet">eigen bedrag</option>
                </select>
                @if (Invoer.LimietKeuze == InstellingenInvoer.EigenLimiet)
                {
                    <input class="form-control" @bind="Invoer.Limiet" aria-label="Eigen bedrag" />
                }
            </div>
        }
    </div>
    <div class="col-md-6">
        <label class="form-label" for="adrescontrole" title="Staat er op de factuur van een bekende leverancier een andere postcode dan eerder, dan eerst laten nakijken (tegen valse facturen).">Nieuw adres van een leverancier nakijken</label>
        <select id="adrescontrole" class="form-select" @bind="Invoer.Adrescontrole">
            @if (Kantoor is not null)
            {
                <option value="@InstellingenInvoer.Kantoor">standaard: @(Kantoor.Adrescontrole ? "aan" : "uit")</option>
            }
            <option value="@InstellingenInvoer.Aan">aan</option>
            <option value="@InstellingenInvoer.Uit">uit</option>
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label" for="betaalverschil" title="Wijkt een betaling hooguit zoveel af van de factuur (nummer en IBAN kloppen), dan sluit Sifer de factuur af en boekt hij het verschil op de rekening hieronder.@Leeg">Klein betaalverschil afboeken tot</label>
        <input id="betaalverschil" class="form-control" @bind="Invoer.Betaalverschil" placeholder="@(Grijs(Kantoor?.Betaalverschil is { } b ? Bedragen.Euro(b) : null) ?? "uit")" />
    </div>
    <div class="col-md-6">
        <label class="form-label" for="verschilrekening" title="Het nummer van de grootboekrekening voor kleine betaalverschillen.@Leeg">Rekening voor betaalverschillen</label>
        <input id="verschilrekening" class="form-control" @bind="Invoer.Verschilrekening" placeholder="@Grijs(Kantoor?.Verschilrekening)" />
    </div>
    @if (MetDocumentmap)
    {
        <div class="col-12">
            <Documentmapveld Invoer="Invoer" Kantoor="Kantoor" />
        </div>
    }
    @if (Kantoor is null)
    {
        <div class="col-12">
            <label class="form-label" for="standaardomschrijving">Standaardomschrijving inkoopfactuur</label>
            <input id="standaardomschrijving" class="form-control" @bind="Invoer.Omschrijving" @bind:event="oninput" maxlength="200" placeholder="bijv. #leverancier #factuurnummer #maand"
                   title="@string.Join(", ", Omschrijvingssjabloon.Variabelen.Select(v => $"{v.Naam} = {v.Betekenis}"))" />
            @if (Omschrijvingssjabloon.IsSjabloon(Invoer.Omschrijving))
            {
                <div class="small text-secondary mt-1" title="Voorbeeld">@Omschrijvingssjabloon.Vul(Invoer.Omschrijving!, Voorbeeld)</div>
            }
        </div>
        <div class="col-12">
            <label class="form-label" for="standaardomschrijving-verkoop">Standaardomschrijving ingelezen verkoopfactuur</label>
            <input id="standaardomschrijving-verkoop" class="form-control" @bind="Invoer.OmschrijvingVerkoop" @bind:event="oninput" maxlength="200" placeholder="bijv. Verkoop #klant #maandnr-#jaar"
                   title="@string.Join(", ", Omschrijvingssjabloon.Variabelen.Select(v => $"{v.Naam} = {v.Betekenis}"))" />
            @if (Omschrijvingssjabloon.IsSjabloon(Invoer.OmschrijvingVerkoop))
            {
                <div class="small text-secondary mt-1" title="Voorbeeld">@Omschrijvingssjabloon.Vul(Invoer.OmschrijvingVerkoop!, Voorbeeld)</div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public InstellingenInvoer Invoer { get; set; } = default!;

    /// <summary>De instellingen van het kantoor, als de velden bij een administratie horen.</summary>
    [Parameter]
    public Verwerkingsinstellingen? Kantoor { get; set; }

    /// <summary>De documentmap hier tonen; bij een administratie staat hij in een eigen blok (Documenten).</summary>
    [Parameter]
    public bool MetDocumentmap { get; set; } = true;

    private static readonly Factuurvariabelen Voorbeeld = new("2026-0042", "Kantoorartikelen", "Kantoorhandel Jansen", new DateOnly(2026, 3, 14), new DateOnly(2026, 4, 13), null);

    private static readonly System.Globalization.CultureInfo Nl = System.Globalization.CultureInfo.GetCultureInfo("nl-NL");

    /// <summary>De waarde van het kantoor, grijs in een leeg veld: "standaard: 2". Leeg laten = de kantoorinstelling.</summary>
    private string? Grijs(string? kantoorwaarde) => Kantoor is null ? null : kantoorwaarde is null ? "standaard: geen" : $"standaard: {kantoorwaarde}";

    /// <summary>In de tooltip bij een administratie: wat een leeg veld betekent.</summary>
    private string Leeg => Kantoor is null ? string.Empty : " Leeg laten = de standaard van het kantoor (grijs).";
}
