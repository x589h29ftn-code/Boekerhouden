@* Een kolomkop om op te sorteren: klikken sorteert, nog eens klikken keert om; het pijltje toont de richting.
   Gewijzigd tekent de tabel opnieuw: geef de pagina mee (Gewijzigd="StateHasChanged"), anders tekent alleen de kop. *@

<th class="sorteerbaar @Klasse" data-breedte="@Breedte" aria-sort="@(Sortering.Kolom == Naam ? (Sortering.Oplopend ? "ascending" : "descending") : null)" title="Sorteren" @onclick="Wissel">
    @* Rechts uitgelijnd (bedragen): het pijltje links van de tekst, zodat de tekst gelijk eindigt met de bedragen. *@
    @if (Rechts)
    {
        <span class="sorteerpijl links"><Icoon Naam="arrow-up" /></span>@(Tekst ?? Naam)
    }
    else
    {
        @(Tekst ?? Naam)<span class="sorteerpijl"><Icoon Naam="arrow-up" /></span>
    }
</th>

@code {
    [Parameter, EditorRequired]
    public ISortering Sortering { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Naam { get; set; } = "";

    /// <summary>De kop zoals hij er staat, als die anders is dan de naam van de kolom.</summary>
    [Parameter]
    public string? Tekst { get; set; }

    [Parameter]
    public string? Klasse { get; set; }

    /// <summary>Een vaste breedte in pixels (voor de versleepbare kolommen, zie kolommen.js); leeg = zoals getekend.</summary>
    [Parameter]
    public int? Breedte { get; set; }

    [Parameter, EditorRequired]
    public EventCallback Gewijzigd { get; set; }

    private bool Rechts => Klasse?.Contains("text-end", StringComparison.Ordinal) == true;

    private async Task Wissel()
    {
        Sortering.Wissel(Naam);
        await Gewijzigd.InvokeAsync();
    }
}
