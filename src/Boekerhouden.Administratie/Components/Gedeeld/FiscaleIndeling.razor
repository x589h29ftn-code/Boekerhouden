@* Welke kostenrekeningen niet of beperkt aftrekbaar zijn voor de vennootschapsbelasting. Elke wijziging wordt meteen
   bewaard (los van een formulier). Staat op Fiscale positie, waar het effect te zien is. *@
@using Boekerhouden.Boekhouding.Vpb
@inject VpbDienst Vpb
@inject GrootboekDienst Grootboek
@inject Meldingen Meldingen

@if (schema is not null)
{
    <Foutmeldingen Fouten="fouten" />
    <div class="row g-3 vpb-indeling">
        @foreach (var (soort, titel) in Fiscalelijsten)
        {
            var s = soort;
            <div class="col-md-6" data-soort="@soort">
                <label class="form-label">@titel</label>
                <table class="table table-sm align-middle mb-1 overzichtstabel">
                    <tbody>
                        @foreach (var r in Fiscaleindeling.Rekeningen(schema, soort).Where(r => !r.IsBalans).OrderBy(r => r.Nummer, Boekhouding.Grootboek.Rekeningnummers.Volgorde))
                        {
                            var nummer = r.Nummer;
                            <tr class="regel-met-acties">
                                <td><span class="rekeningnummer">@r.Nummer</span> @r.Naam</td>
                                <td class="text-end" style="width:7rem">
                                    @if (r.Fiscaal is null)
                                    {
                                        <span class="status" title="Automatisch op RGS-code en naam">automatisch</span>
                                    }
                                </td>
                                <td style="width:1.75rem"><button type="button" class="btn btn-sm btn-link text-secondary p-0 regelactie" title="Weer gewoon aftrekbaar" aria-label="Weer gewoon aftrekbaar" @onclick="() => ZetFiscaal(nummer, Fiscaalsoort.Gewoon)"><Icoon Naam="x" /></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="d-flex gap-2">
                    <RekeningKeuze @bind-Waarde="nieuw[s]" Schema="schema" Kader="Kader" Label="@($"Rekening toevoegen: {titel.ToLowerInvariant()}")" Klasse="form-control form-control-sm" />
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@string.IsNullOrWhiteSpace(nieuw[s])" @onclick="() => Voegtoe(s)">Toevoegen</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private static readonly (Fiscaalsoort Soort, string Titel)[] Fiscalelijsten =
        [(Fiscaalsoort.NietAftrekbaar, "Niet aftrekbaar"), (Fiscaalsoort.BeperktAftrekbaar, "Beperkt aftrekbaar")];

    private readonly Dictionary<Fiscaalsoort, string?> nieuw = new() { [Fiscaalsoort.NietAftrekbaar] = null, [Fiscaalsoort.BeperktAftrekbaar] = null };
    private Boekhouding.Grootboek.Rekeningschema? schema;
    private IReadOnlyList<string>? fouten;

    [Parameter, EditorRequired]
    public Guid Administratie { get; set; }

    [Parameter, EditorRequired]
    public Geopend Kader { get; set; } = default!;

    /// <summary>Na een wijziging, bijv. om de fiscale positie opnieuw te berekenen.</summary>
    [Parameter]
    public EventCallback Gewijzigd { get; set; }

    protected override async Task OnInitializedAsync() => schema = await Grootboek.Schema(Kader.Wie, Administratie);

    private async Task ZetFiscaal(string nummer, Fiscaalsoort soort)
    {
        var uitkomst = await Vpb.ZetFiscaal(Kader.Wie, Administratie, nummer, soort);
        fouten = uitkomst.IsGelukt ? null : uitkomst.Fouten;
        if (uitkomst.IsGelukt)
        {
            Meldingen.Toon($"{nummer}: {VpbDienst.Naam(soort)}");
            schema = await Grootboek.Schema(Kader.Wie, Administratie);
            await Gewijzigd.InvokeAsync();
        }
    }

    private async Task Voegtoe(Fiscaalsoort soort)
    {
        if (nieuw[soort]?.Trim() is { Length: > 0 } nummer)
        {
            nieuw[soort] = null;
            await ZetFiscaal(nummer, soort);
        }
    }
}
