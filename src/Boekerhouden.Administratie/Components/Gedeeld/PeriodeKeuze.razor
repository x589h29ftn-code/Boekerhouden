@* Een periode kiezen: van en tot en met, met pijlen naar de vorige en volgende periode van dezelfde lengte. *@
@using Boekerhouden.Boekhouding.Grootboek

<div class="periodekeuze">
    <DatumVeld Label="Van" Waarde="Van" WaardeChanged="ZetVan" />
    <span class="text-secondary" aria-hidden="true">→</span>
    <DatumVeld Label="Tot en met" Waarde="Tot" WaardeChanged="ZetTot" />
    <button type="button" class="btn btn-sm btn-link text-secondary px-1" title="Vorige periode" @onclick="() => Schuif(-1)">‹</button>
    <button type="button" class="btn btn-sm btn-link text-secondary px-1" title="Volgende periode" @onclick="() => Schuif(1)">›</button>
</div>

@code {
    [Parameter, EditorRequired]
    public DateOnly Van { get; set; }

    [Parameter, EditorRequired]
    public DateOnly Tot { get; set; }

    /// <summary>De nieuwe periode (van, tot en met).</summary>
    [Parameter]
    public EventCallback<(DateOnly Van, DateOnly Tot)> Gewijzigd { get; set; }

    private Task Schuif(int stappen) => Gewijzigd.InvokeAsync(Periode.Schuif(Van, Tot, stappen));

    private Task ZetVan(DateOnly van) => Gewijzigd.InvokeAsync((van, van > Tot ? van : Tot));

    private Task ZetTot(DateOnly tot) => Gewijzigd.InvokeAsync((tot < Van ? tot : Van, tot));
}
