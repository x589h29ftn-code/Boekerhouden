@* Omzet en inkoop (of alle kosten) per maand als staafjes, het resultaat als lijn; één as in euro's. Als SVG zonder
   script (CSP): per maand een vlak met een tooltip met alle bedragen, dat naar de kolommenbalans van die maand gaat.
   Kleuren: --grafiek-1..3 in administratie.css (gecontroleerd op kleurenblindheid en contrast). Met Tabel dezelfde
   cijfers als tabel. *@
@using Boekerhouden.Boekhouding.Grootboek
@using static Boekerhouden.Administratie.Components.Gedeeld.Grafiek

<div class="maandgrafiek">
    <div class="grafiekkop">
        <span class="legenda"><span class="sleutel staaf omzet"></span>Omzet</span>
        <span class="legenda"><span class="sleutel staaf kosten"></span>@KostenNaam</span>
        <span class="legenda"><span class="sleutel lijn"></span>Resultaat</span>
        <button type="button" class="btn btn-link btn-sm p-0 ms-auto text-secondary" @onclick="() => tabel = !tabel">@(tabel ? "Grafiek" : "Tabel")</button>
    </div>
    @if (tabel)
    {
        <table class="table table-sm mb-0 grafiektabel">
            <thead><tr><th>Maand</th><th class="text-end">Omzet</th><th class="text-end">@KostenNaam</th><th class="text-end">Resultaat</th></tr></thead>
            <tbody>
                @{
                    var omzet = Weergave.HeleEuros(Maanden.Select(m => m.Omzet));
                    var kosten = Weergave.HeleEuros(Maanden.Select(Kosten));
                    var resultaat = Weergave.HeleEuros(Maanden.Select(m => m.Resultaat));
                }
                @for (var i = 0; i < Maanden.Count; i++)
                {
                    <tr>
                        <td><a href="@Adres(Maanden[i].Maand)">@Maandnaam(Maanden[i].Maand)</a></td>
                        <td class="text-end">@Weergave.BedragHeel(omzet[i])</td>
                        <td class="text-end">@Weergave.BedragHeel(kosten[i])</td>
                        <td class="text-end">@Weergave.BedragHeel(resultaat[i])</td>
                    </tr>
                }
            </tbody>
            <tfoot><tr><td>Totaal</td><td class="text-end">@Weergave.BedragHeel(Maanden.Sum(m => m.Omzet))</td><td class="text-end">@Weergave.BedragHeel(Maanden.Sum(Kosten))</td><td class="text-end">@Weergave.BedragHeel(Maanden.Sum(m => m.Resultaat))</td></tr></tfoot>
        </table>
    }
    else
    {
        <svg viewBox="0 0 @Breedte @Hoogte" role="img" aria-label="@($"Omzet, {KostenNaam.ToLowerInvariant()} en resultaat per maand")">
            @foreach (var t in vlak.Ticks)
            {
                <line class="raster @(t == 0 ? "nul" : null)" x1="@G(Links)" x2="@G(Breedte - Rechts)" y1="@G(vlak.Y(t))" y2="@G(vlak.Y(t))" />
                @Label(Links - 8, vlak.Y(t) + 4, "end", Asgetal(t))
            }
            @for (var i = 0; i < Maanden.Count; i++)
            {
                var m = Maanden[i];
                var midden = vlak.Midden(i);
                @Label(midden, Hoogte - 6, "middle", Maandkort(m.Maand, false))
                <path class="staaf omzet" d="@vlak.Staaf(midden - Staafbreedte - 1, Staafbreedte, m.Omzet)" />
                <path class="staaf kosten" d="@vlak.Staaf(midden + 1, Staafbreedte, Kosten(m))" />
            }
            @if (Lijnpunten.Count > 1)
            {
                <polyline class="lijn" points="@string.Join(' ', Lijnpunten.Select(p => $"{G(p.X)},{G(p.Y)}"))" />
            }
            @foreach (var p in Lijnpunten)
            {
                <circle class="punt" cx="@G(p.X)" cy="@G(p.Y)" r="4" />
            }
            @for (var i = 0; i < Maanden.Count; i++)
            {
                var m = Maanden[i];
                <a href="@Adres(m.Maand)">
                    <rect class="raakvlak" x="@G(Links + i * vlak.Band)" y="0" width="@G(vlak.Band)" height="@G(Hoogte - Onder)">
                        <title>@Maandnaam(m.Maand)&#10;Omzet: @Weergave.BedragHeel(m.Omzet)&#10;@KostenNaam: @Weergave.BedragHeel(Kosten(m))&#10;Resultaat: @Weergave.BedragHeel(m.Resultaat)</title>
                    </rect>
                </a>
            }
        </svg>
    }
</div>

@code {
    private const double Staafbreedte = 16;

    private bool tabel;
    private Grafiek vlak = new([], 12);

    [Parameter, EditorRequired]
    public IReadOnlyList<Maandcijfer> Maanden { get; set; } = [];

    /// <summary>Alle kosten in plaats van alleen de inkoop (kostprijs van de omzet).</summary>
    [Parameter]
    public bool AlleKosten { get; set; }

    /// <summary>Tot en met deze maand loopt de resultaatlijn (later in het jaar is er nog niets).</summary>
    [Parameter]
    public DateOnly Tot { get; set; } = DateOnly.MaxValue;

    /// <summary>Waar een maand naartoe gaat (de kolommenbalans van die maand).</summary>
    [Parameter, EditorRequired]
    public Func<DateOnly, string> Adres { get; set; } = _ => "";

    private string KostenNaam => AlleKosten ? "Kosten" : "Inkoop";

    private decimal Kosten(Maandcijfer m) => AlleKosten ? m.Kosten : m.Inkoop;

    private List<(double X, double Y)> Lijnpunten =>
        [.. Maanden.Select((m, i) => (m, i)).Where(x => x.m.Maand <= Tot).Select(x => (vlak.Midden(x.i), vlak.Y(x.m.Resultaat)))];

    protected override void OnParametersSet() =>
        vlak = new Grafiek(Maanden.SelectMany(m => new[] { m.Omzet, Kosten(m), m.Resultaat }), Maanden.Count);
}
