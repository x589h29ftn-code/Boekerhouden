@* De openstaande posten bij een bankmutatie in een venster (dubbelklik op de mutatie, "Kiezen…", of F2 in de kolom
   factuurnummer): zoeken op leverancier, factuurnummer of bedrag, filteren op leverancier, soort en tegenpartij, met
   de pijltjes en Enter. Een of meer posten aanvinken (ook een creditnota) en het verschil zien, of (Enkel) één post
   kiezen voor een regel. *@
@using Boekerhouden.Boekhouding.Bank
@using Boekerhouden.Boekhouding.Facturen
@using Boekerhouden.Domain

<div class="venster-achtergrond" @onclick="Sluit">
    <div class="venster card openpostenvenster" role="dialog" aria-modal="true" aria-label="Openstaande posten" @onclick:stopPropagation @onkeydown="Toets">
        <div class="card-header">
            <div class="d-flex align-items-center gap-2">
                <input @ref="zoekveld" class="form-control form-control-sm" placeholder="Zoeken op leverancier, factuurnummer of bedrag" aria-label="Posten zoeken"
                       @bind="zoek" @bind:event="oninput" @bind:after="() => gemarkeerd = 0" />
                <select class="form-select form-select-sm w-auto" aria-label="Leverancier of klant" @bind="relatie" @bind:after="() => gemarkeerd = 0">
                    <option value="">Alle relaties</option>
                    @foreach (var optie in Relatieopties)
                    {
                        <option value="@optie.Code">@optie.Naam</option>
                    }
                </select>
                <select class="form-select form-select-sm w-auto" aria-label="Soort" @bind="soort" @bind:after="() => gemarkeerd = 0">
                    <option value="">Crediteuren en debiteuren</option>
                    <option value="@Factuursoort.Inkoop">Crediteuren</option>
                    <option value="@Factuursoort.Verkoop">Debiteuren</option>
                </select>
                @if (VanTegenpartij.Count > 0)
                {
                    <label class="form-check form-switch mb-0 small text-nowrap" title="Alleen de posten van de relatie bij het IBAN van de mutatie">
                        <input class="form-check-input" type="checkbox" @bind="alleenTegenpartij" @bind:after="() => gemarkeerd = 0" />
                        <span class="form-check-label">tegenpartij</span>
                    </label>
                }
                <button class="btn-close ms-1" title="Sluiten (Esc)" aria-label="Sluiten" @onclick="Sluit"></button>
            </div>
            <div class="small text-secondary mt-1 text-truncate" title="@Verwerking.Mutatie.Omschrijving">
                @Weergave.Datum(Verwerking.Mutatie.Datum) · @Verwerking.Mutatie.TegenNaam · @Verwerking.Mutatie.Omschrijving
            </div>
        </div>
        <div class="venster-inhoud">
            <table class="table table-sm table-hover align-middle mb-0 overzichtstabel" data-sleepbaar="@(Enkel ? "openposten-enkel" : "openposten-kiezen")">
                <thead>
                    <tr>
                        @if (!Enkel)
                        {
                            <th></th>
                        }
                        <SorteerKop Sortering="sortering" Naam="Relatie" Tekst="Leverancier / klant" Gewijzigd="StateHasChanged" />
                        <SorteerKop Sortering="sortering" Naam="Factuurnr." Gewijzigd="StateHasChanged" />
                        <SorteerKop Sortering="sortering" Naam="Datum" Gewijzigd="StateHasChanged" />
                        <SorteerKop Sortering="sortering" Naam="Vervaldatum" Gewijzigd="StateHasChanged" />
                        <SorteerKop Sortering="sortering" Naam="Openstaand" Klasse="text-end" Gewijzigd="StateHasChanged" />
                    </tr>
                </thead>
                <tbody>
                    @{ var treffers = Treffers; }
                    @for (var i = 0; i < treffers.Count; i++)
                    {
                        var p = treffers[i];
                        var n = i;
                        var aan = gekozen.Contains(p.Id);
                        <tr class="klikbaar @(aan ? "table-active" : null) @(n == gemarkeerd ? "gemarkeerd" : null)" @onclick="() => Klik(p)">
                            @if (!Enkel)
                            {
                                <td><input class="form-check-input" type="checkbox" checked="@aan" aria-label="Kiezen" @onclick:stopPropagation @onchange="() => Wissel(p.Id)" /></td>
                            }
                            <td>@Naam(p.Relatie)</td>
                            <td>@p.Factuurnummer</td>
                            <td class="text-nowrap">@Weergave.Datum(p.Datum)</td>
                            <td class="text-nowrap text-secondary">@Weergave.Datum(p.Vervaldatum)</td>
                            <td class="text-end"><Euro Waarde="p.Openstaand" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (treffers.Count == 0)
            {
                <div class="text-secondary text-center py-4">Geen openstaande post gevonden.</div>
            }
        </div>
        @if (!Enkel)
        {
        <div class="card-footer">
            <Foutmeldingen Fouten="Fouten" />
            <div class="d-flex flex-wrap align-items-center gap-3 small">
                <span>Gekozen <strong><Euro Waarde="Totaal" /></strong></span>
                <span>Mutatie <strong><Euro Waarde="Verwerking.Mutatie.Bedrag" /></strong></span>
                <span class="@(Verschil != 0 && gekozen.Count > 0 ? "status let-op" : "text-secondary")" title="Het verschil blijft openstaan op de laatste post, tenzij je het afboekt.">Verschil <Euro Waarde="Verschil" /></span>
                @if (!Kiezen && Verschil != 0 && gekozen.Count > 0)
                {
                    <label class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" @bind="afboeken" />
                        <span class="form-check-label">verschil afboeken</span>
                    </label>
                }
                <button class="btn btn-sm btn-primary ms-auto" disabled="@((gekozen.Count == 0 && !Kiezen) || bezig)" @onclick="Bevestig">@(Kiezen ? "Kiezen" : "Afletteren")</button>
            </div>
            @if (!Kiezen && afboeken && Verschil != 0 && gekozen.Count > 0)
            {
                <div class="row g-2 align-items-end mt-1 verschil-afboeken">
                    <div class="col-md-4">
                        <label class="form-label small mb-0" for="verschil-rekening">Rekening</label>
                        <RekeningKeuze Id="verschil-rekening" @bind-Waarde="rekening" Schema="Verwerking.Schema" Kader="Kader" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0" for="verschil-btw">Btw</label>
                        <select id="verschil-btw" class="form-select form-select-sm" @bind="btwCode">
                            <option value="">geen</option>
                            @foreach (var c in Verwerking.BtwCodes.Where(c => c.Actief))
                            {
                                <option value="@c.Code" title="@c.Code · @c.Omschrijving">@c.Kort</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small mb-0" for="verschil-omschrijving">Omschrijving</label>
                        <input id="verschil-omschrijving" class="form-control form-control-sm" @bind="omschrijving" placeholder="Betalingskorting" />
                    </div>
                </div>
            }
        </div>
        }
    </div>
</div>

@code {
    private ElementReference zoekveld;
    private string? zoek;
    private List<Guid> gekozen = [];
    private bool afboeken;
    private string? rekening;
    private string? btwCode;
    private string? omschrijving;
    private bool bezig;
    private string relatie = "";
    private string soort = "";
    private bool alleenTegenpartij;
    private int gemarkeerd;

    [Parameter, EditorRequired]
    public Bankverwerking Verwerking { get; set; } = default!;

    /// <summary>Alleen kiezen (voor het verwerkpaneel, waar je de rest over regels verdeelt); niet zelf afletteren.</summary>
    [Parameter]
    public bool Kiezen { get; set; }

    [Parameter]
    public Geopend? Kader { get; set; }

    /// <summary>Eén post kiezen (voor een regel): klikken of Enter kiest en sluit het venster.</summary>
    [Parameter]
    public bool Enkel { get; set; }

    /// <summary>Wat de gebruiker al typte (bijv. in de kolom factuurnummer).</summary>
    [Parameter]
    public string? Zoektekst { get; set; }

    /// <summary>Posten die al op een andere regel staan: die staan hier niet.</summary>
    [Parameter]
    public IReadOnlyList<Guid> Uitgesloten { get; set; } = [];

    [Parameter]
    public EventCallback<OpenPost> Gekozen { get; set; }

    /// <summary>De posten die al aangevinkt staan (bijv. van een kandidaat).</summary>
    [Parameter]
    public IReadOnlyList<Guid> Voorgekozen { get; set; } = [];

    /// <summary>Het verschil meteen afboeken (bijv. bij betalingskorting).</summary>
    [Parameter]
    public bool Afboeken { get; set; }

    [Parameter]
    public IReadOnlyList<string>? Fouten { get; set; }

    [Parameter]
    public EventCallback<(IReadOnlyList<Guid> Posten, Verschilafboeking? Verschil)> Afletteren { get; set; }

    [Parameter]
    public EventCallback Gesloten { get; set; }

    /// <summary>De relatie(s) bij het IBAN van de mutatie: hun posten staan bovenaan.</summary>
    private HashSet<string> VanTegenpartij => [.. Verwerking.Relaties.Where(r => r.HeeftIban(Verwerking.Mutatie.TegenIban)).Select(r => r.Code)];

    private List<OpenPost> Treffers
    {
        get
        {
            var eigen = VanTegenpartij;
            return [.. sortering.Pas(Verwerking.OpenPosten
                .Where(p => !Uitgesloten.Contains(p.Id))
                .Where(p => gekozen.Contains(p.Id) || (Past(p) && (relatie.Length == 0 || p.Relatie == relatie)
                            && (soort.Length == 0 || p.Soort.ToString() == soort) && (!alleenTegenpartij || eigen.Contains(p.Relatie))))
                .OrderByDescending(p => gekozen.Contains(p.Id))
                .ThenByDescending(p => eigen.Contains(p.Relatie)))];
        }
    }

    private Sortering<OpenPost>? sorteringen;

    private Sortering<OpenPost> sortering => sorteringen ??= new(
        new("Relatie", p => Naam(p.Relatie).ToUpperInvariant()),
        new("Factuurnr.", p => p.Factuurnummer),
        new("Datum", p => p.Datum, EerstOplopend: false),
        new("Vervaldatum", p => p.Vervaldatum),
        new("Openstaand", p => Math.Abs(p.Openstaand), EerstOplopend: false));

    private decimal Totaal => Verwerking.OpenPosten.Where(p => gekozen.Contains(p.Id)).Sum(p => p.Openstaand);

    private decimal Verschil => Totaal - Verwerking.Mutatie.Bedrag;

    protected override void OnInitialized()
    {
        gekozen = [.. Voorgekozen];
        afboeken = Afboeken;
        zoek = Zoektekst;
        // De posten van de tegenpartij eerst; met een zoektekst alles.
        alleenTegenpartij = string.IsNullOrWhiteSpace(Zoektekst) && VanTegenpartij.Count > 0
                            && Verwerking.OpenPosten.Any(p => VanTegenpartij.Contains(p.Relatie) && !Uitgesloten.Contains(p.Id));
        if (Afboeken)
        {
            omschrijving = "Betalingskorting";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await zoekveld.FocusAsync();
        }
    }

    /// <summary>Zoeken op naam, code of factuurnummer van de post, of op het bedrag (ook zonder minteken).</summary>
    private bool Past(OpenPost p)
    {
        if (string.IsNullOrWhiteSpace(zoek))
        {
            return true;
        }

        var tekst = zoek.Trim();
        if (BedragParser.TryParse(tekst, out var bedrag) && Math.Abs(p.Openstaand) == Math.Abs(bedrag))
        {
            return true;
        }

        return p.Factuurnummer.Contains(tekst, StringComparison.OrdinalIgnoreCase)
               || p.Relatie.Contains(tekst, StringComparison.OrdinalIgnoreCase)
               || Naam(p.Relatie).Contains(tekst, StringComparison.OrdinalIgnoreCase);
    }

    private string Naam(string code) => Verwerking.Relaties.FirstOrDefault(r => r.Code == code)?.Naam ?? code;

    private IEnumerable<(string Code, string Naam)> Relatieopties =>
        Verwerking.OpenPosten.Select(p => p.Relatie).Distinct().Select(c => (c, Naam(c))).OrderBy(r => r.Item2, StringComparer.CurrentCultureIgnoreCase);

    private async Task Klik(OpenPost post)
    {
        if (Enkel)
        {
            await Gekozen.InvokeAsync(post);
        }
        else
        {
            Wissel(post.Id);
        }
    }

    private void Wissel(Guid post)
    {
        if (!gekozen.Remove(post))
        {
            gekozen.Add(post);
        }
    }

    private async Task Bevestig()
    {
        bezig = true;
        var verschil = !Kiezen && afboeken && Verschil != 0 ? new Verschilafboeking(rekening ?? "", btwCode, omschrijving) : null;
        await Afletteren.InvokeAsync(([.. gekozen], verschil));
        bezig = false;
    }

    private async Task Toets(KeyboardEventArgs e)
    {
        var aantal = Treffers.Count;
        switch (e.Key)
        {
            case "ArrowDown":
                gemarkeerd = Math.Min(aantal - 1, gemarkeerd + 1);
                break;
            case "ArrowUp":
                gemarkeerd = Math.Max(0, gemarkeerd - 1);
                break;
            case "Enter" when gemarkeerd >= 0 && gemarkeerd < aantal:
                await Klik(Treffers[gemarkeerd]);
                break;
            case "Escape":
                await Sluit();
                break;
        }
    }

    private async Task Sluit() => await Gesloten.InvokeAsync();
}
