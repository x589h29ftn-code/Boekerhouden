@* De factuur naast een overzicht (bijv. een boeking of een vast actief), alleen om te bekijken; met dezelfde versleepbare
   scheiding als het verwerkscherm. In de webapp haalt de viewer de PDF bij de server, in de Windows-app krijgt hij de
   inhoud mee. Een e-factuur zonder PDF toont de gegevens uit de e-factuur, net als bij het verwerken. *@
@implements IAsyncDisposable
@inject InkoopDienst Inkoop
@inject IJSRuntime JS
@inject IServiceProvider Diensten

<div @ref="scheiding" class="verwerken-scheiding" title="Sleep om de factuur breder of smaller te maken; dubbelklik voor de standaardbreedte"></div>
<div @ref="paneel" class="verwerken-viewer">
    @if (verwerking is { HeeftBeeld: false } e)
    {
        <Efactuurbeeld Factuur="e.Herkend" />
    }
    else
    {
        <div @ref="viewer" class="factuurviewer"></div>
    }
</div>

@code {
    private ElementReference scheiding;
    private ElementReference paneel;
    private ElementReference viewer;
    private IJSObjectReference? module;
    private IJSObjectReference? koppeling;

    [Parameter, EditorRequired]
    public Uitvoerder Wie { get; set; } = default!;

    [Parameter]
    public Guid Administratie { get; set; }

    [Parameter]
    public Guid Document { get; set; }

    private Verwerking? verwerking;

    protected override async Task OnInitializedAsync() => verwerking = await Inkoop.Verwerking(Wie, Administratie, Document);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./factuurviewer.js");
        await module.InvokeVoidAsync("scheiding", scheiding, paneel);
        if (verwerking is { HeeftBeeld: false })
        {
            return;
        }

        object bron = $"/a/{Administratie}/documenten/{Document}?beeld=1";
        if (Diensten.GetService<IDocumentvenster>() is not null)
        {
            if (await Inkoop.Beeld(Wie, Administratie, Document) is not { } beeld)
            {
                return;
            }

            bron = new DotNetStreamReference(new MemoryStream(beeld));
        }

        koppeling = await module.InvokeAsync<IJSObjectReference>("bekijk", viewer, bron, Document.ToString());
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (koppeling is not null)
            {
                await koppeling.InvokeVoidAsync("sluit");
                await koppeling.DisposeAsync();
            }

            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Het circuit is al weg.
        }
    }
}
