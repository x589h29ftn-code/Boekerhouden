@* Downloaden (Excel, PDF, auditfile) achter één knop met een menu, zoals Nieuw in het memoriaal: de kop van een
   overzicht blijft rustig. Op elk scherm op dezelfde plek: als laatste in de kop. Is er maar één keuze, dan is het een
   gewone knop met die naam (geen menu met één regel). *@

@if (Keuzes.Count == 1)
{
    <button type="button" class="btn btn-sm btn-outline-secondary downloadknop" disabled="@Bezig" title="@Keuzes[0].Titel" @onclick="() => Kies(Keuzes[0])">@Keuzes[0].Naam</button>
    return;
}

<span class="knopmenu downloadmenu">
    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@Bezig" aria-haspopup="menu" aria-expanded="@(open ? "true" : "false")"
            @onclick="() => open = !open">Downloaden <Icoon Naam="chevron-down" /></button>
    @if (open)
    {
        <span class="menu" role="menu">
            @foreach (var keuze in Keuzes)
            {
                <button type="button" role="menuitem" title="@keuze.Titel" @onclick="() => Kies(keuze)">@keuze.Naam</button>
            }
        </span>
    }
</span>

@code {
    private bool open;

    /// <summary>Wat er te downloaden is: de naam in het menu, de uitleg in de tooltip, en wat er gebeurt.</summary>
    public sealed record Keuze(string Naam, string Titel, Func<Task> Actie);

    [Parameter, EditorRequired]
    public IReadOnlyList<Keuze> Keuzes { get; set; } = [];

    [Parameter]
    public bool Bezig { get; set; }

    private async Task Kies(Keuze keuze)
    {
        open = false;
        await keuze.Actie();
    }
}
