@page "/inloggen"
@attribute [AllowAnonymous]
@inject SignInManager<Gebruiker> SignIn
@inject UserManager<Gebruiker> Gebruikers
@inject GebruikerDienst GebruikerDienst
@inject AuditDienst Audit
@inject Doorverwijzer Doorverwijzer
@inject NavigationManager Navigatie

<PageTitle>Inloggen – Administratie</PageTitle>

<h1 class="h5 mb-3">Inloggen</h1>
<Foutmeldingen Fouten="fouten" />
<EditForm Model="Invoer" method="post" OnSubmit="LogIn" FormName="inloggen">
    <div class="mb-3">
        <label for="email" class="form-label">E-mailadres</label>
        <InputText id="email" @bind-Value="Invoer.Email" class="form-control" autocomplete="username" autofocus />
    </div>
    <div class="mb-3">
        <label for="wachtwoord" class="form-label">Wachtwoord</label>
        <InputText id="wachtwoord" type="password" @bind-Value="Invoer.Wachtwoord" class="form-control" autocomplete="current-password" />
    </div>
    <button type="submit" class="btn btn-primary w-100">Inloggen</button>
</EditForm>
<p class="text-secondary small mt-3 mb-0">Wachtwoord vergeten? Vraag de beheerder om een nieuw tijdelijk wachtwoord.</p>

@code {
    private IReadOnlyList<string>? fouten;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InlogInvoer Invoer { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string? TerugNaar { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Invoer ??= new();
        if (HttpMethods.IsGet(HttpContext.Request.Method) && await GebruikerDienst.EersteBeheerderNodig())
        {
            Navigatie.NavigateTo("/eerste-gebruiker");
        }
    }

    private async Task LogIn()
    {
        var email = Invoer.Email.Trim();
        if (email.Length == 0 || Invoer.Wachtwoord.Length == 0)
        {
            fouten = ["Vul je e-mailadres en wachtwoord in."];
            return;
        }

        var gebruiker = await Gebruikers.FindByEmailAsync(email);
        var resultaat = gebruiker is null
            ? Microsoft.AspNetCore.Identity.SignInResult.Failed
            : await SignIn.PasswordSignInAsync(gebruiker, Invoer.Wachtwoord, isPersistent: false, lockoutOnFailure: true);
        var wie = gebruiker is null ? new Uitvoerder(null, email) : new Uitvoerder(gebruiker.Id, gebruiker.Naam);

        if (resultaat.Succeeded)
        {
            await Audit.Log(wie, AuditActies.Ingelogd);
            if (gebruiker!.MoetWachtwoordWijzigen)
            {
                Navigatie.NavigateTo(WachtwoordWijzigenVerplicht.Pad);
                return;
            }

            Doorverwijzer.NaarLokaal(TerugNaar);
        }
        else if (resultaat.IsLockedOut)
        {
            await Audit.Log(wie, AuditActies.AccountGeblokkeerd);
            Navigatie.NavigateTo("/geblokkeerd");
        }
        else
        {
            await Audit.Log(wie, AuditActies.InloggenMislukt);
            fouten = ["Onjuist e-mailadres of wachtwoord. Na 5 mislukte pogingen wordt het account 15 minuten geblokkeerd."];
        }
    }

    private sealed class InlogInvoer
    {
        public string Email { get; set; } = "";

        public string Wachtwoord { get; set; } = "";
    }
}
