    private async Task Upload(StapInfo s, InputFileChangeEventArgs e)
    {
        var bestand = e.File;
        if (bestand.Size > BijlageDienst.MaximaleGrootte)
        {
            Meld(Uitkomst.Mislukt($"'{bestand.Name}' is te groot (hoogstens {BijlageDienst.MaximaleGrootte / 1024 / 1024} MB)."), string.Empty);
            return;
        }

        await using var stroom = bestand.OpenReadStream(BijlageDienst.MaximaleGrootte);
        Meld(await BijlageDienst.VoegToe(s.Id, bestand.Name, bestand.ContentType, stroom, await Wie()), $"Bijlage '{bestand.Name}' toegevoegd");
        await Laad();
    }

    private async Task VerwijderBijlage(BijlageInfo b)
    {
        Meld(await BijlageDienst.Verwijder(b.Id, await Wie()), $"Bijlage '{b.Bestandsnaam}' verwijderd");
        await Laad();
    }

    private static string Aantal(int aantal, string enkelvoud, string meervoud) => $"{aantal} {(aantal == 1 ? enkelvoud : meervoud)}";

    private static string Grootte(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:0.0} MB"
        : bytes >= 1024 ? $"{bytes / 1024} kB"
        : $"{bytes} B";

    private void Meld(Uitkomst uitkomst, string gelukt)
    {
        melding = uitkomst.IsGelukt ? gelukt : string.Join(" ", uitkomst.Fouten);
        meldingIsFout = !uitkomst.IsGelukt;
    }

    private async Task<Uitvoerder> Wie() => (await Authenticatie).User.AlsUitvoerder();
}
