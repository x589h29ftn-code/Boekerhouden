@page "/dossiers/{Id:guid}/werkprogramma"
@using Boekerhouden.Domain.Rapport
@using Boekerhouden.Domain.Rubricering
@using Boekerhouden.Server.Components.Rapportweergave
@using Boekerhouden.Server.Export
@inject WerkprogrammaDienst WerkprogrammaDienst
@inject RubriceerDienst RubriceerDienst
@inject ReviewDienst ReviewDienst
@inject BijlageDienst BijlageDienst
@inject RapportDienst RapportDienst

<PageTitle>Werkprogramma @(w?.Dossier.Naam) – Boekerhouden</PageTitle>

@if (!geladen)
{
    <p class="text-secondary">Laden…</p>
}
else if (w is null)
{
    <div class="alert alert-warning">Dit dossier bestaat niet (meer). <a href="/">Terug naar de klanten</a></div>
}
else
{
    <nav aria-label="kruimelpad">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Klanten</a></li>
            <li class="breadcrumb-item"><a href="/klanten/@w.Dossier.KlantId">@w.Dossier.KlantNaam</a></li>
            <li class="breadcrumb-item"><a href="/dossiers/@w.Dossier.Id">@w.Dossier.Naam</a></li>
            <li class="breadcrumb-item active" aria-current="page">Werkprogramma</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center flex-wrap gap-3 mb-2">
        <h1 class="h3 mb-0 me-auto">Werkprogramma</h1>
        @if (melding is not null)
        {
            <span class="rubriceer-melding @(meldingIsFout ? "fout" : null)" role="status">
                @melding
                <button class="btn-close btn-sm ms-1" aria-label="Sluiten" @onclick="() => melding = null"></button>
            </span>
        }
        <span class="small text-secondary">@Weergave.Tekst(w.Dossier.Soort) · versie @w.Versie</span>
    </div>
    <DossierMenu DossierId="w.Dossier.Id" Actief="/werkprogramma" Post="@HuidigePost" />
    <HeadContent>
        <style>@((MarkupString)RapportHtml.Stijl)</style>
    </HeadContent>

    <div class="row g-3 werkprogramma">
        <div class="col-lg-3">
            <nav class="wp-boom" aria-label="Onderdelen">
                @foreach (var fase in Enum.GetValues<Fase>())
                {
                    <div class="boom-kop">@Weergave.Tekst(fase)</div>
                    @if (fase == Fase.Uitvoering)
                    {
                        @foreach (var (groep, posten) in PostGroepen)
                        {
                            <div class="wp-groep">@groep</div>
                            @foreach (var (hoofdpost, naam) in posten)
                            {
                                var od = UitvoeringVan(hoofdpost);
                                <button type="button" class="wp-onderdeel @(HuidigePost == hoofdpost ? "actief" : null)" @onclick="() => KiesPost(hoofdpost)" data-post="@hoofdpost" title="RGS @hoofdpost">
                                    <span class="titel">@naam</span>
                                    @if (od is { OpenPunten: > 0 })
                                    {
                                        <span class="status let-op" title="Open reviewpunten">@Aantal(od.OpenPunten, "punt", "punten")</span>
                                    }
                                    <span class="status" title="@(od is null ? null : $"{Weergave.Tekst(w.Keuzes.GetValueOrDefault(hoofdpost)?.Beoordeling ?? PostBeoordeling.Materieel)}: stappen gereed")">@(od is null ? null : (w.Keuzes.GetValueOrDefault(hoofdpost) is { Beoordeling: PostBeoordeling.Risicopost } ? "risico " : null) + (OnderdeelStatus(od) is { Length: > 0 } st ? st : "materieel"))</span>
                                </button>
                            }
                        }
                    }
                    @foreach (var od in w.Onderdelen.Where(x => x.Fase == fase && !(fase == Fase.Uitvoering && x.HoofdpostCode is { } c && HeeftSaldo(c))))
                    {
                        <button type="button" class="wp-onderdeel @(od.Id == Gekozen?.Id ? "actief" : null)" @onclick="() => Kies(od.Id)" data-onderdeel="@od.Titel">
                            <span class="titel">@od.Titel@(od.Verplicht ? " *" : null)</span>
                            @if (od.OpenPunten > 0)
                            {
                                <span class="status let-op" title="Open reviewpunten">@Aantal(od.OpenPunten, "punt", "punten")</span>
                            }
                            <span class="status">@OnderdeelStatus(od)</span>
                        </button>
                    }
                    @if (fase == Fase.Uitvoering && Hoofdposten.Count == 0 && !w.Onderdelen.Any(x => x.Fase == Fase.Uitvoering))
                    {
                        <div class="wp-leeg">Nog geen posten met saldo.</div>
                    }
                }
            </nav>
        </div>

        <div class="col-lg-9">
            @if (afmelden is not null)
            {
                <div class="bericht mb-2 d-flex flex-wrap align-items-center gap-2" id="afmelden">
                    <span class="me-auto">Bij @Naam(afmelden) zijn al stappen ingevuld. Wat moet er mee gebeuren?</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => Beoordeel(afmelden, PostBeoordeling.NietVanToepassing, true)">Bewaren als niet van toepassing</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => Beoordeel(afmelden, PostBeoordeling.NietVanToepassing, false)">Verwijderen</button>
                    <button class="btn btn-sm btn-link text-secondary" @onclick="() => afmelden = null">Annuleren</button>
                </div>
            }
            @if (gekozenPost is { } postZonderWerk && UitvoeringVan(postZonderWerk) is null)
            {
                <div class="card wp-inhoud" id="post-uitwerking">
                    <div class="card-header d-flex align-items-center gap-3">
                        <span class="fw-semibold me-auto" title="RGS @postZonderWerk">@Naam(postZonderWerk)</span>
                        @Beoordeling(postZonderWerk)
                    </div>
                    @Cijfers(postZonderWerk)
                    @InRapport(postZonderWerk)
                    @Grondslag(postZonderWerk)
                    @VorigeVolgende(postZonderWerk)
                </div>
            }
            else if (Gekozen is { } o)
            {
                <div class="card wp-inhoud">
                    <div class="card-header d-flex align-items-center gap-3">
                        <span class="fw-semibold me-auto">@o.Titel</span>
                        @if (o.Soort == OnderdeelSoort.Post && o.HoofdpostCode is { } beoordeeldePost)
                        {
                            @Beoordeling(beoordeeldePost)
                        }
                        @if (o.IsGereviewd)
                        {
                            <span class="small text-secondary" id="gereviewd">@(o.Soort == OnderdeelSoort.Doorlezen ? "geparafeerd" : "gereviewd") door @o.GereviewdDoor, @Weergave.DatumTijd(o.GereviewdOp!.Value)</span>
                            @if (o.Soort == OnderdeelSoort.Doorlezen ? isAccountant : isReviewer)
                            {
                                <button class="btn btn-sm btn-link text-secondary p-0" @onclick="() => ReviewTerug(o)">terugzetten</button>
                            }
                        }
                        else
                        {
                            <span class="small text-secondary">@OnderdeelStatus(o)</span>
                            @if (o.Soort == OnderdeelSoort.Doorlezen ? isAccountant : isReviewer)
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled="@(o.NietTeReviewen is not null)" title="@(o.NietTeReviewen ?? (o.Soort == OnderdeelSoort.Doorlezen ? "Paraaf van de accountant: het rapport is doorgelezen." : null))" @onclick="() => Reviewen(o)">@(o.Soort == OnderdeelSoort.Doorlezen ? "Paraaf" : "Gereviewd")</button>
                            }
                        }
                        @if (o.Stappen.Any(s => s.Verwijderd))
                        {
                            <span class="form-check form-switch mb-0 small">
                                <input class="form-check-input" type="checkbox" id="verwijderd" @bind="toonVerwijderd" />
                                <label class="form-check-label" for="verwijderd">verwijderde stappen</label>
                            </span>
                        }
                    </div>
                    @if (o.Soort == OnderdeelSoort.Post && o.HoofdpostCode is { } risicopost && w.Keuzes.GetValueOrDefault(risicopost) is { Beoordeling: PostBeoordeling.Risicopost } risicokeuze)
                    {
                        @Risico(risicopost, risicokeuze.Risico)
                    }

                    @if (o.Soort == OnderdeelSoort.Bespreking)
                    {
                        <Klantbespreking DossierId="@Id" Soort="@w.Dossier.Soort" Stand="@versie" OnMelding="m => Meld(m.Uitkomst, m.Gelukt)" />
                    }

                    @if (o.Soort == OnderdeelSoort.Doorlezen)
                    {
                        <Doorlezen DossierId="@Id" Stand="@versie" OnMelding="m => Meld(m.Uitkomst, m.Gelukt)" />
                    }

                    @if (o.Soort == OnderdeelSoort.MaterielePosten)
                    {
                        <div class="wp-sectie" id="materiele-posten">
                            <div class="wp-sectie-kop">
                                <span class="me-auto">Beoordeling posten</span>
                                <span class="small text-secondary" title="Risicogericht samenstellen: een materiële post is van belang voor het beeld van de jaarrekening, een risicopost is een post waar het mis kan gaan (bijv. waardering, volledigheid, schattingen). Beide krijgen het postprogramma.">Standaard n.v.t.; materiële posten en risicoposten krijgen werk.</span>
                            </div>
                            <div class="kolomkop mp-raster">
                                <span>Hoofdpost</span><span class="text-end">@w.Dossier.Boekjaar</span><span class="text-end">@(w.Dossier.Boekjaar - 1)</span>
                                <span class="text-center">n.v.t.</span><span class="text-center">materieel</span><span class="text-center">risicopost</span>
                            </div>
                            @foreach (var (hp, naam) in Hoofdposten)
                            {
                                var totaal = r!.Balans!.Totaal(hp);
                                var keuze = w.Keuzes.GetValueOrDefault(hp);
                                <div class="mp-raster mp-regel" data-post="@hp" @key="(hp, versie)">
                                    <span class="naam" @onclick="() => Wissel(hp)" title="RGS @hp">
                                        <span class="pijl" aria-hidden="true">@(open.Contains(hp) ? "▾" : "▸")</span>@naam
                                    </span>
                                    <span class="bedrag text-end">@Bedragen.Heel(totaal.Huidig)</span>
                                    <span class="bedrag text-end vorig">@Bedragen.Heel(totaal.Vorig)</span>
                                    @foreach (var b in Enum.GetValues<PostBeoordeling>())
                                    {
                                        <span class="text-center">
                                            <input type="radio" class="form-check-input" name="@($"beoordeling-{hp}")" checked="@((keuze?.Beoordeling ?? PostBeoordeling.NietVanToepassing) == b)"
                                                   aria-label="@($"{naam} {Weergave.Tekst(b)}")" @onchange="() => Beoordeel(hp, b, null)" />
                                        </span>
                                    }
                                </div>
                                @if (keuze is { Beoordeling: PostBeoordeling.Risicopost })
                                {
                                    @Risico(hp, keuze.Risico)
                                }
                                @if (open.Contains(hp))
                                {
                                    @foreach (var sub in Subposten(hp))
                                    {
                                        var t = r.Balans.Totaal(sub.Code);
                                        <div class="mp-raster mp-sub" @key="(sub.Code, versie)">
                                            <span class="naam" title="RGS @sub.Code">@r.Naam(sub.Code)</span>
                                            <span class="bedrag text-end">@Bedragen.Heel(t.Huidig)</span>
                                            <span class="bedrag text-end vorig">@Bedragen.Heel(t.Vorig)</span>
                                            <span></span><span></span><span></span>
                                        </div>
                                    }
                                }
                            }
                            @if (Hoofdposten.Count == 0)
                            {
                                <p class="text-secondary small m-3">Nog geen hoofdposten met saldo. Lees een saldibalans in en rubriceer de rekeningen.</p>
                            }
                        </div>
                        <Notitie Label="Toelichting op de beoordeling (optioneel)" Tekst="@o.Notitie" OnBewaar="t => BewaarNotitie(o, t)" />
                    }

                    @if (o.Soort == OnderdeelSoort.Post && o.HoofdpostCode is { } postCode && r?.Balans is not null)
                    {
                        @Cijfers(postCode)
                        <Notitie Label="Cijferbeoordeling" Tekst="@o.Notitie" OnBewaar="t => BewaarNotitie(o, t)" />
                    }

                    <div class="wp-sectie" id="stappen">
                        <div class="wp-sectie-kop"><span class="me-auto">Stappen</span></div>
                        @foreach (var s in o.Stappen.Where(s => toonVerwijderd || !s.Verwijderd))
                        {
                            var isOpen = openStap == s.Id;
                            <div class="wp-stap @(s.Verwijderd ? "verwijderd" : null) @(isOpen ? "open" : null)" data-stap="@s.Titel" @key="(s.Id, versie)">
                                <div class="wp-stap-regel">
                                    <input type="checkbox" class="form-check-input" checked="@(s.Status == StapStatus.Gereed)" disabled="@(s.Verwijderd || s.Status == StapStatus.NietVanToepassing || o.IsGereviewd)"
                                           aria-label="@s.Titel gereed" title="Aftekenen" @onchange="e => ZetStatus(s, (bool)e.Value! ? StapStatus.Gereed : StapStatus.Open, null)" />
                                    <span class="titel" @onclick="() => openStap = isOpen ? null : s.Id" title="@s.Instructie">
                                        @s.Titel@(s.Verplicht ? " *" : null)
                                        @if (s.Eigen)
                                        {
                                            <span class="status ms-1">eigen</span>
                                        }
                                        @if (s.Bijlagen.Count > 0)
                                        {
                                            <span class="status ms-2">@Aantal(s.Bijlagen.Count, "bijlage", "bijlagen")</span>
                                        }
                                        @if (o.Reviewpunten.Count(p => p.StapId == s.Id && !p.Opgelost) is > 0 and var punten)
                                        {
                                            <span class="status let-op ms-2">@Aantal(punten, "punt", "punten")</span>
                                        }
                                    </span>
                                    <span class="status">@StapTekst(s)</span>
                                    <span class="acties">
                                        @if (o.IsGereviewd)
                                        {
                                        }
                                        else if (!s.Verwijderd)
                                        {
                                            <button class="btn btn-sm btn-link" title="Omhoog" @onclick="() => Verplaats(s, -1)">↑</button>
                                            <button class="btn btn-sm btn-link" title="Omlaag" @onclick="() => Verplaats(s, 1)">↓</button>
                                            @if (!s.Verplicht)
                                            {
                                                <button class="btn btn-sm btn-link" title="Verwijderen" @onclick="() => BeginVerwijderen(s)">✕</button>
                                            }
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-link" @onclick="() => Herstel(s)">herstellen</button>
                                        }
                                    </span>
                                </div>
                                @if (verwijderStap == s.Id)
                                {
                                    <form class="wp-stap-detail d-flex gap-2" @onsubmit="() => Verwijder(s)" @onsubmit:preventDefault>
                                        <input class="form-control form-control-sm" placeholder="Reden (verplicht voor een standaardstap)" @bind="verwijderReden" aria-label="Reden verwijderen" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Verwijderen</button>
                                        <button type="button" class="btn btn-sm btn-link text-secondary" @onclick="() => verwijderStap = null">Annuleren</button>
                                    </form>
                                }
                                @if (isOpen)
                                {
                                    <div class="wp-stap-detail">
                                        @if (s.Instructie is not null)
                                        {
                                            <p class="instructie">@s.Instructie</p>
                                        }
                                        <textarea class="form-control form-control-sm" rows="3" placeholder="Antwoord of uitwerking" value="@s.Antwoord" disabled="@(s.Verwijderd || o.IsGereviewd)"
                                                  aria-label="Antwoord @s.Titel" @onchange="e => BewaarAntwoord(s, (string?)e.Value)"></textarea>
                                        <div class="bijlagen mt-2">
                                            @foreach (var b in s.Bijlagen)
                                            {
                                                <div class="bijlage" @key="b.Id">
                                                    <a href="/bijlagen/@b.Id" download title="@b.Door, @Weergave.DatumTijd(b.Op)">@b.Bestandsnaam</a>
                                                    <span class="status">@Grootte(b.Grootte)</span>
                                                    @if (!o.IsGereviewd)
                                                    {
                                                        <button class="btn btn-sm btn-link text-secondary p-0" title="Bijlage verwijderen" @onclick="() => VerwijderBijlage(b)">✕</button>
                                                    }
                                                </div>
                                            }
                                            @if (!s.Verwijderd && !o.IsGereviewd)
                                            {
                                                <label class="small text-secondary">
                                                    bijlage toevoegen
                                                    <InputFile class="form-control form-control-sm d-inline-block w-auto ms-1" OnChange="e => Upload(s, e)" aria-label="@($"Bijlage bij {s.Titel}")" />
                                                </label>
                                            }
                                        </div>
                                        @if (!s.Verwijderd && !o.IsGereviewd)
                                        {
                                            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                                @if (s.Status != StapStatus.Gereed)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ZetStatus(s, StapStatus.Gereed, null)">Aftekenen</button>
                                                }
                                                @if (s.Status != StapStatus.Open)
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ZetStatus(s, StapStatus.Open, null)">Weer openzetten</button>
                                                }
                                                @if (s.Status != StapStatus.NietVanToepassing)
                                                {
                                                    @if (nvtStap == s.Id)
                                                    {
                                                        <input class="form-control form-control-sm w-auto flex-grow-1" placeholder="Reden" @bind="nvtReden" aria-label="Reden niet van toepassing" />
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ZetStatus(s, StapStatus.NietVanToepassing, nvtReden)">Niet van toepassing</button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-link text-secondary" @onclick="() => { nvtStap = s.Id; nvtReden = string.Empty; }">niet van toepassing…</button>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (nieuweStap)
                        {
                            <form class="wp-stap-detail" @onsubmit="VoegStapToe" @onsubmit:preventDefault id="nieuwe-stap">
                                <input class="form-control form-control-sm mb-2" placeholder="Titel" @bind="nieuweTitel" aria-label="Titel nieuwe stap" autofocus />
                                <textarea class="form-control form-control-sm mb-2" rows="2" placeholder="Instructie (optioneel)" @bind="nieuweInstructie" aria-label="Instructie nieuwe stap"></textarea>
                                <button type="submit" class="btn btn-sm btn-primary">Toevoegen</button>
                                <button type="button" class="btn btn-sm btn-link text-secondary" @onclick="() => nieuweStap = false">Annuleren</button>
                            </form>
                        }
                        else if (!o.IsGereviewd)
                        {
                            <div class="p-2"><button class="btn btn-sm btn-link p-0" @onclick="() => { nieuweStap = true; nieuweTitel = string.Empty; nieuweInstructie = null; }">+ stap</button></div>
                        }
                    </div>

                    <div class="wp-sectie" id="reviewpunten">
                        <div class="wp-sectie-kop"><span class="me-auto">Reviewpunten</span></div>
                        @foreach (var p in o.Reviewpunten.OrderBy(p => p.Opgelost).ThenBy(p => p.Op))
                        {
                            <div class="reviewpunt @(p.Opgelost ? "opgelost" : null)" @key="(p.Id, versie)">
                                <div class="d-flex gap-2 align-items-baseline">
                                    <span class="me-auto">
                                        @if (p.StapId is { } stapId && o.Stappen.FirstOrDefault(x => x.Id == stapId) is { } bij)
                                        {
                                            <span class="status me-1">@bij.Titel:</span>
                                        }
                                        @p.Tekst
                                    </span>
                                    <span class="status">@p.Door, @Weergave.Datum(p.Op)</span>
                                </div>
                                @if (p.Opgelost)
                                {
                                    <div class="small text-secondary">
                                        @($"opgelost door {p.OpgelostDoor}{(p.Reactie is null ? null : ": " + p.Reactie)}")
                                        <button class="btn btn-sm btn-link text-secondary p-0 ms-1" @onclick="() => Heropen(p)">heropenen</button>
                                    </div>
                                }
                                else if (oplossen == p.Id)
                                {
                                    <form class="d-flex gap-2 mt-1" @onsubmit="() => LosOp(p)" @onsubmit:preventDefault>
                                        <input class="form-control form-control-sm" placeholder="Reactie (optioneel)" @bind="reactie" aria-label="Reactie op reviewpunt" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Opgelost</button>
                                        <button type="button" class="btn btn-sm btn-link text-secondary" @onclick="() => oplossen = null">Annuleren</button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-link p-0" @onclick="() => { oplossen = p.Id; reactie = null; }">oplossen…</button>
                                }
                            </div>
                        }
                        <form class="d-flex gap-2 p-2" @onsubmit="() => PlaatsPunt(o)" @onsubmit:preventDefault>
                            <select class="form-select form-select-sm w-auto" @bind="puntStap" aria-label="Reviewpunt bij stap">
                                <option value="">hele onderdeel</option>
                                @foreach (var s in o.Actief)
                                {
                                    <option value="@s.Id">@s.Titel</option>
                                }
                            </select>
                            <input class="form-control form-control-sm" placeholder="Nieuw reviewpunt" @bind="puntTekst" aria-label="Nieuw reviewpunt" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">Plaatsen</button>
                        </form>
                    </div>
                    @if (o.Soort == OnderdeelSoort.Post && o.HoofdpostCode is { } rapportpost)
                    {
                        @InRapport(rapportpost)
                        @Grondslag(rapportpost)
                    }
                    @if (o.Fase == Fase.Uitvoering && o.HoofdpostCode is { } huidig && HeeftSaldo(huidig))
                    {
                        @VorigeVolgende(huidig)
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private bool geladen;
    private int versie;
    private WerkprogrammaOverzicht? w;
    private RubriceerOverzicht? r;
    private Guid? gekozenId;
    private string? gekozenPost;
    private RapportInhoud? rapportInhoud;
    private Guid? openStap;
    private Guid? nvtStap;
    private string nvtReden = string.Empty;
    private Guid? verwijderStap;
    private string? verwijderReden;
    private bool toonVerwijderd;
    private bool nieuweStap;
    private string nieuweTitel = string.Empty;
    private string? nieuweInstructie;
    private string? afmelden;
    private string? melding;
    private bool meldingIsFout;
    private bool isReviewer;
    private bool isAccountant;
    private Guid? oplossen;
    private string? reactie;
    private string? puntTekst;
    private Guid? puntStap;
    private readonly HashSet<string> open = new(StringComparer.Ordinal);

    [Parameter]
    public Guid Id { get; set; }

    /// <summary>Het onderdeel dat bij het openen gekozen is (?onderdeel=…).</summary>
    [SupplyParameterFromQuery(Name = "onderdeel")]
    public Guid? OnderdeelBijStart { get; set; }

    /// <summary>De hoofdpost die bij het openen gekozen is (?post=BMva), bijv. vanuit het rapport.</summary>
    [SupplyParameterFromQuery(Name = "post")]
    public string? PostBijStart { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> Authenticatie { get; set; } = default!;

    private OnderdeelInfo? Gekozen => gekozenPost is { } post ? UitvoeringVan(post)
        : w?.Onderdelen.FirstOrDefault(o => o.Id == gekozenId) ?? w?.Onderdelen.FirstOrDefault();

    /// <summary>De hoofdpost waar je bent; de tabbladen Rapport en Proefbalans openen op dezelfde post.</summary>
    private string? HuidigePost => gekozenPost ?? Gekozen?.HoofdpostCode;

    protected override async Task OnParametersSetAsync()
    {
        var gebruiker = (await Authenticatie).User;
        isAccountant = gebruiker.IsInRole(Rollen.Accountant);
        isReviewer = gebruiker.IsInRole(Rollen.Reviewer) || isAccountant;
        gekozenId = OnderdeelBijStart;
        gekozenPost = PostBijStart;
        await Laad();
        geladen = true;
    }

    private async Task Laad()
    {
        // Nieuwe sleutels na elke keer laden: een vinkje toont dan altijd de opgeslagen stand, ook als de dienst een
        // wijziging weigerde (Blazor weet niet dat de gebruiker het vinkje in de browser al had omgezet).
        versie++;
        w = await WerkprogrammaDienst.Overzicht(Id, await Wie());
        r = await RubriceerDienst.Overzicht(Id, metVoorstellen: false);
        rapportInhoud = (await RapportDienst.Maak(Id))?.Waarde;
    }

    /// <summary>De hoofdposten met saldo in de volgorde van de jaarrekening: activa, passiva (creditposten van de balans) en winst-en-verliesrekening.</summary>
    private IEnumerable<(string Groep, List<(string Code, string Naam)> Posten)> PostGroepen
    {
        get
        {
            bool Credit(string code) => r?.Schema?.Zoek(code)?.Kant == Boekerhouden.Domain.Rgs.Saldokant.Credit;
            return new (string Groep, Func<string, bool> Hoort)[]
                {
                    ("Activa", c => c[0] == 'B' && !Credit(c)),
                    ("Passiva", c => c[0] == 'B' && Credit(c)),
                    ("Winst-en-verliesrekening", c => c[0] == 'W'),
                }
                .Select(g => (g.Groep, Hoofdposten.Where(p => g.Hoort(p.Code)).ToList()))
                .Where(g => g.Item2.Count > 0);
        }
    }

    private bool HeeftSaldo(string code) => Hoofdposten.Any(p => p.Code == code);

    /// <summary>Het onderdeel met de stappen van een materiële post; null bij een post zonder werkprogramma.</summary>
    private OnderdeelInfo? UitvoeringVan(string code) => w?.Onderdelen.FirstOrDefault(o => o.Fase == Fase.Uitvoering && o.HoofdpostCode == code);

    private IReadOnlyList<(string Code, string Naam)> Hoofdposten =>
        r is { Schema: { } schema, Balans: { } balans }
            ? [.. schema.Hoofdposten.Where(p => balans.Totaal(p.Code) is { Aantal: > 0 } t && (t.Huidig != 0 || t.Vorig != 0)).Select(p => (p.Code, r.Naam(p.Code)))]
            : [];

    private string Naam(string code) => r?.Naam(code) ?? code;

    private IEnumerable<Boekerhouden.Domain.Rgs.RgsCode> Subposten(string code) =>
        r?.Schema?.Kinderen(code).Where(c => c.Niveau == 3 && r.Balans!.Totaal(c.Code) is { Aantal: > 0 } t && (t.Huidig != 0 || t.Vorig != 0)) ?? [];

    /// <summary>De rekeningen die (na omslag) op deze subpost, een grootboekcode of een eigen post eronder staan.</summary>
    private IEnumerable<RubriceerRekening> RekeningenOnder(string subpost)
    {
        var plaatsing = r!.Balans!.Plaatsing;
        return r.Rekeningen
            .Where(x => x.HeeftSaldo && plaatsing.TryGetValue(x.Id, out var p) && OnderSubpost(p, subpost))
            .OrderBy(x => x.Nummer, StringComparer.Ordinal);
    }

    private bool OnderSubpost(string sleutel, string subpost)
    {
        var code = sleutel.StartsWith(PostBalans.EigenVoorvoegsel, StringComparison.Ordinal)
            ? r!.EigenPosten.FirstOrDefault(e => PostBalans.EigenSleutel(e.Id) == sleutel)?.OuderCode
            : sleutel;
        return code == subpost || (code is not null && r!.Schema!.Zoek(code) is { Niveau: 4 } c && c.Ouder == subpost);
    }

    /// <summary>De cijfers van een hoofdpost: subposten met dit jaar, vorig jaar en verschil, open te klappen tot de rekeningen.</summary>
    private RenderFragment Cijfers(string postCode) => __builder =>
    {
        var totaal = r!.Balans!.Totaal(postCode);
        var boekjaar = w!.Dossier.Boekjaar;
        <div class="wp-sectie" id="cijfers">
            <div class="wp-sectie-kop">
                <span class="me-auto">Cijfers</span>
                @if (UitvoeringVan(postCode) is not null && w.Keuzes.GetValueOrDefault(postCode) is not { MetWerk: true })
                {
                    <span class="status let-op">niet meer materieel of risicopost; stappen bewaard</span>
                }
                <a class="small" href="/dossiers/@Id/proefbalans?open=@postCode">naar de proefbalans</a>
            </div>
            <div class="kolomkop pb-raster" style="--kolommen:3">
                <span>Post</span><span class="text-end">@boekjaar</span><span class="text-end">@(boekjaar - 1)</span><span class="text-end">Verschil</span><span></span>
            </div>
            <div class="pb-raster pb-post niveau-2" style="--kolommen:3">
                <span class="naam">@r.Naam(postCode)</span>
                <span class="bedrag text-end">@Bedragen.Heel(totaal.Huidig)</span>
                <span class="bedrag text-end">@Bedragen.Heel(totaal.Vorig)</span>
                <span class="bedrag text-end">@Bedragen.Heel(totaal.Verschil)</span>
                <span></span>
            </div>
            @foreach (var sub in Subposten(postCode))
            {
                var t = r.Balans.Totaal(sub.Code);
                <div class="pb-raster pb-post" style="--kolommen:3;--diepte:1">
                    <span class="naam" @onclick="() => Wissel(sub.Code)">
                        <span class="pijl" aria-hidden="true">@(open.Contains(sub.Code) ? "▾" : "▸")</span>@r.Naam(sub.Code)
                    </span>
                    <span class="bedrag text-end">@Bedragen.Heel(t.Huidig)</span>
                    <span class="bedrag text-end vorig">@Bedragen.Heel(t.Vorig)</span>
                    <span class="bedrag text-end">@(t.Verschil != 0 ? Bedragen.Heel(t.Verschil) : "")</span>
                    <span></span>
                </div>
                @if (open.Contains(sub.Code))
                {
                    @foreach (var rek in RekeningenOnder(sub.Code))
                    {
                        <div class="pb-raster pb-rekening" style="--kolommen:3;--diepte:2">
                            <span class="naam"><span class="nr">@rek.Nummer</span> @rek.Omschrijving</span>
                            <span class="bedrag text-end"><Bedrag Waarde="rek.Saldo" /></span>
                            <span class="bedrag text-end vorig"><Bedrag Waarde="rek.SaldoVorig" /></span>
                            <span class="bedrag text-end">@(((rek.Saldo ?? 0) - (rek.SaldoVorig ?? 0)) is var v && v != 0 ? Bedragen.Heel(v) : "")</span>
                            <span></span>
                        </div>
                    }
                }
            }
        </div>
    };

    private static string OnderdeelStatus(OnderdeelInfo o) =>
        o.GereviewdDoor is not null ? (o.Soort == OnderdeelSoort.Doorlezen ? "geparafeerd" : "gereviewd")
        : o.Aantal == 0 ? ""
        : o.IsGereed ? "gereed"
        : $"{o.Klaar}/{o.Aantal}";

    private static string StapTekst(StapInfo s) => s switch
    {
        { Verwijderd: true } => $"verwijderd door {s.VerwijderdDoor}: {s.Reden}",
        { Status: StapStatus.Gereed } => $"{s.UitgevoerdDoor} · {(s.UitgevoerdOp is { } op ? Weergave.Datum(op) : null)}",
        { Status: StapStatus.NietVanToepassing } => $"n.v.t.: {s.Reden}",
        { OvergenomenVan: { } jaar } => $"overgenomen uit {jaar}, nog bijwerken",
        _ => string.IsNullOrEmpty(s.Antwoord) ? "" : "ingevuld",
    };

    private void Kies(Guid onderdeelId)
    {
        gekozenId = onderdeelId;
        gekozenPost = null;
        openStap = null;
        nieuweStap = false;
        verwijderStap = null;
        afmelden = null;
    }

    private void KiesPost(string code)
    {
        Kies(Guid.Empty);
        gekozenPost = code;
    }

    /// <summary>
    /// De post zoals in het rapport: specificatie, toelichting, verloop en grondslagen, met dezelfde bewerkingen als in
    /// de rapportviewer (uitsplitsen, toelichten, verloop, grondslagen). Wat hier verandert, staat zo in het rapport.
    /// </summary>
    private RenderFragment InRapport(string code) => __builder =>
    {
        if (rapportInhoud is null)
        {
            return;
        }

        var p = RapportPerPost.Bij(rapportInhoud.Rapport, code);
        var specificatie = rapportInhoud.Rapport.Hoofdstukken.SelectMany(h => h.Blokken).OfType<TabelBlok>().Any(t => t.Tabel.Code == code);
        <div class="wp-sectie" id="in-rapport">
            <div class="wp-sectie-kop">
                <span class="me-auto">In het rapport</span>
                <span class="form-check form-switch mb-0 small" title="Of de specificatie van deze post in het rapport staat. Geldt voor de klant, ook volgende jaren.">
                    <input class="form-check-input" type="checkbox" id="specificatie" checked="@specificatie" @key="(code, versie)"
                           @onchange="e => ZetSpecificatie(code, (bool)e.Value!)" />
                    <label class="form-check-label" for="specificatie">specificatie</label>
                </span>
                <a class="small" href="/dossiers/@Id/rapport#@RapportHtml.Anker(code)">naar het rapport</a>
            </div>
            <div class="wp-rapportfragment">
                <RapportDocument Inhoud="rapportInhoud" Post="@(code)" Deel="PostDeel.Rapportage" Bewerkbaar="true" Gewijzigd="NaRapportWijziging" Wie="Wie" @key="(code, versie)" />
                @if (p.Titel is null && p.Verlopen.Count == 0)
                {
                    <div class="status">Deze post staat niet in het rapport. Zet de specificatie aan om hem te tonen en toe te lichten.</div>
                }
            </div>
        </div>
    };

    /// <summary>
    /// Tot slot de grondslag van de post, zoals in de algemene toelichting van de jaarrekening: aan of uit en de tekst
    /// aan te passen (vanaf dit jaar).
    /// </summary>
    private RenderFragment Grondslag(string code) => __builder =>
    {
        if (rapportInhoud is not { Rapport.Soort: RapportSoort.Jaarrekening })
        {
            return;
        }

        var heeft = rapportInhoud.Rapport.Hoofdstukken.SelectMany(h => h.Blokken).OfType<GrondslagBlok>()
            .Any(g => g.Codes.Any(c => c.StartsWith(code, StringComparison.Ordinal)));
        var hoofdstuk = rapportInhoud.Rapport.Hoofdstukken.FirstOrDefault(h => h.Blokken.Any(b => b is GrondslagBlok));
        <div class="wp-sectie" id="grondslag">
            <div class="wp-sectie-kop">
                <span class="me-auto">Grondslag</span>
                @if (hoofdstuk is not null)
                {
                    <a class="small" href="/dossiers/@Id/rapport#@RapportHtml.Anker(hoofdstuk)">naar de algemene toelichting</a>
                }
            </div>
            <div class="wp-rapportfragment">
                @if (heeft)
                {
                    <RapportDocument Inhoud="rapportInhoud" Post="@(code)" Deel="PostDeel.Grondslagen" Bewerkbaar="true" Gewijzigd="NaRapportWijziging" Wie="Wie" @key="(code, versie, 2)" />
                }
                else
                {
                    <div class="status">Er is geen grondslag die bij deze post hoort; de algemene grondslagen staan in de algemene toelichting.</div>
                }
            </div>
        </div>
    };

    private async Task ZetSpecificatie(string code, bool tonen)
    {
        Meld(await RapportDienst.ZetSpecificatie(Id, code, tonen, await Wie()), $"Specificatie {Naam(code)} {(tonen ? "wel" : "niet")} in het rapport");
        await Laad();
    }

    /// <summary>Na een wijziging in het rapportdeel: de melding tonen en alles opnieuw laden.</summary>
    private async Task NaRapportWijziging((Uitkomst Uitkomst, string? Melding) wijziging)
    {
        if (wijziging.Melding is not null || !wijziging.Uitkomst.IsGelukt)
        {
            Meld(wijziging.Uitkomst, wijziging.Melding ?? string.Empty);
        }

        await Laad();
    }

    /// <summary>Naar de vorige of volgende post, zodat je het hele rapport doorloopt.</summary>
    private RenderFragment VorigeVolgende(string code) => __builder =>
    {
        var posten = Hoofdposten.Select(p => p.Code).ToList();
        var i = posten.IndexOf(code);
        if (i < 0)
        {
            return;
        }

        <div class="wp-volgende">
            @if (i > 0)
            {
                var vorige = posten[i - 1];
                <button type="button" class="btn btn-sm btn-link" @onclick="() => KiesPost(vorige)">‹ @Naam(vorige)</button>
            }
            <span class="me-auto"></span>
            @if (i < posten.Count - 1)
            {
                var volgende = posten[i + 1];
                <button type="button" class="btn btn-sm btn-link" @onclick="() => KiesPost(volgende)">@Naam(volgende) ›</button>
            }
        </div>
    };

    private void Wissel(string code)
    {
        if (!open.Remove(code))
        {
            open.Add(code);
        }
    }

    private async Task Beoordeel(string code, PostBeoordeling beoordeling, bool? bewaren)
    {
        var uitkomst = await WerkprogrammaDienst.Beoordeel(Id, code, beoordeling, bewaren, await Wie());
        if (!uitkomst.IsGelukt && uitkomst.Fouten[0] == WerkprogrammaDienst.BewarenOfVerwijderen)
        {
            afmelden = code;
            await Laad();
            return;
        }

        afmelden = null;
        Meld(uitkomst, beoordeling == PostBeoordeling.NietVanToepassing
            ? $"{Naam(code)}: n.v.t."
            : $"{Naam(code)} is {Weergave.Tekst(beoordeling)}; het werkprogramma staat bij Uitvoering");
        await Laad();
    }

    private async Task BewaarRisico(string code, string? risico)
    {
        var uitkomst = await WerkprogrammaDienst.ZetRisico(Id, code, risico, await Wie());
        if (!uitkomst.IsGelukt)
        {
            Meld(uitkomst, string.Empty);
        }

        await Laad();
    }

    /// <summary>De drie bolletjes n.v.t. / materieel / risicopost bij een post (in de kop van de post).</summary>
    private RenderFragment Beoordeling(string code) => __builder =>
    {
        var huidig = w!.Keuzes.GetValueOrDefault(code)?.Beoordeling ?? PostBeoordeling.NietVanToepassing;
        <span class="beoordeling small" role="radiogroup" aria-label="Beoordeling" title="Materiële posten en risicoposten krijgen het postprogramma: stappen, bijlagen en reviewpunten.">
            @foreach (var b in Enum.GetValues<PostBeoordeling>())
            {
                var id = $"beoordeling-{code}-{b}";
                <span class="form-check form-check-inline mb-0 me-2">
                    <input class="form-check-input" type="radio" id="@id" name="@($"beoordeling-kop-{code}")" checked="@(huidig == b)" @key="(code, b, versie)"
                           @onchange="() => Beoordeel(code, b, null)" />
                    <label class="form-check-label" for="@id">@Weergave.Tekst(b)</label>
                </span>
            }
        </span>
    };

    /// <summary>Bij een risicopost: wat er mis kan gaan, op één regel.</summary>
    private RenderFragment Risico(string code, string? risico) => __builder =>
    {
        <div class="wp-risico" @key="(code, versie, 3)">
            <label for="@($"risico-{code}")">Risico</label>
            <input id="@($"risico-{code}")" class="form-control form-control-sm" value="@risico" placeholder="bijv. onjuiste waardering, onvolledige opname, schatting"
                   aria-label="@($"Risico {Naam(code)}")" @onchange="e => BewaarRisico(code, (string?)e.Value)" />
        </div>
    };

