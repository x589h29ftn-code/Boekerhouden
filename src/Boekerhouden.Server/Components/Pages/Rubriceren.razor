@page "/dossiers/{Id:guid}/rubriceren"
@using Boekerhouden.Domain.Rgs
@using Boekerhouden.Domain.Rubricering
@inject RubriceerDienst RubriceerDienst

<PageTitle>Rubriceren @(o?.Dossier.Naam) – Boekerhouden</PageTitle>

@if (!geladen)
{
    <p class="text-secondary">Laden…</p>
}
else if (o is null)
{
    <div class="alert alert-warning">Dit dossier bestaat niet (meer). <a href="/">Terug naar de klanten</a></div>
}
else
{
    <nav aria-label="kruimelpad">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Klanten</a></li>
            <li class="breadcrumb-item"><a href="/klanten/@o.Dossier.KlantId">@o.Dossier.KlantNaam</a></li>
            <li class="breadcrumb-item"><a href="/dossiers/@o.Dossier.Id">@o.Dossier.Naam</a></li>
            <li class="breadcrumb-item active" aria-current="page">Rubriceren</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center flex-wrap gap-3 mb-3">
        <h1 class="h3 mb-0 me-auto">Rubriceren</h1>
        @if (melding is not null)
        {
            <span class="rubriceer-melding @(meldingIsFout ? "fout" : null)" role="status">
                @melding
                <button class="btn-close btn-sm ms-1" aria-label="Sluiten" @onclick="() => melding = null"></button>
            </span>
        }
        <div class="rubriceer-voortgang" title="@o.Gekoppeld van @o.Relevant rekeningen met saldo gekoppeld">
            <div class="progress" role="progressbar" aria-valuenow="@o.Percentage" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width:@(o.Percentage)%"></div>
            </div>
            <span class="small text-secondary">@o.Percentage% gekoppeld</span>
        </div>
    </div>
    <DossierMenu DossierId="o.Dossier.Id" Actief="/rubriceren" />

    @if (o.Schema is null)
    {
        <div class="alert alert-warning">
            Er is nog geen RGS-werkboek ingelezen, dus er zijn nog geen rubrieken.
            <AuthorizeView Roles="@Rollen.Beheerder">
                <Authorized>Lees het in via <a href="/beheer/rgs">Beheer › RGS</a>.</Authorized>
                <NotAuthorized>Vraag de beheerder om het in te lezen.</NotAuthorized>
            </AuthorizeView>
        </div>
    }
    else
    {
        <div class="row g-3 rubriceren">
            @* Links: de grootboekrekeningen *@
            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-header d-flex align-items-center gap-2">
                        <span class="fw-semibold me-auto">Grootboekrekeningen</span>
                        <select class="form-select form-select-sm w-auto" @bind="filterLinks" aria-label="Welke rekeningen">
                            <option value="open">Nog te koppelen</option>
                            <option value="alle">Alle</option>
                        </select>
                    </div>
                    <div class="werkbalk">
                        <input type="search" class="form-control form-control-sm" placeholder="Zoek nummer of omschrijving"
                               @bind="zoekLinks" @bind:event="oninput" aria-label="Zoek rekening" />
                        @if (AantalVoorstellen > 0)
                        {
                            <button class="btn btn-sm btn-outline-secondary text-nowrap" @onclick="AccepteerVoorstellen"
                                    title="Neem de voorgestelde post over voor @(geselecteerd.Count > 0 ? "de geselecteerde rekeningen" : "alle rekeningen met een voorstel")">
                                Voorstellen overnemen (@AantalVoorstellen)
                            </button>
                        }
                    </div>
                    <div class="kolomkop rek-raster">
                        <input type="checkbox" class="form-check-input" aria-label="Alles selecteren"
                               checked="@(ZichtbareRekeningen.Any() && ZichtbareRekeningen.All(r => geselecteerd.Contains(r.Id)))"
                               @onchange="e => SelecteerAlles((bool)e.Value!)" />
                        <span>Nr.</span>
                        <span title="Cursief met vraagteken is een voorstel; klik erop om het over te nemen">Omschrijving → post</span>
                        <span class="text-end">@o.Dossier.Boekjaar</span>
                    </div>
                    <div class="rekeningen-lijst">
                        @foreach (var r in ZichtbareRekeningen)
                        {
                            <div class="rek-regel rek-raster sleepbaar @(geselecteerd.Contains(r.Id) ? "geselecteerd" : null)" draggable="true"
                                 data-rekening="@r.Nummer" @ondragstart="() => BeginSlepen(r.Id)">
                                <input type="checkbox" class="form-check-input" checked="@geselecteerd.Contains(r.Id)"
                                       aria-label="Selecteer @r.Nummer" @onchange="e => Selecteer(r.Id, (bool)e.Value!)" />
                                <span class="nr">@r.Nummer</span>
                                <span class="oms">
                                    <span class="tekst" title="@r.Omschrijving">@r.Omschrijving</span>
                                    @if (r.Koppeling is { } k)
                                    {
                                        <span class="post" title="@Titel(k.Sleutel) · @BronTekst(k.Bron)">→ @KortLabel(k.Sleutel)</span>
                                    }
                                    else if (r.Voorstel is { } voorstel && o.Schema.Zoek(voorstel.Code) is not null)
                                    {
                                        <button type="button" class="post voorstel" title="Voorstel (@voorstel.Herkomst): @Titel(voorstel.Code). Klik om over te nemen."
                                                @onclick="() => KoppelVoorstel(r)">→ @KortLabel(voorstel.Code)?</button>
                                    }
                                </span>
                                <span class="bedrag text-end" title="@SaldoTitel(r)"><Bedrag Waarde="r.Saldo" /></span>
                            </div>
                        }
                        @if (!ZichtbareRekeningen.Any())
                        {
                            <p class="text-center text-secondary my-4">@(filterLinks == "open" ? "Alle rekeningen met saldo zijn gekoppeld." : "Geen rekeningen gevonden.")</p>
                        }
                    </div>
                    <div class="card-footer bg-white small text-secondary">
                        @if (geselecteerd.Count > 0)
                        {
                            <span class="text-body">@geselecteerd.Count geselecteerd</span>
                            <span> · </span>
                            <button class="btn btn-link btn-sm p-0 align-baseline" @onclick="Ontkoppel">ontkoppel</button>
                        }
                    </div>
                </div>
            </div>

            @* Rechts: de posten (RGS) *@
            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-header d-flex align-items-center gap-2">
                        <span class="fw-semibold me-auto">Posten <span class="text-secondary fw-normal small">RGS @o.Schema.Versie · @o.Selectie.Naam</span></span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClapIn">inklappen</button>
                    </div>
                    <div class="werkbalk">
                        <input type="search" class="form-control form-control-sm" placeholder="Zoek post"
                               @bind="zoekRechts" @bind:event="oninput" aria-label="Zoek post" />
                        <div class="form-check form-switch mb-0 small text-nowrap">
                            <input class="form-check-input" type="checkbox" id="metSaldo" @bind="alleenGevuld" />
                            <label class="form-check-label" for="metSaldo">alleen gevuld</label>
                        </div>
                        <div class="form-check form-switch mb-0 small text-nowrap" title="Toon onder de subposten ook de RGS-grootboekcodes (niveau 4)">
                            <input class="form-check-input" type="checkbox" id="niveau4" @bind="toonNiveau4" />
                            <label class="form-check-label" for="niveau4">grootboekcodes</label>
                        </div>
                    </div>
                    <div class="kolomkop boom-raster">
                        <span>
                            <AuthorizeView Roles="@Rollen.Beheerder">
                                <span class="form-check mb-0 d-inline-block" title="Dezelfde rekening bij andere klanten (zelfde nummer en vergelijkbare omschrijving) automatisch koppelen">
                                    <input class="form-check-input" type="checkbox" id="onthouden" @bind="onthouden" />
                                    <label class="form-check-label fw-normal" for="onthouden">onthouden in kantoorsjabloon</label>
                                </span>
                            </AuthorizeView>
                        </span>
                        <span class="text-end">@o.Dossier.Boekjaar</span>
                        <span class="text-end">@(o.Dossier.Boekjaar - 1)</span>
                    </div>
                    <div class="posten-boom">
                        @foreach (var regel in BoomRegels())
                        {
                            @switch (regel)
                            {
                                case KopRegel kop:
                                    <div class="boom-kop">@kop.Tekst</div>
                                    break;
                                case KnoopRegel kr:
                                    var k = kr.Knoop;
                                    var totaal = o.Balans!.Totaal(k.Sleutel);
                                    <div class="knoop boom-raster niveau-@k.Niveau @(KanKoppelen(k) ? "dropdoel" : null) @(k.EigenId is not null ? "eigen" : null)"
                                         style="--diepte:@kr.Diepte" data-sleutel="@k.Sleutel"
                                         @ondrop="() => Neerzetten(k)" @ondragenter="() => OpenBijSlepen(k)">
                                        @if (k.EigenId is { } salderenId && salderenPost == salderenId)
                                        {
                                            <form class="d-flex gap-1 align-items-center bewerk" @onsubmit="() => ZetSaldering(salderenId, salderenCode)" @onsubmit:preventDefault>
                                                <input class="form-control form-control-sm" @bind="salderenCode" aria-label="RGS-code voor een saldo aan de andere kant"
                                                       placeholder="RGS-code aan de andere kant, bijv. BVorVbkTvo" autofocus />
                                                <button type="submit" class="btn btn-sm btn-primary">Salderen</button>
                                                <button type="button" class="btn btn-sm btn-link" @onclick="() => salderenPost = null">Annuleren</button>
                                            </form>
                                        }
                                        else if (hernoemSleutel == k.Sleutel)
                                        {
                                            <form class="d-flex gap-1 align-items-center bewerk" @onsubmit="Hernoem" @onsubmit:preventDefault>
                                                <input class="form-control form-control-sm" @bind="hernoemNaam" aria-label="Nieuwe naam" autofocus
                                                       title="@($"Geldt vanaf {o.Dossier.Boekjaar}; eerdere jaren houden hun naam")" />
                                                @if (isBeheerder && k.EigenId is null)
                                                {
                                                    <label class="small text-nowrap"><input type="checkbox" class="form-check-input" @bind="hernoemKantoorbreed" /> alle klanten</label>
                                                }
                                                <button type="submit" class="btn btn-sm btn-primary">Opslaan</button>
                                                @if (k.EigenId is null && o.IsHernoemd(k.Code))
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Terug naar de RGS-omschrijving" @onclick="() => HernoemTerug(k)">Standaard</button>
                                                }
                                                <button type="button" class="btn btn-sm btn-link" @onclick="() => hernoemSleutel = null">Annuleren</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="naam" @onclick="() => Wissel(k.Sleutel)" title="@Titel(k.Sleutel)">
                                                <span class="pijl" aria-hidden="true">@(kr.KanOpen ? (kr.Open ? "▾" : "▸") : "")</span>
                                                @if (kr.MetPad)
                                                {
                                                    <span class="pad">@Pad(k) › </span>
                                                }
                                                @o.Naam(k.Sleutel)
                                                @if (k.EigenId is not null)
                                                {
                                                    <span class="eigen-label">eigen</span>
                                                    @if (Saldering(k) is { } omslag)
                                                    {
                                                        <span class="eigen-label" title="@($"De rekeningen tellen samen; staat het saldo aan de andere kant, dan staat de post onder {omslag} {o.Schema?.Zoek(omslag)?.Omschrijving}")">gesaldeerd</span>
                                                    }
                                                }
                                            </span>
                                            <span class="acties">
                                                @if (geselecteerd.Count > 0 && KanKoppelen(k))
                                                {
                                                    <button class="btn btn-sm btn-outline-primary py-0" title="Geselecteerde rekeningen hier koppelen" @onclick="() => KoppelSelectie(k)">hierheen</button>
                                                }
                                                <button class="btn btn-sm btn-link py-0" title="Hernoemen voor de jaarrekening" @onclick="() => BeginHernoemen(k)">✎</button>
                                                @if (k.EigenId is null && k.Niveau is 3 or 4)
                                                {
                                                    <button class="btn btn-sm btn-link py-0" title="Eigen post toevoegen onder deze post" @onclick="() => BeginNieuw(k)">＋</button>
                                                }
                                                @if (k.EigenId is { } eigenId)
                                                {
                                                    <button class="btn btn-sm btn-link py-0" title="@(Saldering(k) is null ? "Salderen: de rekeningen samen tellen, bijv. omzetbelasting die het ene jaar te betalen en het andere jaar te vorderen is" : "Niet meer salderen")"
                                                            @onclick="() => WisselSaldering(k, eigenId)">⇄</button>
                                                    <button class="btn btn-sm btn-link py-0" title="Eigen post verwijderen" @onclick="() => VerwijderEigen(eigenId)">✕</button>
                                                }
                                            </span>
                                            <span class="bedrag text-end">@(totaal.Aantal > 0 ? Bedragen.Heel(totaal.Huidig) : "")</span>
                                            <span class="bedrag text-end vorig">@(totaal.Aantal > 0 ? Bedragen.Heel(totaal.Vorig) : "")</span>
                                        }
                                    </div>
                                    break;
                                case NieuwRegel nr:
                                    <form class="knoop-nieuw d-flex gap-1" style="--diepte:@nr.Diepte" @onsubmit="VoegToe" @onsubmit:preventDefault>
                                        <input class="form-control form-control-sm" placeholder="Naam, bijv. @(o.Naam(nr.OuderCode)) 1" @bind="nieuweNaam" aria-label="Naam nieuwe post" autofocus />
                                        <button type="submit" class="btn btn-sm btn-primary">Toevoegen</button>
                                        <button type="button" class="btn btn-sm btn-link" @onclick="() => nieuwOnder = null">Annuleren</button>
                                    </form>
                                    break;
                                case RekeningRegel rr:
                                    var r = rr.Rekening;
                                    <div class="rekening-in-boom boom-raster sleepbaar" draggable="true" style="--diepte:@rr.Diepte" data-rekening="@r.Nummer"
                                         @ondragstart="() => BeginSlepen(r.Id)">
                                        <span class="naam" title="@r.Nummer @r.Omschrijving · @BronTekst(r.Koppeling!.Bron) · @Titel(r.Koppeling.Sleutel)">
                                            <span class="nr">@r.Nummer</span> @r.Omschrijving
                                        </span>
                                        <span class="acties">
                                            <button class="btn btn-sm btn-link py-0" title="Ontkoppelen" @onclick="() => OntkoppelEen(r.Id)">✕</button>
                                        </span>
                                        <span class="bedrag text-end"><Bedrag Waarde="r.Saldo" /></span>
                                        <span class="bedrag text-end vorig"><Bedrag Waarde="r.SaldoVorig" /></span>
                                    </div>
                                    break;
                            }
                        }

                        @if (Zoekresultaten is { Count: 0 })
                        {
                            <p class="text-center text-secondary my-4">Geen posten gevonden voor ‘@zoekRechts’.</p>
                        }
                    </div>
                    <div class="card-footer bg-white small">
                        <div class="d-flex flex-wrap gap-3 text-secondary">
                            <span title="Saldo van alle balansposten; na volledig koppelen gelijk aan het resultaat">Activa − passiva <span class="bedrag text-body">@Bedragen.Heel(o.Balans!.Balans.Huidig)</span></span>
                            <span>Resultaat <span class="bedrag text-body">@Bedragen.Heel(o.Balans.ResultaatHuidig)</span></span>
                            @if (o.Balans.Ongekoppeld.Aantal > 0)
                            {
                                <span>Ongekoppeld @o.Balans.Ongekoppeld.Aantal rekening(en), saldo <span class="bedrag text-body">@Bedragen.Heel(o.Balans.Ongekoppeld.Huidig)</span></span>
                            }
                            else if (o.Balans.Balans.Huidig == o.Balans.ResultaatHuidig)
                            {
                                <span class="ms-auto">✓ alles gekoppeld; de balans sluit op het resultaat</span>
                            }
                        </div>
                        @{
                            var signalen = o.Balans.Signalen.Where(s => s.Soort != SignaalSoort.Ongekoppeld).ToList();
                        }
                        @if (signalen.Count > 0)
                        {
                            <details class="mt-1">
                                <summary>@signalen.Count aandachtspunt(en)</summary>
                                @foreach (var signaal in signalen)
                                {
                                    <div class="text-secondary">@signaal.Tekst</div>
                                }
                            </details>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool geladen;
    private RubriceerOverzicht? o;
    private readonly HashSet<Guid> geselecteerd = [];
    private readonly HashSet<string> open = new(StringComparer.Ordinal);
    private List<Guid> gesleept = [];
    private string filterLinks = "open";
    private string? zoekLinks;
    private string? zoekRechts;
    private bool alleenGevuld;
    private bool toonNiveau4;
    private bool onthouden;
    private string? melding;
    private bool meldingIsFout;
    private string? hernoemSleutel;
    private string hernoemNaam = "";
    private bool hernoemKantoorbreed;
    private string? nieuwOnder;
    private string nieuweNaam = "";
    private Guid? salderenPost;
    private string salderenCode = "";
    private bool isBeheerder;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> Authenticatie { get; set; } = default!;

    /// <summary>Een post in de boom: een RGS-code of een eigen post (EigenId).</summary>
    private sealed record Knoop(string Sleutel, string Code, int Niveau, Guid? EigenId);

    private abstract record Regel;

    private sealed record KopRegel(string Tekst) : Regel;

    private sealed record KnoopRegel(Knoop Knoop, int Diepte, bool Open, bool KanOpen, bool MetPad) : Regel;

    private sealed record NieuwRegel(string OuderCode, int Diepte) : Regel;

    private sealed record RekeningRegel(RubriceerRekening Rekening, int Diepte) : Regel;

    protected override async Task OnParametersSetAsync()
    {
        isBeheerder = (await Authenticatie).User.IsInRole(Rollen.Beheerder);
        onthouden = isBeheerder;
        await Laad();
        geladen = true;
    }

    private async Task Laad()
    {
        o = await RubriceerDienst.Overzicht(Id);
        geselecteerd.IntersectWith(o?.Rekeningen.Select(r => r.Id) ?? []);
    }

    private IEnumerable<RubriceerRekening> ZichtbareRekeningen =>
        o is null ? [] : o.Rekeningen
            .Where(r => filterLinks == "alle" || (r.Koppeling is null && r.HeeftSaldo))
            .Where(r => string.IsNullOrWhiteSpace(zoekLinks)
                        || r.Nummer.Contains(zoekLinks.Trim(), StringComparison.OrdinalIgnoreCase)
                        || r.Omschrijving.Contains(zoekLinks.Trim(), StringComparison.OrdinalIgnoreCase));

    private int AantalVoorstellen => o?.Rekeningen.Count(r => r.Voorstel is not null && r.Koppeling is null
                                                              && (geselecteerd.Count == 0 || geselecteerd.Contains(r.Id))) ?? 0;

    /// <summary>
    /// De posten onder een post. Zonder "grootboekcodes" toont een subpost alleen zijn eigen posten (ook die onder een
    /// grootboekcode hangen); de RGS-grootboekcodes (niveau 4) zijn dan verborgen.
    /// </summary>
    private IEnumerable<Knoop> Kinderen(Knoop ouder)
    {
        if (o?.Schema is null || ouder.EigenId is not null)
        {
            return [];
        }

        var kinderen = new List<Knoop>();
        if (ouder.Niveau is 3 or 4)
        {
            var onder = ouder.Niveau == 3 && !toonNiveau4
                ? o.EigenPosten.Where(p => p.OuderCode == ouder.Code || o.Schema.Zoek(p.OuderCode)?.Ouder == ouder.Code)
                : o.EigenPosten.Where(p => p.OuderCode == ouder.Code);
            kinderen.AddRange(onder.Select(p => new Knoop(PostBalans.EigenSleutel(p.Id), p.OuderCode, ouder.Niveau + 1, p.Id)));
        }

        if (ouder.Niveau < 3 || (ouder.Niveau == 3 && toonNiveau4))
        {
            kinderen.AddRange(o.Schema.Kinderen(ouder.Code).Where(c => o.Codes.Contains(c.Code)).Select(c => new Knoop(c.Code, c.Code, c.Niveau, null)));
        }

        return kinderen.Where(k => !alleenGevuld || o.Balans!.Totaal(k.Sleutel).Aantal > 0);
    }

    /// <summary>De rekeningen die direct op een post staan; zonder grootboekcodes ook die op de codes eronder.</summary>
    private IEnumerable<RubriceerRekening> RekeningenOp(Knoop k) =>
        o?.Rekeningen.Where(r => r.Koppeling is { } kp
                                 && (kp.Sleutel == k.Sleutel
                                     || (k.Niveau == 3 && !toonNiveau4 && kp.EigenPostId is null && o.Schema!.Zoek(kp.Code)?.Ouder == k.Code))) ?? [];

    /// <summary>Korte naam voor de lijst links: de subpost (bij een grootboekcode de subpost erboven) of de eigen post.</summary>
    private string KortLabel(string sleutel)
    {
        if (o!.Schema!.Zoek(sleutel) is { Niveau: 4, Ouder: { } ouder })
        {
            return o.Naam(ouder);
        }

        return o.Naam(sleutel);
    }

    /// <summary>Het volledige pad met code, voor de tooltip.</summary>
    private string Titel(string sleutel)
    {
        var code = sleutel.StartsWith(PostBalans.EigenVoorvoegsel, StringComparison.Ordinal)
            ? o!.EigenPosten.FirstOrDefault(p => PostBalans.EigenSleutel(p.Id) == sleutel)?.OuderCode
            : sleutel;
        var pad = code is null ? [] : o!.Schema!.Voorouders(code).Where(c => c.Niveau >= 2).Reverse().Select(c => o.Naam(c.Code)).ToList();
        var rgs = code is null ? null : o!.Schema!.Zoek(code);
        if (sleutel == code)
        {
            pad.Add(o!.Naam(sleutel));
        }
        else
        {
            pad.Add(rgs is null ? "?" : o!.Naam(rgs.Code));
            pad.Add(o!.Naam(sleutel) + " (eigen post)");
        }

        return $"{string.Join(" › ", pad)} · {code}" + (o!.IsHernoemd(code ?? string.Empty) && rgs is not null ? $" (RGS: {rgs.Omschrijving})" : string.Empty);
    }

    private string SaldoTitel(RubriceerRekening r) => string.Join(" · ", new[]
    {
        r.Correcties != 0 ? $"incl. correcties {Bedragen.Heel(r.Correcties)}" : null,
        r.SaldoVorig is { } v ? $"{o!.Dossier.Boekjaar - 1}: {Bedragen.Heel(v)}" : null,
    }.OfType<string>());

    private static string BronTekst(KoppelBron bron) => bron switch
    {
        KoppelBron.Sjabloon => "automatisch via kantoorsjabloon",
        KoppelBron.Bestand => "automatisch via RGS-code uit het bestand",
        KoppelBron.Voorstel => "voorstel, bevestigd",
        _ => "handmatig",
    };

    private static bool KanKoppelen(Knoop k) => k.EigenId is not null || k.Niveau is 3 or 4;

    private List<Knoop>? Zoekresultaten
    {
        get
        {
            if (o?.Schema is null || string.IsNullOrWhiteSpace(zoekRechts) || zoekRechts.Trim().Length < 2)
            {
                return null;
            }

            var tekst = zoekRechts.Trim();
            var rgs = o.Schema.Alle
                .Where(c => c.Niveau is 3 or 4 && o.Codes.Contains(c.Code)
                            && (o.Naam(c.Code).Contains(tekst, StringComparison.OrdinalIgnoreCase) || c.Code.Contains(tekst, StringComparison.OrdinalIgnoreCase)))
                .Select(c => new Knoop(c.Code, c.Code, c.Niveau, null));
            var eigen = o.EigenPosten.Where(p => p.Naam.Contains(tekst, StringComparison.OrdinalIgnoreCase))
                .Select(p => new Knoop(PostBalans.EigenSleutel(p.Id), p.OuderCode, (o.Schema.Zoek(p.OuderCode)?.Niveau ?? 3) + 1, p.Id));
            return [.. eigen.Concat(rgs).Take(60)];
        }
    }

    private string Pad(Knoop k) =>
        string.Join(" › ", (k.EigenId is null ? o!.Schema!.Voorouders(k.Code) : [o!.Schema!.Zoek(k.Code)!, .. o.Schema.Voorouders(k.Code)])
            .Where(c => c.Niveau >= 2).Reverse().Select(c => o.Naam(c.Code)));

    /// <summary>De zichtbare regels van de boom (of de zoekresultaten), van boven naar beneden.</summary>
    private List<Regel> BoomRegels()
    {
        var regels = new List<Regel>();
        if (Zoekresultaten is { } resultaten)
        {
            regels.AddRange(resultaten.Select(k => new KnoopRegel(k, 0, false, false, MetPad: true)));
            return regels;
        }

        foreach (var (zijde, kop) in new[] { ("B", "Balans"), ("W", "Winst-en-verliesrekening") })
        {
            regels.Add(new KopRegel(kop));
            foreach (var knoop in Kinderen(new Knoop(zijde, zijde, 1, null)))
            {
                BouwRegels(regels, knoop, 0);
            }
        }

        return regels;
    }

    private void BouwRegels(List<Regel> regels, Knoop k, int diepte)
    {
        var kinderen = Kinderen(k).ToList();
        var rekeningen = RekeningenOp(k).ToList();
        var nieuw = nieuwOnder == k.Code && k.EigenId is null;
        var isOpen = open.Contains(k.Sleutel);
        regels.Add(new KnoopRegel(k, diepte, isOpen, kinderen.Count > 0 || rekeningen.Count > 0 || nieuw, MetPad: false));
        if (!isOpen)
        {
            return;
        }

        if (nieuw)
        {
            regels.Add(new NieuwRegel(k.Code, diepte + 1));
        }

        foreach (var kind in kinderen)
        {
            BouwRegels(regels, kind, diepte + 1);
        }

        regels.AddRange(rekeningen.Select(r => new RekeningRegel(r, diepte + 1)));
    }

    private void Wissel(string sleutel)
    {
        if (!open.Remove(sleutel))
        {
            open.Add(sleutel);
        }
    }

    private void ClapIn() => open.Clear();

    private void OpenBijSlepen(Knoop k)
    {
        // Slepen boven een hoofdpost klapt die open, zodat de subposten zichtbaar worden.
        if (gesleept.Count > 0 && k.Niveau == 2)
        {
            open.Add(k.Sleutel);
        }
    }

    private void Selecteer(Guid id, bool aan)
    {
        if (aan)
        {
            geselecteerd.Add(id);
        }
        else
        {
            geselecteerd.Remove(id);
        }
    }

    private void SelecteerAlles(bool aan)
    {
        foreach (var r in ZichtbareRekeningen)
        {
            Selecteer(r.Id, aan);
        }
    }

    private void BeginSlepen(Guid id) =>
        gesleept = geselecteerd.Contains(id) ? [.. geselecteerd] : [id];

    private async Task Neerzetten(Knoop k)
    {
        var rekeningen = gesleept;
        gesleept = [];
        if (rekeningen.Count == 0)
        {
            return;
        }

        if (!KanKoppelen(k))
        {
            open.Add(k.Sleutel);
            Meld("Zet de rekening op een subpost; de hoofdpost is opengeklapt.", fout: true);
            return;
        }

        await Koppel(rekeningen, k);
    }

    private Task KoppelSelectie(Knoop k) => Koppel([.. geselecteerd], k);

    private async Task Koppel(IReadOnlyCollection<Guid> rekeningen, Knoop k)
    {
        var uitkomst = await RubriceerDienst.Koppel(o!.Dossier.KlantId, rekeningen, k.Sleutel, onthouden, await Wie());
        if (uitkomst.IsGelukt)
        {
            Meld($"{rekeningen.Count} gekoppeld aan {o.Naam(k.Sleutel)}");
            geselecteerd.ExceptWith(rekeningen);
            await Laad();
        }
        else
        {
            Meld(string.Join(" ", uitkomst.Fouten), fout: true);
        }
    }

    private async Task KoppelVoorstel(RubriceerRekening r)
    {
        var uitkomst = await RubriceerDienst.Koppel(o!.Dossier.KlantId, [r.Id], r.Voorstel!.Code, onthouden, await Wie(), KoppelBron.Voorstel);
        if (uitkomst.IsGelukt)
        {
            Meld($"{r.Nummer} gekoppeld aan {KortLabel(r.Voorstel.Code)}");
            await Laad();
        }
        else
        {
            Meld(string.Join(" ", uitkomst.Fouten), fout: true);
        }
    }

    private async Task AccepteerVoorstellen()
    {
        var uitkomst = await RubriceerDienst.AccepteerVoorstellen(Id, geselecteerd.Count > 0 ? [.. geselecteerd] : null, onthouden, await Wie());
        Meld(uitkomst.IsGelukt ? $"{uitkomst.Waarde} voorstel(len) overgenomen; controleer ze in de posten" : string.Join(" ", uitkomst.Fouten), !uitkomst.IsGelukt);
        geselecteerd.Clear();
        await Laad();
    }

    private async Task Ontkoppel()
    {
        await RubriceerDienst.Ontkoppel(o!.Dossier.KlantId, [.. geselecteerd], await Wie());
        Meld($"{geselecteerd.Count} ontkoppeld");
        geselecteerd.Clear();
        await Laad();
    }

    private async Task OntkoppelEen(Guid id)
    {
        await RubriceerDienst.Ontkoppel(o!.Dossier.KlantId, [id], await Wie());
        await Laad();
    }

    private void BeginHernoemen(Knoop k)
    {
        hernoemSleutel = k.Sleutel;
        hernoemNaam = o!.Naam(k.Sleutel);
        hernoemKantoorbreed = false;
    }

    private async Task Hernoem()
    {
        var uitkomst = await RubriceerDienst.Hernoem(o!.Dossier.Id, hernoemSleutel!, hernoemNaam, hernoemKantoorbreed, await Wie());
        Meld(uitkomst.IsGelukt ? $"Hernoemd naar '{hernoemNaam.Trim()}'{(hernoemKantoorbreed ? " voor alle klanten" : string.Empty)} vanaf {o.Dossier.Boekjaar}" : string.Join(" ", uitkomst.Fouten), !uitkomst.IsGelukt);
        hernoemSleutel = null;
        await Laad();
    }

    private async Task HernoemTerug(Knoop k)
    {
        await RubriceerDienst.Hernoem(o!.Dossier.Id, k.Sleutel, null, kantoorbreed: false, await Wie());
        if (isBeheerder && hernoemKantoorbreed && o.KantoorNamen.ContainsKey(k.Code))
        {
            await RubriceerDienst.Hernoem(o.Dossier.Id, k.Sleutel, null, kantoorbreed: true, await Wie());
        }

        hernoemSleutel = null;
        await Laad();
    }

    private void BeginNieuw(Knoop k)
    {
        nieuwOnder = k.Code;
        nieuweNaam = "";
        open.Add(k.Sleutel);
    }

    private async Task VoegToe()
    {
        var uitkomst = await RubriceerDienst.VoegEigenPostToe(o!.Dossier.KlantId, nieuwOnder!, nieuweNaam, await Wie());
        if (uitkomst.IsGelukt)
        {
            Meld($"Post '{nieuweNaam.Trim()}' toegevoegd");
            nieuwOnder = null;
            await Laad();
        }
        else
        {
            Meld(string.Join(" ", uitkomst.Fouten), fout: true);
        }
    }

    private string? Saldering(Knoop k) => o?.EigenPosten.FirstOrDefault(p => p.Id == k.EigenId)?.OmslagCode;

    /// <summary>Salderen aan (met het voorstel uit RGS, of anders een code invullen) of uit.</summary>
    private async Task WisselSaldering(Knoop k, Guid id)
    {
        if (Saldering(k) is not null)
        {
            await ZetSaldering(id, null);
            return;
        }

        var post = o!.EigenPosten.First(p => p.Id == id);
        if (o.Schema is not null && RubriceerDienst.VoorstelOmslag(o.Schema, post.OuderCode) is { } voorstel)
        {
            await ZetSaldering(id, voorstel);
            return;
        }

        salderenPost = id;
        salderenCode = "";
    }

    private async Task ZetSaldering(Guid id, string? code)
    {
        var uitkomst = await RubriceerDienst.ZetSaldering(o!.Dossier.KlantId, id, code, await Wie());
        Meld(uitkomst.IsGelukt ? (code is null ? "Niet meer gesaldeerd" : $"Gesaldeerd; aan de andere kant naar {code}") : string.Join(" ", uitkomst.Fouten), !uitkomst.IsGelukt);
        if (uitkomst.IsGelukt)
        {
            salderenPost = null;
            await Laad();
        }
    }

    private async Task VerwijderEigen(Guid id)
    {
        var uitkomst = await RubriceerDienst.VerwijderEigenPost(o!.Dossier.KlantId, id, await Wie());
        Meld(uitkomst.IsGelukt ? "Eigen post verwijderd; de rekeningen staan nu op de post erboven" : string.Join(" ", uitkomst.Fouten), !uitkomst.IsGelukt);
        await Laad();
    }

    private void Meld(string tekst, bool fout = false)
    {
        melding = tekst;
        meldingIsFout = fout;
    }

    private async Task<Uitvoerder> Wie() => (await Authenticatie).User.AlsUitvoerder();
}
