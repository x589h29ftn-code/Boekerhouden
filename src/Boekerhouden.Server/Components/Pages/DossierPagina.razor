@page "/dossiers/{Id:guid}"
@inject DossierDienst DossierDienst
@inject ImportDienst ImportDienst
@inject RubriceerDienst RubriceerDienst
@inject SignaalDienst SignaalDienst

<PageTitle>@(dossier is null ? "Dossier" : $"{dossier.Naam} – {dossier.KlantNaam}") – Boekerhouden</PageTitle>

@if (!geladen)
{
    <p class="text-secondary">Laden…</p>
}
else if (dossier is null)
{
    <div class="alert alert-warning">Dit dossier bestaat niet (meer). <a href="/">Terug naar de klanten</a></div>
}
else
{
    <nav aria-label="kruimelpad">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Klanten</a></li>
            <li class="breadcrumb-item"><a href="/klanten/@dossier.KlantId">@dossier.KlantNaam</a></li>
            <li class="breadcrumb-item active" aria-current="page">@dossier.Naam</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center gap-2 mb-1">
        <h1 class="h3 mb-0">@dossier.Naam</h1>
        <DossierStatusLabel Status="dossier.Status" />
    </div>
    <p class="text-secondary mb-2">@dossier.Klantnummer @dossier.KlantNaam · @Weergave.Tekst(dossier.Rechtsvorm) · @Weergave.Tekst(dossier.Soort)</p>
    <DossierMenu DossierId="dossier.Id" />

    @if (signalen is not null)
    {
        <div class="bericht mb-3 d-flex flex-wrap gap-3 small" id="dossierstand">
            <span>Gekoppeld <span class="bedrag">@signalen.Percentage%</span></span>
            <span>Werkprogramma @(signalen.StappenTotaal > 0 ? $"{signalen.StappenKlaar} van {signalen.StappenTotaal} stappen klaar" : "nog niet gestart")</span>
            @foreach (var signaal in signalen.Signalen)
            {
                <span class="status let-op">@signaal</span>
            }
            <a class="ms-auto" href="/dossiers/@dossier.Id/werkprogramma">naar het werkprogramma</a>
        </div>
    }

    <ImportPaneel KlantId="dossier.KlantId" Klantnummer="@dossier.Klantnummer" KlantNaam="@dossier.KlantNaam"
                  Boekjaar="dossier.Boekjaar" OnGeimporteerd="Geimporteerd" />

    @if (rubricering is { Rekeningen.Count: > 0 })
    {
        <div class="card mt-4" id="rubricering">
            <div class="card-header d-flex align-items-center gap-3">
                <span class="fw-semibold me-auto">Proefbalans per hoofdpost @(rubricering.Rekeningen.Any(r => r.Correcties != 0) ? "(na correcties)" : null)</span>
                @if (rubricering.Schema is not null)
                {
                    <span class="small text-secondary">@rubricering.Gekoppeld van @rubricering.Relevant rekeningen gekoppeld (@rubricering.Percentage%)</span>
                }
                <a class="btn btn-sm btn-outline-secondary" href="/dossiers/@dossier.Id/rubriceren">Rubriceren</a>
            </div>
            @if (rubricering is { Schema: not null, Balans: { } balans } && rubricering.Gekoppeld > 0)
            {
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>Hoofdpost</th><th class="text-end" style="width:11rem">@dossier.Boekjaar</th><th class="text-end" style="width:11rem">@(dossier.Boekjaar - 1)</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var post in rubricering.Schema.Hoofdposten.Where(p => balans.Totaal(p.Code).Aantal > 0))
                        {
                            <tr>
                                <td title="RGS @post.Code"><a class="link-body-emphasis link-underline-opacity-0 link-underline-opacity-75-hover" href="/dossiers/@dossier.Id/proefbalans?open=@post.Code">@rubricering.Naam(post.Code)</a></td>
                                <td class="text-end bedrag">@Bedragen.Heel(balans.Totaal(post.Code).Huidig)</td>
                                <td class="text-end bedrag text-secondary">@Bedragen.Heel(balans.Totaal(post.Code).Vorig)</td>
                            </tr>
                        }
                        @if (balans.Ongekoppeld.Aantal > 0)
                        {
                            <tr class="fst-italic">
                                <td>Nog niet gekoppeld (@balans.Ongekoppeld.Aantal rekeningen)</td>
                                <td class="text-end bedrag">@Bedragen.Heel(balans.Ongekoppeld.Huidig)</td>
                                <td class="text-end bedrag text-secondary">@Bedragen.Heel(balans.Ongekoppeld.Vorig)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-semibold">
                            <td>Resultaat</td>
                            <td class="text-end bedrag">@Bedragen.Heel(balans.ResultaatHuidig)</td>
                            <td class="text-end bedrag text-secondary">@Bedragen.Heel(balans.ResultaatVorig)</td>
                        </tr>
                    </tfoot>
                </table>
            }
            else if (rubricering.Schema is null)
            {
                <div class="card-body small text-secondary">Er is nog geen RGS-werkboek ingelezen (Beheer › RGS).</div>
            }
            else
            {
                <div class="card-body small text-secondary">Nog niets gekoppeld. Koppel de grootboekrekeningen aan de rubrieken van RGS.</div>
            }
        </div>
    }

    <div class="card mt-4">
        <div class="card-header d-flex align-items-center">
            <span class="fw-semibold me-auto">Saldibalans @dossier.Boekjaar</span>
            @if (proefbalans?.Import is { } import)
            {
                <span class="small text-secondary">
                    @import.Bestandsnaam · @import.AantalRegels regels · ingelezen @Weergave.DatumTijd(import.GeimporteerdOp) door @import.GeimporteerdDoor
                </span>
            }
        </div>
        @if (proefbalans is null || proefbalans.Regels.Count == 0)
        {
            <div class="card-body text-secondary">Nog geen saldibalans ingelezen voor @dossier.Boekjaar.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0 proefbalans">
                    <thead>
                        <tr>
                            <th style="width:9rem">Grootboek</th>
                            <th>Omschrijving</th>
                            <th class="text-end" style="width:11rem">@dossier.Boekjaar</th>
                            <th class="text-end" style="width:11rem">@(dossier.Boekjaar - 1)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var regel in proefbalans.Regels)
                        {
                            <tr>
                                <td class="bedrag">@regel.Nummer</td>
                                <td>@regel.Omschrijving</td>
                                <td class="text-end bedrag"><Bedrag Waarde="regel.Bedrag" /></td>
                                <td class="text-end bedrag text-secondary"><Bedrag Waarde="regel.BedragVorigJaar" /></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-semibold">
                            <td colspan="2">Saldo (moet nihil zijn)</td>
                            <td class="text-end bedrag">@Bedragen.Heel(proefbalans.Totaal)</td>
                            <td class="text-end bedrag text-secondary">@(proefbalans.ImportVorigJaar is null ? "–" : Bedragen.Heel(proefbalans.TotaalVorigJaar))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="card-footer bg-white small text-secondary">
                Debet positief, credit negatief.
                @if (proefbalans.ImportVorigJaar is null)
                {
                    <span>Lees ook @(dossier.Boekjaar - 1) in voor de vergelijkende cijfers (kies het jaar hierboven).</span>
                }
            </div>
        }
    </div>
}

@code {
    private bool geladen;
    private DossierDetail? dossier;
    private Proefbalans? proefbalans;
    private RubriceerOverzicht? rubricering;
    private DossierSignalen? signalen;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await Laad();
        geladen = true;
    }

    private async Task Laad()
    {
        dossier = await DossierDienst.Haal(Id);
        proefbalans = dossier is null ? null : await ImportDienst.Proefbalans(dossier.KlantId, dossier.Boekjaar);
        rubricering = dossier is null ? null : await RubriceerDienst.Overzicht(dossier.Id, metVoorstellen: false);
        signalen = dossier is null ? null : (await SignaalDienst.VoorDossiers([dossier.Id])).GetValueOrDefault(dossier.Id);
    }

    private Task Geimporteerd() => Laad();
}
