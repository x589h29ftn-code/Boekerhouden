@* Een tabel uit het rapport. Een lijn staat onder het laatste bedrag vóór een (sub)totaal, een eindtotaal krijgt een
   dubbele lijn. In de viewer: driehoekjes om in en uit te klappen, namen aanklikken, rekeningen uitsplitsen. *@
@using Boekerhouden.Domain.Rapport
@using Boekerhouden.Server.Export

<table class="@(Tabel.Tweekoloms ? "tweekoloms" : "eenkoloms")">
    <thead>
        <tr>
            <th></th>
            <th class="jaar" colspan="@Span">@Tabel.KopHuidig<br />€</th>
            <th class="jaar vorig" colspan="@Span">@Tabel.KopVorig<br />€</th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Tabel.Regels.Count; i++)
        {
            var regel = Tabel.Regels[i];
            var volgende = i + 1 < Tabel.Regels.Count ? Tabel.Regels[i + 1].Soort : (RegelSoort?)null;
            var lijn = volgende is RegelSoort.Subtotaal or RegelSoort.Eindtotaal;
            var dubbel = regel.Soort == RegelSoort.Eindtotaal;
            if (regel.Soort == RegelSoort.Kop)
            {
                <tr class="kop @Sleepklasse(regel)" @ondrop="() => Neerzetten(regel)">
                    <td class="omschrijving" colspan="@Kolommen">
                        @Klap(regel)
                        @Omschrijving(regel)
                        @Rekeningen(regel)
                    </td>
                </tr>
            }
            else
            {
                <tr class="@Klasse(regel) @Sleepklasse(regel)" @ondrop="() => Neerzetten(regel)">
                    <td class="omschrijving">
                        @Klap(regel)
                        @Omschrijving(regel)
                        @Rekeningen(regel)
                        @if (Document.Bewerkbaar && regel.Bron is { Soort: Onderwerp.Rekening, Id: { } id } && openSplitsing != id)
                        {
                            <button type="button" class="bewerk-actie" @onclick="() => openSplitsing = id">uitsplitsen</button>
                            @if (Tabel.Code?.StartsWith('B') == true && !HeeftVerloop(id))
                            {
                                <button type="button" class="bewerk-actie" title="Een verloopoverzicht van deze rekening onder de specificatie, vanaf dit jaar"
                                        @onclick="() => Document.ZetVerloop(RapportOpbouw.RekeningSleutel(id), true)">verloop</button>
                            }
                        }
                    </td>
                    @if (Tabel.Tweekoloms)
                    {
                        <td class="bedrag" @onclick="() => Toon(regel)">@RapportHtml.Bedrag(regel.Detail)</td>
                        <td class="@Cel(lijn, dubbel && regel.Totaal is not null)" @onclick="() => Toon(regel)">@RapportHtml.Bedrag(regel.Totaal)</td>
                        <td class="bedrag vorig" @onclick="() => Toon(regel)">@RapportHtml.Bedrag(regel.DetailVorig)</td>
                        <td class="@Cel(lijn, dubbel && regel.TotaalVorig is not null, vorig: true)" @onclick="() => Toon(regel)">@RapportHtml.Bedrag(regel.TotaalVorig)</td>
                    }
                    else
                    {
                        <td class="@Cel(lijn, dubbel)" @onclick="() => Toon(regel)">@RapportHtml.Bedrag(regel.Detail ?? regel.Totaal)</td>
                        <td class="@Cel(lijn, dubbel, vorig: true)" @onclick="() => Toon(regel)">@RapportHtml.Bedrag(regel.DetailVorig ?? regel.TotaalVorig)</td>
                    }
                </tr>
            }

            @if (openSplitsing is { } open && LaatsteRegel(open) == i)
            {
                <tr class="bewerker">
                    <td colspan="@Kolommen">
                        <UitsplitsingBewerker RekeningId="open" Omschrijving="@SplitsOmschrijving(open)" Saldo="@Som(open, vorig: false)" SaldoVorig="@Som(open, vorig: true)"
                                              Sluiten="() => openSplitsing = null" />
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private Guid? openSplitsing;

    [CascadingParameter]
    public RapportDocument Document { get; set; } = default!;

    [Parameter, EditorRequired]
    public Tabel Tabel { get; set; } = default!;

    private int Kolommen => Tabel.Tweekoloms ? 5 : 3;

    private bool HeeftVerloop(Guid rekeningId) =>
        Document.Inhoud.Rapport.Hoofdstukken.SelectMany(h => h.Blokken).OfType<VerloopBlok>().Any(v => v.Verloop.Sleutel == RapportOpbouw.RekeningSleutel(rekeningId));

    private int Span => Tabel.Tweekoloms ? 2 : 1;

    private static string Klasse(Regel regel) => regel.Soort switch
    {
        RegelSoort.Post => "post",
        RegelSoort.Detail when regel.Omschrijving == RapportOpbouw.NietGespecificeerd && regel.Bron?.Soort == Onderwerp.Uitsplitsing => "detail verschil",
        RegelSoort.Detail => "detail",
        RegelSoort.Subtotaal => "subtotaal",
        _ => "eindtotaal",
    };

    private static string Cel(bool lijn, bool dubbel, bool vorig = false) =>
        string.Join(' ', new[] { "bedrag", vorig ? "vorig" : null, lijn ? "lijn" : null, dubbel ? "dubbel" : null }.OfType<string>());

    /// <summary>Het driehoekje om in of uit te klappen; alleen in de viewer en nooit bij afdrukken.</summary>
    private RenderFragment? Klap(Regel regel) => Document.Bewerkbaar && regel is { Uitgeklapt: { } uit, Bron: { } bron }
        ? @<button type="button" class="klap" title="@(uit ? "Inklappen" : "Uitklappen")" aria-expanded="@(uit ? "true" : "false")"
                   aria-label="@($"{regel.Omschrijving} {(uit ? "inklappen" : "uitklappen")}")" @onclick="() => Document.Klap(bron.Sleutel, !uit)">@(uit ? "▾" : "▸")</button>
        : null;

    private RenderFragment Omschrijving(Regel regel) => regel.Bron switch
    {
        { Soort: Onderwerp.Uitsplitsing, Id: { } id } bron when Document.Bewerkbaar =>
            @<span class="bewerkbaar" title="@($"{bron.Herkomst} · klik om de uitsplitsing aan te passen")" @onclick="() => openSplitsing = id">@regel.Omschrijving</span>,
        { Soort: Onderwerp.Post or Onderwerp.EigenPost or Onderwerp.Rekening } bron =>
            @<BewerkbareTekst Tekst="@regel.Omschrijving" Titel="@bron.Herkomst" Bewerkbaar="@Document.Bewerkbaar" Opslaan="naam => Document.Hernoem(bron, naam)" />,
        _ => @<text>@regel.Omschrijving</text>,
    };

    /// <summary>De laatste regel van een rekening (of zijn uitsplitsing); daaronder komt de bewerker.</summary>
    private int LaatsteRegel(Guid rekeningId)
    {
        for (var i = Tabel.Regels.Count - 1; i >= 0; i--)
        {
            if (Tabel.Regels[i].Bron?.Id == rekeningId)
            {
                return i;
            }
        }

        return -1;
    }

    private IEnumerable<Regel> RegelsVan(Guid rekeningId) => Tabel.Regels.Where(r => r.Bron?.Id == rekeningId && r.Bron.Soort is Onderwerp.Rekening or Onderwerp.Uitsplitsing);

    /// <summary>Het saldo van de rekening zoals in het rapport: de som van zijn regels (bij een uitsplitsing inclusief het verschil).</summary>
    private decimal Som(Guid rekeningId, bool vorig) => RegelsVan(rekeningId).Sum(r => (vorig ? r.DetailVorig : r.Detail) ?? 0);

    private static bool HeeftRekeningen(Regel regel) => regel.Bron?.Soort is Onderwerp.Post or Onderwerp.EigenPost or Onderwerp.Rekening or Onderwerp.Uitsplitsing;

    /// <summary>"rekeningen" bij aanwijzen: rechts de grootboekrekeningen van de post, om ze naar een andere post te slepen.</summary>
    private RenderFragment? Rekeningen(Regel regel) => Document.KanRekeningenTonen && HeeftRekeningen(regel)
        ? @<button type="button" class="bewerk-actie" title="De grootboekrekeningen van deze post; sleep er een naar een andere regel om hem daar te verantwoorden"
                   @onclick="() => Toon(regel)">rekeningen</button>
        : null;

    private Task Toon(Regel regel) =>
        Document.KanRekeningenTonen && HeeftRekeningen(regel) ? Document.RekeningenTonen.InvokeAsync(regel.Bron!) : Task.CompletedTask;

    /// <summary>Een regel waar een rekening op kan vallen; de markering tijdens het slepen doet slepen.js.</summary>
    private string? Sleepklasse(Regel regel) =>
        Document.DoelVan(regel.Bron) is null ? (Document.KanRekeningenTonen && HeeftRekeningen(regel) ? "toonbaar" : null)
        : HeeftRekeningen(regel) ? "dropdoel toonbaar" : "dropdoel";

    private Task Neerzetten(Regel regel) =>
        Document.DoelVan(regel.Bron) is { } doel ? Document.Neergezet.InvokeAsync(doel) : Task.CompletedTask;

    private string SplitsOmschrijving(Guid rekeningId) => RegelsVan(rekeningId).FirstOrDefault()?.Omschrijving ?? "";
}
