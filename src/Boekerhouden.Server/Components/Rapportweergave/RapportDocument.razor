@* Het rapport: in de viewer bewerkbaar, voor de PDF statisch gerenderd (zonder knoppen). De opmaak staat in RapportHtml.Stijl. *@
@using Boekerhouden.Domain.Rapport
@using Boekerhouden.Server.Export
@inject RapportDienst RapportDienst
@inject RubriceerDienst RubriceerDienst
@inject GrondslagDienst GrondslagDienst

<CascadingValue Value="this" IsFixed="true">
    @if (Post is { } alleen)
    {
        var grondslagKop = false;
        <div class="rapport-document rapport-fragment" style="--huisstijl: @RapportHtml.Kleur(Inhoud.Kantoor)">
            @foreach (var (h, blok, toelichting, paragraaf) in BlokkenVan(alleen))
            {
                @if (blok is GrondslagBlok && !grondslagKop)
                {
                    grondslagKop = true;
                    <h2 class="groep">Grondslagen <span class="kop-uitleg">(in de algemene toelichting)</span></h2>
                }
                @BlokWeergave(h, blok, toelichting, paragraaf)
            }
        </div>
    }
    else
    {
    <div class="rapport-document" style="--huisstijl: @RapportHtml.Kleur(Inhoud.Kantoor)">
        <section class="voorblad">
            <div class="boven">
                @if (RapportHtml.Logo(Inhoud.Kantoor) is { } logo)
                {
                    <img class="logo" src="@logo" alt="" />
                }
            </div>
            <div class="midden">
                <div class="klant">@R.Klantnaam</div>
                @if (R.Plaats is { Length: > 0 } plaats)
                {
                    <div class="plaats">te @plaats</div>
                }
                <div class="titel">@R.Titel</div>
                @if (R.Concept)
                {
                    <div class="concept">Concept, @Weergave.DatumVoluit(Inhoud.Op)</div>
                }
            </div>
            <div class="onder">
                <div>@Inhoud.Kantoor.Naam</div>
                <div>@Adres</div>
            </div>
        </section>

        <section class="inhoud">
            <h1>Inhoudsopgave</h1>
            @foreach (var deel in R.Delen)
            {
                <div class="inhoud-deel">@deel.Titel</div>
                <ol>
                    @foreach (var h in deel.Hoofdstukken)
                    {
                        <li><span class="nr">@h.Nummer</span>@h.Titel</li>
                    }
                </ol>
            }
            @if (R.Concept && R.Waarschuwingen.Count > 0)
            {
                <div class="aandacht">
                    <div>Nog niet af</div>
                    <ul>
                        @foreach (var waarschuwing in R.Waarschuwingen)
                        {
                            <li>@waarschuwing</li>
                        }
                    </ul>
                </div>
            }
        </section>

        @foreach (var deel in R.Delen)
        {
            <section class="tussenblad"><div class="deel">@deel.Titel</div></section>
            @foreach (var h in deel.Hoofdstukken)
            {
                <section class="hoofdstuk" id="@RapportHtml.Anker(h)">
                    <h1><span class="nr">@h.Nummer</span>@h.Titel</h1>
                    @foreach (var (blok, toelichting, paragraaf) in Blokken(h))
                    {
                        @BlokWeergave(h, blok, toelichting, paragraaf)
                    }
                </section>
            }
        }
    </div>
    }
</CascadingValue>

@code {
    [Parameter, EditorRequired]
    public RapportInhoud Inhoud { get; set; } = default!;

    /// <summary>In de viewer: in- en uitklappen, namen en toelichtingen aanpassen, rekeningen uitsplitsen.</summary>
    [Parameter]
    public bool Bewerkbaar { get; set; }

    /// <summary>Na elke wijziging: de uitkomst en een korte melding (null = geen melding), om het rapport opnieuw te maken.</summary>
    [Parameter]
    public EventCallback<(Uitkomst Uitkomst, string? Melding)> Gewijzigd { get; set; }

    /// <summary>Wie de wijzigingen doet (alleen in de viewer; de PDF wordt zonder gebruiker gerenderd).</summary>
    [Parameter]
    public Func<Task<Uitvoerder>>? Wie { get; set; }

    /// <summary>In de viewer: de rekeningen onder de post van een regel tonen (rechts naast het rapport).</summary>
    [Parameter]
    public EventCallback<Bron> RekeningenTonen { get; set; }

    /// <summary>Waar een gesleepte rekening heen gaat als hij op een regel met deze bron valt; null = daar kan niets heen.</summary>
    [Parameter]
    public Func<Bron?, string?>? Sleepdoel { get; set; }

    /// <summary>Een rekening is neergezet op een regel; het argument is het doel (RGS-code of eigen post).</summary>
    [Parameter]
    public EventCallback<string> Neergezet { get; set; }

    /// <summary>Alleen de blokken van deze hoofdpost tonen (in het werkprogramma); null = het hele rapport.</summary>
    [Parameter]
    public string? Post { get; set; }

    public bool KanRekeningenTonen => Bewerkbaar && RekeningenTonen.HasDelegate;

    public string? DoelVan(Bron? bron) => Bewerkbaar ? Sleepdoel?.Invoke(bron) : null;

    private Rapport R => Inhoud.Rapport;

    private string Adres => string.Join(" · ", new[] { Inhoud.Kantoor.Adres, $"{Inhoud.Kantoor.Postcode} {Inhoud.Kantoor.Plaats}".Trim() }
        .Where(t => !string.IsNullOrWhiteSpace(t)));

    /// <summary>
    /// De blokken van een hoofdstuk met hun paragraafnummer (3.1, 3.2, …). Een toelichting direct na de specificatie
    /// van dezelfde post komt bij die tabel, zodat ze samen op een pagina blijven.
    /// </summary>
    private static IEnumerable<(Blok Blok, TekstBlok? Toelichting, string? Paragraaf)> Blokken(Hoofdstuk h)
    {
        var nummer = 0;
        for (var i = 0; i < h.Blokken.Count; i++)
        {
            var blok = h.Blokken[i];
            var paragraaf = h.Paragrafen && blok is TabelBlok { Tabel.Titel: not null } or TekstBlok { Titel: not null } or GroepBlok { HeeftOpgenomen: true }
                ? $"{h.Nummer}.{++nummer}"
                : null;
            if (blok is TabelBlok { Tabel.Code: { } code } && i + 1 < h.Blokken.Count && h.Blokken[i + 1] is TekstBlok { Toelichting: var t } tekst && t == code)
            {
                yield return (blok, tekst, paragraaf);
                i++;
                continue;
            }

            yield return (blok, null, paragraaf);
        }
    }

    /// <summary>Eén blok van het rapport (specificatie met toelichting, losse toelichting, groepskop, verloop of grondslag).</summary>
    private RenderFragment BlokWeergave(Hoofdstuk h, Blok blok, TekstBlok? toelichting, string? paragraaf) => __builder =>
    {
        @if (blok is TabelBlok { Tabel: var tabel })
        {
            <div class="blok" id="@(tabel.Code is null ? null : RapportHtml.Anker(tabel.Code))" data-post="@tabel.Code">
                @if (tabel.Titel is not null)
                {
                    <h2>
                        @if (paragraaf is not null)
                        {
                            <span class="nr">@paragraaf</span>
                        }
                        <BewerkbareTekst Tekst="@tabel.Titel" Titel="@tabel.Bron?.Herkomst" Bewerkbaar="@(Bewerkbaar && tabel.Bron is not null)"
                                         Opslaan="naam => Hernoem(tabel.Bron!, naam)" />
                    </h2>
                }
                <RapportTabel Tabel="tabel" />
                @if (tabel.Code is not null && (toelichting is not null || Bewerkbaar))
                {
                    <ToelichtingBlok Sleutel="@tabel.Code" Tekst="@toelichting?.Tekst" Sjabloon="@toelichting?.Sjabloon" />
                }
                @if (Bewerkbaar && tabel.Code is { } post && post.StartsWith('B') && !h.Blokken.OfType<VerloopBlok>().Any(v => v.Verloop.Sleutel == post))
                {
                    <button type="button" class="bewerk-actie" title="Een verloopoverzicht per subpost, vanaf dit jaar" @onclick="() => ZetVerloop(post, true)">verloop toevoegen</button>
                }
            </div>
        }
        else if (blok is TekstBlok { Toelichting: { } sleutel } tekst)
        {
            <div class="blok" id="@RapportHtml.Anker(sleutel)" data-post="@sleutel">
                @if (tekst.Titel is not null)
                {
                    <h2>
                        @if (paragraaf is not null)
                        {
                            <span class="nr">@paragraaf</span>
                        }
                        @tekst.Titel
                    </h2>
                }
                <ToelichtingBlok Sleutel="@sleutel" Tekst="@tekst.Tekst" Sjabloon="@tekst.Sjabloon" />
            </div>
        }
        else if (blok is GroepBlok groep && (groep.HeeftOpgenomen || Bewerkbaar))
        {
            <h2 class="groep@(groep.HeeftOpgenomen ? null : " dicht")">
                @if (paragraaf is not null)
                {
                    <span class="nr">@paragraaf</span>
                }
                @groep.Titel
            </h2>
        }
        else if (blok is VerloopBlok { Verloop: var verloop })
        {
            <VerloopWeergave Verloop="verloop" @key="verloop" />
        }
        else if (blok is GrondslagBlok grondslag && (grondslag.Opgenomen || Bewerkbaar))
        {
            <GrondslagWeergave Grondslag="grondslag" />
        }
        else if (blok is TekstBlok vast)
        {
            <p>@vast.Tekst</p>
        }
    };

    /// <summary>
    /// De blokken van één hoofdpost, voor het werkprogramma: de specificatie (met toelichting en verloop toevoegen),
    /// een losse toelichting, de verloopoverzichten eronder (ook die van rekeningen) en daarna de grondslagen met een
    /// code onder de post.
    /// </summary>
    private IEnumerable<(Hoofdstuk H, Blok Blok, TekstBlok? Toelichting, string? Paragraaf)> BlokkenVan(string post)
    {
        var blokken = new List<(Hoofdstuk, Blok, TekstBlok?, string?)>();
        var grondslagen = new List<(Hoofdstuk, Blok, TekstBlok?, string?)>();
        string? vorige = null;
        foreach (var h in R.Hoofdstukken)
        {
            foreach (var (blok, toelichting, paragraaf) in Blokken(h))
            {
                switch (blok)
                {
                    case TabelBlok { Tabel.Code: { } code }:
                        vorige = code;
                        if (code == post)
                        {
                            blokken.Add((h, blok, toelichting, paragraaf));
                        }

                        break;
                    case TekstBlok { Toelichting: { } code }:
                        vorige = code;
                        if (code == post)
                        {
                            blokken.Add((h, blok, null, paragraaf));
                        }

                        break;
                    case VerloopBlok { Verloop.Sleutel: var sleutel } when sleutel == post
                        || (vorige == post && sleutel.StartsWith(RapportOpbouw.RekeningVoorvoegsel, StringComparison.Ordinal)):
                        blokken.Add((h, blok, null, paragraaf));
                        break;
                    case GrondslagBlok grondslag when grondslag.Codes.Any(c => c.StartsWith(post, StringComparison.Ordinal)):
                        grondslagen.Add((h, blok, null, paragraaf));
                        break;
                }
            }
        }

        return [.. blokken, .. grondslagen];
    }

    public Guid DossierId => Inhoud.Dossier.Id;

    public Guid KlantId => Inhoud.Dossier.KlantId;

    public Task<Uitkomst> Klap(string sleutel, bool uitgeklapt) => Uitvoeren(async wie => await RapportDienst.ZetUitgeklapt(DossierId, sleutel, uitgeklapt, wie), null);

    /// <summary>Een andere naam voor een post, eigen post of rekening; leeg = de standaardnaam.</summary>
    public Task<Uitkomst> Hernoem(Bron bron, string? naam) => bron.Soort switch
    {
        Onderwerp.Post or Onderwerp.EigenPost => Uitvoeren(wie => RubriceerDienst.Hernoem(DossierId, bron.Sleutel, naam, false, wie),
            string.IsNullOrWhiteSpace(naam) ? $"Standaardnaam vanaf {Inhoud.Dossier.Boekjaar}" : $"Naam aangepast vanaf {Inhoud.Dossier.Boekjaar}"),
        Onderwerp.Rekening => Uitvoeren(wie => RapportDienst.ZetWeergave(DossierId, bron.Id!.Value, naam, false, wie),
            string.IsNullOrWhiteSpace(naam) ? $"Omschrijving uit de administratie vanaf {Inhoud.Dossier.Boekjaar}" : $"Omschrijving aangepast vanaf {Inhoud.Dossier.Boekjaar}"),
        _ => Task.FromResult(Uitkomst.Mislukt("Deze regel is niet aan te passen.")),
    };

    /// <summary>Een grondslag in dit dossier open (in het rapport) of dicht zetten.</summary>
    public Task<Uitkomst> KlapGrondslag(string sleutel, bool opgenomen) =>
        Uitvoeren(wie => GrondslagDienst.ZetOpgenomen(DossierId, sleutel, opgenomen, wie), null);

    /// <summary>Een eigen tekst voor een grondslag in dit dossier; null = de tekst uit de bibliotheek.</summary>
    public Task<Uitkomst> GrondslagTekst(string sleutel, string? tekst) =>
        Uitvoeren(wie => GrondslagDienst.ZetTekst(DossierId, sleutel, tekst, wie), tekst is null ? "Standaardtekst teruggezet" : "Grondslag aangepast");

    public Task<Uitkomst> Toelichting(string sleutel, string? tekst) =>
        Uitvoeren(wie => RapportDienst.ZetToelichting(DossierId, sleutel, tekst, wie), string.IsNullOrWhiteSpace(tekst) ? "Toelichting verwijderd" : "Toelichting opgeslagen");

    /// <summary>Een verloopoverzicht bij een post of rekening ("rek:&lt;id&gt;") aan- of uitzetten, vanaf dit jaar.</summary>
    public Task<Uitkomst> ZetVerloop(string sleutel, bool tonen) =>
        Uitvoeren(wie => RapportDienst.ZetVerloop(DossierId, sleutel, tonen, wie), tonen ? $"Verloopoverzicht toegevoegd vanaf {Inhoud.Dossier.Boekjaar}" : $"Verloopoverzicht weggehaald vanaf {Inhoud.Dossier.Boekjaar}");

    public Task<Uitkomst> ZetVerloopVergelijkend(string sleutel, bool vergelijkend) =>
        Uitvoeren(wie => RapportDienst.ZetVerloopVergelijkend(DossierId, sleutel, vergelijkend, wie), vergelijkend ? "Verloop met vorig jaar" : "Verloop zonder vorig jaar");

    public Task<Uitkomst> ZetAfschrijvingspercentages(IReadOnlyDictionary<string, string?> percentages) =>
        Uitvoeren(wie => RapportDienst.ZetAfschrijvingspercentages(DossierId, percentages, wie), null);

    public Task<Uitkomst> BewaarVerloop(string sleutel, IReadOnlyList<VerloopMutatie> mutaties) =>
        Uitvoeren(wie => RapportDienst.BewaarVerloop(DossierId, sleutel, mutaties, wie), mutaties.Count == 0 ? "Voorstel uit de saldi teruggezet" : "Verloopoverzicht opgeslagen");

    public Task<Uitkomst> Uitsplitsing(Guid rekeningId, IReadOnlyList<SplitsRegel> regels) =>
        Uitvoeren(wie => RapportDienst.BewaarUitsplitsing(DossierId, rekeningId, regels, wie), regels.Count == 0 ? "Uitsplitsing verwijderd" : "Uitsplitsing opgeslagen");

    private async Task<Uitkomst> Uitvoeren(Func<Uitvoerder, Task<Uitkomst>> actie, string? melding)
    {
        if (Wie is null)
        {
            return Uitkomst.Mislukt("Alleen in de viewer aan te passen.");
        }

        var uitkomst = await actie(await Wie());
        await Gewijzigd.InvokeAsync((uitkomst, melding));
        return uitkomst;
    }
}
