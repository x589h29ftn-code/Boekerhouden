@* Een toelichtende tekst bij een post (rolt door naar volgende jaren). In de viewer aan te klikken; zonder tekst een knop om er een toe te voegen. *@

@if (bewerken)
{
    <div class="toelichting">
        <textarea @ref="invoer" class="inline-invoer" @bind="waarde" @bind:event="oninput" maxlength="@RapportDienst.MaximaleToelichting"
                  aria-label="Toelichting"></textarea>
        <div class="d-flex gap-2 align-items-center mt-1" style="font-size: 8pt">
            <button type="button" class="btn btn-primary btn-sm py-0" @onclick="Bewaar">Opslaan</button>
            <button type="button" class="btn btn-link btn-sm py-0 text-secondary" @onclick="() => bewerken = false">Annuleren</button>
            <VariabeleKeuze Veld="invoer" Waarden="Document.Inhoud.Rapport.Variabelen" />
        </div>
    </div>
}
else if (Tekst is not null)
{
    @if (Document.Bewerkbaar)
    {
        <div class="toelichting bewerkbaar" title="Toelichting · klik om aan te passen (geldt vanaf dit jaar)" @onclick="Start">@Tekst</div>
    }
    else
    {
        <div class="toelichting">@Tekst</div>
    }
}
else if (Document.Bewerkbaar)
{
    <button type="button" class="bewerk-actie" @onclick="Start">toelichting toevoegen</button>
}

@code {
    private bool bewerken;
    private bool focus;
    private string waarde = "";
    private ElementReference invoer;

    [CascadingParameter]
    public RapportDocument Document { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Sleutel { get; set; } = "";

    [Parameter]
    public string? Tekst { get; set; }

    /// <summary>De tekst met variabelen (zoals ingevoerd); null als die gelijk is aan <see cref="Tekst"/>.</summary>
    [Parameter]
    public string? Sjabloon { get; set; }

    private string Ingevoerd => Sjabloon ?? Tekst ?? "";

    private void Start()
    {
        waarde = Ingevoerd;
        bewerken = true;
        focus = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focus)
        {
            focus = false;
            await invoer.FocusAsync();
        }
    }

    private async Task Bewaar()
    {
        bewerken = false;
        if (waarde.Trim() != Ingevoerd)
        {
            await Document.Toelichting(Sleutel, waarde);
        }
    }
}
