@* Navigatie binnen een dossier; rustig, de huidige pagina in donkere tekst. *@
<nav class="dossiermenu" aria-label="Dossier">
    @foreach (var (pad, tekst) in Onderdelen)
    {
        <a href="@($"/dossiers/{DossierId}{pad}")" class="@(pad == Actief ? "actief" : null)" aria-current="@(pad == Actief ? "page" : null)">@tekst</a>
    }
</nav>

@code {
    private static readonly (string Pad, string Tekst)[] Onderdelen =
    [
        ("", "Overzicht"),
        ("/rubriceren", "Rubriceren"),
        ("/correcties", "Correcties"),
        ("/proefbalans", "Proefbalans"),
    ];

    [Parameter, EditorRequired]
    public Guid DossierId { get; set; }

    /// <summary>Het pad van de huidige pagina: "", "/rubriceren", "/correcties" of "/proefbalans".</summary>
    [Parameter]
    public string Actief { get; set; } = "";
}
