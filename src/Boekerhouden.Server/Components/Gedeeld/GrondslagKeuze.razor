@* De keuze commerciële of fiscale grondslagen voor de jaarrekening van een BV: één rustige regel, de uitleg in de tooltip. *@
@inject GrondslagDienst GrondslagDienst

<div class="small text-secondary mb-2 d-flex align-items-center gap-2" id="grondslagkeuze"
     title="Bepaalt de grondslagen en waarderingen, bijv. latente belastingen (alleen commercieel) en afschrijving op panden tot de WOZ-waarde (fiscaal).">
    @if (Huidig is null || wijzigen)
    {
        <span>Grondslagen:</span>
        @foreach (var keuze in Enum.GetValues<Verslaggeving>())
        {
            <button type="button" class="btn btn-sm py-0 @(keuze == Huidig ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => Kies(keuze)">@Weergave.Tekst(keuze)</button>
        }
        @if (wijzigen)
        {
            <button type="button" class="btn btn-link btn-sm p-0 text-secondary" @onclick="() => wijzigen = false">annuleren</button>
        }
    }
    else
    {
        <span>@Weergave.Tekst(Huidig.Value)</span>
        <button type="button" class="btn btn-link btn-sm p-0 text-secondary" @onclick="() => wijzigen = true">wijzigen</button>
    }
</div>

@code {
    private bool wijzigen;

    [Parameter, EditorRequired]
    public Guid DossierId { get; set; }

    [Parameter]
    public Verslaggeving? Huidig { get; set; }

    /// <summary>Na een gelukte keuze, om de pagina opnieuw te laden.</summary>
    [Parameter]
    public EventCallback Gekozen { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> Authenticatie { get; set; } = default!;

    private async Task Kies(Verslaggeving keuze)
    {
        var uitkomst = await GrondslagDienst.KiesVerslaggeving(DossierId, keuze, (await Authenticatie).User.AlsUitvoerder());
        if (uitkomst.IsGelukt)
        {
            wijzigen = false;
            await Gekozen.InvokeAsync();
        }
    }
}
