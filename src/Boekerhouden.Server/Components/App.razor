<!DOCTYPE html>
<html lang="nl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/Boekerhouden.Huisstijl/lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Boekerhouden.Huisstijl/app.css"]" />
    <link rel="stylesheet" href="@Assets["Boekerhouden.Server.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="@Assets["_content/Boekerhouden.Huisstijl/favicon.svg"]" />
    <HeadOutlet @rendermode="PaginaRenderModus" />
</head>

<body>
    <Routes @rendermode="PaginaRenderModus" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["slepen.js"]"></script>
    <script src="@Assets["tekst.js"]"></script>
    <script src="@Assets["navigatie.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // De accountpagina's (inloggen, wachtwoord wijzigen) draaien zonder circuit; de rest is interactief.
    private IComponentRenderMode? PaginaRenderModus =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
