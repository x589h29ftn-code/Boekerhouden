@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigatie

<header class="kopbalk">
    <a class="merk" href="/">
        <img src="favicon.svg" alt="" width="22" height="22" />
        Boekerhouden
    </a>
    <nav class="hoofdmenu" aria-label="Hoofdmenu">
        <a href="/" class="@(Onderdeel == "werk" ? "actief" : null)">Klanten</a>
        <AuthorizeView Roles="@Rollen.Beheerder">
            <a href="/beheer/kantoor" class="@(Onderdeel == "beheer" ? "actief" : null)">Beheer</a>
        </AuthorizeView>
    </nav>
    <AuthorizeView>
        <details class="uitklapmenu gebruikersmenu">
            <summary title="@context.User.WeergaveNaam()" aria-label="Gebruikersmenu"><span class="initialen">@context.User.WeergaveInitialen()</span></summary>
            <div class="menu">
                <div class="naam">@context.User.WeergaveNaam()</div>
                <a href="/wachtwoord-wijzigen" data-enhance-nav="false">Wachtwoord wijzigen</a>
                <form action="/account/uitloggen" method="post">
                    <AntiforgeryToken />
                    <button type="submit">Uitloggen</button>
                </form>
            </div>
        </details>
    </AuthorizeView>
</header>

<main class="hoofdinhoud py-4">
    <ErrorBoundary @ref="foutgrens">
        <ChildContent>
            @Body
        </ChildContent>
        <ErrorContent>
            <div class="alert alert-danger">
                Er ging iets mis. Probeer het opnieuw; blijft het misgaan, meld dan wat je deed bij de beheerder.
                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => foutgrens?.Recover()">Verder</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</main>

<AuthorizeView>
    <a class="hulp-knop" href="/hulp#@Hulpsectie" target="_blank" title="Documentatie" aria-label="Documentatie">?</a>
</AuthorizeView>

@code {
    private ErrorBoundary? foutgrens;

    // Op interactieve pagina's blijft de layout staan bij navigatie; dan het menu en het vraagteken bijwerken.
    protected override void OnInitialized() => Navigatie.LocationChanged += Verplaatst;

    private void Verplaatst(object? afzender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Navigatie.LocationChanged -= Verplaatst;

    private string Pad => Navigatie.ToBaseRelativePath(Navigatie.Uri);

    /// <summary>Welk deel van het hoofdmenu actief is: het werk (klanten en dossiers) of beheer.</summary>
    private string? Onderdeel => Pad.StartsWith("beheer", StringComparison.Ordinal) ? "beheer"
        : Pad.StartsWith("hulp", StringComparison.Ordinal) ? null
        : "werk";

    /// <summary>Het deel van de documentatie dat bij de huidige pagina hoort.</summary>
    private string Hulpsectie => Sectie(Pad);

    internal static string Sectie(string pad)
    {
        var delen = pad.Split('?', '#')[0].Split('/', StringSplitOptions.RemoveEmptyEntries);
        return delen switch
        {
            ["dossiers", _, var tab, ..] => tab,
            ["dossiers", ..] => "dossier",
            ["klanten", ..] => "klanten",
            ["beheer", var onderdeel, ..] => "beheer-" + onderdeel,
            _ => "klanten",
        };
    }
}
