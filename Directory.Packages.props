<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Excel lezen en schrijven (MIT). -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <!-- Transitief via ClosedXML. Versie 1.x is Apache-2.0; 2.x en hoger vallen onder een andere licentie: niet ophogen. -->
    <PackageVersion Include="SixLabors.Fonts" Version="1.0.0" />
    <!-- Tekst uit PDF's halen voor de factuurherkenning (Apache-2.0, zonder afhankelijkheden). -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- QR-code voor het instellen van de authenticator-app (MIT). Versie 1.6.0: voor .NET 6+ zonder afhankelijkheden
         (latere versies trekken System.Drawing.Common mee). -->
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <!-- Database en inloggen (MIT; Npgsql: PostgreSQL-licentie). Versies gelijk aan de .NET-runtime. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- SQLite voor de Windows-app (MIT; SQLitePCLRaw: Apache-2.0; SQLite zelf: public domain). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!-- Windows-app: de schermen in een eigen venster (MIT; WebView2-SDK: BSD-3). -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.100" />
    <!-- Tests. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
